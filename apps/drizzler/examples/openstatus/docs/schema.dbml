Table integration {
  id integer [pk, not null]
  name text [not null]
  workspace_id integer
  credential text [note: 'Not used yet but we might need to get store something for the integration  webhook url and or secret']
  external_id text [not null]
  created_at integer
  updated_at integer
  data text [not null]
  indexes {
    (workspace_id) [name: 'integration_workspace_id_idx']
  }
}

Table workspace {
  id integer [pk, not null]
  slug text [not null, unique]
  name text
  stripe_id text [unique]
  subscription_id text
  plan text
  ends_at integer
  paid_until integer
  trial_ends_at integer
  trialed_at integer
  limits text [not null]
  workos_organization_id text [unique]
  sso_enabled integer [not null, note: 'Our own permission switch, never mirrored from WorkOS: the downgrade cascade clears it, and a later connection webhook must not resurrect it.']
  created_at integer
  updated_at integer
  dsn text
  indexes {
    (id, dsn) [unique]
  }
}

Table workspace_sso_domain {
  id integer [pk, not null]
  workspace_id integer [not null]
  domain text [not null, unique, note: 'Globally unique: two workspaces claiming the same domain would make the login-time lookup ambiguous, which is an account-takeover vector.']
  verified_at integer [note: 'Only ever written from the `organization_domain.verified` webhook.']
  created_at integer
  indexes {
    (workspace_id) [name: 'workspace_sso_domain_workspace_id_idx']
  }
}

Table user {
  id integer [pk, not null]
  tenant_id text [unique, note: 'clerk fields']
  first_name text
  last_name text
  photo_url text
  name text [note: 'next-auth fields']
  email text
  emailVerified integer
  created_at integer
  updated_at integer
  deleted_at integer
  indexes {
    (email) [name: 'user_email_idx']
  }
}

Table users_to_workspaces {
  user_id integer [not null]
  workspace_id integer [not null]
  role text [not null]
  created_at integer
  indexes {
    (user_id, workspace_id) [pk]
    (workspace_id) [name: 'users_to_workspaces_workspace_id_idx']
  }
}

Table account {
  user_id integer [not null]
  type text [not null]
  provider text [not null]
  provider_account_id text [not null]
  refresh_token text
  access_token text
  expires_at integer
  token_type text
  scope text
  id_token text
  session_state text
  indexes {
    (provider, provider_account_id) [pk]
    (user_id) [name: 'account_user_id_idx']
  }
}

Table session {
  session_token text [pk, not null]
  user_id integer [not null]
  expires integer [not null]
  indexes {
    (user_id) [name: 'session_user_id_idx']
  }
}

Table verification_token {
  identifier text [not null]
  token text [not null]
  expires integer [not null]
  indexes {
    (identifier, token) [pk]
  }
}

Table status_report {
  id integer [pk, not null]
  status text [not null]
  title text [not null]
  workspace_id integer
  page_id integer
  created_by integer
  updated_by integer
  created_at integer
  updated_at integer
  indexes {
    (workspace_id, created_at) [name: 'status_report_workspace_created_idx']
    (page_id) [name: 'status_report_page_id_idx']
  }
}

Table status_report_update {
  id integer [pk, not null]
  status text [not null]
  date integer [not null]
  message text [not null]
  status_report_id integer [not null]
  created_by integer
  updated_by integer
  created_at integer
  updated_at integer
  indexes {
    (status_report_id) [name: 'status_report_update_status_report_id_idx']
  }
}

Table page {
  id integer [pk, not null]
  workspace_id integer [not null]
  title text [not null]
  description text [not null]
  icon text
  slug text [not null, unique]
  custom_domain text [not null]
  published integer
  force_theme text [not null]
  custom_theme text [note: 'Per-mode CSS variable overrides ({ light, dark }) merged over the configured theme vars. Gated by the "custom-theme" plan limit.']
  password text [note: 'Password protecting the status page - no specific restriction on password']
  password_protected integer
  access_type text
  auth_email_domains text
  allowed_ip_ranges text
  homepage_url text [note: 'links and urls']
  contact_url text
  default_locale text [not null]
  locales text
  default_timezone text [not null, note: 'IANA zone the public page renders its bars and timestamps in']
  legacy_page integer [not null]
  configuration text
  allow_index integer [not null]
  show_monitor_values integer [note: 'Displays the total and failed request numbers for each monitor TODO: remove this column - we moved into configuration']
  created_at integer
  updated_at integer
  indexes {
    `LOWER(slug)` [name: 'page_lower_slug_idx']
    `LOWER(custom_domain)` [name: 'page_lower_custom_domain_idx']
    (workspace_id) [name: 'page_workspace_id_idx']
  }
}

Table monitor {
  id integer [pk, not null]
  job_type text [not null]
  periodicity text [not null]
  status text [not null]
  active integer
  regions text [not null]
  url text [not null]
  name text [not null]
  external_name text
  description text [not null]
  headers text
  body text
  method text
  workspace_id integer
  timeout integer [not null, note: 'Custom timeout for this monitor']
  degraded_after integer [note: 'Threshold for the monitor to be considered degraded']
  assertions text
  otel_endpoint text
  otel_headers text
  public integer
  retry integer
  follow_redirects integer
  grpc_service text
  grpc_tls text
  heartbeat_token text
  heartbeat_period integer [note: 'seconds']
  heartbeat_grace integer
  heartbeat_cron text
  heartbeat_tz text
  created_at integer
  updated_at integer
  deleted_at integer
  indexes {
    (workspace_id) [name: 'monitor_workspace_id_active_idx']
    (heartbeat_token) [unique, name: 'monitor_heartbeat_token_idx']
  }
}

Table page_subscriber {
  id integer [pk, not null]
  email text
  page_id integer [not null]
  channel_type text [not null, note: 'Added: channel type discriminator']
  webhook_url text [note: 'Added: webhook-specific fields (null for email channel)']
  channel_config text
  slack_channel_id text [note: 'Slack channel id (null for non-slack channels). teamId + channelName live in channelConfig; the bot token is resolved from the integration row at send time, never persisted here.']
  source text [not null, note: 'How the subscription was created. Vendor-added rows skip verification and are editable from the dashboard.']
  name text [note: 'Optional human-readable label (e.g. "Supabase #incidents"). When set, rendered in place of the raw destination in UI.']
  token text
  accepted_at integer
  expires_at integer
  unsubscribed_at integer
  created_at integer
  updated_at integer
  indexes {
    (page_id) [name: 'page_subscriber_page_id_idx']
    `LOWER(email), page_id` [unique, name: 'idx_page_subscriber_email_page_active']
    `LOWER(webhook_url), page_id` [unique, name: 'idx_page_subscriber_webhook_page_active']
    (slack_channel_id, page_id) [unique, name: 'idx_page_subscriber_slack_channel_page_active']
  }
}

Table page_subscriber_to_page_component {
  page_subscriber_id integer [not null]
  page_component_id integer [not null]
  created_at integer
  indexes {
    (page_subscriber_id, page_component_id) [pk]
  }
}

Table notification {
  id integer [pk, not null]
  name text [not null]
  provider text [not null]
  data text
  workspace_id integer
  created_at integer
  updated_at integer
  indexes {
    (workspace_id) [name: 'notification_workspace_id_idx']
  }
}

Table notification_trigger {
  id integer [pk, not null]
  monitor_id integer
  notification_id integer
  cron_timestamp integer [not null]
  indexes {
    (notification_id, monitor_id, cron_timestamp) [unique, name: 'notification_id_monitor_id_crontimestampe']
  }
}

Table notifications_to_monitors {
  monitor_id integer [not null]
  notification_id integer [not null]
  created_at integer
  indexes {
    (monitor_id, notification_id) [pk]
    (notification_id) [name: 'notifications_to_monitors_notification_id_idx']
  }
}

Table notification_outbox {
  id integer [pk, not null]
  dedup_key text [not null]
  monitor_id integer [not null]
  workspace_id integer
  notification_id integer [not null]
  provider text [not null]
  event_type text [not null]
  from_status text [not null]
  to_status text [not null]
  cron_timestamp integer [not null]
  incident_id integer
  payload text [not null]
  delivery_status text [not null]
  outcome text
  attempts integer [not null]
  next_attempt_at integer [not null]
  deadline_at integer [not null]
  locked_by text
  locked_until integer
  delivered_at integer
  last_error text
  created_at integer [not null]
  indexes {
    (dedup_key) [unique, name: 'notification_outbox_dedup_key_idx']
    (next_attempt_at) [name: 'notification_outbox_claim_idx']
    (notification_id, cron_timestamp) [name: 'notification_outbox_notification_id_cron_timestamp_idx']
    (monitor_id, notification_id) [name: 'notification_outbox_channel_idx']
  }
}

Table notification_dead_letter {
  id integer [pk, not null]
  outbox_id integer [not null]
  dedup_key text [not null]
  monitor_id integer [not null]
  workspace_id integer
  notification_id integer [not null]
  provider text [not null]
  event_type text [not null]
  from_status text [not null]
  to_status text [not null]
  cron_timestamp integer [not null]
  incident_id integer
  payload text [not null]
  attempts integer [not null]
  final_error text
  died_at integer [not null]
  indexes {
    (dedup_key) [unique, name: 'notification_dead_letter_dedup_key_idx']
    (workspace_id, died_at) [name: 'notification_dead_letter_workspace_id_died_at_idx']
  }
}

Table monitor_status {
  monitor_id integer [not null]
  region text [not null]
  status text [not null]
  cron_timestamp integer [not null]
  created_at integer
  updated_at integer
  indexes {
    (monitor_id, region) [pk]
    (monitor_id, region) [name: 'monitor_status_idx']
  }
}

Table invitation {
  id integer [pk, not null]
  email text [not null]
  role text [not null]
  workspace_id integer [not null]
  token text [not null]
  expires_at integer [not null]
  created_at integer
  accepted_at integer
  indexes {
    (workspace_id) [name: 'invitation_workspace_id_idx']
  }
}

Table monitor_incident {
  id integer [pk, not null]
  title text [not null]
  summary text [not null]
  status text [not null]
  monitor_id integer [note: 'Service affected by incident']
  workspace_id integer [note: 'Workspace where the incident happened']
  started_at integer [not null, note: 'Data related to incident timeline']
  acknowledged_at integer [note: 'Who has acknowledged the incident']
  acknowledged_by integer
  resolved_at integer [note: 'Who has resolved it']
  resolved_by integer
  incident_screenshot_url text
  recovery_screenshot_url text
  auto_resolved integer [note: 'If the incident was auto resolved']
  created_at integer
  updated_at integer
  indexes {
    (monitor_id, started_at) [unique]
    (workspace_id, started_at) [name: 'monitor_incident_workspace_id_started_at_idx']
    (monitor_id) [unique, name: 'monitor_incident_open_idx']
  }
}

Table monitor_tag {
  id integer [pk, not null]
  workspace_id integer [not null]
  name text [not null]
  color text [not null]
  created_at integer
  updated_at integer
  indexes {
    (workspace_id) [name: 'monitor_tag_workspace_id_idx']
  }
}

Table monitor_tag_to_monitor {
  monitor_id integer [not null]
  monitor_tag_id integer [not null]
  created_at integer
  indexes {
    (monitor_id, monitor_tag_id) [pk]
    (monitor_tag_id) [name: 'monitor_tag_to_monitor_monitor_tag_id_idx']
  }
}

Table application {
  id integer [pk, not null]
  name text
  dsn text [unique]
  workspace_id integer
  created_at integer
  updated_at integer
  indexes {
    (workspace_id) [name: 'application_workspace_id_idx']
  }
}

Table maintenance {
  id integer [pk, not null]
  title text [not null]
  message text [not null, note: 'deprecated: mirror of the first `maintenance_update` (backfilled in migration 0092); dropped in a follow-up']
  from integer [not null]
  to integer [not null]
  workspace_id integer
  page_id integer
  created_by integer
  updated_by integer
  created_at integer
  updated_at integer
  indexes {
    (page_id) [name: 'maintenance_page_id_idx']
    (workspace_id) [name: 'maintenance_workspace_id_idx']
  }
}

Table maintenance_update {
  id integer [pk, not null]
  message text [not null]
  date integer [not null]
  maintenance_id integer [not null]
  created_by integer
  updated_by integer
  created_at integer
  updated_at integer
  indexes {
    (maintenance_id) [name: 'maintenance_update_maintenance_id_idx']
  }
}

Table check {
  id integer [pk, increment, not null]
  regions text [not null]
  url text [not null]
  headers text
  body text
  method text
  count_requests integer
  workspace_id integer
  created_at integer
  indexes {
    (workspace_id) [name: 'check_workspace_id_idx']
  }
}

