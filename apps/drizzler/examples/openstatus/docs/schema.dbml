  cron_timestamp integer [not null]
  created_at integer
  updated_at integer
  indexes {
    (monitor_id, private_location_id) [pk]
    (private_location_id) [name: 'private_location_monitor_status_pl_id_idx']
  }
}

Table private_location {
  id integer [pk, not null]
  name text [not null]
  token text [not null]
  status text [not null]
  metadata text
  last_seen_at integer
  workspace_id integer
  created_at integer
  updated_at integer
  indexes {
    (workspace_id) [name: 'private_location_workspace_id_idx']
  }
}

