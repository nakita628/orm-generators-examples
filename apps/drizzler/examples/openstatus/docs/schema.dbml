  deleted_at integer
  indexes {
    (private_location_id) [name: 'private_location_to_monitor_private_location_id_idx']
    (monitor_id) [name: 'private_location_to_monitor_monitor_id_idx']
  }
}

Table monitor_group {
  id integer [pk, not null]
  workspace_id integer [not null]
  page_id integer [not null]
  name text [not null]
  created_at integer
  updated_at integer
  indexes {
    (workspace_id) [name: 'monitor_group_workspace_id_idx']
    (page_id) [name: 'monitor_group_page_id_idx']
  }
}

Table viewer {
  id integer [pk, not null]
  name text
  email text [unique]
  emailVerified integer
  image text
  created_at integer
  updated_at integer
}

Table viewer_session {
  session_token text [pk, not null]
  user_id integer [not null]
  expires integer [not null]
}

Table viewer_accounts {
  user_id text [not null]
  type text [not null]
  provider text [not null]
  providerAccountId text [not null]
  refresh_token text
  access_token text
  expires_at integer
  token_type text
  scope text
  id_token text
  session_state text
  indexes {
    (provider, providerAccountId) [pk]
  }
}

Table api_key {
  id integer [pk, increment, not null]
  name text [not null]
  description text
  prefix text [not null, unique]
  hashed_token text [not null, unique]
  workspace_id integer [not null]
  created_by_id integer [not null]
  scopes text [not null, note: 'Stored as a JSON array so per-resource scopes (e.g. \'monitor.read\') can be added later without re-shaping the column. v1 stores a single value: [\'read\'] or [\'write\']. Existing rows backfill to [\'write\'] via the column default to preserve current behavior.']
  created_at integer
  expires_at integer
  last_used_at integer
  indexes {
    (prefix) [name: 'api_key_prefix_idx']
    (workspace_id) [name: 'api_key_workspace_id_idx']
  }
}

Table page_component {
  id integer [pk, not null]
  workspace_id integer [not null]
  page_id integer [not null]
  type text [not null]
  monitor_id integer
  name text [not null]
  description text
  order integer
  group_id integer
  group_order integer
  created_at integer
  updated_at integer
  indexes {
    (page_id, monitor_id) [unique, name: 'page_component_page_id_monitor_id_unique']
    (workspace_id) [name: 'page_component_workspace_id_idx']
  }
}

Table maintenance_to_page_component {
  maintenance_id integer [not null]
  page_component_id integer [not null]
  created_at integer
  indexes {
    (maintenance_id, page_component_id) [pk]
    (page_component_id) [name: 'maintenance_to_page_component_page_component_id_idx']
  }
}

Table status_report_to_page_component {
  status_report_id integer [not null]
  page_component_id integer [not null]
  created_at integer
  indexes {
    (status_report_id, page_component_id) [pk]
    (page_component_id) [name: 'status_report_to_page_component_page_component_id_idx']
  }
}

Table status_report_update_to_page_component {
  status_report_update_id integer [not null]
  page_component_id integer [not null]
  impact text [not null]
  created_at integer
  indexes {
    (status_report_update_id, page_component_id) [pk]
    (page_component_id) [name: 'status_report_update_to_page_component_page_component_id_idx']
  }
  Note: 'timeline: the impact each update set per component — the only place impact is stored. `status_report_to_page_component` stays the membership source.'
}

Table page_component_groups {
  id integer [pk, not null]
  workspace_id integer [not null]
  page_id integer [not null]
  name text [not null]
  default_open integer [not null]
  created_at integer
  updated_at integer
  indexes {
    (page_id) [name: 'page_component_groups_page_id_idx']
    (workspace_id) [name: 'page_component_groups_workspace_id_idx']
  }
}

Table feedback {
  id integer [pk, not null]
  workspace_id integer [not null]
  user_id integer [not null]
  source text [not null]
  message text [not null]
  type text
  blocker integer
  path text [not null]
  metadata text
  created_at integer [not null]
  indexes {
    (workspace_id) [name: 'feedback_workspace_id_idx']
  }
}

Table audit_log {
  id integer [pk, increment, not null]
  workspace_id integer [not null]
  actor_type text [not null]
  actor_id text [not null]
  actor_user_id integer
  action text [not null]
  entity_type text [not null]
  entity_id text [not null]
  before text
  after text
  metadata text
  changed_fields text
  created_at integer [not null]
  indexes {
    (workspace_id, created_at) [name: 'audit_log_workspace_created_idx']
    (workspace_id, entity_type, entity_id, created_at) [name: 'audit_log_entity_idx']
  }
  Note: 'Append-only log of mutating actions taken against the workspace. No foreign keys: rows outlive their subjects (workspace / user / monitor deletions must not cascade-remove audit history, and a soft-deleted user must not block inserts). References on columns are informational and enforced in application code. Reads must sort by `(created_at DESC, id DESC)` — bulk operations emit multiple rows in the same millisecond; the autoincrement id gives a deterministic tiebreaker.'
}

Table external_service {
  id integer [pk, not null]
  slug text [not null, unique]
  aliases text [not null]
  name text [not null]
  url text [not null]
  status_page_url text [not null]
  provider text [not null]
  industry text [not null]
  description text
  api_config text
  deleted_at integer
  created_at integer
  updated_at integer
  indexes {
    (deleted_at) [name: 'external_service_deleted_at_idx']
  }
}

Table external_service_component {
  id integer [pk, not null]
