  upstream_component_id text [not null]
  slug text [not null]
  aliases text [not null]
  name text [not null]
  description text
  group_name text
  position integer [not null]
  indicator text [not null]
  status text [not null]
  first_seen_at integer [not null]
  updated_at integer [not null]
  indexes {
    (external_service_id, upstream_component_id) [unique, name: 'external_service_component_unique_idx']
    (external_service_id, slug) [unique, name: 'external_service_component_slug_unique_idx']
  }
}

Table external_service_incident {
  id integer [pk, not null]
  external_service_id integer [not null]
  provider_incident_id text [not null]
  name text [not null]
  status text [not null]
  impact text
  shortlink text
  started_at integer
  created_at integer [not null]
  resolved_at integer
  affected_component_ids text [not null]
  raw_payload text
  raw_payload_purged_at integer
  first_seen_at integer [not null]
  updated_at integer [not null]
  indexes {
    (external_service_id, provider_incident_id) [unique, name: 'external_service_incident_unique_idx']
    (external_service_id, started_at) [name: 'external_service_incident_started_at_idx']
    (resolved_at) [name: 'external_service_incident_resolved_at_idx']
  }
}

Table external_service_report {
  id integer [pk, not null]
  external_service_id integer [not null]
  external_service_component_id integer
  reporter_hash text [not null]
  country text [not null]
  created_at integer [not null]
  indexes {
    (external_service_id, created_at) [name: 'external_service_report_service_idx']
    (external_service_component_id, created_at) [name: 'external_service_report_component_idx']
  }
}

Table chat_session {
  id integer [pk, increment, not null]
  workspace_id integer [not null]
  user_id integer [not null]
  title text [not null]
  messages text [not null]
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (workspace_id, user_id, updated_at) [name: 'chat_session_workspace_user_updated_idx']
  }
  Note: 'Surrogate-PK row per dashboard chat conversation. Many rows per (workspace, user). Bounded by application logic on insert (`MAX_CHAT_SESSIONS_PER_USER`); per-row payload bounded by `MAX_CHAT_MESSAGES` and a tool-result compaction policy in the service layer.'
}

Table frozen_monitor_uptime {
  id integer [pk, not null]
  workspace_id integer [not null]
  monitor_id integer [not null]
  month text [not null, note: 'UTC first-of-month, YYYY-MM-01']
  days text [not null]
  created_at integer
  indexes {
    (monitor_id, month) [unique, name: 'frozen_monitor_uptime_monitor_id_month_unique']
    (workspace_id) [name: 'frozen_monitor_uptime_workspace_id_idx']
  }
}

Table monitor_transition {
  id integer [pk, not null]
  monitor_id integer [not null]
  region text [not null]
  cron_timestamp integer [not null]
  from_status text [not null]
  to_status text [not null]
  quorum_count integer [not null]
  region_count integer [not null]
  transitioned integer [not null]
  outbox_rows integer [not null]
  created_at integer [not null]
  indexes {
    (monitor_id, cron_timestamp) [name: 'monitor_transition_monitor_id_cron_timestamp_idx']
    (created_at) [name: 'monitor_transition_created_at_idx']
  }
}

Table oauth_client {
  id integer [pk, increment, not null]
  client_id text [not null, unique]
  name text [not null]
  redirect_uris text [not null]
  revoked_at integer
  created_at integer
  Note: 'Every client is public (token_endpoint_auth_method "none"), so there is no secret column. Confidential clients are a follow-up.'
}

Table oauth_session {
  id text [pk, not null]
  client_id text [not null]
  redirect_uri text [not null]
  scope text [not null]
  state text
  resource text
  code_challenge text [not null]
  code_challenge_method text [not null]
  decided_at integer
  expires_at integer [not null]
  indexes {
    (client_id) [name: 'oauth_session_client_id_idx']
    (expires_at) [name: 'oauth_session_expires_at_idx']
  }
  Note: 'Pending authorize request. Lives in a row (not memory) because the server runs several instances and the consent page is served by the dashboard.'
}

Table oauth_authorization_code {
  id integer [pk, increment, not null]
  hash text [not null, unique]
  client_id text [not null]
  user_id integer [not null]
  workspace_id integer [not null]
  scope text [not null]
  redirect_uri text [not null]
  code_challenge text [not null]
  expires_at integer [not null]
  consumed_at integer
  grant_id integer [note: 'Set on exchange so a replayed code can revoke the grant it produced.']
  indexes {
    (expires_at) [name: 'oauth_authorization_code_expires_at_idx']
    (client_id) [name: 'oauth_authorization_code_client_id_idx']
  }
}

Table oauth_grant {
  id integer [pk, increment, not null]
  client_id text [not null]
  user_id integer [not null]
  workspace_id integer [not null]
  scope text [not null]
  access_token_hash text [not null, unique]
  access_token_expires_at integer [not null]
  refresh_token_hash text [not null, unique]
  refresh_token_expires_at integer [not null]
  previous_refresh_token_hash text [note: 'Grace window: the hash rotated out at `rotatedAt` stays valid briefly so two concurrent refreshes do not kill the grant.']
  rotated_at integer
  last_used_at integer
  revoked_at integer
  created_at integer
  indexes {
    (workspace_id) [name: 'oauth_grant_workspace_id_idx']
    (client_id, user_id) [name: 'oauth_grant_client_id_user_id_idx']
    (user_id) [name: 'oauth_grant_user_id_idx']
    (previous_refresh_token_hash) [name: 'oauth_grant_previous_refresh_token_hash_idx']
    (refresh_token_expires_at) [name: 'oauth_grant_refresh_token_expires_at_idx']
  }
  Note: 'One row per consent. Access and refresh token share the row because they are one-to-one and rotate together.'
}

Table incident {
  id integer [pk, increment, not null]
  workspace_id integer [not null]
  title text [not null]
  severity text [not null]
  status text [not null]
  summary text
  commander_id integer
  declared_by integer
  declared_at integer [not null]
  started_at integer [not null]
  mitigated_at integer
  resolved_at integer
  resolved_by integer
  closed_at integer
  status_report_id integer
  slack_team_id text
  slack_channel_id text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (workspace_id, status) [name: 'incident_workspace_id_status_idx']
    (workspace_id, declared_at) [name: 'incident_workspace_id_declared_at_idx']
    (slack_team_id, slack_channel_id) [unique, name: 'incident_slack_channel_idx']
    (status_report_id) [unique, name: 'incident_status_report_id_idx']
  }
  Note: 'Autoincrement: audit rows outlive a deleted incident, so its id must never be reused.'
}

Table incident_event {
  id integer [pk, increment, not null]
  incident_id integer [not null]
  type text [not null]
  message text
  source text
  source_ref text
  created_by integer
  created_at integer [not null]
  indexes {
    (incident_id, created_at) [name: 'incident_event_incident_id_created_at_idx']
  }
}

Table incident_postmortem {
  id integer [pk, increment, not null]
  incident_id integer [not null, unique]
  status text [not null]
  content text [not null]
  source_transcript text
  drafted_by text [not null]
  created_by integer
  updated_by integer
  approved_by integer
  approved_at integer
  published_at integer
  created_at integer [not null]
  updated_at integer [not null]
}

Table slack_user {
  id integer [pk, increment, not null]
  workspace_id integer [not null]
  slack_team_id text [not null]
  slack_user_id text [not null]
  user_id integer [not null]
  created_at integer [not null]
  indexes {
    (workspace_id, slack_team_id, slack_user_id) [unique]
    (user_id) [name: 'slack_user_user_id_idx']
  }
}

Table monitor_heartbeat_state {
  monitor_id integer [pk, not null]
  last_ping_at integer
  last_ping_kind text [not null, note: 'what the last ping reported: a `/fail` keeps the heartbeat down until a success ping']
  next_due_at integer [note: 'NULL until the first ping, so a new heartbeat never alerts']
  indexes {
    (next_due_at) [name: 'monitor_heartbeat_state_next_due_at_idx']
  }
}

