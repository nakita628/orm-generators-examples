Table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null]
  image text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  role text
  banned boolean
  ban_reason text
  ban_expires timestamp
  stripe_customer_id text
}

Table session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  active_organization_id text
  active_team_id text
  indexes {
    (user_id) [name: 'session_userId_idx']
  }
}

Table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (user_id) [name: 'account_userId_idx']
  }
}

Table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (identifier) [name: 'verification_identifier_idx']
  }
}

Table organization {
  id text [pk, not null]
  name text [not null]
  slug text [not null, unique]
  logo text
  created_at timestamp [not null]
  metadata text
  stripe_customer_id text
}

Table team {
  id text [pk, not null]
  name text [not null]
  member_count integer [not null]
  organization_id text [not null]
  created_at timestamp [not null]
  updated_at timestamp
  indexes {
    (organization_id) [name: 'team_organizationId_idx']
  }
}

Table team_member {
  id text [pk, not null]
  team_id text [not null]
  user_id text [not null]
  membership_key text [unique]
  created_at timestamp
  indexes {
    (team_id) [name: 'teamMember_teamId_idx']
    (user_id) [name: 'teamMember_userId_idx']
  }
}

Table member {
  id text [pk, not null]
  organization_id text [not null]
  user_id text [not null]
  role text [not null]
  created_at timestamp [not null]
  indexes {
    (organization_id) [name: 'member_organizationId_idx']
    (user_id) [name: 'member_userId_idx']
  }
}

Table invitation {
  id text [pk, not null]
  organization_id text [not null]
  email text [not null]
  role text
  team_id text
  status text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null]
  inviter_id text [not null]
  indexes {
    (organization_id) [name: 'invitation_organizationId_idx']
    (email) [name: 'invitation_email_idx']
  }
}

Table subscription {
  id text [pk, not null]
  plan text [not null]
  reference_id text [not null]
  stripe_customer_id text
  stripe_subscription_id text
  status text [not null]
  period_start timestamp
  period_end timestamp
  trial_start timestamp
  trial_end timestamp
  cancel_at_period_end boolean
  cancel_at timestamp
  canceled_at timestamp
  ended_at timestamp
  seats integer
  billing_interval text
  stripe_schedule_id text
}

Ref session_user_id_user_id_fk: session.user_id > user.id [delete: cascade]

Ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade]

Ref team_organization_id_organization_id_fk: team.organization_id > organization.id [delete: cascade]

Ref team_member_team_id_team_id_fk: team_member.team_id > team.id [delete: cascade]

Ref team_member_user_id_user_id_fk: team_member.user_id > user.id [delete: cascade]

Ref member_organization_id_organization_id_fk: member.organization_id > organization.id [delete: cascade]

Ref member_user_id_user_id_fk: member.user_id > user.id [delete: cascade]

Ref invitation_organization_id_organization_id_fk: invitation.organization_id > organization.id [delete: cascade]

Ref invitation_inviter_id_user_id_fk: invitation.inviter_id > user.id [delete: cascade]