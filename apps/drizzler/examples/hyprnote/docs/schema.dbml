Table attachment_transfer_jobs {
  id text [pk, not null]
  attachment_id text [not null]
  session_id text [not null]
  workspace_id text [not null]
  direction text [not null]
  expected_sha256 text [not null]
  expected_size_bytes integer [not null]
  ciphertext_sha256 text [not null]
  ciphertext_size_bytes integer [not null]
  remote_object_id text [not null]
  object_key text [not null]
  cache_id text [not null]
  phase text [not null]
  attempt_count integer [not null]
  next_attempt_at text [not null]
  last_attempt_at text
  last_error text [not null]
  created_at text [not null]
  updated_at text [not null]
  completed_at text
  indexes {
    (attachment_id, expected_sha256, expected_size_bytes) [unique, name: 'idx_attachment_transfer_jobs_live_version']
    (object_key) [unique, name: 'idx_attachment_transfer_jobs_delete_object']
    (remote_object_id) [unique, name: 'idx_attachment_transfer_jobs_upload_object_id']
    (remote_object_id) [unique, name: 'idx_attachment_transfer_jobs_delete_object_id']
    (cache_id) [unique, name: 'idx_attachment_transfer_jobs_cache_id']
    (phase, next_attempt_at, created_at) [name: 'idx_attachment_transfer_jobs_due']
    (attachment_id) [name: 'idx_attachment_transfer_jobs_attachment_id']
    (session_id) [name: 'idx_attachment_transfer_jobs_session_id']
  }
}

