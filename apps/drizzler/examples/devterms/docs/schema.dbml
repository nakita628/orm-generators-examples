Table users {
  id text [pk, not null]
  name text [not null]
  role text [not null]
  email text [not null, unique]
  avatar text [not null]
  github_id integer [not null, unique]
  created_at integer [not null]
  indexes {
    (name) [name: 'users_name_idx']
    (role) [name: 'users_role_idx']
  }
}

Table sessions {
  id text [pk, not null]
  user_id text [not null]
  expires_at integer [not null]
}

Table definitions {
  id text [pk, not null]
  user_id text [not null]
  status text [not null]
  term text [not null]
  definition text [not null]
  example text [not null]
  upvotes integer [not null]
  downvotes integer [not null]
  created_at integer [not null]
  indexes {
    (status) [name: 'definitions_status_idx']
    (term) [name: 'definitions_term_idx']
    (upvotes) [name: 'definitions_upvotes_idx']
    (created_at) [name: 'definitions_created_at_idx']
  }
}

Table reports {
  id text [pk, not null]
  user_id text [not null]
  definition_id text [not null]
  read integer [not null]
  reason text [not null]
  created_at integer [not null]
  indexes {
    (read) [name: 'reports_read_idx']
    (created_at) [name: 'reports_created_at_idx']
  }
}

Table wotds {
  id text [pk, not null]
  definition_id text [not null]
  created_at integer [not null]
  indexes {
    (created_at) [name: 'wotds_created_at_idx']
  }
}

Ref sessions_user_id_users_id: sessions.user_id > users.id

Ref definitions_user_id_users_id: definitions.user_id > users.id

Ref reports_user_id_users_id: reports.user_id > users.id

Ref reports_definition_id_definitions_id: reports.definition_id > definitions.id

Ref wotds_definition_id_definitions_id: wotds.definition_id > definitions.id