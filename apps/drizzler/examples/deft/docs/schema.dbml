Table capability_provider_snapshots {
  id text [pk, not null]
  org_id text [not null]
  provider_kind text [not null]
  provider_instance_id text [not null]
  adapter_contract_version text [not null]
  snapshot_digest text [not null]
  safe_snapshot jsonb [not null]
  captured_at timestamp [not null]
  created_at timestamp [not null]
  indexes {
    (org_id, id) [unique, name: 'capability_provider_snapshots_org_id_id_unique']
    (org_id, provider_kind, provider_instance_id, id) [unique, name: 'capability_provider_snapshots_org_provider_id_unique']
    (org_id, provider_kind, provider_instance_id, snapshot_digest) [unique, name: 'capability_provider_snapshots_identity_digest_unique']
    (org_id, provider_kind, provider_instance_id, captured_at) [name: 'capability_provider_snapshots_provider_idx']
  }
  Note: '═══ GOVERNED APP RUNS (DORMANT PHASE 3 FOUNDATION) ═══ These tables are additive and have no execution consumer until a later, separately certified phase. Secret payload ciphertext is intentionally split from safe Run metadata so ordinary app_runs selections cannot expose it.'
}

Table app_runs {
  id text [pk, not null]
  org_id text [not null]
  contract_version text [not null]
  origin_kind text [not null]
  initiating_actor_type text [not null]
  initiating_actor_id text [not null]
  execution_actor_type text [not null]
  execution_actor_id text [not null]
  provider_kind text [not null]
  provider_instance_id text [not null]
  operation_name text [not null]
  provider_snapshot_id text [not null]
  origin_app_installation_id text
  origin_app_version_id text
  origin_app_binding_key text
  origin_runtime_binding_id text
  origin_resource_binding_id text
  origin_native_binding_id text
  origin_public_endpoint_id text
  origin_public_ingress_id text
  origin_app_grant_snapshot_id text
  origin_app_automation_definition_id text
  origin_app_automation_fire_id text
  state text [not null]
  risk_class text [not null]
  review_requirement text [not null]
  review_scope text [not null]
  retry_class text [not null]
  retention_class text [not null]
  idempotency_key_version text [not null]
  idempotency_fingerprint text [not null]
  input_fingerprint_key_version text [not null]
  input_fingerprint text [not null]
  authorization_snapshot jsonb [not null]
  safe_preview jsonb [not null]
  safe_outcome jsonb
  root_run_id text [not null]
  parent_run_id text
  depth integer [not null]
  input_expires_at timestamp [not null]
  result_expires_at timestamp [not null]
  idempotency_expires_at timestamp [not null]
  attempt_limit integer [not null]
  execution_release_kind text
  execution_released_at timestamp
  budget_reserved_at timestamp
  budget_reserved_count integer
  budget_limit_at_reservation integer
  input_purged_at timestamp
  result_purged_at timestamp
  started_at timestamp
  terminal_at timestamp
  unknown_outcome_at timestamp
  reconciled_at timestamp
  cancelled_at timestamp
  cancel_requested_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id, id) [unique, name: 'app_runs_org_id_id_unique']
    (org_id, id, origin_resource_binding_id) [unique, name: 'app_runs_resource_attempt_identity_unique']
    (org_id, id, origin_app_installation_id, origin_app_version_id, origin_app_grant_snapshot_id, origin_resource_binding_id, provider_snapshot_id) [unique, name: 'app_runs_sync_intent_identity_unique']
    (org_id, origin_app_automation_definition_id, origin_app_automation_fire_id, id) [unique, name: 'app_runs_automation_lineage_unique']
    (org_id, origin_app_automation_definition_id, origin_app_automation_fire_id) [unique, name: 'app_runs_automation_fire_unique']
    (org_id, origin_public_endpoint_id, origin_public_ingress_id) [unique, name: 'app_runs_public_ingress_unique']
    (org_id, initiating_actor_type, initiating_actor_id, provider_kind, provider_instance_id, operation_name, idempotency_key_version, idempotency_fingerprint, idempotency_expires_at) [name: 'app_runs_idempotency_lookup_idx']
    (org_id, state, created_at) [name: 'app_runs_org_state_idx']
    (org_id, root_run_id, created_at) [name: 'app_runs_root_idx']
    (org_id, parent_run_id) [name: 'app_runs_parent_idx']
    (org_id, origin_app_automation_definition_id, origin_app_automation_fire_id) [name: 'app_runs_automation_lineage_idx']
    (state, input_expires_at, result_expires_at) [name: 'app_runs_secret_expiry_idx']
    (idempotency_expires_at) [name: 'app_runs_idempotency_expiry_idx']
  }
}

