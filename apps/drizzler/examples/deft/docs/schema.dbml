}

Table task_labels {
  task_id text [not null]
  label_id text [not null]
  indexes {
    (task_id, label_id) [pk]
  }
}

Table task_comments {
  id text [pk, not null]
  org_id text [not null]
  task_id text [not null]
  user_id text [not null]
  content text [not null]
  is_deleted boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id, task_id) [name: 'task_comments_org_task_idx']
  }
  Note: '═══ TASK COMMENTS ═══'
}

Table task_reactions {
  id text [pk, not null]
  org_id text [not null]
  task_id text [not null]
  user_id text [not null]
  emoji text [not null]
  created_at timestamp [not null]
  indexes {
    (task_id, user_id, emoji) [unique, name: 'task_reactions_unique']
    (task_id) [name: 'task_reactions_task_idx']
    (org_id) [name: 'task_reactions_org_idx']
  }
  Note: '═══ TASK REACTIONS ═══ Task 6.3 — emoji reactions on tasks. A (task, user, emoji) tuple is unique; duplicate POST toggles off, DELETE removes explicitly.'
}

Table task_activity {
  id text [pk, not null]
  org_id text [not null]
  task_id text [not null]
  user_id text
  action text [not null]
  field text
  old_value text
  new_value text
  agent_action_id text [note: 'Task 3.3 — attribution to the specific agent action + employee that produced this activity row. Both nullable; when set they link the activity log entry to an agentActions row and/or an agentEmployees row so the UI can show "done by agent X via plan Y".']
  acting_agent_employee_id text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (task_id) [name: 'activity_task_idx']
    (org_id, task_id) [name: 'task_activity_org_task_idx']
  }
  Note: '═══ TASK ACTIVITY LOG ═══'
}

Table task_relationships {
  id text [pk, not null]
  source_task_id text [not null]
  target_task_id text [not null]
  type task_relationship_type [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  Note: '═══ TASK RELATIONSHIPS ═══'
}

Table task_watchers {
  id text [pk, not null]
  task_id text [not null]
  user_id text [not null]
  created_at timestamp [not null]
  indexes {
    (task_id, user_id) [unique, name: 'task_watcher_unique']
    (task_id) [name: 'task_watcher_task_idx']
  }
  Note: '═══ TASK WATCHERS ═══'
}

Table task_assignees {
  id text [pk, not null]
  task_id text [not null]
  user_id text [not null]
  created_at timestamp [not null]
  indexes {
    (task_id, user_id) [unique, name: 'task_assignee_unique']
  }
  Note: '═══ TASK ASSIGNEES ═══ Additional (non-primary) assignees — shown as secondary avatars on the task card. The task\'s single primary assignee lives on tasks.assignee_id and MUST NOT be duplicated here. Route handlers enforce this invariant.'
}

