}

Table messages {
  id text [pk, not null]
  org_id text [not null]
  space_id text [not null]
  user_id text [not null]
  content text [not null]
  parent_id text
  is_pinned boolean [not null]
  is_deleted boolean [not null]
  edited_at timestamp
  metadata jsonb
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (space_id) [name: 'message_space_idx']
    (org_id) [name: 'message_org_idx']
    (parent_id) [name: 'message_parent_idx']
    (created_at) [name: 'message_created_idx']
    (org_id, id) [unique, name: 'messages_org_id_id_unique']
    (org_id, space_id) [unique, name: 'app_private_defty_messages_request_unique']
  }
  Note: '═══ MESSAGES ═══'
}

Table app_private_defty_seals {
  id text [pk, not null]
  org_id text [not null]
  space_id text [not null]
