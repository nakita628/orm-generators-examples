Table agent_employees {
  id text [pk, not null]
  org_id text [not null]
  user_id text [not null]
  name text [not null]
  slug text [not null]
  role agent_employee_role [not null]
  avatar_url text
  system_prompt text [not null]
  expertise_description text
  starter_prompts text
  mcp_connection_ids text [note: 'native_tools[] removed in Task 4.12 (migration 0038) — per-employee tool selection moved to the skills primitive (migrations 0035-0037).']
  disabled_tools text
  space_ids text
  project_ids text
  trust_level trust_level [not null]
  max_daily_actions integer [not null]
  daily_action_count integer [not null]
  daily_action_reset_at timestamp
  heartbeat_enabled boolean [not null]
  heartbeat_interval_min integer [not null]
  heartbeat_config jsonb
  heartbeat_overrides jsonb [note: 'Task 8.2 — per-employee overlay for the heartbeat prompt builder. Shape (all fields optional): { checklist?: string[];          // extra checklist items cadence_minutes?: number;      // per-employee cadence override (Task 8.3) }']
  daily_budget_cents integer [not null, note: 'Task 8.5 — daily cost guardrails. `daily_cost_cents` is reset at UTC midnight alongside `daily_action_count`; `daily_budget_cents` is the soft cap enforced by the heartbeat + trigger dispatchers. Default 10000 (=$100/day) mirrors the PR plan, tunable per-employee via the PATCH endpoint.']
  daily_cost_cents integer [not null]
  unhealthy boolean [not null, note: 'Task 8.5 / 8.6 — circuit breaker. Set by the heartbeat handler after 3 consecutive errors OR by Task 8.6\'s loop detector; cleared via PATCH { mark_healthy: true }. Blocks every autonomous dispatcher from firing until cleared.']
  unhealthy_reason text
  last_heartbeat_at timestamp
  is_active boolean [not null]
  is_deleted boolean [not null, note: 'is_active=false is "pause" (resumable). is_deleted=true is a real soft-delete — the row is hidden from every list endpoint and cannot be restored from the UI. Separate semantics added in migration 0058.']
  deleted_at timestamp
  is_byoa boolean [not null]
  byoa_model_info text
  mcp_token_hash text
  runtime_kind text [not null, note: 'BYOA runtime/control-plane metadata. Deft registers an already-running agent as a workplace employee; it does not own the runtime\'s identity.']
  job_title text
  wake_mode text [not null]
  certification_status text [not null]
  last_verified_at timestamp
  last_mcp_call_at timestamp
  last_work_outcome_at timestamp
  connection_notes text
  trigger_subscriptions text [note: 'trigger_subscriptions is the routing key for the trigger system (e.g. member.joined, cron:standup) — kept as part of Phase 9.']
  app_run_authorization_version integer [not null]
  created_by text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id, slug) [unique, name: 'agent_employee_slug_unique']
    (org_id) [name: 'agent_employee_org_idx']
  }
  Note: '═══ AGENT EMPLOYEES ═══'
}

