  attention_id text
  reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id, source_state_id, publication_revision, recipient_user_id) [unique, name: 'native_mention_delivery_unique']
    (org_id, recipient_user_id) [name: 'native_mention_recipient_idx']
  }
}

Table native_create_requests {
  id text [pk, not null]
  org_id text [not null]
  user_id text [not null]
  operation text [not null]
  request_hash text [not null]
  resource_id text [not null]
  created_at timestamp [not null]
  indexes {
    (org_id) [name: 'native_create_requests_org_idx']
  }
}

Table org_members {
  id text [pk, not null]
