Table orgs {
  id text [pk, not null]
  name text [not null]
  slug text [not null, unique]
  logo_url text
  timezone text [not null]
  trust_level trust_level [not null]
  agent_name text
  agent_enabled boolean [not null]
  ai_config jsonb [not null, note: 'Per-org AI provider config (BYOK). Read via apps/api/src/lib/org-ai-config.ts. Schema documented in packages/db/drizzle/0061_org_ai_config.sql.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  Note: '═══ ORGS ═══'
}

Table users {
  id text [pk, not null]
  email text [unique]
  name text [not null]
  kind user_kind [not null]
  is_agent boolean [not null]
  agent_employee_id text
  avatar_url text
  title text
  profile_summary text
  expertise_tags text
  timezone text
  status_emoji text
  status_text text
  status_expires_at timestamp
  password_hash text
  password_version integer [not null]
  email_verified boolean [not null]
  last_seen_at timestamp
  notification_keywords text
  notification_preferences jsonb [not null]
  show_read_receipts boolean [not null]
  ics_publish_token text [note: 'Per-user secret token for the outbound ICS feed. Lazily generated when the user first opens Settings → Calendar. See migration 0062.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  Note: '═══ USERS ═══'
}

Table native_reference_states {
  id text [pk, not null]
  org_id text [not null]
  source_kind text [not null]
  source_id text [not null]
  content_hash text [not null]
  revision integer [not null]
  current_refs jsonb [not null]
  published_person_ids jsonb [not null]
  publication_revision integer [not null]
  is_deleted boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id, source_kind, source_id) [unique, name: 'native_reference_source_unique']
    (org_id, id) [unique, name: 'native_reference_org_id_unique']
    (org_id) [name: 'native_reference_org_idx']
  }
  Note: 'Durable native-create identities; retain tombstones when a resource is deleted.'
}

Table native_mention_deliveries {
  id text [pk, not null]
  org_id text [not null]
  source_state_id text [not null]
