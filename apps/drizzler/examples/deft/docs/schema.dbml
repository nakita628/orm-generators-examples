  indexes {
    (org_id, space_id) [unique, name: 'app_private_defty_seals_space_unique']
    (space_id) [unique, name: 'app_private_defty_seals_global_space_unique']
    (org_id, id) [unique, name: 'app_private_defty_seals_identity_unique']
    (org_id, owner_user_id) [name: 'app_private_defty_seals_owner_idx']
  }
  Note: '═══ REACTIONS ═══ Permanent private Defty audience authority; bodies remain in canonical messages.'
}

Table app_private_defty_grants {
  id text [pk, not null]
