  lock_token text
  lock_expires_at timestamp
  created_at timestamp [not null]
  indexes {
    (status, queue, run_at) [name: 'job_queue_poll_idx']
    (org_id) [name: 'job_queue_org_idx']
    (status, lock_expires_at) [name: 'job_queue_lease_idx']
    (dedupe_key) [unique, name: 'job_queue_dedupe_unique']
