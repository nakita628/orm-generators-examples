    (org_id, id) [unique, name: 'app_private_defty_grants_identity_unique']
    (org_id, resource_binding_id) [name: 'app_private_defty_grants_parent_idx']
    (org_id, owner_user_id, expires_at) [name: 'app_private_defty_grants_owner_app_idx']
  }
}

Table reactions {
  id text [pk, not null]
  message_id text [not null]
  user_id text [not null]
  emoji text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (message_id, user_id, emoji) [unique, name: 'reaction_unique']
  }
}

Table files {
  id text [pk, not null]
  org_id text [not null]
  uploaded_by text [not null]
  filename text [not null]
  mime_type text [not null]
  size_bytes integer [not null]
  storage_key text [not null]
  thumbnail_key text
  detected_mime_type text
  attachment_kind text [not null]
  content_sha256 text
  processing_status attachment_processing_status [not null]
  processing_error text
  processed_at timestamp
  staged_expires_at timestamp
  message_id text
  task_id text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id) [name: 'files_org_idx']
    (staged_expires_at) [name: 'files_staged_expiry_idx']
    (org_id, id) [unique, name: 'files_org_id_id_unique']
  }
  Note: '═══ FILES ═══'
}

Table attachment_derivatives {
  org_id text [not null]
  file_id text [not null]
  kind text [not null]
  mime_type text [not null]
  content text [not null]
  size_bytes integer [not null]
  metadata jsonb
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (file_id, kind) [pk]
    (org_id, file_id) [name: 'attachment_derivatives_org_file_idx']
  }
  Note: 'Bounded, permission-inheriting derivatives. The original bytes stay in the FileStore; this table contains only safe-to-read text representations.'
}

Table projects {
  id text [pk, not null]
  org_id text [not null]
  name text [not null]
  description text
  prefix text [not null]
  icon text
  color text
  lead_id text
  is_archived boolean [not null]
  is_deleted boolean [not null]
  deleted_at timestamp
  task_counter integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (org_id, prefix) [unique, name: 'project_prefix_unique']
  }
  Note: '═══ PROJECTS ═══'
}

Table project_spaces {
  id text [pk, not null]
  project_id text [not null]
  space_id text [not null]
  indexes {
    (project_id, space_id) [unique, name: 'project_space_unique']
  }
  Note: '═══ PROJECT ↔ SPACE LINKS ═══'
}

Table tasks {
  id text [pk, not null]
  org_id text [not null]
  project_id text [not null]
  number integer [not null]
  title text [not null]
  description text
  status task_status [not null]
  priority task_priority [not null]
  assignee_id text [note: 'Primary assignee (singular). Used by board columns, dashboard "My Tasks", nudge targeting, and status-change notifications. Every task has exactly one primary assignee or null.']
  created_by text [not null]
  due_date timestamp
  start_date timestamp
  estimation text
  is_template boolean [not null]
  recurrence text
  recurrence_source_id text
  sort_order real [not null]
  source_message_id text
  parent_task_id text
  is_deleted boolean [not null]
  embedding vector [note: 'Task 3.8 — pgvector embedding over (title + description) for semantic search via retrieveContext({ types: [\'tasks\'] }). Populated by the embed-content worker (source_type: \'task\') and backfilled via backfill-task-embeddings.ts.']
  metadata jsonb [note: 'Task 4.11 — skill-defined custom-field payload. Keys match the `id`s in the resolved skill config\'s `custom_fields[]` (e.g. Sales skill stores `deal_value`, `contact_name`). Null for tasks in projects with no custom fields. Not covered by tasks.search_vector (FTS still scans title + description only).']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (project_id) [name: 'task_project_idx']
    (assignee_id) [name: 'task_assignee_idx']
    (org_id) [name: 'task_org_idx']
    (parent_task_id) [name: 'task_parent_idx']
    (project_id, number) [unique, name: 'task_number_unique']
    (org_id, id) [unique, name: 'tasks_org_id_id_unique']
  }
  Note: '═══ TASKS ═══'
}

Table message_attachments {
  org_id text [not null]
  message_id text [not null]
  file_id text [not null]
  position integer [not null]
  created_at timestamp [not null]
  indexes {
    (message_id, file_id) [pk]
    (org_id, message_id, position) [name: 'message_attachments_org_message_position_idx']
    (file_id) [name: 'message_attachments_file_idx']
  }
  Note: '═══ TYPED ATTACHMENT LINKS ═══ Legacy files.message_id/task_id stay in place during the expand-and-contract window. New writes are mirrored here so every target link carries an explicit tenant boundary and deterministic ordering.'
}

Table task_attachments {
  org_id text [not null]
  task_id text [not null]
  file_id text [not null]
  position integer [not null]
  created_at timestamp [not null]
  indexes {
    (task_id, file_id) [pk]
    (org_id, task_id, position) [name: 'task_attachments_org_task_position_idx']
    (file_id) [name: 'task_attachments_file_idx']
  }
}

Table labels {
  id text [pk, not null]
  org_id text [not null]
  name text [not null]
  color text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
