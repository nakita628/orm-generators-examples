Table project1_post {
  id bigint [pk, increment, not null]
  name varchar
  createdById varchar [not null]
  createdAt timestamp [not null]
  updatedAt timestamp
  indexes {
    (createdById) [name: 'created_by_idx']
    (name) [name: 'name_idx']
  }
}

Table project1_user {
  id varchar [pk, not null]
  name varchar
  email varchar [not null]
  emailVerified timestamp
  image varchar
}

Table project1_account {
  userId varchar [not null]
  type varchar [not null]
  provider varchar [not null]
  providerAccountId varchar [not null]
  refresh_token text
  access_token text
  expires_at integer
  token_type varchar
  scope varchar
  id_token text
  session_state varchar
  indexes {
    (provider, providerAccountId) [pk]
    (userId) [name: 'account_user_id_idx']
  }
}

Table project1_session {
  sessionToken varchar [pk, not null]
  userId varchar [not null]
  expires timestamp [not null]
  indexes {
    (userId) [name: 'session_user_id_idx']
  }
}

Table project1_verification_token {
  identifier varchar [not null]
  token varchar [not null]
  expires timestamp [not null]
  indexes {
    (identifier, token) [pk]
  }
}

Ref project1_post_createdById_project1_user_id_fk: project1_post.createdById > project1_user.id

Ref project1_account_userId_project1_user_id_fk: project1_account.userId > project1_user.id

Ref project1_session_userId_project1_user_id_fk: project1_session.userId > project1_user.id