Table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  emailVerified integer [note: 'Nullable and without a SQL default because SQLite can\'t add those constraints to an existing column without rebuilding the user table.']
  image text
  role text
  createdAt integer
  updatedAt integer
  bookmarkQuota integer [note: 'Admin Only Settings']
  storageQuota integer
  browserCrawlingEnabled integer
  manualTierName text [note: 'Admin-granted plan label (e.g. a collaborator name). While set, Stripe and in-app purchase syncs don\'t downgrade the user\'s entitlements; it\'s cleared when the user gets an active paid subscription.']
  bookmarkClickAction text [not null, note: 'User Settings']
  archiveDisplayBehaviour text [not null]
  timezone text
  backupsEnabled integer [not null, note: 'Backup Settings']
  backupsFrequency text [not null]
  backupsRetentionDays integer [not null]
  readerFontSize integer [note: 'Reader view settings (nullable = opt-in, null means use client default)']
  readerLineHeight real
  readerFontFamily text
  autoTaggingEnabled integer [note: 'AI Settings (nullable = opt-in, null means use server default)']
  autoSummarizationEnabled integer
  tagStyle text
  curatedTagIds text
  inferredTagLang text
}

Table account {
  id text [pk, not null]
  accountId text [not null]
  providerId text [not null]
  userId text [not null]
  accessToken text
  refreshToken text
  idToken text
  accessTokenExpiresAt integer
  refreshTokenExpiresAt integer
  scope text
  password text
  createdAt integer [not null]
  updatedAt integer [not null]
  indexes {
    (providerId, accountId) [unique, name: 'accounts_providerId_accountId_unique']
    (userId) [name: 'accounts_userId_idx']
  }
}

Table session {
  id text [pk, not null]
  token text [not null, unique]
  userId text [not null]
  expiresAt integer [not null]
  ipAddress text
  userAgent text
  createdAt integer [not null]
  updatedAt integer [not null]
  indexes {
    (userId) [name: 'sessions_userId_idx']
  }
}

Table verificationToken {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expiresAt integer [not null]
  createdAt integer [not null]
  updatedAt integer [not null]
  indexes {
    (identifier, value) [unique, name: 'verificationTokens_identifier_value_unique']
    (identifier) [name: 'verificationTokens_identifier_idx']
  }
}

Table apiKey {
  id text [pk, not null]
  name text [not null]
  createdAt integer [not null]
  lastUsedAt integer
  keyId text [not null, unique]
  keyHash text [not null]
  scopes text [not null]
  userId text [not null]
  indexes {
    (name, userId) [unique]
  }
}

Table bookmarks {
  id text [pk, not null]
  createdAt integer [not null, note: 'The `createdAt` field and the `createdAt` column intentionally don\'t match. Re-saving an existing bookmark bumps it back to the top of the list, so the timestamp everything sorts and filters on is now "when was this last saved" and lives in the `lastSavedAt` column. It keeps the `createdAt` field name because that\'s what the API has always exposed and what every query already orders by. The immutable "when did this row first appear" timestamp stays in the original `createdAt` column, and is exposed to clients as `firstCreatedAt`.']
  lastSavedAt integer [not null]
  modifiedAt integer
  title text
  archived integer [not null]
  favourited integer [not null]
  userId text [not null]
  taggingStatus text
  summarizationStatus text
  embeddingStatus text
  summary text
  note text
  type text [not null]
  source text
  indexes {
    (lastSavedAt) [name: 'bookmarks_lastSavedAt_idx']
    (userId, lastSavedAt, id) [name: 'bookmarks_userId_lastSavedAt_id_idx']
    (userId, archived, lastSavedAt, id) [name: 'bookmarks_userId_archived_lastSavedAt_id_idx']
    (userId, favourited, lastSavedAt, id) [name: 'bookmarks_userId_favourited_lastSavedAt_id_idx']
  }
}

Table bookmarkLinks {
  id text [pk, not null]
  url text [not null]
  title text [note: 'Crawled info']
  description text
  author text
  publisher text
  datePublished integer
  dateModified integer
  imageUrl text
  favicon text
  htmlContent text
  contentAssetId text
  readerViewStatus text
  readerViewScore integer
  readerViewReasons text
  readerViewClassifierVersion integer
  crawledAt integer
  crawlStatus text
  crawlStatusCode integer
  probeMetadataAt integer [note: 'When the pre-crawl probe last extracted and stored this link\'s metadata. Lets crawl retries skip re-fetching it.']
  indexes {
    (url) [name: 'bookmarkLinks_url_idx']
  }
}

Table assets {
  id text [pk, not null, note: 'Asset ids don\'t have a default function as they are generated by the caller']
  assetType text [not null]
  size integer [not null]
  contentType text
  fileName text
  bookmarkId text
  userId text [not null]
  indexes {
    (bookmarkId) [name: 'assets_bookmarkId_idx']
    (assetType) [name: 'assets_assetType_idx']
    (userId, size, id, assetType, bookmarkId) [name: 'assets_userId_size_idx']
  }
}

Table highlights {
  id text [pk, not null]
  bookmarkId text [not null]
  userId text [not null]
  startOffset integer [not null]
  endOffset integer [not null]
  color text [not null]
  text text
  prefix text
  suffix text
  note text
  createdAt integer [not null]
  indexes {
    (bookmarkId) [name: 'highlights_bookmarkId_idx']
    (userId, createdAt, id) [name: 'highlights_userId_createdAt_id_idx']
  }
}

Table userReadingProgress {
  id text [pk, not null]
  bookmarkId text [not null]
  userId text [not null]
  readingProgressOffset integer [not null]
  readingProgressAnchor text
  readingProgressPercent integer
  modifiedAt integer
  indexes {
    (bookmarkId, userId) [unique]
    (bookmarkId) [name: 'userReadingProgress_bookmarkId_idx']
    (userId) [name: 'userReadingProgress_userId_idx']
  }
}

Table bookmarkTexts {
  id text [pk, not null]
  text text
  sourceUrl text
}

Table bookmarkAssets {
  id text [pk, not null]
  assetType text [not null]
  assetId text [not null]
  content text
  metadata text
  fileName text
  sourceUrl text
}

Table bookmarkTags {
  id text [pk, not null]
  name text [not null]
  normalizedName text
  createdAt integer [not null]
  userId text [not null]
  indexes {
    (userId, name) [unique]
    (userId, id) [unique, name: 'bookmarkTags_userId_id_idx']
    (name) [name: 'bookmarkTags_name_idx']
    (normalizedName) [name: 'bookmarkTags_normalizedName_idx']
  }
}

Table tagsOnBookmarks {
  bookmarkId text [not null]
  tagId text [not null]
  attachedAt integer
  attachedBy text [not null]
  indexes {
    (bookmarkId, tagId) [pk]
    (tagId, bookmarkId) [name: 'tagsOnBookmarks_tagId_bookmarkId_idx']
  }
}

Table bookmarkLists {
  id text [pk, not null]
  name text [not null]
  description text
  icon text [not null]
  createdAt integer [not null]
  userId text [not null]
  type text [not null]
  query text [note: 'Only applicable for smart lists']
  parentId text
  rssToken text [note: 'Whoever have access to this token can read the content of this list']
  public integer [not null]
  indexes {
    (userId) [name: 'bookmarkLists_userId_idx']
    (userId, id) [unique, name: 'bookmarkLists_userId_id_idx']
  }
}

Table bookmarksInLists {
  bookmarkId text [not null]
  listId text [not null]
  addedAt integer
  listMembershipId text [note: 'Tie the list\'s existence to the user\'s membership of this list.']
  indexes {
    (bookmarkId, listId) [pk]
    (listId, bookmarkId) [name: 'bookmarksInLists_listId_bookmarkId_idx']
  }
}

Table listCollaborators {
  id text [pk, not null]
  listId text [not null]
  userId text [not null]
  role text [not null]
  createdAt integer [not null]
  addedBy text
  indexes {
    (listId, userId) [unique]
    (listId) [name: 'listCollaborators_listId_idx']
    (userId) [name: 'listCollaborators_userId_idx']
  }
}

Table listInvitations {
  id text [pk, not null]
  listId text [not null]
  userId text [not null]
  role text [not null]
  status text [not null]
  invitedAt integer [not null]
  invitedEmail text
  invitedBy text
  indexes {
    (listId, userId) [unique]
    (listId) [name: 'listInvitations_listId_idx']
    (userId) [name: 'listInvitations_userId_idx']
    (status) [name: 'listInvitations_status_idx']
  }
}

Table customPrompts {
  id text [pk, not null]
  text text [not null]
  enabled integer [not null]
  appliesTo text [not null]
  createdAt integer [not null]
  userId text [not null]
  indexes {
    (userId) [name: 'customPrompts_userId_idx']
  }
}

Table chatSessions {
  id text [pk, not null]
  title text [not null]
  userId text [not null]
  createdAt integer [not null]
  modifiedAt integer
  indexes {
    (userId) [name: 'chatSessions_userId_idx']
    (userId, modifiedAt) [name: 'chatSessions_userId_modifiedAt_idx']
  }
}

Table chatMessages {
  id text [pk, not null]
  chatId text [not null]
  role text [not null]
  content text [not null]
  metadata text
  createdAt integer [not null]
  indexes {
    (chatId) [name: 'chatMessages_chatId_idx']
    (chatId, createdAt) [name: 'chatMessages_chatId_createdAt_idx']
  }
}

Table rssFeeds {
  id text [pk, not null]
  name text [not null]
  url text [not null]
  enabled integer [not null]
  importTags integer [not null]
  createdAt integer [not null]
  lastFetchedAt integer
  lastSuccessfulFetchAt integer
  lastFetchedStatus text
  userId text [not null]
  indexes {
    (userId) [name: 'rssFeeds_userId_idx']
  }
}

Table webhooks {
  id text [pk, not null]
  createdAt integer [not null]
  url text [not null]
  userId text [not null]
  events text [not null]
  token text
  indexes {
    (userId) [name: 'webhooks_userId_idx']
  }
}

Table rssFeedImports {
  id text [pk, not null]
  createdAt integer [not null]
  entryId text [not null]
  rssFeedId text [not null]
  bookmarkId text
  indexes {
    (rssFeedId) [name: 'rssFeedImports_feedIdIdx_idx']
    (entryId) [name: 'rssFeedImports_entryIdIdx_idx']
    (rssFeedId, entryId) [unique]
    (bookmarkId) [name: 'rssFeedImports_bookmarkId_idx']
    (rssFeedId, bookmarkId) [name: 'rssFeedImports_rssFeedId_bookmarkId_idx']
  }
}

Table backups {
  id text [pk, not null]
  userId text [not null]
  assetId text
  createdAt integer [not null]
  size integer [not null]
  bookmarkCount integer [not null]
  status text [not null]
  errorMessage text
  indexes {
    (userId) [name: 'backups_userId_idx']
    (createdAt) [name: 'backups_createdAt_idx']
  }
}

Table config {
  key text [pk, not null]
  value text [not null]
}

Table ruleEngineRules {
  id text [pk, not null]
  enabled integer [not null]
  name text [not null]
  description text
  event text [not null]
  condition text [not null]
  userId text [not null, note: 'References']
  tagId text
  indexes {
    (userId) [name: 'ruleEngine_userId_idx']
  }
}

Table ruleEngineActions {
  id text [pk, not null]
  userId text [not null]
  ruleId text [not null]
  action text [not null]
  listId text [note: 'References']
  tagId text
  indexes {
    (userId) [name: 'ruleEngineActions_userId_idx']
    (ruleId) [name: 'ruleEngineActions_ruleId_idx']
  }
}

Table invites {
  id text [pk, not null]
  email text [not null]
  token text [not null, unique]
  createdAt integer [not null]
  usedAt integer
  invitedBy text [not null]
}

Table subscriptions {
  id text [pk, not null]
  userId text [not null, unique]
  stripeCustomerId text [not null]
  stripeSubscriptionId text
  status text [not null]
  tier text [not null]
  priceId text
  cancelAtPeriodEnd integer
  startDate integer
  endDate integer
  createdAt integer [not null]
  modifiedAt integer
  indexes {
    (userId) [name: 'subscriptions_userId_idx']
    (stripeCustomerId) [name: 'subscriptions_stripeCustomerId_idx']
  }
}

Table inAppSubscriptions {
  id text [pk, not null]
  userId text [not null, unique]
  store text [note: 'The RevenueCat store identifier (e.g. "app_store", "play_store").']
  productId text
  status text [not null]
  cancelAtPeriodEnd integer [not null]
  billingIssue integer [not null]
  isSandbox integer [not null]
  startDate integer
  endDate integer
  createdAt integer [not null]
  modifiedAt integer
  Note: 'Subscriptions purchased through the mobile app stores (App Store / Google Play). These are managed by RevenueCat, which is the source of truth; this table mirrors the state of the configured RevenueCat entitlement.'
}

Table importSessions {
  id text [pk, not null]
  name text [not null]
  userId text [not null]
  message text
  rootListId text
  status text [not null]
  lastProcessedAt integer
  completedAt integer
  totalBookmarks integer [not null]
  completedBookmarks integer [not null]
  failedBookmarks integer [not null]
  pendingBookmarks integer [not null]
  processingBookmarks integer [not null]
  createdAt integer [not null]
  modifiedAt integer
  indexes {
    (userId) [name: 'importSessions_userId_idx']
    (status) [name: 'importSessions_status_idx']
    (status, completedAt) [name: 'importSessions_status_completedAt_idx']
  }
}

Table importSessionBookmarks {
  id text [pk, not null]
  importSessionId text [not null]
  bookmarkId text [not null]
  createdAt integer [not null]
  indexes {
    (bookmarkId) [name: 'importSessionBookmarks_bookmarkId_idx']
    (importSessionId, bookmarkId) [unique]
  }
}

Table importStagingBookmarks {
  id text [pk, not null]
  importSessionId text [not null]
  type text [not null, note: 'Bookmark data to create']
  url text
  title text
  content text
  note text
  tags text
  listIds text
  sourceAddedAt integer
  archived integer
  status text [not null, note: 'Processing state']
  processingStartedAt integer
  result text [note: 'Result (for observability)']
  resultReason text
  resultBookmarkId text
  createdAt integer [not null]
  completedAt integer
  indexes {
    (importSessionId, status) [name: 'importStaging_session_status_idx']
    (completedAt) [name: 'importStaging_completedAt_idx']
    (resultBookmarkId) [name: 'importStaging_resultBookmarkId_idx']
    (status) [name: 'importStaging_status_idx']
    (status, processingStartedAt) [name: 'importStaging_status_processingStartedAt_idx']
  }
}

Ref account_userId_user_id_fk: account.userId > user.id [delete: cascade]

Ref session_userId_user_id_fk: session.userId > user.id [delete: cascade]

Ref apiKey_userId_user_id_fk: apiKey.userId > user.id [delete: cascade]

Ref bookmarks_userId_user_id_fk: bookmarks.userId > user.id [delete: cascade]

Ref bookmarkLinks_id_bookmarks_id_fk: bookmarkLinks.id - bookmarks.id [delete: cascade]

Ref assets_bookmarkId_bookmarks_id_fk: assets.bookmarkId > bookmarks.id [delete: cascade]

Ref assets_userId_user_id_fk: assets.userId > user.id [delete: cascade]

Ref highlights_bookmarkId_bookmarks_id_fk: highlights.bookmarkId > bookmarks.id [delete: cascade]

Ref highlights_userId_user_id_fk: highlights.userId > user.id [delete: cascade]

Ref userReadingProgress_bookmarkId_bookmarks_id_fk: userReadingProgress.bookmarkId > bookmarks.id [delete: cascade]

Ref userReadingProgress_userId_user_id_fk: userReadingProgress.userId > user.id [delete: cascade]

Ref bookmarkTexts_id_bookmarks_id_fk: bookmarkTexts.id - bookmarks.id [delete: cascade]

Ref bookmarkAssets_id_bookmarks_id_fk: bookmarkAssets.id - bookmarks.id [delete: cascade]

Ref bookmarkTags_userId_user_id_fk: bookmarkTags.userId > user.id [delete: cascade]

Ref tagsOnBookmarks_bookmarkId_bookmarks_id_fk: tagsOnBookmarks.bookmarkId > bookmarks.id [delete: cascade]

Ref tagsOnBookmarks_tagId_bookmarkTags_id_fk: tagsOnBookmarks.tagId > bookmarkTags.id [delete: cascade]

Ref bookmarkLists_userId_user_id_fk: bookmarkLists.userId > user.id [delete: cascade]

Ref bookmarkLists_parentId_bookmarkLists_id_fk: bookmarkLists.parentId > bookmarkLists.id [delete: set null]

Ref bookmarksInLists_bookmarkId_bookmarks_id_fk: bookmarksInLists.bookmarkId > bookmarks.id [delete: cascade]

Ref bookmarksInLists_listId_bookmarkLists_id_fk: bookmarksInLists.listId > bookmarkLists.id [delete: cascade]

Ref bookmarksInLists_listMembershipId_listCollaborators_id_fk: bookmarksInLists.listMembershipId > listCollaborators.id [delete: cascade]

Ref listCollaborators_listId_bookmarkLists_id_fk: listCollaborators.listId > bookmarkLists.id [delete: cascade]

Ref listCollaborators_userId_user_id_fk: listCollaborators.userId > user.id [delete: cascade]

Ref listCollaborators_addedBy_user_id_fk: listCollaborators.addedBy > user.id [delete: set null]

Ref listInvitations_listId_bookmarkLists_id_fk: listInvitations.listId > bookmarkLists.id [delete: cascade]

Ref listInvitations_userId_user_id_fk: listInvitations.userId > user.id [delete: cascade]

Ref listInvitations_invitedBy_user_id_fk: listInvitations.invitedBy > user.id [delete: set null]

Ref customPrompts_userId_user_id_fk: customPrompts.userId > user.id [delete: cascade]

Ref chatSessions_userId_user_id_fk: chatSessions.userId > user.id [delete: cascade]

Ref chatMessages_chatId_chatSessions_id_fk: chatMessages.chatId > chatSessions.id [delete: cascade]

Ref rssFeeds_userId_user_id_fk: rssFeeds.userId > user.id [delete: cascade]

Ref webhooks_userId_user_id_fk: webhooks.userId > user.id [delete: cascade]

Ref rssFeedImports_rssFeedId_rssFeeds_id_fk: rssFeedImports.rssFeedId > rssFeeds.id [delete: cascade]

Ref rssFeedImports_bookmarkId_bookmarks_id_fk: rssFeedImports.bookmarkId > bookmarks.id [delete: set null]

Ref backups_userId_user_id_fk: backups.userId > user.id [delete: cascade]

Ref backups_assetId_assets_id_fk: backups.assetId > assets.id [delete: cascade]

Ref ruleEngineRules_userId_user_id_fk: ruleEngineRules.userId > user.id [delete: cascade]

Ref ruleEngineRules_userId_tagId_bookmarkTags_userId_id_fk: ruleEngineRules.(userId, tagId) > bookmarkTags.(userId, id) [delete: cascade]

Ref ruleEngineActions_userId_user_id_fk: ruleEngineActions.userId > user.id [delete: cascade]

Ref ruleEngineActions_ruleId_ruleEngineRules_id_fk: ruleEngineActions.ruleId > ruleEngineRules.id [delete: cascade]

Ref ruleEngineActions_userId_tagId_bookmarkTags_userId_id_fk: ruleEngineActions.(userId, tagId) > bookmarkTags.(userId, id) [delete: cascade]

Ref ruleEngineActions_userId_listId_bookmarkLists_userId_id_fk: ruleEngineActions.(userId, listId) > bookmarkLists.(userId, id) [delete: cascade]

Ref invites_invitedBy_user_id_fk: invites.invitedBy > user.id [delete: cascade]

Ref subscriptions_userId_user_id_fk: subscriptions.userId - user.id [delete: cascade]

Ref inAppSubscriptions_userId_user_id_fk: inAppSubscriptions.userId - user.id [delete: cascade]

Ref importSessions_userId_user_id_fk: importSessions.userId > user.id [delete: cascade]

Ref importSessions_rootListId_bookmarkLists_id_fk: importSessions.rootListId > bookmarkLists.id [delete: set null]

Ref importSessionBookmarks_importSessionId_importSessions_id_fk: importSessionBookmarks.importSessionId > importSessions.id [delete: cascade]

Ref importSessionBookmarks_bookmarkId_bookmarks_id_fk: importSessionBookmarks.bookmarkId > bookmarks.id [delete: cascade]

Ref importStagingBookmarks_importSessionId_importSessions_id_fk: importStagingBookmarks.importSessionId > importSessions.id [delete: cascade]

Ref importStagingBookmarks_resultBookmarkId_bookmarks_id_fk: importStagingBookmarks.resultBookmarkId > bookmarks.id [delete: set null]

Ref bookmarks_id_bookmarkLinks_id: bookmarks.id - bookmarkLinks.id

Ref bookmarks_id_bookmarkTexts_id: bookmarks.id - bookmarkTexts.id

Ref bookmarks_id_bookmarkAssets_id: bookmarks.id - bookmarkAssets.id