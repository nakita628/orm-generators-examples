Table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  is2FAEnabled boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  resetPasswordToken text
  resetPasswordExpiresAt text
  confirmationToken text
  confirmationExpiresAt text
}

Table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
}

Table organization {
  id text [pk, not null]
  name text [not null]
  slug text [unique]
  logo text
  created_at timestamp [not null]
  metadata text
  default_role text
  owner_id text [not null]
}

Table organization_role {
  id text [pk, not null]
  organization_id text [not null]
  role text [not null]
  permission text [not null]
  created_at timestamp [not null]
  updated_at timestamp
  indexes {
    (organization_id) [name: 'organizationRole_organizationId_idx']
    (role) [name: 'organizationRole_role_idx']
  }
}

Table member {
  id text [pk, not null]
  organization_id text [not null]
  user_id text [not null]
  role text [not null]
  created_at timestamp [not null]
  team_id text
  is_default boolean [not null]
  canCreateProjects boolean [not null, note: 'Permissions']
  canAccessToSSHKeys boolean [not null]
  canCreateServices boolean [not null]
  canDeleteProjects boolean [not null]
  canDeleteServices boolean [not null]
  canAccessToDocker boolean [not null]
  canAccessToAPI boolean [not null]
  canAccessToGitProviders boolean [not null]
  canAccessToTraefikFiles boolean [not null]
  canDeleteEnvironments boolean [not null]
  canCreateEnvironments boolean [not null]
  accesedProjects text [not null]
  accessedEnvironments text [not null]
  accesedServices text [not null]
  accessedGitProviders text [not null]
  accessedServers text [not null]
}

Table invitation {
  id text [pk, not null]
  organization_id text [not null]
  email text [not null]
  role text
  status text [not null]
  expires_at timestamp [not null]
  inviter_id text [not null]
  team_id text
  created_at timestamp [not null]
}

Table two_factor {
  id text [pk, not null]
  secret text [not null]
  backup_codes text [not null]
  user_id text [not null]
  verified boolean [not null]
  failed_verification_count integer [not null]
  locked_until timestamp
}

Table passkey {
  id text [pk, not null]
  name text
  public_key text [not null]
  user_id text [not null]
  credential_id text [not null]
  counter integer [not null]
  device_type text [not null]
  backed_up boolean [not null]
  transports text
  created_at timestamp
  aaguid text
  indexes {
    (user_id) [name: 'passkey_userId_idx']
    (credential_id) [name: 'passkey_credentialID_idx']
  }
}

Table apikey {
  id text [pk, not null]
  name text
  start text
  prefix text
  key text [not null]
  config_id text [not null]
  reference_id text [not null]
  refill_interval integer
  refill_amount integer
