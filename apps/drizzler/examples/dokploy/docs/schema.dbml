  createdAt text [not null]
}

Table scim_provider {
  id text [pk, not null]
  provider_id text [not null, unique]
  scim_token text [not null, unique]
  organization_id text
}

Table security {
  securityId text [pk, not null]
  username text [not null]
  password text [not null]
  createdAt text [not null]
  applicationId text [not null]
  indexes {
    (username, applicationId) [unique]
  }
}

Table server {
  serverId text [pk, not null]
  name text [not null]
  description text
  ipAddress text [not null]
  port integer [not null]
  username text [not null]
  appName text [not null]
  enableDockerCleanup boolean [not null]
  telemetryProviderIds text [not null]
  buildsConcurrency integer [not null]
  createdAt text [not null]
  organizationId text [not null]
  serverStatus serverStatus [not null]
  serverType serverType [not null]
  command text [not null]
  sshKeyId text
  metricsConfig jsonb [not null]
}

Table session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  active_organization_id text
  Note: 'OLD TABLE'
}

Table "ssh-key" {
  sshKeyId text [pk, not null]
  privateKey text [not null]
  publicKey text [not null]
  name text [not null]
  description text
  createdAt text [not null]
  lastUsedAt text
  organizationId text [not null]
}

Table sso_provider {
  id text [pk, not null]
  issuer text [not null]
  oidc_config text
  saml_config text
  provider_id text [not null, unique]
  user_id text
  organization_id text
  domain text [not null]
  domain_verified boolean [not null]
  created_at timestamp [not null]
}

Table tag {
  tagId text [pk, not null]
  name text [not null]
  color text
  createdAt text [not null]
  organizationId text [not null]
  indexes {
    (organizationId, name) [unique, name: 'unique_org_tag_name']
  }
}

Table project_tag {
  id text [pk, not null]
  projectId text [not null]
  tagId text [not null]
  indexes {
    (projectId, tagId) [unique, name: 'unique_project_tag']
  }
}

Table telemetryProvider {
  telemetryProviderId text [pk, not null]
  name text [not null]
  providerType TelemetryProviderType [not null]
  signals text [not null]
  endpoint text
  apiKey text
  apiSecret text
  extraConfig jsonb
  enabled boolean [not null]
  createdAt text [not null]
  organizationId text [not null]
}

Table user {
  id text [pk, not null]
  firstName text [not null]
  lastName text [not null]
  isRegistered boolean [not null]
  expirationDate text [not null]
  createdAt text [not null]
  created_at timestamp
  two_factor_enabled boolean [note: 'Auth']
  email text [not null, unique]
  email_verified boolean [not null]
  image text
  banned boolean
  ban_reason text
  ban_expires timestamp
  updated_at timestamp [not null]
  role text [not null, note: 'Admin']
  enablePaidFeatures boolean [not null, note: 'Metrics']
  allowImpersonation boolean [not null]
  enableEnterpriseFeatures boolean [not null, note: 'Enterprise / proprietary features']
  licenseKey text
  isValidEnterpriseLicense boolean [not null]
  stripeCustomerId text
  stripeSubscriptionId text
  serversQuantity integer [not null]
  sendInvoiceNotifications boolean [not null]
  isEnterpriseCloud boolean [not null]
  trustedOrigins text
  bookmarkedTemplates text
  onboardingCompletedAt timestamp
  onboardingStep text
  onboardingReturnEmails integer [not null]
  trialPlanPromptSubscriptionId text
  serverSetupFailedEmailAt timestamp
  serverConnectFailure text
  Note: 'TEMP'
}

Table vault_provider {
  vaultProviderId text [pk, not null]
  name text [not null]
  providerType VaultProviderType [not null]
  config jsonb [not null]
  assignments jsonb [not null]
  organizationId text [not null]
  createdAt text [not null]
  indexes {
    (organizationId, name) [unique, name: 'vault_provider_org_name_idx']
  }
}

Table volume_backup {
  volumeBackupId text [pk, not null]
  name text [not null]
  volumeName text [not null]
  prefix text [not null]
  serviceType serviceType [not null]
  appName text [not null]
  serviceName text
  turnOff boolean [not null]
  cronExpression text [not null]
  keepLatestCount integer
  enabled boolean
  applicationId text
  postgresId text
  mariadbId text
  mongoId text
  mysqlId text
  redisId text
  libsqlId text
  composeId text
  createdAt text [not null]
  destinationId text [not null]
}

Table webServerSettings {
  id text [pk, not null]
  serverIp text [note: 'Web Server Configuration']
  certificateType certificateType [not null]
  https boolean [not null]
  host text
  letsEncryptEmail text
  sshPrivateKey text
  enableDockerCleanup boolean [not null]
  logCleanupCron text
  telemetryProviderIds text [not null]
  vectorAgentOrganizationId text
  metricsConfig jsonb [not null, note: 'Metrics Configuration']
  whitelabelingConfig jsonb [note: 'Whitelabeling Configuration (Enterprise / Proprietary)']
  remoteServersOnly boolean [not null, note: 'Deployment Configuration (self-hosted only)']
  buildsConcurrency integer [not null, note: 'Concurrent builds on the local web server']
  enforceSSO boolean [not null, note: 'Auth Configuration (self-hosted only)']
  cleanupCacheApplications boolean [not null, note: 'Cache Cleanup Configuration']
  cleanupCacheOnPreviews boolean [not null]
  cleanupCacheOnCompose boolean [not null]
  created_at timestamp
  updated_at timestamp [not null]
}

