  bitbucketOwner text
  bitbucketBranch text
  bitbucketBuildPath text
  username text [note: 'Docker']
  password text
  dockerImage text
  registryUrl text
  customGitUrl text [note: 'Git']
  customGitBranch text
  customGitBuildPath text
  customGitSSHKeyId text
  enableSubmodules boolean [not null]
  dockerfile text
  dockerContextPath text
  dockerBuildStage text
  dropBuildPath text [note: 'Drop']
  healthCheckSwarm json [note: 'Docker swarm json']
  restartPolicySwarm json
  placementSwarm json
  updateConfigSwarm json
  rollbackConfigSwarm json
  modeSwarm json
  labelsSwarm json
  networkSwarm json
  stopGracePeriodSwarm bigint
  endpointSpecSwarm json
  ulimitsSwarm json
  replicas integer [not null]
  applicationStatus applicationStatus [not null]
  buildType buildType [not null]
  railpackVersion text
  herokuVersion text
  publishDirectory text
  isStaticSpa boolean
  createEnvFile boolean [not null]
  createdAt text [not null]
  registryId text
  rollbackRegistryId text
  environmentId text [not null]
  githubId text
  gitlabId text
  giteaId text
  bitbucketId text
  serverId text
  buildServerId text
  buildRegistryId text
  networkIds text
  detachDokployNetwork boolean [not null]
}

