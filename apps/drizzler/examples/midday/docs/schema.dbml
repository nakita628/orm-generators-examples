  slug text [not null, unique]
  description text
  overview text
  developer_name text
  logo_url text
  website text
  install_url text
  screenshots text
  redirect_uris text [not null]
  client_id text [not null, unique]
  client_secret text
  scopes text [not null]
  team_id uuid
  created_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  is_public boolean
  active boolean
  status text
  indexes {
    (team_id) [type: btree, name: 'oauth_applications_team_id_idx']
    (client_id) [type: btree, name: 'oauth_applications_client_id_idx']
    (slug) [type: btree, name: 'oauth_applications_slug_idx']
  }
  Note: 'Relations OAuth Applications'
}

Table oauth_authorization_codes {
  id uuid [pk, not null]
  code text [not null, unique]
  application_id uuid [not null]
  user_id uuid [not null]
  team_id uuid [not null]
  scopes text [not null]
  redirect_uri text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  used boolean
  code_challenge text
  code_challenge_method text
  indexes {
    (code) [type: btree, name: 'oauth_authorization_codes_code_idx']
    (application_id) [type: btree, name: 'oauth_authorization_codes_application_id_idx']
    (user_id) [type: btree, name: 'oauth_authorization_codes_user_id_idx']
  }
  Note: 'OAuth Authorization Codes'
}

Table oauth_access_tokens {
  id uuid [pk, not null]
  token text [not null, unique]
  refresh_token text [unique]
  application_id uuid [not null]
  user_id uuid [not null]
  team_id uuid [not null]
  scopes text [not null]
  expires_at timestamptz [not null]
  refresh_token_expires_at timestamptz
  created_at timestamptz [not null]
  last_used_at timestamptz
  revoked boolean
  revoked_at timestamptz
  indexes {
    (token) [type: btree, name: 'oauth_access_tokens_token_idx']
    (refresh_token) [type: btree, name: 'oauth_access_tokens_refresh_token_idx']
    (application_id) [type: btree, name: 'oauth_access_tokens_application_id_idx']
    (user_id) [type: btree, name: 'oauth_access_tokens_user_id_idx']
  }
  Note: 'OAuth Access Tokens'
}

Table activities {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  team_id uuid [not null, note: 'Core fields']
  user_id uuid
  type activity_type [not null]
  priority smallint
  group_id uuid [note: 'Group related activities together (e.g., same business event across multiple users)']
  source activity_source [not null, note: 'Source of the activity']
  metadata jsonb [not null, note: 'All the data']
  status activity_status [not null, note: 'Simple lifecycle (only for notifications)']
  last_used_at timestamptz [note: 'Timestamp of last system use (e.g. insight generation, digest inclusion)']
  indexes {
    (team_id, priority, status, created_at) [type: btree, name: 'activities_notifications_idx']
    (team_id, type, source, created_at) [type: btree, name: 'activities_insights_idx']
    (metadata) [type: gin, name: 'activities_metadata_gin_idx']
    (group_id) [name: 'activities_group_id_idx']
    (team_id, group_id, type, created_at) [type: btree, name: 'activities_insights_group_idx']
  }
}

Table notification_settings {
  id uuid [pk, not null]
  user_id uuid [not null]
  team_id uuid [not null]
  notification_type text [not null]
  channel text [not null]
  enabled boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (user_id, team_id, notification_type, channel) [unique, name: 'notification_settings_user_team_type_channel_key']
    (user_id, team_id) [name: 'notification_settings_user_team_idx']
    (notification_type, channel) [name: 'notification_settings_type_channel_idx']
  }
}

Table accounting_sync_records {
  id uuid [pk, not null]
  transaction_id uuid [not null]
  team_id uuid [not null]
  provider accounting_provider [not null]
  provider_tenant_id text [not null]
  provider_transaction_id text
  synced_attachment_mapping jsonb [not null, note: 'Maps Midday attachment IDs to provider attachment IDs for sync tracking Format: { "midday-attachment-id": "provider-attachment-id" }']
  synced_at timestamptz [not null]
  sync_type accounting_sync_type
  status accounting_sync_status [not null]
  error_message text
  error_code text [note: 'Standardized error code for frontend handling (e.g., "ATTACHMENT_UNSUPPORTED_TYPE", "AUTH_EXPIRED")']
  provider_entity_type text [note: 'Provider-specific entity type (e.g., "Purchase", "SalesReceipt", "Voucher", "BankTransaction")']
  created_at timestamptz [not null, note: 'When the record was first created (synced_at gets updated on every sync)']
  indexes {
    (transaction_id) [name: 'idx_accounting_sync_transaction']
    (team_id, provider) [name: 'idx_accounting_sync_team_provider']
    (team_id, status) [name: 'idx_accounting_sync_status']
    (transaction_id, provider) [unique, name: 'accounting_sync_records_transaction_provider_key']
  }
  Note: 'Accounting Sync Records Tracks which transactions have been synced to which accounting providers Supports multiple providers per transaction (Xero AND QuickBooks, etc.)'
}

Table insights {
  id uuid [pk, not null]
  team_id uuid [not null]
  period_type insight_period_type [not null, note: 'Flexible period definition']
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  period_year smallint [not null]
  period_number smallint [not null]
  status insight_status [not null]
  selected_metrics jsonb [note: 'Selected 4 key metrics (dynamically chosen)']
  all_metrics jsonb [note: 'Full metrics snapshot (for drill-down)']
  anomalies jsonb [note: 'Detected anomalies and patterns']
  expense_anomalies jsonb [note: 'Expense category anomalies (spikes, new categories, etc.)']
  milestones jsonb [note: 'Streaks and milestones']
  activity jsonb [note: 'Activity context']
  currency varchar [not null]
  title text [note: 'AI-generated title (for card headers and email subjects)']
  content jsonb [note: 'AI-generated content (relief-first structure)']
  predictions jsonb [note: 'Forward-looking predictions for follow-through tracking']
  audio_path text [note: 'Audio narration storage path: {teamId}/insights/{insightId}.mp3']
  generated_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (team_id, period_type, period_year, period_number) [unique, name: 'insights_team_period_unique']
    (team_id) [name: 'insights_team_id_idx']
    (team_id, period_type, generated_at) [name: 'insights_team_period_type_idx']
  }
}

Table insight_user_status {
  insight_id uuid [not null]
  user_id uuid [not null]
  read_at timestamptz
  dismissed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (insight_id, user_id) [pk]
    (user_id) [name: 'insight_user_status_user_idx']
    (insight_id) [name: 'insight_user_status_insight_idx']
  }
  Note: 'Per-user insight interaction tracking (read/dismiss state)'
}

