Table document_tag_embeddings {
  slug text [pk, not null]
  embedding vector
  name text [not null]
  model text [not null]
}

Table transaction_category_embeddings {
  name text [pk, not null]
  embedding vector
  model text [not null]
  system boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (system) [type: btree, name: 'transaction_category_embeddings_system_idx']
  }
}

Table transactions {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  date date [not null]
  name text [not null]
  method transactionMethods [not null]
  amount numeric(10,2) [not null]
  currency text [not null]
  team_id uuid [not null]
  assigned_id uuid
  note varchar
  bank_account_id uuid
  internal_id text [not null]
  status transactionStatus
  balance numeric(10,2)
  manual boolean
  notified boolean
  internal boolean
  description text
  category_slug text
  baseAmount numeric(10,2)
  counterparty_name text
  base_currency text
  tax_amount numeric(10,2)
  tax_rate numeric(10,2)
  tax_type text
  recurring boolean
  frequency transaction_frequency
  merchant_name text
  enrichment_completed boolean
  fts_vector tsvector [not null]
  indexes {
    (date) [type: btree, name: 'idx_transactions_date']
    (fts_vector) [type: gin, name: 'idx_transactions_fts']
    (fts_vector) [type: gin, name: 'idx_transactions_fts_vector']
    (id) [type: btree, name: 'idx_transactions_id']
    (name) [type: btree, name: 'idx_transactions_name']
    (merchant_name) [type: gin, name: 'idx_transactions_merchant_name_trgm']
    (team_id, date, name) [type: btree, name: 'idx_transactions_team_id_date_name']
    (team_id, name) [type: btree, name: 'idx_transactions_team_id_name']
    (name) [type: gist, name: 'idx_trgm_name']
    (assigned_id) [type: btree, name: 'transactions_assigned_id_idx']
    (bank_account_id) [type: btree, name: 'transactions_bank_account_id_idx']
    (category_slug) [type: btree, name: 'transactions_category_slug_idx']
    (team_id, date, currency, bank_account_id) [type: btree, name: 'transactions_team_id_date_currency_bank_account_id_category_idx']
    (team_id) [type: btree, name: 'transactions_team_id_idx']
    (team_id, date, category_slug) [type: btree, name: 'idx_transactions_reports']
    (internal_id) [unique, name: 'transactions_internal_id_key']
  }
}

Table tracker_entries {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  duration bigint [note: 'You can use { mode: "bigint" } if numbers are exceeding js number limitations']
  project_id uuid
  start timestamptz
  stop timestamptz
  assigned_id uuid
  team_id uuid
  description text
  rate numeric(10,2)
  currency text
  billed boolean
  date date
  indexes {
    (team_id) [type: btree, name: 'tracker_entries_team_id_idx']
    (team_id, date) [name: 'tracker_entries_team_date_idx']
  }
}

Table customer_tags {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  customer_id uuid [not null]
  team_id uuid [not null]
  tag_id uuid [not null]
  indexes {
    (customer_id, tag_id) [unique, name: 'unique_customer_tag']
  }
}

Table inbox_accounts {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  email text [not null]
  access_token text [not null]
  refresh_token text [not null]
  team_id uuid [not null]
  last_accessed timestamptz [not null]
  provider inbox_account_providers [not null]
  external_id text [not null]
  expiry_date timestamptz [not null]
  schedule_id text
  status inbox_account_status [not null]
  error_message text
  indexes {
    (email) [unique, name: 'inbox_accounts_email_key']
    (external_id) [unique, name: 'inbox_accounts_external_id_key']
  }
}

Table bank_accounts {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  created_by uuid [not null]
  team_id uuid [not null]
  name text
  currency text
  bank_connection_id uuid
  enabled boolean [not null]
  account_id text [not null]
  balance numeric(10,2)
  manual boolean
  type account_type
  base_currency text
  baseBalance numeric(10,2)
  error_details text
  error_retries smallint
  account_reference text
  iban text [note: 'Additional account data for reconnect matching and user display']
  subtype text
  bic text
  routing_number text [note: 'US bank account details (Teller, Plaid)']
  wire_routing_number text
  account_number text
  sort_code text
  availableBalance numeric(10,2) [note: 'Credit account balances']
  creditLimit numeric(10,2)
  indexes {
    (bank_connection_id) [type: btree, name: 'bank_accounts_bank_connection_id_idx']
    (created_by) [type: btree, name: 'bank_accounts_created_by_idx']
    (team_id) [type: btree, name: 'bank_accounts_team_id_idx']
  }
}

Table invoice_recurring {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz
  team_id uuid [not null]
  user_id uuid [not null]
  customer_id uuid
  frequency invoice_recurring_frequency [not null, note: 'Frequency settings']
  frequency_day integer
  frequency_week integer
  frequency_interval integer
  end_type invoice_recurring_end_type [not null, note: 'End conditions']
  end_date timestamptz
  end_count integer
  status invoice_recurring_status [not null, note: 'Status tracking']
  invoices_generated integer [not null]
  consecutive_failures integer [not null]
  next_scheduled_at timestamptz
  last_generated_at timestamptz
  timezone text [not null]
  due_date_offset integer [not null, note: 'Invoice template data']
  amount numeric(10,2)
  currency text
  line_items jsonb
  template jsonb
  payment_details jsonb
  from_details jsonb
  note_details jsonb
  customer_name text
  vat numeric(10,2)
  tax numeric(10,2)
  discount numeric(10,2)
  subtotal numeric(10,2)
  top_block jsonb
  bottom_block jsonb
  template_id uuid
  upcoming_notification_sent_at timestamptz [note: 'Notification tracking']
  indexes {
    (team_id) [type: btree, name: 'invoice_recurring_team_id_idx']
    (next_scheduled_at) [type: btree, name: 'invoice_recurring_next_scheduled_at_idx']
    (status) [type: btree, name: 'invoice_recurring_status_idx']
    (next_scheduled_at) [type: btree, name: 'invoice_recurring_active_scheduled_idx']
  }
}

Table invoices {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz
  due_date timestamptz
  invoice_number text
  customer_id uuid
  amount numeric(10,2)
  currency text
  line_items jsonb
  payment_details jsonb
  customer_details jsonb
  company_datails jsonb
  note text
  internal_note text
  team_id uuid [not null]
  paid_at timestamptz
  fts tsvector [not null]
  vat numeric(10,2)
  tax numeric(10,2)
  url text
  file_path text
  status invoice_status [not null]
  viewed_at timestamptz
  from_details jsonb
  issue_date timestamptz
  template jsonb
  note_details jsonb
  customer_name text
  token text [not null]
  sent_to text
  reminder_sent_at timestamptz
  discount numeric(10,2)
  file_size bigint
  user_id uuid
  subtotal numeric(10,2)
  top_block jsonb
  bottom_block jsonb
  sent_at timestamptz
  scheduled_at timestamptz
  scheduled_job_id text
  template_id uuid
  payment_intent_id text
  refunded_at timestamptz
  invoice_recurring_id uuid [note: 'Recurring invoice fields']
  recurring_sequence integer
  indexes {
    (created_at) [type: btree, name: 'invoices_created_at_idx']
    (fts) [type: gin, name: 'invoices_fts']
    (team_id) [type: btree, name: 'invoices_team_id_idx']
    (template_id) [type: btree, name: 'invoices_template_id_idx']
    (team_id, sent_at) [name: 'invoices_team_sent_at_idx']
    (team_id, status, paid_at) [name: 'invoices_team_status_paid_at_idx']
    (invoice_recurring_id) [type: btree, name: 'invoices_invoice_recurring_id_idx']
    (invoice_recurring_id, recurring_sequence) [unique, name: 'invoices_recurring_sequence_unique_idx']
    (scheduled_job_id) [unique, name: 'invoices_scheduled_job_id_key']
    (team_id, due_date) [name: 'invoices_team_due_date_idx']
    (team_id, status, due_date) [name: 'invoices_team_status_due_date_idx']
    (team_id, customer_id) [name: 'invoices_team_customer_id_idx']
    (customer_id) [name: 'invoices_customer_id_idx']
    (team_id, created_at) [name: 'invoices_team_created_at_idx']
  }
}

Table customers {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  name text [not null]
  email text [not null]
  billingEmail text
  country text
  address_line_1 text
  address_line_2 text
  city text
  state text
  zip text
  note text
  team_id uuid [not null]
  website text
  phone text
  vat_number text
  country_code text
  token text [not null]
  contact text
  status text [note: 'Customer relationship fields']
  preferred_currency text
  default_payment_terms integer
  is_archived boolean
  source text
  external_id text
  logo_url text [note: 'Enrichment fields (from Gemini + Google Search grounding)']
  description text
  industry text
  company_type text
  employee_count text
  founded_year integer
  estimated_revenue text
  funding_stage text
  total_funding text
  headquarters_location text
  timezone text
  linkedin_url text
  twitter_url text
  instagram_url text
  facebook_url text
  ceo_name text
  finance_contact text
  finance_contact_email text
  primary_language text
  fiscal_year_end text
  enrichment_status text [note: 'Enrichment metadata']
  enriched_at timestamptz
  portal_enabled boolean [note: 'Portal fields']
  portal_id text
  fts tsvector [not null]
  indexes {
    (fts) [type: gin, name: 'customers_fts']
    (status) [name: 'idx_customers_status']
    (is_archived) [name: 'idx_customers_is_archived']
    (enrichment_status) [name: 'idx_customers_enrichment_status']
    (website) [name: 'idx_customers_website']
    (industry) [name: 'idx_customers_industry']
    (team_id) [name: 'customers_team_id_idx']
    (team_id, created_at) [name: 'customers_team_created_at_idx']
  }
}

Table exchange_rates {
  id uuid [pk, not null]
  base text
  rate numeric(10,2)
  target text
  updated_at timestamptz
  indexes {
    (base, target) [type: btree, name: 'exchange_rates_base_target_idx']
    (base, target) [unique, name: 'unique_rate']
  }
}

