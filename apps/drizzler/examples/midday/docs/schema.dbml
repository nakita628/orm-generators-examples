    (team_id, created_at) [type: btree, name: 'documents_team_id_created_at_idx']
    (team_id, date) [type: btree, name: 'documents_team_id_date_idx']
    (team_id, name) [type: btree, name: 'documents_team_id_name_idx']
    (fts_english) [type: gin, name: 'idx_documents_fts_english']
    (fts_language) [type: gin, name: 'idx_documents_fts_language']
    (fts_simple) [type: gin, name: 'idx_documents_fts_simple']
    (title) [type: gin, name: 'idx_gin_documents_title']
    (name) [type: gin, name: 'idx_gin_documents_name']
  }
}

