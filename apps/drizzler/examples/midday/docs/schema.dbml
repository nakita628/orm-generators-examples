  time_format numeric
  date_format text
  indexes {
    (team_id) [type: btree, name: 'users_team_id_idx']
  }
}

Table tracker_projects {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  team_id uuid
  rate numeric(10,2)
  currency text
  status trackerStatus [not null]
  description text
  name text [not null]
  billable boolean
  estimate bigint [note: 'You can use { mode: "bigint" } if numbers are exceeding js number limitations']
  customer_id uuid
  fts tsvector [not null]
  indexes {
    (fts) [type: gin, name: 'tracker_projects_fts']
    (team_id) [type: btree, name: 'tracker_projects_team_id_idx']
  }
}

Table inbox {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  team_id uuid
  file_path text
  file_name text
  transaction_id uuid
  amount numeric(10,2)
  currency text
  content_type text
  size bigint [note: 'You can use { mode: "bigint" } if numbers are exceeding js number limitations']
  attachment_id uuid
  date date
  forwarded_to text
  reference_id text
  meta json
  status inbox_status
  website text
  sender_email text
  display_name text
  fts tsvector [not null]
  type inbox_type
  description text
  base_amount numeric(10,2)
  base_currency text
  tax_amount numeric(10,2)
  tax_rate numeric(10,2)
  tax_type text
  inbox_account_id uuid
  invoice_number text
  grouped_inbox_id uuid
  indexes {
    (attachment_id) [type: btree, name: 'inbox_attachment_id_idx']
    (created_at) [type: btree, name: 'inbox_created_at_idx']
    (team_id) [type: btree, name: 'inbox_team_id_idx']
    (transaction_id) [type: btree, name: 'inbox_transaction_id_idx']
    (inbox_account_id) [type: btree, name: 'inbox_inbox_account_id_idx']
    (invoice_number) [type: btree, name: 'inbox_invoice_number_idx']
    (grouped_inbox_id) [type: btree, name: 'inbox_grouped_inbox_id_idx']
    (display_name) [type: gin, name: 'idx_inbox_display_name_trgm']
    (team_id, status, created_at) [name: 'inbox_team_status_created_at_idx']
    (reference_id) [unique, name: 'inbox_reference_id_key']
  }
}

Table inbox_blocklist {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  team_id uuid [not null]
  type inbox_blocklist_type [not null]
  value text [not null]
  indexes {
    (team_id, type, value) [unique, name: 'inbox_blocklist_team_id_type_value_key']
  }
}

Table transaction_match_suggestions {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  team_id uuid [not null, note: 'Core relationship']
  inbox_id uuid [not null]
  transaction_id uuid [not null]
  confidence_score numeric(4,3) [not null, note: 'Match scores for transparency']
  amount_score numeric(4,3)
  currency_score numeric(4,3)
  date_score numeric(4,3)
  name_score numeric(4,3)
  match_type text [not null, note: 'Match context']
  match_details jsonb
  status text [not null, note: 'User interaction tracking']
  user_action_at timestamptz
  user_id uuid
  indexes {
    (inbox_id) [type: btree, name: 'transaction_match_suggestions_inbox_id_idx']
    (transaction_id) [type: btree, name: 'transaction_match_suggestions_transaction_id_idx']
    (team_id) [type: btree, name: 'transaction_match_suggestions_team_id_idx']
    (status) [type: btree, name: 'transaction_match_suggestions_status_idx']
    (confidence_score) [type: btree, name: 'transaction_match_suggestions_confidence_idx']
    (transaction_id, team_id, status) [type: btree, name: 'transaction_match_suggestions_lookup_idx']
    (team_id, status, created_at) [type: btree, name: 'transaction_match_suggestions_team_status_created_idx']
    (inbox_id, transaction_id) [unique, name: 'transaction_match_suggestions_unique']
  }
}

Table document_tag_assignments {
