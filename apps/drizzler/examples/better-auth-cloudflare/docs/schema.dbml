Table users {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified integer [not null]
  image text
  created_at integer [not null]
  updated_at integer [not null]
  is_anonymous integer
}

Table sessions {
  id text [pk, not null]
  expires_at integer [not null]
  token text [not null, unique]
  created_at integer [not null]
  updated_at integer [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  timezone text
  city text
  country text
  region text
  region_code text
  colo text
  latitude text
  longitude text
  indexes {
    (user_id) [name: 'sessions_userId_idx']
  }
}

Table accounts {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (user_id) [name: 'accounts_userId_idx']
  }
}

Table verifications {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (identifier) [name: 'verifications_identifier_idx']
  }
}

Table rate_limits {
  id text [pk, not null]
  key text [not null, unique]
  count integer [not null]
  last_request integer [not null]
}

Ref sessions_user_id_users_id_fk: sessions.user_id > users.id [delete: cascade]

Ref accounts_user_id_users_id_fk: accounts.user_id > users.id [delete: cascade]