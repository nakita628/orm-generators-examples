Table prompts {
  id integer [pk, increment, not null]
  title text [not null]
  description text
  content text [not null]
  slug text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (slug) [unique, name: 'prompts_slug_unique']
  }
}

Table app_collections {
  id integer [pk, increment, not null]
  name text [not null]
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (name) [unique, name: 'app_collections_name_unique']
  }
}

Table apps {
  id integer [pk, increment, not null]
  name text [not null]
  path text [not null]
  created_at integer [not null]
  updated_at integer [not null]
  github_org text
  github_repo text
  github_branch text
  gitlab_instance_url text [note: 'The GitLab project an app is linked to. An app links to GitHub or GitLab, never both. Which one an app belongs to is decided in src/shared/linked_remote.ts, and src/ipc/utils/app_git_remote.ts builds the URLs and credentials on top of it — resolve through those rather than reading these columns directly, so the UI and the push cannot disagree about the provider. The instance URL is recorded because Dyad holds one GitLab connection at a time and it can later point at a different instance than this project is on — pushing there would silently go to the wrong GitLab.']
  gitlab_project_id integer
  gitlab_project_path text
  gitlab_branch text
  supabase_project_id text
  supabase_parent_project_id text [note: 'If supabaseProjectId is a branch, then the parent project id set. This is because there\'s no way to retrieve ALL the branches for ALL projects in a single API call This is only used for display purposes but is NOT used for any actual supabase management logic.']
  supabase_organization_slug text [note: 'Supabase organization slug for credential lookup']
  supabase_test_user_id text [note: 'In-flight ephemeral test-user id for isolated e2e runs against Supabase. Supabase\'s free tier has no DB branching, so instead of a throwaway branch we create a dedicated throwaway auth user (via the Auth Admin API, stamped app_metadata.dyad_test=true) and run the tests authenticated as it. Set while a test session holds that user, cleared on teardown. Persisted so a crash mid-session can be reconciled (orphan user deleted) on the next launch. See ipc/utils/supabase_test_user.ts.']
  neon_project_id text
  neon_development_branch_id text
  neon_preview_branch_id text
  neon_active_branch_id text
  neon_test_branch_id text [note: 'In-flight ephemeral test branch for isolated e2e test runs. Set while a test session holds a throwaway copy-on-write branch, cleared on teardown. Persisted so a crash mid-session can be reconciled (orphan branch deleted) on the next launch. See ipc/utils/neon_test_branch.ts.']
  neon_production_auth_cookie_secret text
  neon_development_auth_cookie_secret text
  selected_database_branch_type text [note: 'Which Neon branch the unified database section is set to deploy/sync against ("production" | "development"). Null is interpreted differently by each consumer: the backend sync (getSelectedDeployBranchType) treats null as production, while the DatabaseSection UI treats null as "not yet chosen" and shows the branch picker until the user selects one. Read by the main process when syncing env vars + trusted domains to Vercel.']
  vercel_project_id text
  vercel_project_name text
  vercel_team_id text
  vercel_deployment_url text
  install_command text
  start_command text
  chat_context text
  is_favorite integer [not null]
  theme_id text [note: 'Theme ID for design system theming (null means "no theme")']
  needs_app_blueprint integer [not null]
  testing_enabled integer [not null, note: 'Per-app opt-in for the experimental AI E2E testing feature. Off by default: running tests can mutate the app\'s real data, so the Tests panel gates all run/generate controls behind this flag until the user explicitly enables it (after acknowledging the data-backup warning). See TestsPanel.tsx.']
  collection_id integer
}

Table test_user_cleanup {
  user_id text [pk, not null]
  app_id integer [not null]
  owner_id text [not null]
  project_id text [not null]
  organization_slug text [not null]
  Note: 'Independent recovery records: concurrent cases must never overwrite another run\'s user. Deliberately no cascading FK: a failed remote deletion must remain recoverable even after the local app is deleted. No credentials are stored.'
}

Table test_branch_cleanup {
  branch_id text [pk, not null]
  app_id integer [not null]
  owner_id text [not null, unique]
  project_id text [not null]
  Note: 'One record per sandboxed run, independent of the recorder\'s app-row marker. Retain provider identity after app deletion/reassociation so failed cleanup remains recoverable. Never store connection strings or auth credentials here.'
}

Table chats {
  id integer [pk, increment, not null]
  app_id integer [not null]
  title text
  execution_backend text [not null]
  claude_session_id text
  claude_session_state text
  initial_commit_hash text
  created_at integer [not null]
  compacted_at integer [note: 'Context compaction fields']
  compaction_backup_path text
  pending_compaction integer
  chat_mode text
  model_selection text
  referenced_app_ids text [note: 'App ids referenced via `@app:Name` that stay available for the rest of the chat (agent-backed modes only). Stored on the chat rather than derived from message history so references survive compaction, which rewrites history. Ids, not paths: apps can be renamed or moved, so paths are resolved per turn.']
  is_favorite integer [not null]
}

Table messages {
  id integer [pk, increment, not null]
  chat_id integer [not null]
  role text [not null]
  content text [not null]
  approval_state text
  source_commit_hash text [note: 'The commit hash of the codebase at the time the message was created']
  commit_hash text [note: 'The commit hash of the codebase at the time the message was sent']
  request_id text
  user_input_request_id text
  chat_turn_intent_id text [note: 'Stable idempotency identity for main-owned chat turn admission. Unlike userInputRequestId, ordinary queued turns also carry this identity.']
  max_tokens_used integer [note: 'Max tokens used for this message (only for assistant messages)']
  model text [note: 'Model name used for this message (only for assistant messages)']
  inference_source text
  ai_messages_json text [note: 'AI SDK messages (v5 envelope) for preserving tool calls/results in agent mode']
  using_free_agent_mode_quota integer [note: 'Track if this message used the free agent quota (for non-Pro users)']
  is_compaction_summary integer [note: 'Indicates this message is a compaction summary']
  created_at integer [not null]
  indexes {
    (chat_id, user_input_request_id) [unique, name: 'messages_chat_user_input_request_unique']
    (chat_id, chat_turn_intent_id) [unique, name: 'messages_chat_turn_intent_unique']
  }
}

Table chat_turn_intents {
  intent_id text [pk, not null]
  chat_id integer [not null]
  payload_hash text [not null]
  intent text
  acceptance text [not null]
  recovery text [not null]
  terminal_outcome text
  accepted_message_id integer
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (chat_id) [name: 'chat_turn_intents_chat_idx']
  }
}

Table chat_queue_states {
  chat_id integer [pk, not null]
  revision integer [not null]
  paused integer [not null]
  pause_reason text
  updated_at integer [not null]
}

Table chat_queue_entries {
  intent_id text [pk, not null]
  position integer [not null]
  status text [not null]
}

Table agent_threads {
  id text [pk, not null, note: 'Stable UUID for the sub-agent thread.']
  chat_id integer [not null, note: 'Chat that owns and displays this thread.']
  persona text [not null, note: 'Specialized role assigned to the sub-agent.']
  task_name text [not null, note: 'Short user-visible name for the task.']
  assignment text [not null, note: 'Full assignment originally given to the sub-agent.']
  status text [not null, note: 'Current lifecycle state of the thread.']
  provider text [not null, note: 'Provider used to run the sub-agent model.']
  model text [not null, note: 'Provider model identifier used by the sub-agent.']
  reasoning_effort text [not null, note: 'Provider-specific reasoning effort value.']
  context_json text [note: 'Durable invocation context such as scope and source message.']
  result_json text [note: 'Structured terminal result produced by the sub-agent.']
  review_base_commit text [note: 'Base commit used to construct a review target.']
  review_target_commit text [note: 'Target commit used to construct a review target.']
  review_diff_hash text [note: 'Hash identifying the exact diff reviewed.']
  invocation_source text [not null, note: 'User or system path that created this thread.']
  remediation_source text [note: 'Action that initiated review remediation.']
  auto_fix_at integer [note: 'Scheduled time at which automatic fixes begin.']
  error text [note: 'User-visible terminal error, when the thread fails.']
  input_tokens integer [not null, note: 'Cumulative model input tokens used by the thread.']
  output_tokens integer [not null, note: 'Cumulative model output tokens used by the thread.']
  tool_call_count integer [not null, note: 'Cumulative number of child tool calls.']
  created_at integer [not null, note: 'Time at which the thread was created.']
  started_at integer [note: 'Time at which execution first started.']
  completed_at integer [note: 'Time at which execution reached a terminal state.']
  updated_at integer [not null, note: 'Time of the latest durable thread update.']
  indexes {
    (chat_id) [name: 'agent_threads_chat_id_idx']
  }
}

Table agent_messages {
  id integer [pk, increment, not null]
  thread_id text [not null]
  sequence integer [not null]
  message_id text [not null]
  role text [not null]
  content text [not null]
  consumed integer [not null]
  created_at integer [not null]
  indexes {
    (thread_id, sequence) [unique, name: 'agent_messages_thread_sequence_unique']
    (thread_id, message_id) [unique, name: 'agent_messages_thread_message_unique']
  }
}

Table agent_activities {
  id integer [pk, increment, not null, note: 'Local row identifier for the activity snapshot.']
  thread_id text [not null, note: 'Sub-agent thread that owns this activity.']
  sequence integer [not null, note: 'Stable first-seen order within the thread.']
  tool_call_id text [not null, note: 'AI SDK call identifier used to update this activity.']
  tool_name text [not null, note: 'Registered name of the invoked tool.']
  status text [not null, note: 'Current execution state of the tool invocation.']
  presentation_xml text [not null, note: 'Existing Dyad XML used to render the activity.']
  input_json text [note: 'Validated tool arguments retained for grounded report reconstruction.']
  output_text text [note: 'Bounded model-visible tool result retained for grounded reports.']
  error text [note: 'User-visible tool error when execution fails.']
  started_at integer [not null, note: 'Time at which the tool invocation first appeared.']
  completed_at integer [note: 'Time at which the invocation reached a terminal state.']
  indexes {
    (thread_id, tool_call_id) [unique, name: 'agent_activities_thread_tool_call_unique']
    (thread_id, sequence) [unique, name: 'agent_activities_thread_sequence_unique']
  }
}

Table versions {
  id integer [pk, increment, not null]
  app_id integer [not null]
  commit_hash text [not null]
  neon_db_timestamp text
  is_favorite integer [not null]
  note text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (app_id, commit_hash) [unique, name: 'versions_app_commit_unique']
  }
}

Table security_fix_chats {
  id integer [pk, increment, not null]
  app_id integer [not null]
  review_chat_id integer [not null]
  finding_key text [not null, note: 'Hash of the normalized finding(s) the fix chat was created for']
  fix_chat_id integer [not null]
  created_at integer [not null]
  indexes {
    (app_id, review_chat_id, finding_key) [unique, name: 'security_fix_chats_unique']
    (review_chat_id) [name: 'security_fix_chats_review_chat_id_idx']
    (fix_chat_id) [name: 'security_fix_chats_fix_chat_id_idx']
  }
}

Table coolify_app_connections {
  id integer [pk, increment, not null]
  app_id integer [not null]
  server_uuid text [not null, note: 'Where the deployment goes. Coolify addresses a resource by all three: the machine, the grouping, and the lane within it — an app can have a production and a staging copy in one project on one server. The Coolify instance is deliberately not here. Its only handle is the URL, which changes without the instance changing (http to https once a certificate lands, an IP becoming a domain), so keying on it would make every app look moved. These are UUIDs, so they do not collide across instances anyway.']
  project_uuid text [not null]
  environment_name text [not null]
  application_uuid text
  domain text [note: 'What the user asked for, not where the app ended up — that is app_url. Null means no custom domain, so the address is whatever the deploy is entitled to generate. Never write a generated address back here, or the user\'s "no preference" becomes a stored preference they cannot undo.']
  app_url text
  last_deployed_at integer
  indexes {
    (app_id, server_uuid, project_uuid, environment_name) [unique, name: 'coolify_app_connections_target_unique']
  }
  Note: 'Where an app deploys to on a Coolify instance. A table rather than columns on `apps` because these are set together and mean nothing apart: a server without a project names nowhere, and an application id without either belongs to no instance. The row existing is what "connected" means, so disconnecting deletes it rather than nulling every field and hoping each writer nulls the same ones. One row is one deployment. The target columns are NOT NULL because the database will not hold a half-configured connection; the rest fill in as a deploy progresses. The API token is instance-wide and lives in settings.'
}

Table cloudflare_app_connections {
  id integer [pk, increment, not null]
  app_id integer [not null]
  root_directory text [not null, note: 'Path from the repository root, "" for the root itself.']
  account_id text [not null]
  worker_name text [not null]
  worker_tag text [not null, note: 'Cloudflare\'s immutable id for the Worker; its builds API keys on this.']
  trigger_uuid text [not null, note: 'The rule that deploys this target on each push.']
  worker_url text [note: 'The workers.dev address, or null when the Worker has that route off.']
  created_at integer [not null]
  indexes {
    (app_id, root_directory) [unique, name: 'cloudflare_app_connections_target_unique']
    (account_id, worker_tag) [unique, name: 'cloudflare_app_connections_worker_unique']
  }
  Note: 'Which Cloudflare Worker a folder of an app deploys to. One row per target, where a target is a folder with a Wrangler config or a Nitro app: an app can deploy several Workers, each with its own rule on Cloudflare. The row existing is what "connected" means, so every column but `workerUrl` is NOT NULL and disconnecting deletes the row. The API token is account-wide and lives in settings.'
}

Table language_model_providers {
  id text [pk, not null]
  name text [not null]
  api_base_url text [not null]
  env_var_name text
  created_at integer [not null]
  updated_at integer [not null]
}

Table language_models {
  id integer [pk, increment, not null]
  display_name text [not null]
  api_name text [not null]
  builtin_provider_id text
  custom_provider_id text
  description text
  max_output_tokens integer
  context_window integer
  created_at integer [not null]
  updated_at integer [not null]
}

Table mcp_servers {
  id integer [pk, increment, not null]
  name text [not null]
  transport text [not null]
  command text
  args text [note: 'Store typed JSON for args and environment variables']
  env_json text [note: 'Legacy plaintext env vars and headers. These remain for unedited rows so older builds can still use their existing configuration; new writes and secret edits clear them in favor of the encrypted columns below, which are what this build reads.']
  headers_json text
  env_encrypted text [note: 'Env vars and headers encrypted via Electron `safeStorage`, or base64 plaintext where no keyring is available (see encryptSecretMap). Both hold a JSON object of strings.']
  headers_encrypted text
  url text
  enabled integer [not null]
  oauth_enabled integer [not null, note: 'Whether this server requires OAuth. When true, the MCP manager wires an `OAuthClientProvider` into the streamable HTTP transport so the Vercel `@ai-sdk/mcp` `auth()` flow can drive PKCE + refresh.']
  oauth_state text [note: 'OAuth state (tokens, expiry, client info). Encrypted via Electron `safeStorage`, or base64 plaintext where no keyring is available (see encryptToString). Read/written only by DyadOAuthClientProvider.']
  oauth_client_id text [note: 'Optional pre-registered OAuth client_id for servers that don\'t support dynamic client registration (RFC 7591). User-supplied via the add-server UI; left blank for servers that support DCR.']
  oauth_client_secret text [note: 'Optional pre-registered OAuth client_secret for confidential clients. Encrypted via `safeStorage` (base64 plaintext fallback where no keyring exists). Never sent to the renderer.']
  oauth_scope text [note: 'Space-separated OAuth scopes requested at the authorize endpoint. Server-defined values; check provider docs. Blank means omit the `scope` parameter entirely so the server applies its own default (rather than us guessing a value that fits a minority of providers).']
  oauth_callback_port integer [note: 'Per-server callback port. Manual (non-DCR) flows pre-register a redirect URI that includes the port, so it must stay stable for those rows. Null falls back to DEFAULT_OAUTH_CALLBACK_PORT.']
  catalog_slug text [note: 'Slug of the curated catalog entry this server was added from. Null for manually configured servers.']
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (catalog_slug) [unique, name: 'uniq_mcp_catalog_slug']
  }
  Note: '--- MCP (Model Context Protocol) tables ---'
}

Table mcp_tool_consents {
  id integer [pk, increment, not null]
  server_id integer [not null]
  tool_name text [not null]
  consent text [not null]
  updated_at integer [not null]
  indexes {
    (server_id, tool_name) [unique, name: 'uniq_mcp_consent']
  }
}

Table chat_search_dirty_messages {
  message_id integer [pk, not null]
  Note: '--- Chat search (FTS5) support tables --- Dirty queues for the chat_search_fts index (created in a custom migration — drizzle cannot model FTS5 virtual tables). Rows are enqueued by SQLite triggers when source rows change and drained by ChatSearchIndexer, which builds the searchable text projection in TypeScript. No foreign keys: triggers own the row lifecycle, including cleanup on delete.'
}

Table chat_search_dirty_chats {
  chat_id integer [pk, not null]
}

Table chat_search_meta {
  key text [pk, not null]
  value text [not null]
  Note: 'Key/value metadata for the chat-search index (e.g. projection version so a policy change can trigger a background rebuild).'
}

Table custom_themes {
  id integer [pk, increment, not null]
  name text [not null]
  description text
  prompt text [not null]
  created_at integer [not null]
  updated_at integer [not null]
  Note: '--- Custom Themes table ---'
}

Ref apps_collection_id_app_collections_id_fk: apps.collection_id > app_collections.id [delete: set null]

Ref chats_app_id_apps_id_fk: chats.app_id > apps.id [delete: cascade]

Ref messages_chat_id_chats_id_fk: messages.chat_id > chats.id [delete: cascade]

Ref chat_turn_intents_chat_id_chats_id_fk: chat_turn_intents.chat_id > chats.id [delete: cascade]

Ref chat_queue_states_chat_id_chats_id_fk: chat_queue_states.chat_id - chats.id [delete: cascade]

Ref chat_queue_entries_intent_id_chat_turn_intents_intent_id_fk: chat_queue_entries.intent_id - chat_turn_intents.intent_id [delete: cascade]

Ref agent_threads_chat_id_chats_id_fk: agent_threads.chat_id > chats.id [delete: cascade]

Ref agent_messages_thread_id_agent_threads_id_fk: agent_messages.thread_id > agent_threads.id [delete: cascade]

Ref agent_activities_thread_id_agent_threads_id_fk: agent_activities.thread_id > agent_threads.id [delete: cascade]

Ref versions_app_id_apps_id_fk: versions.app_id > apps.id [delete: cascade]

Ref security_fix_chats_app_id_apps_id_fk: security_fix_chats.app_id > apps.id [delete: cascade]

Ref security_fix_chats_review_chat_id_chats_id_fk: security_fix_chats.review_chat_id > chats.id [delete: cascade]

Ref security_fix_chats_fix_chat_id_chats_id_fk: security_fix_chats.fix_chat_id > chats.id [delete: cascade]

Ref coolify_app_connections_app_id_apps_id_fk: coolify_app_connections.app_id > apps.id [delete: cascade]

Ref cloudflare_app_connections_app_id_apps_id_fk: cloudflare_app_connections.app_id > apps.id [delete: cascade]

Ref language_models_custom_provider_id_language_model_providers_id_fk: language_models.custom_provider_id > language_model_providers.id [delete: cascade]

Ref mcp_tool_consents_server_id_mcp_servers_id_fk: mcp_tool_consents.server_id > mcp_servers.id [delete: cascade]