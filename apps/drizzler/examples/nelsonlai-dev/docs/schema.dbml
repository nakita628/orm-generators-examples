Table users {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null]
  image text
  role text
  banned boolean
  ban_reason text
  ban_expires timestamptz
  last_login_method text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table sessions {
  id text [pk, not null]
  expires_at timestamptz [not null]
  token text [not null, unique]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (user_id) [name: 'sessions_user_id_idx']
  }
}

Table accounts {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamptz
  refresh_token_expires_at timestamptz
  scope text
  password text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (user_id) [name: 'accounts_user_id_idx']
    (provider_id, account_id) [unique, name: 'accounts_provider_id_account_id_unique']
  }
}

Table verifications {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (identifier) [name: 'verifications_identifier_idx']
  }
}

Table comments {
  id text [pk, not null]
  body text [not null]
  post_slug text [not null]
  user_id text
  parent_id text
  is_deleted boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (post_slug, created_at, id) [name: 'comments_post_slug_created_at_id_idx']
    (parent_id, created_at, id) [name: 'comments_parent_id_created_at_id_idx']
    (user_id) [name: 'comments_user_id_idx']
  }
}

Table comment_votes {
  user_id text [not null]
  comment_id text [not null]
  is_like boolean [not null]
  indexes {
    (user_id, comment_id) [pk]
    (comment_id, is_like) [name: 'comment_votes_comment_id_is_like_idx']
  }
}

Table comment_notification_preferences {
  user_id text [pk, not null]
  comment_replies_enabled boolean [not null]
}

Table comment_reply_unsubscribes {
  user_id text [not null]
  comment_id text [not null]
  indexes {
    (user_id, comment_id) [pk]
  }
}

Table guestbook_messages {
  id text [pk, not null]
  body text [not null]
  user_id text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (created_at, id) [name: 'guestbook_messages_created_at_id_desc_idx']
    (user_id) [name: 'guestbook_messages_user_id_idx']
  }
}

Table posts {
  slug text [pk, not null]
  likes integer [not null]
  views integer [not null]
  created_at timestamptz [not null]
  indexes {
    (created_at) [name: 'posts_created_at_desc_idx']
  }
}

Table post_likes {
  post_slug text [not null]
  anon_key text [not null]
  like_count integer [not null]
  created_at timestamptz [not null]
  indexes {
    (post_slug, anon_key) [pk]
  }
}

Ref sessions_user_id_users_id_fk: sessions.user_id > users.id [delete: cascade]

Ref accounts_user_id_users_id_fk: accounts.user_id > users.id [delete: cascade]

Ref comments_post_slug_posts_slug_fk: comments.post_slug > posts.slug [delete: cascade]

Ref comments_user_id_users_id_fk: comments.user_id > users.id [delete: set null]

Ref comments_parent_id_comments_id_fk: comments.parent_id > comments.id [delete: restrict]

Ref comment_votes_user_id_users_id_fk: comment_votes.user_id > users.id [delete: cascade]

Ref comment_votes_comment_id_comments_id_fk: comment_votes.comment_id > comments.id [delete: cascade]

Ref comment_notification_preferences_user_id_users_id_fk: comment_notification_preferences.user_id - users.id [delete: cascade]

Ref comment_reply_unsubscribes_user_id_users_id_fk: comment_reply_unsubscribes.user_id > users.id [delete: cascade]

Ref comment_reply_unsubscribes_comment_id_comments_id_fk: comment_reply_unsubscribes.comment_id > comments.id [delete: cascade]

Ref guestbook_messages_user_id_users_id_fk: guestbook_messages.user_id > users.id [delete: cascade]

Ref post_likes_post_slug_posts_slug_fk: post_likes.post_slug > posts.slug [delete: cascade]