Table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified integer [not null]
  image text
  created_at integer [not null]
  updated_at integer [not null]
  role text
  banned integer
  ban_reason text
  ban_expires integer
}

Table session {
  id text [pk, not null]
  expires_at integer [not null]
  token text [not null, unique]
  created_at integer [not null]
  updated_at integer [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  indexes {
    (user_id) [name: 'session_userId_idx']
  }
}

Table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (user_id) [name: 'account_userId_idx']
  }
}

Table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (identifier) [name: 'verification_identifier_idx']
  }
}

Table rateLimit {
  id text [pk, not null]
  key text
  count integer
  last_request integer
  indexes {
    (key) [name: 'rateLimit_key_idx']
  }
  Note: 'Backs better-auth\'s `rateLimit: { storage: \'database\' }`. Field names (key, count, lastRequest) must match what the rate-limiter adapter reads/writes.'
}

Table subscription {
  id text [pk, not null]
  user_id text [not null, unique]
  provider text [not null]
  customer_id text [not null]
  subscription_id text
  status text [not null]
  plan text [not null]
  price_id text
  current_period_end integer
  cancel_at_period_end integer [not null]
  lifetime integer [not null]
  lifetime_payment_intent_id text
  payment_failed_at integer
  last_event_at integer
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (customer_id) [name: 'subscription_customer_id_idx']
  }
}

Table processed_webhook_events {
  event_id text [pk, not null]
  processed_at integer [not null]
  status text [not null, note: '\'pending\' = 已认领未落库（apply 中/曾中途死掉）；\'done\' = 已应用。D1 无跨语句事务， 认领与落库间的宕机窗口靠「陈旧 pending 可被重试接管」闭合（见 handleWebhook）。']
}

Table waitlist {
  id text [pk, not null]
  email text [not null, unique]
  locale text [not null]
  source text [not null]
  created_at integer [not null]
}

Table sponsorship {
  id text [pk, not null]
  email text
  github text
  message text
  amount integer [not null]
  currency text [not null]
  amount_usd integer [note: 'USD cents frozen at checkout. Wall tiers sum this — summing mixed currencies reads HK$78 as $78 (see currency.ts). null = row predates the column (USD-only era).']
  mode text [not null]
  stripe_session_id text [not null, unique]
  stripe_subscription_id text
  stripe_payment_intent_id text
  status text [not null]
  hidden integer [not null]
  created_at integer [not null]
  indexes {
    (stripe_subscription_id) [name: 'sponsorship_subscription_id_idx']
    (stripe_payment_intent_id) [name: 'sponsorship_payment_intent_id_idx']
  }
}

Table feedback {
  id text [pk, not null]
  user_id text [not null]
  title text [not null]
  body text [not null]
  status text [not null]
  admin_note text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (user_id) [name: 'feedback_userId_idx']
  }
}

Ref session_user_id_user_id_fk: session.user_id > user.id [delete: cascade]

Ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade]

Ref subscription_user_id_user_id_fk: subscription.user_id - user.id [delete: cascade]

Ref feedback_user_id_user_id_fk: feedback.user_id > user.id [delete: cascade]