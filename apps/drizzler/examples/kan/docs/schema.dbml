Ref card_activity_commentId_card_comments_id_fk: card_activity.commentId > card_comments.id [delete: cascade]

Ref card_activity_sourceBoardId_board_id_fk: card_activity.sourceBoardId > board.id [delete: set null]

Ref card_activity_attachmentId_card_attachment_id_fk: card_activity.attachmentId > card_attachment.id [delete: cascade]

Ref _card_labels_cardId_card_id_fk: _card_labels.cardId > card.id [delete: cascade]

Ref _card_labels_labelId_label_id_fk: _card_labels.labelId > label.id [delete: cascade]

Ref _card_workspace_members_cardId_card_id_fk: _card_workspace_members.cardId > card.id [delete: cascade]

Ref _card_workspace_members_workspaceMemberId_workspace_members_id_fk: _card_workspace_members.workspaceMemberId > workspace_members.id [delete: cascade]

Ref card_comments_cardId_card_id_fk: card_comments.cardId > card.id [delete: cascade]

Ref card_comments_createdBy_user_id_fk: card_comments.createdBy > user.id [delete: set null]

Ref card_comments_deletedBy_user_id_fk: card_comments.deletedBy > user.id [delete: set null]

Ref card_attachment_cardId_card_id_fk: card_attachment.cardId > card.id [delete: cascade]

Ref card_attachment_createdBy_user_id_fk: card_attachment.createdBy > user.id [delete: set null]

Ref card_checklist_cardId_card_id_fk: card_checklist.cardId > card.id [delete: cascade]

Ref card_checklist_createdBy_user_id_fk: card_checklist.createdBy > user.id [delete: set null]

Ref card_checklist_deletedBy_user_id_fk: card_checklist.deletedBy > user.id [delete: set null]

Ref card_checklist_item_checklistId_card_checklist_id_fk: card_checklist_item.checklistId > card_checklist.id [delete: cascade]

Ref card_checklist_item_createdBy_user_id_fk: card_checklist_item.createdBy > user.id [delete: set null]

Ref card_checklist_item_deletedBy_user_id_fk: card_checklist_item.deletedBy > user.id [delete: set null]

Ref feedback_createdBy_user_id_fk: feedback.createdBy > user.id [delete: set null]

Ref import_createdBy_user_id_fk: import.createdBy > user.id [delete: set null]

