Ref card_activity_toListId_list_id_fk: card_activity.toListId > list.id [delete: cascade]

Ref card_activity_labelId_label_id_fk: card_activity.labelId > label.id [delete: cascade]

Ref card_activity_workspaceMemberId_workspace_members_id_fk: card_activity.workspaceMemberId > workspace_members.id [delete: set null]

