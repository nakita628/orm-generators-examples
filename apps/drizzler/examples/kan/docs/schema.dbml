Ref notification_cardId_card_id_fk: notification.cardId > card.id [delete: cascade]

Ref notification_commentId_card_comments_id_fk: notification.commentId > card_comments.id [delete: cascade]

Ref notification_workspaceId_workspace_id_fk: notification.workspaceId > workspace.id [delete: cascade]

Ref workspace_roles_workspaceId_workspace_id_fk: workspace_roles.workspaceId > workspace.id [delete: cascade]

