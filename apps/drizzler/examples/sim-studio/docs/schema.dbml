    (archived_at) [name: 'workflow_schedule_archived_at_partial_idx']
    (source_workspace_id, source_type, archived_at, status) [name: 'idx_workflow_schedule_on_source_workspace_id_source_t_c07f3bba6']
    (next_run_at, last_queued_at, deployment_version_id, workflow_id) [name: 'workflow_schedule_due_workflow_idx']
    (next_run_at, last_queued_at) [name: 'workflow_schedule_due_job_idx']
  }
}

Table job_execution_logs {
