  metadata jsonb [not null]
  chunk_text_tsv tsvector
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (source_document) [name: 'docs_emb_source_document_idx']
    (header_level) [name: 'docs_emb_header_level_idx']
    (source_document, header_level) [name: 'docs_emb_source_header_idx']
    (embedding_model) [name: 'docs_emb_model_idx']
    (created_at) [name: 'docs_emb_created_at_idx']
    (embedding) [type: hnsw, name: 'docs_embedding_vector_hnsw_idx']
    (metadata) [type: gin, name: 'docs_emb_metadata_gin_idx']
    (chunk_text_tsv) [type: gin, name: 'docs_emb_chunk_text_fts_idx']
  }
}

