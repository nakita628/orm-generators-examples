  conversation_id text
  external_conversation_key text [note: 'Stable provider conversation identity; only trusted ingress can bind it to this private chat.']
  external_conversation_metadata jsonb
  preview_yaml text
  config jsonb
  resources jsonb [not null]
  auto_allowed_tools jsonb [not null, note: 'Copilot tool ids the user allowed for the rest of this chat only, as opposed to the account-wide list on `settings.copilotAutoAllowedTools`.']
  last_seen_at timestamp
