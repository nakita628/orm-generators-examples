Table permission_group {
  id text [pk, not null]
  organization_id text [not null]
  name text [not null]
  description text
  config jsonb [not null]
  created_by text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  is_default boolean [not null]
  membership_mode text [not null, note: 'How an empty non-default group behaves. `inherit` (the default, and every pre-existing group) keeps the member invariant above: no member rows means the group governs every member of its workspaces. `explicit` means the group governs exactly its member rows and therefore governs nobody when empty. Directory-managed groups must be `explicit`. Under `inherit`, an identity provider removing the last member would silently widen the group from "these three people" to "everyone in these workspaces" — the opposite of what the administrator asked for.']
  indexes {
    (created_by) [name: 'permission_group_created_by_idx']
    (organization_id, name) [unique, name: 'permission_group_organization_name_unique']
    (organization_id) [unique, name: 'permission_group_organization_default_unique']
  }
  Note: 'A named set of access-control restrictions (`config`) governing users within an organization. Scope invariant: the organization\'s single default group (`isDefault`) is org-wide and governs everyone not covered by another group. Every non-default group targets specific workspaces (rows in `permission_group_workspace`), and a non-default group with no rows governs nothing. Being org-wide is definitionally `isDefault` — there is no separate flag. Enforced by the API contracts/routes. Member invariant: a non-default group with no `permission_group_member` rows governs every member of its workspaces (including external members); adding members narrows it to only those users. The default group ignores membership.'
}

Table permission_group_workspace {
  id text [pk, not null]
  permission_group_id text [not null]
  workspace_id text [not null]
  organization_id text [not null]
  created_at timestamp [not null]
  indexes {
    (workspace_id) [name: 'permission_group_workspace_workspace_id_idx']
    (permission_group_id, workspace_id) [unique, name: 'permission_group_workspace_group_workspace_unique']
  }
  Note: 'Workspaces a non-default `permission_group` targets. Rows are absent for the organization-wide default group; a non-default group with zero rows governs no workspace.'
}

Table permission_group_member {
  id text [pk, not null]
  permission_group_id text [not null]
  organization_id text [not null]
  user_id text [not null]
  assigned_by text
  assigned_at timestamp [not null]
  indexes {
    (permission_group_id, user_id) [unique, name: 'permission_group_member_group_user_unique']
    (organization_id, user_id) [name: 'permission_group_member_organization_user_idx']
  }
  Note: 'Explicit members of a `permission_group`. Membership narrows a non-default group to only these users; a non-default group with no rows here governs every member of its workspaces (including external members). The default group ignores these rows.'
}

Table resource_policy {
  id text [pk, not null]
  workspace_id text
  organization_id text
  resource_type text [not null]
  resource_id text [not null]
  revision integer [not null]
  document jsonb [not null]
  created_by text
  updated_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [name: 'resource_policy_organization_id_idx']
    (resource_type, resource_id) [unique, name: 'resource_policy_resource_unique']
    (workspace_id) [name: 'resource_policy_workspace_id_idx']
  }
  Note: 'Versioned statement policy attached to one canonical workspace or organization resource.'
}

Table async_jobs {
  id text [pk, not null]
  type text [not null]
  payload jsonb [not null]
  status text [not null]
  created_at timestamp [not null]
  started_at timestamp
  completed_at timestamp
  run_at timestamp
  attempts integer [not null]
  max_attempts integer [not null]
  error text
  output jsonb
  metadata jsonb [not null]
  updated_at timestamp [not null]
  indexes {
    (status, started_at) [name: 'async_jobs_status_started_at_idx']
    (status, completed_at) [name: 'async_jobs_status_completed_at_idx']
    (run_at, created_at, id) [name: 'async_jobs_schedule_pending_run_at_idx']
    (started_at, id) [name: 'async_jobs_schedule_processing_started_at_idx']
    (updated_at, id) [name: 'async_jobs_schedule_unreconciled_terminal_idx']
  }
  Note: 'Async Jobs - Queue for background job processing (Redis/DB backends) Used when trigger.dev is not available for async workflow executions'
}

Table knowledge_connector {
  id text [pk, not null]
  knowledge_base_id text [not null]
  connector_type text [not null]
  credential_id text [note: 'The credential used to index content. In members mode it is optional: NULL indexes the union of members\' listings; a dedicated credential indexes content while members only establish document visibility. Not yet a foreign key: rows written before the `credential` table existed may still hold a raw `account.id`, which script migration 0011 remaps. contract-pending(after 0011 has run in production): add the reference to `credential.id` with ON DELETE SET NULL and remove the raw account-id fallback in lib/oauth/credential-service.ts.']
  encrypted_api_key text
  source_config json [not null]
  sync_mode text [not null]
  sync_interval_minutes integer [not null]
  access_mode text [not null, note: 'How document access is derived. `workspace`: every synced document is `{ws}`. `members`: a document\'s ACL is the members whose own listing returned it, optionally with a dedicated credential for content. `admin`: source permissions and identity groups are mirrored independently of content changes.']
  credential_group_id text [note: 'Members mode: the credential group whose option supplies the member credentials.']
  credential_group_option_id text [note: 'Members mode: the option within the group; must map to this connector\'s provider.']
  member_sync_status text [not null, note: 'Members-mode run state. Mirrors `status` for the content engine but is independent of it: the two engines never run for the same connector (`kc_sync_lock_exclusive_check`), yet share no columns so neither can misread the other\'s lease.']
  member_sync_lock_token text
  member_sync_lock_lease_at timestamp
  next_member_sync_at timestamp [note: 'Millisecond precision: the scheduler round-trips this through a JavaScript `Date` and claims the run by equality, so stored microseconds from a SQL writer could never be matched back. Any column compared that way has to stay within what a `Date` can carry.']
  last_member_sync_at timestamp
  last_member_sync_error text
  member_sync_consecutive_failures integer [not null]
  access_rewrite_pending boolean [not null, note: 'Set by a mode switch whose ACL rewrite exceeded the request budget; the member-sync job finishes the rewrite before the mode takes effect.']
  image_removal_pending boolean [not null, note: 'Set when a settings change stops indexing images the connector already indexed; the next sync removes them and clears it.']
  member_tombstone_cursor jsonb [note: 'Where the members-mode absence reconcile resumes: the external id of the last live document it checked, in `doc_connector_external_id_idx` order. NULL starts a new pass from the beginning.']
  member_resurrection_cursor text [note: 'Where the members-mode resurrection walk resumes: the last document id it covered. NULL starts a new walk from the connector\'s first document.']
  status text [not null, note: 'One of `active`, `pending`, `syncing`, `error`, `paused`, `disabled`. `pending` and `syncing` are the two halves of a sync in flight: `pending` is written as the sync is handed to the queue, `syncing` when a worker takes the lock. The split exists because the queue depth between them is unbounded — without `pending` the row is indistinguishable from idle for as long as the hand-off takes, which is what forced readers to guess from `created_at`. A row left `pending` past the lock TTL is reclaimed by the scheduler, which is the only thing that ever observes a lost hand-off.']
  last_sync_at timestamp
  last_sync_error text
  last_sync_doc_count integer
  listing_checkpoint jsonb [note: 'Durable content-listing progress; contains cursors and counters, never credentials.']
  directory_checkpoint jsonb [note: 'Member account enumeration resumes independently of the content listing.']
  next_sync_at timestamp [note: 'Millisecond precision for the same round-trip reason as `next_member_sync_at`.']
  next_directory_sync_at timestamp [not null]
  consecutive_failures integer [not null]
  sync_lock_token text [note: 'Identifies the sync run that currently holds this connector\'s lock. `status = \'syncing\'` only says *a* run holds it. After the scheduler reclaims a stale lock and dispatches a replacement, the original run would still see `syncing` and overwrite the replacement\'s state. Terminal writes match this token so a run can prove the lock is still *its own*.']
  sync_lock_lease_at timestamp [note: 'When the run holding this connector\'s lock last proved it was alive. Split off `updated_at`, which the stale-lock reaper used to read as a lease. `updated_at` is the row\'s modification time, so every unrelated write — a config edit, a status change — renewed the lease of a wedged run and pushed its recovery out by another full TTL. Only lock acquisition and the heartbeat write this column; both terminal helpers clear it alongside `sync_lock_token`. NULL on a row locked before this column existed, and on any future writer that forgets it, so every reader compares `COALESCE(lease, updated_at)` rather than the lease alone — a `lease <= cutoff` test is NULL-false and would make such a row permanently unreclaimable.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  archived_at timestamp
  deleted_at timestamp
  detached_at timestamp [note: 'Set when the connector is removed but its documents are kept. The connector stops syncing and leaves every management surface at once, while its documents stay readable; a background job releases them as standalone entries in bounded pages and then deletes the row. Releasing a document rewrites every search projection row of it, so the release cannot run inside the removal request.']
  detach_reserved_bytes bigint [not null, note: 'Storage admitted and charged when the connector was detached but not yet matched by a released document. Each released page consumes its bytes; whatever remains when the row is deleted, such as a document deleted before its release, is settled then. Billing recomputations count it alongside standalone documents, since the workspace ledger already includes it.']
  indexes {
    (knowledge_base_id) [name: 'kc_knowledge_base_id_idx']
    (status, next_sync_at) [name: 'kc_status_next_sync_idx']
    (archived_at) [name: 'kc_archived_at_partial_idx']
    (deleted_at) [name: 'kc_deleted_at_partial_idx']
    (member_sync_status, next_member_sync_at) [name: 'kc_member_sync_due_idx']
    (next_directory_sync_at, id) [name: 'kc_directory_sync_due_idx']
  }
  Note: 'Knowledge Connector - persistent link to an external source (Confluence, Google Drive, etc.) that syncs documents into a knowledge base.'
}

Table knowledge_connector_partition {
  connector_id text [not null]
  partition_key text [not null]
  generation_id text [not null]
  context jsonb [not null]
  cursor text
  status text [not null]
  attempts integer [not null]
  retry_at timestamp [not null]
  last_served_at timestamp
  failure jsonb
  permission_cursor text
  permission_attempts integer [not null]
  permission_retry_at timestamp [not null]
  permission_last_served_at timestamp
  permission_started_at timestamp
  permission_failure jsonb
  indexes {
    (connector_id, partition_key) [pk]
    (connector_id, generation_id, status, retry_at, last_served_at) [name: 'kcp_content_due_idx']
    (connector_id, generation_id, permission_retry_at, permission_last_served_at) [name: 'kcp_permission_due_idx']
  }
  Note: 'Bounded provider partitions, committed atomically with their owning connector listing checkpoint.'
}

Table knowledge_connector_permission_snapshot {
  connector_id text [pk, not null]
  revision integer [not null]
  metadata jsonb [not null]
  payload jsonb [not null]
  Note: 'Private provider configuration; metadata reads never materialize the larger normalized payload.'
}

Table knowledge_connector_permission_grant {
  connector_id text [not null]
  group_key text [not null]
  subject_token text [not null]
  indexes {
    (connector_id, group_key, subject_token) [pk]
    (subject_token, connector_id, group_key) [name: 'kcpg_subject_idx']
  }
  Note: 'Administrator-managed connector groups; provider directory crawls never write these grants.'
}

Table knowledge_connector_member {
  id text [pk, not null]
  workspace_id text
  organization_id text
  connector_id text [not null]
  credential_id text [not null]
  subject_token text [not null, note: 'Snapshot of the member\'s identity token, derived from the credential row by `lib/knowledge/access/tokens.ts`. Reconciliation rewrites it and rematerialises the member\'s documents if the credential\'s subject changes.']
  status text [not null, note: '`active`, `suspended`, or `disabled`.']
  consecutive_failures integer [not null]
  next_attempt_at timestamp [note: 'When the member is next due. NULL means "with the connector\'s next run": a member that completed on a manual-only connector. A new member is due now. An explicit time that has passed is what keeps a connector re-dispatching itself.']
  last_started_at timestamp
  last_complete_listing_at timestamp [note: 'Last listing that was full, complete, and not suspect — the only kind that may remove observations.']
  last_listed_count integer
  last_error text
  member_synced_through timestamp [note: 'Authorization watermark: complete nonsuspect full listing or completely drained change feed.']
  scope_renewed_at timestamp [note: 'When every observation under the containers the source still grants this member was last renewed, for connectors that grant access per container; NULL until the first renewal completes.']
  scope_renewal_cursor text [note: 'Where an unfinished scope renewal resumes in the source\'s container listing, and when that renewal pass began; both NULL when no pass is in progress.']
  scope_renewal_started_at timestamp
  change_cursor text [note: 'Where the member\'s change feed resumes. Opened just before a full listing and stored once that listing lands, so every later run reads the feed instead of relisting; NULL when the connector has no feed or the feed has to be reopened.']
  listing_checkpoint jsonb [note: 'Durable full-listing progress, separate from the provider\'s incremental change token.']
  suspended_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [name: 'kcm_organization_id_idx']
    (connector_id, credential_id) [unique, name: 'kcm_connector_credential_unique']
    (connector_id, next_attempt_at, last_started_at) [name: 'kcm_connector_queue_idx']
    (credential_id) [name: 'kcm_credential_idx']
  }
  Note: 'One row per (members-mode connector, member credential). Membership is derived from the credential-group option on every run: `active` while the managed credential is usable and the enrollment live, `suspended` otherwise (needs re-auth, enrollment revoked, option disabled). Suspension drops the member\'s token from every ACL immediately but keeps their observations, so a routine scope-version bump never wipes the observation graph. A row is deleted only when the credential row is gone (cascade), the option no longer references it, or it has stayed suspended past the purge window.'
}

Table knowledge_document_observation {
  document_id text [not null]
  member_id text [not null]
  last_seen_at timestamp [not null]
  run_id text [not null, note: 'Member-sync run (`knowledge_connector_member_sync_log.id`) that last asserted this observation.']
  indexes {
    (document_id, member_id) [pk]
    (member_id) [name: 'kdo_member_idx']
  }
  Note: '"Member M\'s crawl returned document D." A members-mode document\'s ACL is exactly the subject tokens of its active observers; a document with no observation of any status is tombstoned and, after the purge window, hard deleted.'
}

Table knowledge_external_directory {
  workspace_id text
  organization_id text
  provider_id text [not null]
  tenant_id text [not null]
  sync_lock_token text
  sync_lock_lease_at timestamp
  last_started_at timestamp [note: 'A newer attempt invalidates cached completion until that whole pass succeeds.']
  last_complete_sync_at timestamp [note: 'Complete directory enumeration, including empty directories; independent of individual group freshness.']
  indexes {
    (workspace_id, provider_id, tenant_id) [unique, name: 'ked_workspace_identity_unique']
    (organization_id, provider_id, tenant_id) [unique, name: 'ked_organization_identity_unique']
  }
  Note: 'Shared refresh ownership and complete-pass evidence for a workspace/provider/tenant directory.'
}

Table knowledge_external_group {
  id text [pk, not null]
  workspace_id text
  organization_id text
  provider_id text [not null, note: 'Matches the provider segment of the `g:` token, e.g. `google-drive`.']
  tenant_id text [not null, note: 'The directory this group belongs to: a Workspace domain for Google, a site\'s cloud id for Confluence.']
  external_group_id text [not null]
  last_synced_at timestamp [note: 'When this group\'s membership was last enumerated in full, and the only thing that decides whether it still grants access. A failed or partial enumeration writes nothing at all — not the membership, not this column — which is what makes a transient directory outage harmless. It is also why the column has to exist: without an age bound, a group whose sync stopped running would keep granting forever from membership nobody has checked since. A group unconfirmed for longer than `EXTERNAL_GROUP_STALE_AFTER_MS` grants nothing.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id, provider_id, tenant_id, external_group_id) [unique, name: 'keg_organization_identity_unique']
    (organization_id, last_synced_at) [name: 'keg_organization_synced_idx']
    (workspace_id, provider_id, tenant_id, external_group_id) [unique, name: 'keg_identity_unique']
    (workspace_id, last_synced_at) [name: 'keg_workspace_synced_idx']
  }
  Note: 'A group in an external directory, as an admin-mode crawl names it. Scoped by workspace, provider and tenant rather than by connector: two Drive connectors over the same Google Workspace domain grant the same groups, and resolving that domain\'s directory once per connector would multiply the Admin SDK traffic by the number of knowledge bases. `externalGroupId` is whatever the source\'s permissions API names a group by — a group email in Drive, a group id in Confluence — canonicalised by `canonicalGroupId`, exactly as `groupToken` spells it. Keying the directory by the same identifier the grant carries is what lets a token resolve to membership with no lookup in between.'
}

Table knowledge_external_group_member {
  group_id text [not null]
  subject_token text [not null, note: 'Includes `u:*@<domain>` for directory-wide grants; source account IDs retain their case.']
  created_at timestamp [not null]
  indexes {
    (group_id, subject_token) [pk]
    (subject_token) [name: 'kegm_subject_token_idx']
  }
  Note: 'External group membership keyed by canonical identity tokens: verified addresses (`u:`) or provider account identities (`s:`). Provider identities preserve permissions when a directory hides email addresses. Confluence space audiences may also reference native groups, whose members remain identities.'
}

Table knowledge_connector_member_sync_log {
  id text [pk, not null]
  connector_id text [not null]
  status text [not null, note: '`started`, `partial`, `completed`, or `failed`.']
  started_at timestamp [not null]
  completed_at timestamp
  members_claimed integer [not null]
  members_completed integer [not null]
  members_incomplete integer [not null]
  members_failed integer [not null]
  docs_failed integer [note: 'Null on historical runs that did not record document failure counts.']
  processing_dispatch_failed integer
  docs_listed integer [not null]
  docs_added integer [not null]
  docs_updated integer [not null]
  docs_unchanged integer [not null]
  docs_hydrated_once integer [not null]
  observations_added integer [not null]
  observations_renewed integer [not null, note: 'Observations kept fresh by per-container renewal rather than relisting.']
  observations_removed integer [not null]
  docs_tombstoned integer [not null]
  docs_resurrected integer [not null]
  docs_purged integer [not null]
  credentials_audited integer [not null]
  error_message text
  database_failure_class text [note: 'The transient database failure class (`capacity`, `conflict`, or `connection`) that failed the run; null on every other outcome and on runs logged before it was recorded. Only these runs count toward the database retry streak.']
  indexes {
    (connector_id) [name: 'kcmsl_connector_started_at_idx']
    (started_at) [name: 'kcmsl_started_at_partial_idx']
  }
  Note: 'Audit trail for members-mode runs; the content sync log is untouched. The row id doubles as the run\'s lease token so the scheduler can tell an orphaned `started` row from one a live run still holds.'
}

Table knowledge_connector_sync_log {
  id text [pk, not null]
  connector_id text [not null]
  status text [not null]
  started_at timestamp [not null]
  completed_at timestamp
  docs_added integer [not null]
  docs_updated integer [not null]
  docs_deleted integer [not null]
  docs_unchanged integer [not null]
  docs_skipped integer [not null]
  docs_failed integer [not null]
  listed_count integer [note: 'Complete listing-cycle size; per-worker counters may cover only its last page batch.']
  error_message text
  database_failure_class text [note: 'The transient database failure class (`capacity`, `conflict`, or `connection`) that failed the run; null on every other outcome and on runs logged before it was recorded. Only these runs count toward the database retry streak.']
  indexes {
    (connector_id) [name: 'kcsl_connector_started_at_idx']
    (started_at) [name: 'kcsl_started_at_partial_idx']
    (started_at) [name: 'kcsl_terminal_started_at_idx']
  }
  Note: 'Knowledge Connector Sync Log - audit trail for connector sync operations.'
}

Table user_table_definitions {
  id text [pk, not null]
  workspace_id text [not null]
  folder_id text
  name text [not null]
  description text
  schema jsonb [not null, note: 'Stores the table schema definition. Example: { columns: [{ name: string, type: string, required: boolean }] }']
  metadata jsonb [note: 'Stores UI-specific metadata separate from the data schema. Example: { columnWidths: { name: 200, age: 100 } }']
  max_rows integer [not null]
  row_count integer [not null]
  rows_version bigint [not null, note: 'Folded part of a monotonic counter: the triggers on `user_table_rows` log one `user_table_row_changes` row per INSERT/DELETE statement, and one per transaction when an UPDATE changes `data` or `order_key`; the fold adds their count here. Keys the versioned table-snapshot cache so a stored CSV under `v{rows_version}` is reused until the table mutates. Never written from application code — the fold is the only writer. Read the live value through `lib/table/row-changes.ts`, never this column alone.']
  schema_locked boolean [not null, note: 'Per-table mutation locks. Each guards one mutation verb; an admin toggles them independently. Enforced at the `lib/table` service layer (see `lib/table/mutation-locks.ts`), which covers every entry point — routes, workflow blocks, and Mothership — since all funnel through those helpers. A locked verb rejects with 423; toggling a lock requires workspace admin. Append-only = update + delete locked; read-only = all four locked. These are integrity controls (against accidental/agentic mutation), not confidentiality controls — reads and exports are never blocked.']
  insert_locked boolean [not null]
  update_locked boolean [not null]
  delete_locked boolean [not null]
  archived_at timestamp
  created_by text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id) [name: 'user_table_def_workspace_id_idx']
    (folder_id) [name: 'user_table_def_folder_id_idx']
    (created_by) [name: 'user_table_def_created_by_idx']
    (workspace_id, name) [unique, name: 'user_table_def_workspace_name_unique']
    (archived_at) [name: 'user_table_def_archived_at_idx']
    (workspace_id, archived_at) [name: 'user_table_def_workspace_archived_partial_idx']
  }
  Note: 'User-defined table definitions Stores schema and metadata for custom tables created by users'
}

Table user_table_rows {
  id text [pk, not null]
  table_id text [not null, note: 'The foreign key is `DEFERRABLE INITIALLY DEFERRED` (the `table_rows_version_at_commit` migration), so a row updated twice in one transaction does not key-share the definition row mid-transaction. drizzle can\'t express deferrability, so it lives only in the migration.']
  workspace_id text [not null]
  data jsonb [not null]
  position integer [not null]
  order_key text [note: 'Fractional order key (base-62 string) — the authoritative row order. Nullable during the backfill window. Ordered with `id` as a deterministic tiebreaker. Stored with `COLLATE "C"` (migration 0228) so Postgres compares it bytewise, matching the fractional-indexing library\'s ASCII ordering. drizzle can\'t express column collation, so the collation lives only in the migration.']
  secret_provenance_version integer
  created_at timestamp [not null]
  updated_at timestamp [not null]
  created_by text
  indexes {
    (created_by) [name: 'user_table_rows_created_by_idx']
    `data jsonb_path_ops` [type: gin, name: 'user_table_rows_tenant_data_gin_idx']
    (workspace_id, table_id) [name: 'user_table_rows_workspace_table_idx']
    (table_id, position) [name: 'user_table_rows_table_position_idx']
    (table_id, order_key, id) [name: 'user_table_rows_table_order_key_idx']
    (table_id, created_at, id) [name: 'user_table_rows_table_created_id_idx']
    (table_id, id) [name: 'user_table_rows_table_id_id_idx']
  }
  Note: 'User-defined table rows Stores actual row data as JSONB for flexible schema'
}

Table user_table_row_changes {
  id bigint [pk, increment, not null]
  table_id text [not null]
  row_delta integer [not null, note: '`+n` for an insert, `-n` for a delete, `0` for an update of row content or order.']
  indexes {
    (table_id) [name: 'user_table_row_changes_table_id_idx']
  }
  Note: 'Append-only log of row mutations not yet folded into `user_table_definitions`. A table\'s current `row_count` is the stored count plus the sum of its `row_delta`s, and its current `rows_version` is the stored version plus its number of log rows, read in one statement (see `lib/table/row-changes.ts`). Writers only insert here, so no row write waits on the shared definition row; a background fold moves each table\'s rows into the definition row and deletes them in one transaction.'
}

Table user_table_row_secret_provenance {
  row_id text [pk, not null]
  content_updated_at timestamp [not null]
  status text [not null]
  entries jsonb [not null]
  updated_at timestamp [not null]
  Note: 'Encrypted secret provenance for a table row\'s current JSONB payload. The sidecar is bound to `user_table_rows.updated_at`; a missing or stale sidecar on a tracked row is treated as unknown at model re-entry.'
}

Table table_views {
  id text [pk, not null]
  table_id text [not null]
  workspace_id text [not null]
  name text [not null]
  config jsonb [not null, note: '`TableViewConfig` — `{ filter, sort, hiddenColumns, columnOrder, columnWidths, pinnedColumns }`. Every column reference is keyed by stable column id, so a rename never touches a saved view; ids of deleted columns are pruned on read.']
  is_default boolean [not null]
  created_by text [note: 'Nullable with `set null` rather than the `cascade` used for table ownership: a view is workspace-shared, so it must outlive the member who created it.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (table_id, created_at) [name: 'table_views_table_created_idx']
    (workspace_id, created_at, id) [name: 'table_views_workspace_created_idx']
    (table_id) [unique, name: 'table_views_table_default_unique']
  }
  Note: 'Saved views for a user-defined table — a named filter + sort + column layout. Workspace-shared: anyone who can read the table sees every view, and `write` is required to create, update, or delete one. New tables are seeded with one default view; legacy tables without one temporarily retain the built-in "All" fallback. A dedicated table rather than a key on `user_table_definitions.metadata`: that column is written read-modify-write with a shallow merge, so a stale snapshot from any concurrent column resize would silently drop a view saved in between. Per-view rows make each save an independent insert.'
}

Table table_jobs {
  id text [pk, not null]
  table_id text [not null]
  workspace_id text [not null]
  type text [not null, note: '`\'import\'` | `\'delete\'`.']
  status text [not null, note: '`\'running\'` → `\'ready\'` | `\'failed\'` | `\'canceled\'`.']
  payload jsonb [note: 'Type-specific descriptor (e.g. delete filter/exclusions). Nullable; reserved for future resumability — today\'s workers carry their payload in-process via `runDetached`.']
  rows_processed integer [not null]
  error text
  started_at timestamp [not null]
  updated_at timestamp [not null]
  completed_at timestamp
  indexes {
    (table_id) [unique, name: 'table_jobs_one_active_per_table']
    (status, updated_at) [name: 'table_jobs_watchdog_idx']
    (table_id, started_at) [name: 'table_jobs_table_started_idx']
  }
  Note: 'Background data-mutation jobs on a user table (CSV import, bulk filtered delete). One row per job. A detached worker streams progress into `rows_processed` and flips `status` to a terminal state; cancel flips `status` to `\'canceled\'` and the worker bails at its next ownership check. The partial-unique index on `table_id WHERE status = \'running\'` is the concurrency gate: at most one running job per table, so a second import, or an import + delete, can\'t write into the same table at once. Distinct from `table_run_dispatches` — that fans workflow runs across rows via trigger.dev; this mutates row data directly.'
}

Table table_row_executions {
  table_id text [not null]
  row_id text [not null]
  group_id text [not null]
  status text [not null]
  execution_id text
  job_id text
  workflow_id text [not null]
  error text
  running_block_ids text [not null]
  block_errors jsonb [not null]
  cancelled_at timestamp
  capability_governed_user_id text [note: 'Person whose permission group gates this cell\'s tools, persisted with the dispatcher\'s `pending` pre-stamp. The stamp and the worker that runs it are not the same run: a cell task that finds the row\'s cascade lock held bails, and the lock owner drains the marker itself. That owner belongs to whatever dispatch queued IT, so without the subject on the marker the drained cell would run under the wrong person\'s group — or under none, when the owner is an actorless auto-fire. Read only while the marker is unclaimed (`pending` with a null `execution_id`); later writes on the same cell carry no subject and null it, which is why nothing reads it after pickup. `ON DELETE SET NULL`, matching `table_run_dispatches`: a deleted person\'s runs are stopped by that table\'s cancel, not held open by this reference.']
  enrichment_details jsonb [note: 'Enrichment cascade breakdown (provider outcomes, cost, timing) for `enrichment`-type groups. Null for workflow groups and pre-feature runs. Deliberately excluded from the hot grid read (`loadExecutionsByRow`) — read on demand for the enrichment details panel.']
  updated_at timestamp [not null]
  indexes {
    (row_id, group_id) [pk]
    (table_id, status) [name: 'table_row_executions_table_status_idx']
    (execution_id) [name: 'table_row_executions_execution_id_idx']
    (table_id, group_id) [name: 'table_row_executions_table_group_idx']
  }
  Note: 'Per-row workflow-group execution state. One row per (rowId, groupId) — the group\'s run metadata (status, executionId, jobId, blockErrors, etc.) for one row of one user-defined table. Lives in a sidecar table (not a JSONB column on `user_table_rows`) so the dispatcher and "X running" counter can hit `(table_id, status)` and `(table_id, group_id)` indexes directly instead of walking JSONB blobs, and so each cell-write rewrites only its own row instead of the whole executions object on the parent row tuple.'
}

Table table_run_dispatches {
  id text [pk, not null]
  table_id text [not null]
  workspace_id text [not null]
  request_id text [not null]
  mode text [not null, note: '`\'all\'` re-runs completed cells; `\'incomplete\'` skips them.']
  scope jsonb [not null, note: '`{ groupIds: string[], rowIds?: string[] }` — the run\'s scope.']
  status text [not null, note: '`pending` → `dispatching` → `complete` | `cancelled`.']
  cursor integer [not null, note: 'Highest `user_table_rows.position` we\'ve already enqueued cells for.']
  limit jsonb [note: 'Optional cap on how much work the dispatch does before completing. `{ type: \'rows\', max: number }` today; the discriminated shape lets future caps (cells, cost, duration) extend without a schema change. Null = unbounded (process every row in scope).']
  processed_count integer [not null, note: 'Units of `limit.type` already consumed (eligible rows dispatched, for `type: \'rows\'`). Mutable counter the dispatcher advances per window so the budget survives across the checkpointed waits between windows.']
  is_manual_run boolean [not null, note: 'When true, eligibility bypasses `autoRun: false` skip and treats terminal states as re-runnable. Auto-fire paths (row inserts, CSV import, addWorkflowGroup) set this to false so the dispatch honors the autoRun toggle.']
  triggered_by_user_id text [note: 'User who triggered the run, for per-member usage attribution. Null for auto-fire (row insert/update, CSV import) with no human initiator — those fall back to the workspace billed account.']
  capability_governed_user_id text [note: 'The person whose permission group governs what this run\'s cells may do. Distinct from `triggered_by_user_id`, which is an *attribution* and substitutes the workspace billed account when the credential names no human — right for a meter, wrong for a gate, since it would run a bystander\'s tool denylist against an actorless request. Null when the run has no acting person (workspace API key, schedule, auto-fire), which means no per-tool gate applies. Producers set it explicitly, `null` included: it is required on every dispatch input precisely so a new one cannot inherit the attribution by omission. `set null` on delete, paired with a cancel of this account\'s non-terminal dispatches inside `deleteUserAccount`. Nulling alone would be a silent un-gate — the worker cannot tell a subject erased by deletion from one that was never there — and `restrict` would block account deletion behind background work. Going terminal first makes the nulled row unreachable.']
  requested_at timestamp [not null]
  heartbeat_at timestamp [note: 'Last time the dispatcher loop made progress on this dispatch. Stamped by the same per-window writes that advance `cursor` and `processed_count`, so it means "a holder is alive" rather than "this started a while ago" — the distinction the cleanup sweep needs, since `requested_at` never moves and a legitimately long dispatch would otherwise be reclaimed under a live holder. Null on rows written before this column existed; the sweep reads `COALESCE(heartbeat_at, requested_at)` so those stay reclaimable.']
  completed_at timestamp
  cancelled_at timestamp
  indexes {
    (table_id, status) [name: 'table_run_dispatches_active_idx']
    (status, requested_at) [name: 'table_run_dispatches_watchdog_idx']
    (capability_governed_user_id, status) [name: 'table_run_dispatches_governed_active_idx']
  }
  Note: 'One row per "Run column / Run row / Run all rows" gesture on a user table. The dispatcher task walks the table in row-position windows, advancing `cursor` as it enqueues cells into trigger.dev. Cancel flips `status` to `\'cancelled\'` in one write; the dispatcher bails at the next iteration and a bulk-SQL cell-cancel sweep neuters anything still in trigger.dev\'s queue (workers no-op on pickup via the cancel-sticky guard).'
}

Table mothership_inbox_allowed_sender {
  id text [pk, not null]
  workspace_id text [not null]
  email text [not null]
  label text
  added_by text [not null]
  created_at timestamp [not null]
  indexes {
    (workspace_id, email) [unique, name: 'inbox_sender_ws_email_idx']
  }
}

Table mothership_inbox_task {
  id text [pk, not null]
  workspace_id text [not null]
  from_email text [not null]
  sender_authenticated boolean [not null, note: 'Whether the receiving provider authenticated `fromEmail`\'s domain (SPF, DKIM, or DMARC).']
  from_name text
  subject text [not null]
  body_preview text
  body_text text
  body_html text
  email_message_id text
  in_reply_to text
  response_message_id text
  agentmail_message_id text
  status text [not null]
  chat_id uuid
  trigger_job_id text
  result_summary text
  error_message text
  rejection_reason text
  has_attachments boolean [not null]
  cc_recipients text
  created_at timestamp [not null]
  processing_started_at timestamp
  completed_at timestamp
  indexes {
    (workspace_id, created_at) [name: 'inbox_task_ws_created_at_idx']
    (workspace_id, status) [name: 'inbox_task_ws_status_idx']
    (response_message_id) [name: 'inbox_task_response_msg_id_idx']
    (email_message_id) [name: 'inbox_task_email_msg_id_idx']
  }
}

Table mothership_inbox_webhook {
  id text [pk, not null]
  workspace_id text [not null, unique]
  webhook_id text [not null]
  secret text [not null]
  created_at timestamp [not null]
}

Table data_drains {
  id text [pk, not null]
  organization_id text [not null]
  name text [not null]
  source data_drain_source [not null]
  destination_type data_drain_destination [not null]
  destination_config jsonb [not null, note: 'Non-secret destination config (bucket, region, prefix, url, ...). Validated by destination registry.']
  destination_credentials text [not null, note: 'Encrypted JSON blob containing destination credentials. Never returned to clients.']
  schedule_cadence data_drain_cadence [not null]
  enabled boolean [not null]
  cursor text [note: 'Opaque cursor — JSON-encoded, source-defined. Advances after each acknowledged delivery checkpoint.']
  last_run_at timestamp
  last_success_at timestamp
  created_by text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (enabled, last_run_at) [name: 'data_drains_due_idx']
    (organization_id, name) [unique, name: 'data_drains_org_name_unique']
  }
}

Table data_drain_runs {
  id text [pk, not null]
  drain_id text [not null]
  status data_drain_run_status [not null]
  trigger data_drain_run_trigger [not null]
  started_at timestamp [not null]
  finished_at timestamp
  rows_exported integer [not null]
  bytes_written bigint [not null]
  cursor_before text
  cursor_after text
  error text
  locators jsonb [not null, note: 'Destination-specific delivery locators for this run (e.g. S3 keys, webhook response ids).']
  indexes {
    (drain_id, started_at) [name: 'data_drain_runs_drain_started_idx']
  }
}

Table workspace_sandbox {
  id text [pk, not null]
  workspace_id text [not null]
  name text [not null]
  language sandbox_language [not null]
  dependencies jsonb [not null]
  cli_tools jsonb [not null]
  system_packages jsonb [not null]
  spec_hash text [not null]
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id, name) [unique, name: 'workspace_sandbox_workspace_name_unique']
    (spec_hash) [name: 'workspace_sandbox_spec_hash_idx']
  }
  Note: 'A workspace\'s named library of dependency sets. Provider-agnostic: the same row drives a prebuilt E2B template and a Daytona runtime install, and only the materialization step differs. `specHash` is the content address shared with `sandboxImage`, so editing dependencies points the sandbox at a new build while the old one stays valid for in-flight executions.'
}

Table sandbox_image {
  id text [pk, not null]
  provider text [not null]
  spec_hash text [not null]
  spec jsonb [not null]
  status sandbox_image_status [not null]
  image_ref text [note: 'Passed to the provider at create time once `status` is `ready`.']
  provider_image_id text [note: 'Provider-side image identifier, when it differs from `imageRef`.']
  build_id text
  materialization_generation bigint [note: 'Monotonic target release for this provider materialization; legacy rows are generation 0.']
  error_code text [note: 'Classified taxonomy code; see lib/execution/remote-sandbox/build-errors.ts.']
  error_message text [note: 'User-facing copy rendered from the code at classification time.']
  error_detail text [note: 'Installer log tail, shown behind a disclosure.']
  last_used_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (provider, spec_hash) [unique, name: 'sandbox_image_provider_spec_unique']
    (status) [name: 'sandbox_image_status_idx']
    (last_used_at) [name: 'sandbox_image_last_used_idx']
  }
  Note: 'Build registry for the prebuilt strategy, keyed by content address so two workspaces declaring the same dependency set share one build. Never written under a runtime-strategy provider.'
}

Table scim_connection {
  id text [pk, not null]
  organization_id text [not null]
  status text [not null, note: '`active` or `disabled`. Disabling refuses every credential immediately.']
  settings jsonb [not null]
  last_request_at timestamp
  reconcile_lock_token text [note: 'Reconcile-job lease, in the shape the connector member sync already uses.']
  reconcile_lease_at timestamp
  reconciled_at timestamp
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [unique, name: 'scim_connection_organization_unique']
    (reconciled_at) [name: 'scim_connection_reconcile_due_idx']
  }
  Note: 'One directory-provisioning connection per organization. The bearer credential an identity provider presents resolves to this row, and that row is the entire authorization scope: no SCIM request names an organization, so no request can reach another tenant\'s users.'
}

Table scim_credential {
  id text [pk, not null]
  connection_id text [not null]
  token_hash text [not null]
  token_prefix text [not null, note: 'Leading characters of the token, for identifying it in the settings list.']
  scopes jsonb [not null]
  expires_at timestamp
  revoked_at timestamp
  revoked_by text
  last_used_at timestamp
  created_by text
  created_at timestamp [not null]
  indexes {
    (token_hash) [unique, name: 'scim_credential_token_hash_unique']
    (connection_id) [name: 'scim_credential_connection_idx']
  }
  Note: 'A bearer credential for one connection. Only the SHA-256 digest is stored, so a database read cannot recover a live token. Two credentials may be active at once, which is what lets an administrator rotate without a window where the directory cannot authenticate.'
}

Table scim_user {
  id text [pk, not null]
  connection_id text [not null]
  user_id text [not null]
  external_id text
  user_name text [not null, note: 'Lower-cased `userName`; the uniqueness and lookup key within a connection.']
  active boolean [not null]
  attributes jsonb [not null]
  order_key text [not null, note: 'Stable ascending sort key for pagination. A provider pages with `startIndex`, so the order must not shift between pages the way `created_at` alone can when rows share a timestamp.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (connection_id, user_id) [unique, name: 'scim_user_connection_user_unique']
    (connection_id, user_name) [unique, name: 'scim_user_connection_user_name_unique']
    (connection_id, external_id) [unique, name: 'scim_user_connection_external_id_unique']
    (connection_id, order_key) [name: 'scim_user_connection_order_idx']
    (user_id) [name: 'scim_user_user_idx']
  }
  Note: 'The User resource one connection provisioned, and its link to a Sim account. `id` is the SCIM resource id the provider stores and addresses; it is never a Sim user id, so a provider cannot reach an account it did not provision by guessing one.'
}

Table scim_user_tombstone {
  id text [pk, not null]
  connection_id text [not null]
  external_id text [not null]
  user_id text [not null]
  deleted_at timestamp [not null]
  indexes {
    (connection_id, external_id) [unique, name: 'scim_user_tombstone_connection_external_id_unique']
    (user_id) [name: 'scim_user_tombstone_user_idx']
  }
  Note: 'Remembers which Sim account a deleted external identity belonged to. Directories delete and recreate a person for an ordinary rename or rehire. The tombstone makes the recreated resource relink to the same account instead of creating a second one, which is what would otherwise strand the original.'
}

Table scim_group {
  id text [pk, not null]
  connection_id text [not null]
  external_id text
  display_name text [not null]
  display_name_key text [not null, note: 'Lower-cased `displayName`. Uniqueness is case-insensitive because Microsoft Entra treats a group name as its match key and will otherwise create a duplicate whose only difference is capitalization.']
  order_key text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (connection_id, display_name_key) [unique, name: 'scim_group_connection_display_name_unique']
    (connection_id, external_id) [unique, name: 'scim_group_connection_external_id_unique']
    (connection_id, order_key) [name: 'scim_group_connection_order_idx']
  }
  Note: 'A Group resource one connection provisioned.'
}

Table scim_group_member {
  id text [pk, not null]
  group_id text [not null]
  scim_user_id text [not null]
  created_at timestamp [not null]
  indexes {
    (group_id, scim_user_id) [unique, name: 'scim_group_member_group_user_unique']
    (scim_user_id) [name: 'scim_group_member_scim_user_idx']
  }
  Note: 'Membership of a provisioned group.'
}

Table scim_group_mapping {
  id text [pk, not null]
  group_id text [not null]
  target_kind text [not null, note: '`permission_group`, `workspace`, or `org_role`.']
  permission_group_id text
  workspace_id text
  permission_type permission_type [note: 'Permission granted on `workspaceId`, for workspace targets.']
  role text [note: 'Organization role granted, for `org_role` targets. Only `admin` is accepted.']
  source text [not null, note: '`automatic` mappings were made by name matching and are replaced when the group is renamed; `manual` ones were made by an administrator and are never removed by a sync. Kept apart from `createdBy`, which goes null when its author\'s account is deleted.']
  created_by text
  created_at timestamp [not null]
  indexes {
    (permission_group_id) [name: 'scim_group_mapping_permission_group_idx']
    (workspace_id) [name: 'scim_group_mapping_workspace_idx']
    (group_id, target_kind) [unique, name: 'scim_group_mapping_group_target_unique']
  }
  Note: 'What a directory group means inside Sim, as an administrator configured it. A group may carry several mappings — a permission group, one or more workspaces, and the organization admin role are independent targets.'
}

Table scim_projection_grant {
  id text [pk, not null]
  connection_id text [not null]
  scim_user_id text [not null]
  target_kind text [not null]
  target_id text [not null, note: 'Permission group id, workspace id, or the granted organization role.']
  permission_type permission_type [note: 'The permission SCIM set, so a later manual upgrade stays detectable.']
  baseline_permission permission_type [note: 'Manual workspace access to restore when an unlocked directory withdraws its grant.']
  origin text [not null, note: '`directory` when the directory created the access; `adopted` when the person already held it by hand and a mapping merely covers it. Adopted access is left in place when the mapping goes away, unless the directory is the organization\'s source of truth.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (scim_user_id, target_kind, target_id) [unique, name: 'scim_projection_grant_user_target_unique']
    (connection_id) [name: 'scim_projection_grant_connection_idx']
  }
  Note: 'Provenance for every access SCIM granted. Without it, withdrawing a group\'s access could not tell an access the directory granted from one a workspace administrator granted by hand, and a routine group change would revoke the administrator\'s work.'
}

Table scim_request_log {
  id text [pk, not null]
  connection_id text [not null]
  credential_id text
  method text [not null]
  path text [not null, note: 'Resource path only. Query strings can carry directory attribute values.']
  status integer [not null]
  scim_type text
  detail text
  user_agent text
  duration_ms integer [not null]
  created_at timestamp [not null]
  indexes {
    (connection_id, created_at) [name: 'scim_request_log_connection_created_idx']
  }
  Note: 'Recent provisioning requests, for the settings activity view. Microsoft Entra reports a failed sync without saying what it sent, so an administrator debugging a connection has no other way to see the request that failed. Pruned by the reconcile job.'
}

Table copilot_service_usage {
  id uuid [pk, not null]
  stream_id uuid [not null]
  tool_call_id text [not null]
  service text [not null]
  cost_usd decimal
  worker_origin text [not null]
  created_at timestamptz [not null]
  next_attempt_at timestamptz [not null]
  attempts integer [not null]
  delivered_at timestamptz
  last_error text
  indexes {
    (next_attempt_at) [name: 'copilot_service_usage_pending_idx']
  }
  Note: 'Provider costs outlive tool results and chat deletion until the billing owner acknowledges them.'
}

