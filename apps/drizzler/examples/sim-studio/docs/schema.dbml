    (workspace_id, id) [name: 'job_execution_logs_workspace_ended_at_id_idx']
    (execution_id) [unique, name: 'job_execution_logs_execution_id_unique']
    (trigger) [name: 'job_execution_logs_trigger_idx']
  }
}

Table webhook {
