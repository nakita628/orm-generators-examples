  }
}

Table organization {
  id text [pk, not null]
  name text [not null]
  slug text [not null]
  logo text
  metadata json
  session_policy_settings json
  security_policy_version integer [not null, note: 'Monotonic counter embedded in the Better Auth cookie-cache version for this org\'s members. Bumped on any security-policy change or org-wide session revocation so every cached session cookie in the org is invalidated (falls through to a DB session read) within the policy cache TTL instead of the 24h cookie-cache lifetime.']
  require_sso boolean [not null, note: 'Whether members must sign in through this organization\'s identity provider. Checked only when a session is created, so turning it on ends no session that already exists; signing everyone out stays the separate revoke action. Owners keep password sign-in as a break-glass path for a broken identity provider.']
  whitelabel_settings json
  data_retention_settings json
  org_usage_limit decimal
  storage_used_bytes bigint [not null, note: 'Storage upload/delete hot-path tracker for org-scoped plans. This remains a direct aggregate write for organization file storage changes; personal storage writes update `user_stats.storageUsedBytes`.']
  limit_notifications jsonb [not null, note: 'Highest usage-limit threshold already emailed per category for this org (e.g. `{ seats: 80, storage: 100 }`). Mirrors `user_stats.limitNotifications` for org-scoped (pooled) limits. Re-arms when usage drops below the re-arm band; `credits` instead re-arms with a new billing period or a changed limit (see `claimCreditsThreshold`).']
  credit_balance decimal [not null, note: 'Organization credit balance tracker. Still debited/credited by billing lifecycle paths and threshold/final overage collection. It is not a per-usage aggregate counter.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table aws_marketplace_license {
  id text [pk, not null]
  license_arn text [not null]
  product_code text [not null]
  customer_aws_account_id text [not null]
  agreement_id text
  agreement_seen_at timestamp [note: 'When the source of `agreement_id` was true, so a redelivered old event cannot roll it back.']
  renewed_agreement_id text [note: 'The agreement that replaced this license\'s, from a Purchase Agreement Created event.']
  organization_id text
  status aws_marketplace_license_status [not null]
  dimension text
  quantity integer
  expires_at timestamp
  last_verified_at timestamp [not null]
  last_verification_attempt_at timestamp [not null, note: 'Every verification attempt, failed ones too, so a failing license cannot starve the rest.']
  license_event_received_at timestamp [note: 'AWS says not to activate a subscription until this event has arrived, so staff can see it.']
  claim_token_hash text
  claim_expires_at timestamp
  linked_by_user_id text
  organization_linked_at timestamp [note: 'When `organization_id` last changed to its current value; usage counts from here.']
  ended_at timestamp [note: 'When a read first found the license no longer granting access; cleared if it returns.']
  contact_email text [note: 'Whom to contact about provisioning, as the buyer entered it during setup.']
  company_name text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (license_arn) [unique, name: 'aws_marketplace_license_arn_unique']
    (claim_token_hash) [unique, name: 'aws_marketplace_license_claim_token_hash_unique']
    (agreement_id) [name: 'aws_marketplace_license_agreement_id_idx']
    (renewed_agreement_id) [name: 'aws_marketplace_license_renewed_agreement_id_idx']
    (customer_aws_account_id, product_code) [name: 'aws_marketplace_license_account_product_idx']
    (last_verification_attempt_at) [name: 'aws_marketplace_license_last_attempt_idx']
    (organization_id) [name: 'aws_marketplace_license_organization_id_idx']
    (linked_by_user_id) [name: 'aws_marketplace_license_linked_by_user_id_idx']
  }
  Note: 'An AWS Marketplace SaaS contract license, one row per license ARN: AWS grants a new license with every agreement, so one account can hold several, and the account ID names the buyer but not the license. `status` is the newest Entitlement Service read, never a contract amount; `pending` means AWS has returned no entitlement yet, which `inactive` (lapsed or deprovisioned) is not. While a buyer\'s setup is open, their browser holds a one-time claim whose hash and expiry live here; a verification recording `inactive` clears it.'
}

Table aws_marketplace_usage_tally {
  organization_id text [not null]
  dimension text [not null]
  period_start timestamp [not null]
  counted_from timestamp [not null]
  cost_usd decimal [not null]
  units integer [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id, dimension, period_start) [pk]
  }
  Note: 'How much of an organization\'s billed usage AWS Marketplace has been charged for, per dimension and billing period. Each meter run re-sums the period\'s usage and charges only the whole units above `units`, so a cost raised in place after it was first counted is still charged, and a fraction of a unit waits in `cost_usd` until it adds up. `counted_from` fixes where the period\'s sum starts, the moment the organization\'s billing through AWS began.'
}

Table aws_marketplace_usage_report {
  id text [pk, not null]
  organization_id text [note: 'Kept null when the organization is deleted, so usage already charged is still sent.']
  license_id text [not null]
  dimension text [not null]
  hour_start timestamp [not null]
  quantity integer [not null]
  status aws_marketplace_usage_report_status [not null]
  sent_at timestamp [note: 'When the record first went to AWS. AWS keeps the first record it accepts for a license, dimension and hour, so the quantity is fixed from then on.']
  metering_record_id text
  error text [note: 'Why AWS refused the record, or why it can no longer be sent.']
  reported_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (license_id, dimension, hour_start) [unique, name: 'aws_marketplace_usage_report_license_dimension_hour_unique']
    (status, hour_start) [name: 'aws_marketplace_usage_report_status_hour_idx']
    (organization_id) [name: 'aws_marketplace_usage_report_organization_id_idx']
  }
  Note: 'The units owed to AWS Marketplace for usage counted during one hour, on one license and dimension: the key AWS deduplicates records on. A row gathers units while its hour is open and is sent once it closes, or at once for a license that has ended.'
}

