    (run_id, pending_tool_call_id) [unique, name: 'copilot_run_checkpoints_run_pending_tool_unique']
  }
}

Table copilot_async_tool_calls {
  id uuid [pk, not null]
  run_id uuid [not null]
  checkpoint_id uuid
  tool_call_id text [not null]
  tool_name text [not null]
  args jsonb [not null]
  executable_name text [note: 'Canonical dispatch identity; null only on calls recorded before invocation binding.']
  target_workspace_id text
  approved_args jsonb [note: 'Validated user edits, committed once with the decision; original args stay immutable.']
  assistant_action jsonb [note: 'Server-resolved authority sealed with the original proposal, never supplied by the worker.']
  execution_retryable boolean [not null, note: 'External writes without a provider idempotency key must never be replayed after a crash.']
  status copilot_async_tool_status [not null]
  result jsonb
  error text
  permission_decision copilot_tool_permission_decision [note: 'A null decision on a gated call means its prompt is still outstanding after a reload.']
  permission_decided_at timestamp
  permission_requested_at timestamp [note: 'Set when this call was held for the user\'s decision. Whether a call is gated depends on the turn (the feature flag, the tool\'s arguments, the user\'s allow lists), so the row records it: every execution claim refuses a gated call until `permissionDecision` allows it.']
  pickup_deadline_at timestamptz [note: 'When a desktop call on a device-bound run must be claimed by: set once the call may run and is offered to its device. A call still unclaimed after it fails as never started.']
  persist_seq bigint [note: 'When this call was persisted, as a strictly increasing number: calls from one turn can share a millisecond, and a device must run them in the order the model emitted them. Null on rows persisted before the column existed.']
  claimed_at timestamp
  claimed_by text
  browser_download_started_at timestamp [note: 'One-use download-save admission; never released after an uncertain storage outcome.']
  execution_started_at timestamp [note: 'Separate from the model-facing terminal result, which can precede cleanup.']
  execution_settled_at timestamp
  execution_owner_token text [note: 'Independent of stream ownership and terminal result delivery.']
  execution_lease_expires_at timestamptz
  execution_revoked_at timestamptz
  execution_attempts integer [not null, note: 'Sim executions started for this call, counting each re-run after its owner died.']
  execution_deadline_at timestamptz [note: 'When Sim must have settled this call: the worker\'s wait from the frame, less the settle margin, fixed at first receipt. Every wait, execution and re-run of the call ends by it. Null when the frame named no deadline.']
  client_workflow_execution_id text [note: 'Assigned only after the workflow HTTP executor has reserved this execution identity.']
  sandbox_processes jsonb [not null]
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (checkpoint_id) [name: 'copilot_async_tool_calls_checkpoint_id_idx']
    (status) [name: 'copilot_async_tool_calls_status_idx']
    (run_id, status) [name: 'copilot_async_tool_calls_run_status_idx']
    (tool_call_id) [unique, name: 'copilot_async_tool_calls_tool_call_id_unique']
  }
}

