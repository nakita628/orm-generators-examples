  }
  Note: 'MCP tool attempts, separate from successful Search invocations and billable usage.'
}

Table usage_log {
  id text [pk, not null]
  user_id text [not null]
  category usage_log_category [not null]
  source usage_log_source [not null]
  description text [not null]
  metadata jsonb
  cost decimal [not null]
  event_key text
  billing_entity_type billing_entity_type
  billing_entity_id text
  billing_period_start timestamp
  billing_period_end timestamp
  workspace_id text
  workflow_id text
  execution_id text
  created_at timestamp [not null]
  indexes {
    (user_id, created_at) [name: 'usage_log_user_created_at_idx']
    (source) [name: 'usage_log_source_idx']
    (workflow_id) [name: 'usage_log_workflow_id_idx']
    (event_key) [unique, name: 'usage_log_event_key_unique']
    (billing_entity_type, billing_entity_id, billing_period_start, billing_period_end, user_id, created_at, source, cost) [name: 'usage_log_billing_entity_period_cost_idx']
    (billing_entity_type, billing_entity_id, created_at, user_id, source, cost) [name: 'usage_log_billing_entity_created_at_cost_idx']
    (workspace_id, created_at, billing_entity_type, billing_entity_id, user_id, source, cost, workflow_id) [name: 'usage_log_workspace_created_at_cost_idx']
    (execution_id) [name: 'usage_log_execution_id_idx']
  }
}

Table credential {
  id text [pk, not null]
  workspace_id text
  organization_id text
  slack_app_id text
  type credential_type [not null]
  display_name text [not null]
  description text
  unredacted boolean [not null, note: 'Opts an env_workspace secret out of resolved-secret redaction: its value renders in plaintext across surfaces (logs, model-visible content, sandbox file exports) instead of `{{NAME}}`, and is not recorded into durable provenance. Meaningful only for type = \'env_workspace\'; writes for other types are rejected in the orchestration layer.']
  provider_id text
  account_id text
  env_key text
  env_owner_user_id text
  encrypted_service_account_key text
  encrypted_personal_token text [note: 'Encrypted provider token bound immutably to createdBy, providerSubjectId, and providerTenantId.']
  authorization_app_id text
  credential_group_enrollment_id text
  credential_group_option_id text
  mcp_server_id text
  mcp_oauth_config_version integer
  managed_oauth_scope_version integer
  provider_subject_id text
  provider_tenant_id text
  managed_oauth_status managed_oauth_credential_status
  granted_scopes text
  provider_metadata jsonb
  encrypted_oauth_token_set text
  mcp_tools jsonb
  mcp_tools_refreshed_at timestamp
  granted_at timestamp
  revoked_at timestamp
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  last_refreshed_at timestamp
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [name: 'credential_organization_id_idx']
    (organization_id, account_id) [unique, name: 'credential_organization_account_unique']
    (organization_id, created_by, provider_id, provider_tenant_id, provider_subject_id) [unique, name: 'credential_org_personal_token_unique']
    (workspace_id) [name: 'credential_workspace_id_idx']
    (type) [name: 'credential_type_idx']
    (provider_id) [name: 'credential_provider_id_idx']
    (account_id) [name: 'credential_account_id_idx']
    (env_owner_user_id) [name: 'credential_env_owner_user_id_idx']
    (credential_group_enrollment_id) [name: 'credential_group_enrollment_idx']
    (mcp_server_id) [name: 'credential_mcp_server_idx']
    (credential_group_enrollment_id, credential_group_option_id, provider_subject_id) [unique, name: 'credential_group_option_identity_unique']
    (credential_group_enrollment_id, mcp_server_id) [unique, name: 'credential_managed_mcp_enrollment_server_identity_unique']
    (workspace_id, account_id) [unique, name: 'credential_workspace_account_unique']
    (workspace_id, type, env_key) [unique, name: 'credential_workspace_env_unique']
    (workspace_id, type, env_key, env_owner_user_id) [unique, name: 'credential_workspace_personal_env_unique']
    (workspace_id, created_by, provider_id, provider_tenant_id, provider_subject_id) [unique, name: 'credential_personal_token_identity_unique']
  }
  Note: 'contract-pending(after all GitLab tokens migrate and workspace-token writers are retired): drop credential_personal_token_identity_unique; only the index is retired.'
}

Table workload_identity_pending_subject {
  id text [pk, not null]
  workspace_id text [not null]
  user_id text [not null, note: 'Who the subject was issued to; only they can attach it to a credential.']
  provider text [not null, note: 'The keyless provider family (`aws`, `databricks`, …) the subject was issued for.']
  subject text [not null]
  created_at timestamp [not null]
  expires_at timestamp [not null, note: 'Renewed whenever the subject is shown again; once it passes, the subject is no longer offered.']
  indexes {
    (subject) [unique, name: 'workload_identity_pending_subject_subject_unique']
    (workspace_id, user_id, provider, created_at) [name: 'workload_identity_pending_subject_issuer_idx']
    (user_id) [name: 'workload_identity_pending_subject_user_id_idx']
  }
  Note: 'Keyless trust subjects Sim issued that no credential holds yet. A customer pins the subject in a trust policy that can take days to apply, so the subject outlives the connect dialog: reopening it shows the same subject, and its issuer can renew the proof that attaches it to a new credential. The row is deleted once a credential saves the subject, so a subject is never offered again after it has been used.'
}

Table credential_group {
  id text [pk, not null]
