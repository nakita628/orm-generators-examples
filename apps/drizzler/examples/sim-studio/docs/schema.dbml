Table sim_trigger_state {
  workflow_id text [not null]
  block_id text [not null]
  scope_key text [not null]
  last_fired_at timestamp
  updated_at timestamp [not null]
  indexes {
    (workflow_id, block_id, scope_key) [pk]
  }
  Note: 'Cooldown state for Sim workspace-event trigger subscriptions. Keyed by (workflowId, blockId, scopeKey) rather than the webhook row because webhook rows are recreated per deployment version — state stored there would reset on every redeploy. `scopeKey` is \'\' for subscription-level cooldowns and the source workflow ID for per-source-workflow rules (no_activity).'
}

Table api_key {
  id text [pk, not null]
  user_id text [not null]
  workspace_id text [note: 'Only set for workspace keys']
