Ref workspace_visit_workspace_id_workspace_id_fk: workspace_visit.workspace_id > workspace.id [delete: cascade]

Ref workflow_user_id_user_id_fk: workflow.user_id > user.id [delete: cascade]

Ref workflow_workspace_id_workspace_id_fk: workflow.workspace_id > workspace.id [delete: cascade]

Ref workflow_folder_id_folder_id_fk: workflow.folder_id > folder.id [delete: set null]

Ref workflow_blocks_workflow_id_workflow_id_fk: workflow_blocks.workflow_id > workflow.id [delete: cascade]

Ref workflow_edges_workflow_id_workflow_id_fk: workflow_edges.workflow_id > workflow.id [delete: cascade]

Ref workflow_edges_source_block_id_workflow_blocks_id_fk: workflow_edges.source_block_id > workflow_blocks.id [delete: cascade]

Ref workflow_edges_target_block_id_workflow_blocks_id_fk: workflow_edges.target_block_id > workflow_blocks.id [delete: cascade]

Ref workflow_subflows_workflow_id_workflow_id_fk: workflow_subflows.workflow_id > workflow.id [delete: cascade]

Ref workflow_execution_snapshots_workflow_id_workflow_id_fk: workflow_execution_snapshots.workflow_id > workflow.id [delete: set null]

Ref workflow_execution_logs_workflow_id_workflow_id_fk: workflow_execution_logs.workflow_id > workflow.id [delete: set null]

Ref workflow_execution_logs_workspace_id_workspace_id_fk: workflow_execution_logs.workspace_id > workspace.id [delete: cascade]

Ref workflow_execution_logs_state_snapshot_id_workflow_execution_snapshots_id_fk: workflow_execution_logs.state_snapshot_id > workflow_execution_snapshots.id

Ref workflow_execution_logs_deployment_version_id_workflow_deployment_version_id_fk: workflow_execution_logs.deployment_version_id > workflow_deployment_version.id [delete: set null]

Ref execution_large_values_workspace_id_workspace_id_fk: execution_large_values.workspace_id > workspace.id [delete: cascade]

