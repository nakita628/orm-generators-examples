    (archived_at) [name: 'webhook_archived_at_partial_idx']
    (provider, is_active, workflow_id, deployment_version_id) [name: 'idx_webhook_on_provider_is_active_workflow_id_deploym_bdeed5468']
    (workflow_id, block_id, updated_at) [name: 'idx_webhook_on_workflow_id_block_id_updated_at_desc']
    (workflow_id, block_id) [unique, name: 'webhook_active_registration_unique']
    (workflow_id, block_id) [unique, name: 'webhook_candidate_registration_unique']
    (workflow_id, registration_status, registration_generation) [name: 'webhook_registration_status_generation_idx']
  }
}

Table webhook_path_claim {
  path text [pk, not null]
