Table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique, note: 'Unique byte-for-byte only. The identity an address names is `foldedEmail(email)`, which `user_email_lower_idx` indexes.']
  normalized_email text [unique, note: 'Legacy signup normalization strips Gmail dots and tags and must never be used for identity. Retained for Better Auth and full-row readers that still select this column; removal needs a separate projection migration.']
  email_verified boolean [not null]
  image text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  stripe_customer_id text
  role text
  banned boolean
  ban_reason text
  ban_expires timestamp
  suspended_at timestamp [note: 'When set, the account is suspended: sign-in is refused and API keys stop authenticating, while every resource the user owns is left untouched. Deliberately not `banned`. A ban is a platform-admin action whose `user.update.after` hook runs `disableUserResources`, archiving every workspace the user owns and deleting their API keys, and Sim has no server-side unban to reverse it. SCIM `active: false` is a reversible organization-level suspension that must preserve ownership for a later reactivation, so it needs a state of its own.']
  suspension_source text [note: 'Who suspended the account. Only `scim` exists today; a source only ever lifts its own suspension, so a later source cannot have its suspensions undone by a directory sync.']
}

Table session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  active_organization_id text
  impersonated_by text
  indexes {
    (user_id) [name: 'session_user_id_idx']
  }
}

Table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  oauth_config text
  refresh_revoked_at timestamp [note: 'The provider rejected `refresh_token` as revoked (`invalid_grant` and kin). The marker holds only while `refresh_revoked_token_hash` still fingerprints the stored refresh token, so any writer that stores a new chain supersedes it; a reconnect clears it explicitly, since a provider may reauthorize without issuing a new refresh token.']
  refresh_revoked_code text
  refresh_revoked_token_hash text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (user_id) [name: 'account_user_id_idx']
    (account_id, provider_id) [name: 'idx_account_on_account_id_provider_id']
  }
}

Table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (identifier) [name: 'verification_identifier_idx']
    (expires_at) [name: 'verification_expires_at_idx']
  }
}

Table folder {
  id text [pk, not null]
  project_id text [note: 'File folders may belong to a Project; other resource folders remain workspace-owned.']
  resource_type folder_resource_type [not null]
  name text [not null]
  user_id text [not null]
  workspace_id text
  parent_id text
  locked boolean [not null]
  sort_order integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
  indexes {
    (id, workspace_id, resource_type) [unique, name: 'folder_workspace_owner_type_unique']
    (id, project_id, resource_type) [unique, name: 'folder_project_owner_type_unique']
    (project_id, id) [name: 'folder_project_id_idx']
    (project_id, resource_type, name) [unique, name: 'folder_project_resource_parent_name_active_unique']
    (user_id) [name: 'folder_user_idx']
    (workspace_id, resource_type, parent_id) [name: 'folder_workspace_resource_parent_idx']
    (parent_id, sort_order) [name: 'folder_parent_sort_idx']
    (deleted_at) [name: 'folder_deleted_at_idx']
    (workspace_id, deleted_at) [name: 'folder_workspace_deleted_partial_idx']
    (workspace_id, resource_type, name) [unique, name: 'folder_workspace_resource_parent_name_active_unique']
  }
  Note: 'Generic folder hierarchy shared by workflows, files, knowledge bases, and tables. Supersedes the resource-specific `workflow_folder` and `workspace_file_folders` tables, dropped in migration 0276 once the cutover was verified against production. `resourceType` is a real `pgEnum` here — unlike `pinnedItem.resourceType` — because the set of folder-bearing resources is small and fixed. A folder may only parent a folder of the same `resourceType` in the same workspace; that invariant is enforced both in the application layer and by the `folder_parent_resource_type_match` trigger, since a plain FK cannot express it. `locked` carries over the existing workflow-folder lock feature verbatim. It is NOT extended to the other resource types — file/knowledge_base/table folders leave it at `false` and no lock cascade reads it for them. Dropping the column would regress shipped workflow-folder locking. `color` and `isExpanded` from the old `workflow_folder` table are intentionally not carried over: `color` has no UI consumer, and `isExpanded`\'s real state lives client-side in the folders Zustand store and is never read back from the DB.'
}

Table pinned_item {
  id text [pk, not null]
  user_id text [not null]
  workspace_id text [not null]
  resource_type text [not null, note: '\'workflow\' | \'file\' | \'knowledge_base\' | \'table\' | \'folder\' | \'workspace\'']
  resource_id text [not null]
  pinned_at timestamp [not null]
  indexes {
    (user_id, workspace_id) [name: 'pinned_item_user_workspace_idx']
    (resource_type, resource_id) [name: 'pinned_item_resource_idx']
    (user_id, resource_type, resource_id) [unique, name: 'pinned_item_user_resource_unique']
  }
  Note: 'Per-user pinning of workspace resources. Polymorphic on `resourceType`, following the same shape as `publicShare.resourceType` below — deliberately plain `text` rather than a `pgEnum`, because the set of pinnable kinds is expected to grow (folders become pinnable alongside the generic-folder work) and widening a text column costs nothing where widening an enum needs a migration. Pins are per-user, not per-workspace: two members of the same workspace pin independently, which is why `userId` leads the unique index and every read path filters on the session user.'
}

Table workspace_visit {
  user_id text [not null]
  workspace_id text [not null]
  visited_at timestamp [not null]
  indexes {
    (user_id, workspace_id) [pk]
    (workspace_id) [name: 'workspace_visit_workspace_idx']
  }
  Note: 'When each user last opened each workspace. The workspace list returns these so the switcher orders by recency on the server — every render agrees on the order, and it follows the user across devices.'
}

Table workflow {
  id text [pk, not null]
  user_id text [not null, note: 'Creator and owner. Legitimate as ownership: it anchors personal (workspace-less) workflows, cascades the workflow away with the account, and names the owner for webhook config and deploy-as-block resolution. acts as, what it may read, or what it may authorize. The acting principal is `ExecutionMetadata.userId`, which the principal layer (`resolvePrincipalAttribution`) resolves to the caller for a session, personal API key, or delegated run, and to the workspace billing account for a workspace API key, schedule, or webhook. Exactly one execution use survives, carried as `ExecutionMetadata.workflowUserId`: the personal-environment fallback in `executeWorkflowCore`, for runs with no identifiable caller — workspace API keys, schedules, webhooks, and unauthenticated public-API calls. Those have nobody to resolve personal variables as, and a deployed workflow is routinely authored against its owner\'s personal keys, so dropping the fallback would break them. Workspace variables never fall back here; they always authorize against the actor.']
  workspace_id text
  folder_id text
  sort_order integer [not null]
  name text [not null]
  description text
  last_synced timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  is_deployed boolean [not null]
  deployed_at timestamp
  is_public_api boolean [not null]
  locked boolean [not null]
  fork_sync_excluded boolean [not null]
  run_count integer [not null]
  last_run_at timestamp
  variables json
  archived_at timestamp
  indexes {
    (workspace_id) [name: 'workflow_workspace_id_idx']
    (user_id, workspace_id) [name: 'workflow_user_workspace_idx']
    (workspace_id, name) [unique, name: 'workflow_workspace_folder_name_active_unique']
    (folder_id, sort_order) [name: 'workflow_folder_sort_idx']
    (workspace_id, sort_order, created_at, id) [name: 'workflow_active_workspace_sort_idx']
    (archived_at) [name: 'workflow_archived_at_idx']
    (workspace_id, archived_at) [name: 'workflow_workspace_archived_partial_idx']
  }
}

Table workflow_blocks {
  id text [pk, not null]
  workflow_id text [not null]
  type text [not null, note: '\'starter\', \'agent\', \'api\', \'function\'']
  name text [not null]
  position_x decimal [not null]
  position_y decimal [not null]
  enabled boolean [not null]
  horizontal_handles boolean [not null]
  is_wide boolean [not null]
  advanced_mode boolean [not null]
  trigger_mode boolean [not null]
  error_enabled boolean [not null]
  retry jsonb [note: 'Opt-in {@link BlockRetryConfig}; NULL means the block never retries.']
  locked boolean [not null]
  height decimal [not null]
  sub_blocks jsonb [not null]
  outputs jsonb [not null]
  data jsonb
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workflow_id) [name: 'workflow_blocks_workflow_id_idx']
    (type) [name: 'workflow_blocks_type_idx']
  }
}

Table workflow_edges {
  id text [pk, not null]
  workflow_id text [not null]
  source_block_id text [not null]
  target_block_id text [not null]
  source_handle text
  target_handle text
  created_at timestamp [not null]
  indexes {
    (workflow_id, source_block_id) [name: 'workflow_edges_workflow_source_idx']
    (workflow_id, target_block_id) [name: 'workflow_edges_workflow_target_idx']
  }
}

Table workflow_subflows {
  id text [pk, not null]
  workflow_id text [not null]
  type text [not null, note: '\'loop\' or \'parallel\'']
  config jsonb [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workflow_id, type) [name: 'workflow_subflows_workflow_type_idx']
  }
}

Table waitlist {
  id text [pk, not null]
  email text [not null, unique]
  status text [not null, note: 'pending, approved, rejected']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table workflow_execution_snapshots {
  id text [pk, not null]
  workflow_id text
  state_hash text [not null]
  state_data jsonb [not null]
  created_at timestamp [not null]
  indexes {
    (state_hash) [name: 'workflow_snapshots_hash_idx']
    (workflow_id, state_hash) [unique, name: 'workflow_snapshots_workflow_hash_idx']
    (created_at) [name: 'workflow_snapshots_created_at_idx']
  }
}

Table workflow_execution_logs {
  id text [pk, not null]
  workflow_id text
  workspace_id text [not null]
  execution_id text [not null]
  state_snapshot_id text [not null]
  deployment_version_id text
  level text [not null, note: '\'info\' | \'error\'']
  status text [not null, note: 'See `PERSISTED_WORKFLOW_EXECUTION_STATUSES` in `apps/sim/lib/logs/types.ts`.']
  trigger text [not null, note: '\'api\' | \'webhook\' | \'schedule\' | \'manual\' | \'chat\'']
  started_at timestamp [not null]
  execution_deadline_at timestamp [note: 'Absolute deadline for the current active attempt; cleared while paused or terminal.']
  ended_at timestamp
  total_duration_ms integer [note: 'Wall clock from `started_at` for a terminal row; for a `pending` (paused) row, the active duration recorded at the checkpoint, which excludes the time the run sits waiting. Resuming leaves that checkpoint value in place while the row accrues time again, so a `running` row\'s value is stale until the next terminal write recomputes it.']
  execution_data jsonb [not null, note: 'Heavy trace data (traceSpans, finalOutput, workflowInput, executionState) is externalized to object storage; this column then holds a slim payload: a `traceStoreRef` (__simLargeValueRef) pointer to the stored object plus inline markers (hasTraceSpans, traceSpanCount, environment, trigger, truncation flags). It also still holds the FULL payload inline for legacy / not-yet-backfilled rows, for the storage-write-failure fallback, and for job_execution_logs. Required — not droppable. Read it via `materializeExecutionData`, which resolves the pointer.']
  cost_total decimal [note: 'Faithful, write-once projection of the run\'s usage_log ledger sum (dollars). Backs list cost display/filter/sort without live aggregation; never an independently-computed value (cost_total == SUM(usage_log) for the run).']
  models_used text [note: 'Model names used by the run (incl. zero-cost/BYOK), for the v1 model filter.']
  files jsonb [note: 'File metadata for execution files']
  created_at timestamp [not null]
  indexes {
    (state_snapshot_id) [name: 'workflow_execution_logs_state_snapshot_id_idx']
    (deployment_version_id) [name: 'workflow_execution_logs_deployment_version_id_idx']
    (trigger) [name: 'workflow_execution_logs_trigger_idx']
    (level) [name: 'workflow_execution_logs_level_idx']
    (started_at) [name: 'workflow_execution_logs_started_at_idx']
    (execution_id) [unique, name: 'workflow_execution_logs_execution_id_unique']
    (workflow_id, started_at) [name: 'workflow_execution_logs_workflow_started_at_idx']
    (workspace_id, started_at, status, total_duration_ms, workflow_id, trigger, level) [name: 'workflow_execution_logs_workspace_activity_level_idx']
    (workspace_id) [name: 'workflow_execution_logs_workspace_started_at_id_desc_idx']
    (workspace_id, cost_total) [name: 'workflow_execution_logs_workspace_cost_total_idx']
    (models_used) [type: gin, name: 'workflow_execution_logs_models_used_idx']
    (workspace_id, id) [name: 'workflow_execution_logs_workspace_ended_at_id_idx']
    (started_at) [name: 'workflow_execution_logs_running_started_at_idx']
    (execution_deadline_at) [name: 'workflow_execution_logs_running_deadline_idx']
    (started_at) [name: 'workflow_execution_logs_redacting_started_at_idx']
    (execution_deadline_at) [name: 'workflow_execution_logs_redacting_deadline_idx']
    (ended_at, workspace_id, execution_id) [name: 'workflow_execution_logs_completed_ended_at_idx']
  }
}

Table execution_large_values {
  key text [pk, not null]
  workspace_id text [not null]
  workflow_id text
  owner_execution_id text [not null]
  size integer [not null]
  created_at timestamp [not null]
  deleted_at timestamp
  indexes {
    (owner_execution_id) [name: 'execution_large_values_owner_execution_id_idx']
    (workspace_id, created_at, key) [name: 'execution_large_values_cleanup_idx']
    (workspace_id, deleted_at, key) [name: 'execution_large_values_tombstone_cleanup_idx']
    (workflow_id) [name: 'execution_large_values_workflow_id_idx']
    (workspace_id) [name: 'execution_large_values_workspace_id_idx']
  }
}

Table execution_large_value_references {
  key text [not null]
  execution_id text [not null]
  source execution_large_value_reference_source [not null]
  workspace_id text [not null]
  workflow_id text
  created_at timestamp [not null]
  indexes {
    (key, execution_id, source) [pk]
    (workspace_id, execution_id, source) [name: 'execution_large_value_references_workspace_execution_source_idx']
    (workflow_id) [name: 'execution_large_value_references_workflow_id_idx']
  }
}

Table execution_large_value_dependencies {
  parent_key text [not null]
  child_key text [not null]
  workspace_id text [not null]
  created_at timestamp [not null]
  indexes {
    (parent_key, child_key) [pk]
    (workspace_id, parent_key) [name: 'execution_large_value_dependencies_workspace_parent_key_idx']
    (workspace_id, child_key) [name: 'execution_large_value_dependencies_workspace_child_key_idx']
  }
}

Table paused_executions {
  id text [pk, not null]
  workflow_id text [not null]
  execution_id text [not null]
  execution_snapshot jsonb [not null]
  pause_points jsonb [not null]
  total_pause_count integer [not null]
  resumed_count integer [not null]
  automatic_resume_retry_count integer [not null]
  status text [not null]
  metadata jsonb [not null]
  paused_at timestamp [not null]
  updated_at timestamp [not null]
  expires_at timestamp
  next_resume_at timestamp [note: 'Earliest `resumeAt` across this row\'s time-based pause points. NULL for human-only pauses.']
  indexes {
    (workflow_id) [name: 'paused_executions_workflow_id_idx']
    (status) [name: 'paused_executions_status_idx']
    (execution_id) [unique, name: 'paused_executions_execution_id_unique']
    (next_resume_at) [name: 'paused_executions_next_resume_at_idx']
  }
}

Table resume_queue {
  id text [pk, not null]
  paused_execution_id text [not null]
  parent_execution_id text [not null]
  new_execution_id text [not null]
  context_id text [not null]
  resume_input jsonb
  status text [not null]
  queued_at timestamp [not null]
  claimed_at timestamp
  completed_at timestamp
  failure_reason text
  indexes {
    (parent_execution_id, status, queued_at) [name: 'resume_queue_parent_status_idx']
    (new_execution_id) [name: 'resume_queue_new_execution_idx']
  }
}

Table client_credential_token {
  id text [pk, not null]
  encrypted_value text [not null]
  access_token_digest text
  expires_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (expires_at) [name: 'client_credential_token_expires_at_idx']
    (access_token_digest) [name: 'client_credential_token_access_token_digest_idx']
  }
  Note: 'Durable encrypted application permissions and tokens, plus expiring token-exchange failures.'
}

Table environment {
  id text [pk, not null, note: 'Use the user id as the key']
  user_id text [not null, unique]
  variables json [not null]
  updated_at timestamp [not null]
}

Table organization_secret_source {
  id text [pk, not null]
  organization_id text [not null]
  mode text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [unique, name: 'organization_secret_source_org_unique']
  }
  Note: 'Generic Secrets source configuration, independent of indexed/searchable connectors.'
}

Table organization_secret {
  id text [pk, not null]
  source_id text [not null]
  owner_user_id text
  name text [not null]
  encrypted_value text [not null]
  updated_at timestamp [not null]
  indexes {
    (source_id, name) [unique, name: 'organization_secret_shared_unique']
    (source_id, owner_user_id, name) [unique, name: 'organization_secret_member_unique']
    (owner_user_id) [name: 'organization_secret_owner_idx']
  }
  Note: 'Ciphertext only; a null owner denotes the organization\'s shared environment.'
}

Table sim_link {
  id text [pk, not null]
  organization_id text [not null]
  name text [not null]
  normalized_name text [not null]
  url text [not null]
  default_url text
  description text
  unlisted boolean [not null]
  restrict_edit boolean [not null]
  visit_count integer [not null]
  last_visited_at timestamp
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id, normalized_name) [unique, name: 'sim_link_organization_name_unique']
    (created_by) [name: 'sim_link_created_by_idx']
  }
  Note: 'An organization\'s Sim links (go links): `sim/<name>` redirects members to `url`. Names match case- and punctuation-insensitively through `normalized_name`. `{*}` in `url` marks a variable link filled from the path after the name, and `default_url` serves a variable link opened without values. `visit_count` counts redirects.'
}

Table workspace_environment {
  id text [pk, not null]
  workspace_id text [not null]
  variables json [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id) [unique, name: 'workspace_environment_workspace_unique']
  }
}

Table secret_usage {
  id text [pk, not null]
  workspace_id text [not null]
  secret_name text [not null, note: 'Matches `credential.envKey`; the trail is keyed by name, not by credential row.']
  secret_scope secret_usage_scope [not null]
  secret_owner_user_id text [not null, note: 'Whose personal secret this was; empty for a workspace one, which the workspace owns. Two people can hold personal secrets under the same name, and a personal secret shared with the workspace resolves for callers who do not own it, so name and scope alone do not identify a secret. Without this column one person\'s trail would show another\'s runs. Not the same as `actorUserId`: a scheduled run resolves the workflow owner\'s personal slice under the workspace\'s execution actor.']
  source secret_usage_source [not null]
  workflow_id text [not null, note: 'Empty for a Copilot or MCP resolution, which has no workflow. Empty string rather than null because both this and `actorUserId` sit inside the unique key below, and Postgres treats nulls as distinct — two Copilot rows would never collide, so the upsert would insert forever instead of incrementing. A sentinel keeps the upsert identity explicit and null-free rather than relying on nullable uniqueness semantics. Deliberately not a foreign key, and neither is `actorUserId`. An `onDelete: \'set null\'` would rewrite a key column, so two rows differing only by the deleted id would collide and an ordinary workflow or account deletion would fail on this constraint. They are historical facts in a usage ledger rather than live references, so they are stored as plain ids and joined leniently; a row outliving its workflow is the point of a trail.']
  actor_user_id text [not null, note: 'Whose access authorized the resolution — the run\'s actor; empty when there is none.']
  usage_date date [not null, note: 'UTC day bucket.']
  use_count integer [not null]
  last_used_at timestamp [not null]
  last_execution_id text [note: 'Deep-links the most recent run in Logs, where the block and its code are visible.']
  last_trigger text [note: 'The surface the most recent run came in through (`api`, `webhook`, `schedule`, `manual`, `chat`, `copilot`). There is deliberately no separate "triggered by" column: for every trigger kind the executor can name a caller, that caller *is* `actorUserId`, and for the rest (schedule, webhook, workspace key) no human triggered the run at all.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id, secret_name, secret_scope, secret_owner_user_id, source, workflow_id, actor_user_id, usage_date) [unique, name: 'secret_usage_bucket_unique']
    (workspace_id, secret_name, secret_scope, secret_owner_user_id, last_used_at) [name: 'secret_usage_secret_recent_idx']
  }
  Note: 'Per-day rollup of which secrets a run actually resolved. Execution logs cannot answer this. They persist the whole *available* encrypted environment rather than what a run referenced, they only evidence a secret where value-matching redaction happened to fire, and they expire under `DataRetentionSettings.logRetentionHours`. A secret\'s usage trail has to outlive its runs\' logs, so it is written here instead of derived from them. Rows are a rollup rather than one per run: a workflow on a one-minute schedule touching three secrets would otherwise write thousands of rows a day, which is also why this is not `audit_log` — that table is a human-scale compliance surface and machine-scale rows would drown it. `secretScope` and `secretOwnerUserId` are part of the key because a workspace secret and a personal secret can share a name — as can two people\'s personal secrets — and none of them may merge. `lastTriggeredByUserId` is deliberately *not* in the key: a public endpoint called by many people would otherwise fragment one bucket per caller.'
}

Table workspace_byok_keys {
  id text [pk, not null]
  workspace_id text [not null]
  provider_id text [not null]
  encrypted_api_key text [not null]
  name text
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id, provider_id) [name: 'workspace_byok_workspace_provider_idx']
  }
}

Table organization_byok_keys {
  id text [pk, not null]
  organization_id text [not null]
  provider_id text [not null]
  encrypted_api_key text [not null]
  name text
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id, provider_id) [name: 'organization_byok_organization_provider_idx']
  }
}

Table settings {
  id text [pk, not null, note: 'Use the user id as the key']
  user_id text [not null, unique]
  theme text [not null]
  auto_connect boolean [not null]
  telemetry_enabled boolean [not null]
  email_preferences json [not null]
  billing_usage_notifications_enabled boolean [not null]
  super_user_mode_enabled boolean [not null]
  mothership_environment text [not null]
  error_notifications_enabled boolean [not null]
  snap_to_grid_size integer [not null, note: '0 = off, 10-50 = grid size']
  show_action_bar boolean [not null]
  auto_focus_on_click boolean [not null]
  timezone text
  copilot_auto_allowed_tools jsonb [not null, note: 'Copilot auto-allowed integration tools - array of tool IDs that can run without confirmation']
  last_active_workspace_id text
  updated_at timestamp [not null]
  Note: 'contract-pending(after the release that stops declaring them is deployed): drop settings.show_training_controls and settings.copilot_enabled_models — nothing has read or written either since v0.7.56; safe once no deployed release declares them.'
}

Table workflow_schedule {
  id text [pk, not null]
  workflow_id text
  deployment_version_id text
  deployment_operation_id text
  block_id text
  cron_expression text
  next_run_at timestamp
  last_ran_at timestamp
  last_queued_at timestamp
  trigger_type text [not null, note: '"manual", "webhook", "schedule"']
  timezone text [not null]
  failed_count integer [not null]
  infra_retry_count integer [not null]
  status text [not null, note: '\'active\', \'disabled\', or \'completed\'']
  last_failed_at timestamp
  source_type text [not null, note: '\'workflow\' or \'job\'']
  job_title text
  prompt text
  lifecycle text [not null, note: '\'persistent\' or \'until_complete\'']
  success_condition text
  max_runs integer
  run_count integer [not null]
  source_chat_id text
  source_task_name text
  source_user_id text
  source_workspace_id text
  secret_scope text [not null]
  mounted_secrets jsonb [not null]
  job_history jsonb
  contexts jsonb [note: '`@`-mentioned resources / `/`-invoked skills captured with the prompt, resolved into the agent run at fire time.']
  excluded_dates jsonb [note: 'ISO timestamps of recurring occurrences the user deleted individually (EXDATE); the executor skips them.']
  ends_at timestamp [note: 'Recurrence end boundary: the schedule completes once its next run would fall after this instant.']
  run_budget_usd decimal [note: 'A job\'s spend cap per run in USD; the run pauses once its settled cost reaches it. Null takes the default cap. Unused by workflow schedules.']
  archived_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workflow_id, block_id, deployment_version_id) [unique, name: 'workflow_schedule_workflow_block_deployment_unique']
