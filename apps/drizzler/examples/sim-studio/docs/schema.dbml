  routing_key text [note: 'Tenant routing key for shared-app providers, such as Slack `team_id` or TikTok `open_id`, derived server-side from the connected credential at deploy time — never user input. Inbound events match on this after HMAC verification.']
  provider text [note: 'e.g., "whatsapp", "github", etc.']
  provider_config json
