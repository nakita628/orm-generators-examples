    (workflow_id, status) [name: 'workflow_deployment_operation_workflow_status_idx']
    (deployment_version_id) [name: 'workflow_deployment_operation_deployment_version_idx']
    (workflow_id, deployment_version_id, generation) [name: 'workflow_deployment_operation_workflow_version_generation_idx']
  }
  Note: 'Tracks mutable deployment attempts separately from immutable version snapshots.'
}

Table idempotency_key {
