    (organization_id) [name: 'copilot_chats_organization_id_idx']
    (external_conversation_key) [unique, name: 'copilot_chats_external_conversation_unique']
    (user_id, organization_id, created_at, id) [name: 'copilot_chats_user_org_created_idx']
    (workflow_id) [name: 'copilot_chats_workflow_id_idx']
    (user_id, workflow_id) [name: 'copilot_chats_user_workflow_idx']
    (user_id, workspace_id) [name: 'copilot_chats_user_workspace_idx']
    (created_at) [name: 'copilot_chats_created_at_idx']
    (updated_at) [name: 'copilot_chats_updated_at_idx']
    (workspace_id, id) [name: 'copilot_chats_workspace_created_at_id_idx']
    (user_id, workspace_id) [name: 'copilot_chats_user_workspace_deleted_partial_idx']
  }
  Note: 'contract-pending(after the release that stops declaring plan_artifact is deployed): drop copilot_chats.plan_artifact — the plan artifact moved into the message transcript; safe once no deployed release declares the column.'
