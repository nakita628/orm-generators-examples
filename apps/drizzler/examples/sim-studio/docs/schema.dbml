  key_hash text
  type text [not null]
  access api_key_access [not null]
  last_used timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  expires_at timestamp
  indexes {
    (workspace_id, type) [name: 'api_key_workspace_type_idx']
    (user_id, type) [name: 'api_key_user_type_idx']
    (key_hash) [unique, name: 'api_key_key_hash_idx']
  }
}

Table user_stats {
  id text [pk, not null]
  user_id text [not null, unique]
  current_usage_limit decimal [note: 'Default $5 (1,000 credits) for free plan, null for team/enterprise']
  usage_limit_updated_at timestamp
  last_period_cost decimal [note: 'Previous-period usage; written by the cycle-close sweep from ledger sums.']
  billed_overage_this_period decimal [not null, note: 'Threshold/final billing tracker. Incremented when threshold billing collects overage mid-period; reset to zero by the cycle-close sweep at period rollover. It is not incremented by the ordinary per-usage ledger write path. Amount of overage already billed via threshold billing']
  credit_balance decimal [not null, note: 'Credit balance tracker. Still debited/credited by billing lifecycle paths and threshold/final overage collection. It is not a per-usage aggregate counter.']
  last_period_copilot_cost decimal [note: 'Previous-period Copilot cost; written by the cycle-close sweep from copilot-source ledger sums.']
  storage_used_bytes bigint [not null, note: 'Storage upload/delete hot-path tracker for personal plans. This remains a direct aggregate write for personal file storage changes; org-scoped storage writes update `organization.storageUsedBytes`.']
  free_tier_eligible boolean [not null, note: 'Whether the personal free-tier allowance counts toward this user\'s limit. False when the account reuses an identity from a recently deleted account (see `deletedAccountIdentity`): the free allowance is granted once per person, not once per account row. Prepaid credit and paid plans are unaffected.']
  billing_blocked boolean [not null]
  billing_blocked_reason billing_blocked_reason
  limit_notifications jsonb [not null, note: 'Highest usage-limit threshold already emailed per category (e.g. `{ storage: 80, tables: 100 }`). Prevents re-spamming the same warning; re-arms when usage drops back below the re-arm band. Keyed by limit category (\'storage\' | \'tables\'); seats live on `organization`. `credits` instead holds the threshold emailed for the billing period and limit in `creditsPeriod` (start, epoch seconds) and `creditsLimit` (cents), so a new period or a changed limit re-arms it without a reset (see `claimCreditsThreshold`). Dedup granularity is per billing account per category — intentionally NOT per table, so a user hitting the row limit on several tables gets one \'tables\' warning, not one per table (the email still names the table that triggered it).']
}

Table deleted_account_identity {
  identity_hash text [pk, not null, note: 'HMAC-SHA256 (hex) of `<kind>:<canonical identity>`.']
  deleted_at timestamp [not null]
  expires_at timestamp [not null]
  indexes {
    (expires_at) [name: 'deleted_account_identity_expires_at_idx']
  }
  Note: 'Keyed one-way digests of the sign-in identities (canonical email, OAuth provider subject) of accounts deleted at their holder\'s request, kept for a bounded window so a new account on the same identity does not receive a second free-tier allowance. Holds no user id, address, or other profile data. The digests are pseudonymous: the server key (derived from `BETTER_AUTH_SECRET`) can test a candidate identity against them, and rotating that secret orphans them. Rows are purged once `expiresAt` passes.'
}

Table custom_tools {
