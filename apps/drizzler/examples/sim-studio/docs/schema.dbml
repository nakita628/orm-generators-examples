    (organization_id) [name: 'org_member_usage_limit_organization_id_idx']
  }
  Note: 'Per-member usage limit (in dollars) scoped to a single organization. Keyed by `(organizationId, userId)` so it covers both organization members (rows in `member`) and external members (users with workspace permissions in org-owned workspaces but no `member` row). Independent of `user_stats.current_usage_limit`, which is the user\'s personal subscription cap and is nulled for org-scoped members. An absent row means "no per-member cap" (only the pooled org limit applies). Enforced for usage in org-owned workspaces; hosted-only.'
}

Table organization_access_request_settings {
  organization_id text [pk, not null]
  allow_requests boolean [not null]
  updated_at timestamp [not null]
  updated_by text
  Note: 'Organization opt-out; an absent row keeps access requests enabled.'
}

Table permission_access_request {
  id text [pk, not null]
  organization_id text [not null]
  requester_id text [not null]
  workspace_id text
  scope_key text [not null]
  target_key text [not null]
  target jsonb [not null]
  target_label text [not null]
  membership_id text [not null]
  group_id text
  group_name text
  reason text [not null]
  status text [not null]
  decision_reason text
  decided_by text
  decision jsonb
  created_at timestamp [not null]
  updated_at timestamp [not null]
  decided_at timestamp
  indexes {
    (organization_id, requester_id, scope_key, target_key) [unique, name: 'permission_access_request_pending_unique']
    (organization_id, status, created_at, id) [name: 'permission_access_request_org_queue_idx']
    (organization_id, requester_id, scope_key, created_at, id) [name: 'permission_access_request_requester_idx']
  }
  Note: 'Durable review history, scoped to the organization that owned the request at creation.'
}

Table invitation {
  id text [pk, not null]
  kind invitation_kind [not null]
  email text [not null]
  inviter_id text [not null]
  organization_id text
  membership_intent invitation_membership_intent [not null]
  role text [not null]
  status invitation_status [not null]
  token text [not null, unique]
  expires_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (email) [name: 'invitation_email_idx']
    (organization_id) [name: 'invitation_organization_id_idx']
    (status) [name: 'invitation_status_idx']
    (email, organization_id) [unique, name: 'invitation_pending_email_org_unique']
  }
}

Table workspace {
  id text [pk, not null]
  name text [not null]
  color text [not null]
  logo_url text
  owner_id text [not null, note: 'checks. The owner→admin derivation is redundant: every workspace owner already has an explicit `admin` row in `permissions` (verified across all production workspaces) and all creation paths add one. Retained only as the lifecycle anchor — `onDelete: \'cascade\'` cleans up a user\'s workspaces on account deletion — and the ownership-transfer target when an owner is removed. For admin checks use explicit `permissions` rows; for the workspace\'s principal billing identity use `billedAccountUserId`. DO NOT DELETE.']
  organization_id text
  organization_scope_key text [note: 'Encodes nullable organization identity for the composite membership foreign key.']
  projectId workspaceProjectIdColumn
  workspace_mode workspace_mode [not null]
  billed_account_user_id text [not null]
  storage_used_bytes bigint [not null, note: 'Durable workspace-first storage ledger. Invariant: this non-negative total and the currently routed payer aggregate change atomically while the workspace row is locked. A payer identity change moves this entire total old payer -> new payer in the same transaction.']
  allow_personal_api_keys boolean [not null]
  inbox_enabled boolean [not null]
  inbox_address text
  inbox_provider_id text
  inbox_secret_scope text [not null]
  inbox_mounted_secrets jsonb [not null]
  archived_at timestamp
  organization_assigned_at timestamp
  forked_from_workspace_id text
  fork_sync_new_workflows_excluded boolean [not null, note: 'Whether a newly created workflow in this workspace starts outside fork sync. `false` (default): new workflows join sync once deployed. `true`: they land with `workflow.forkSyncExcluded` set and are opted in on the Forks page. Uniform across a fork lineage (written to every member, inherited by new forks) and forward-only: flipping it never rewrites an existing workflow\'s `forkSyncExcluded`.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (id, projectId) [unique, name: 'workspace_id_project_unique']
    (owner_id) [name: 'workspace_owner_id_idx']
    (organization_id) [name: 'workspace_organization_id_idx']
    (billed_account_user_id) [name: 'workspace_billed_account_user_id_idx']
    (projectId, id) [name: 'workspace_project_id_id_idx']
    (workspace_mode) [name: 'workspace_mode_idx']
    (forked_from_workspace_id) [name: 'workspace_forked_from_workspace_id_idx']
    (inbox_provider_id) [unique, name: 'workspace_inbox_provider_id_idx']
  }
}

Table project {
  id text [pk, not null]
  name text [not null]
  organization_id text
  organization_scope_key text [note: 'Encodes nullable organization identity for the composite membership foreign key.']
  owner_id text [not null, note: 'Lifecycle owner for personal and organization Projects; never an implicit access grant.']
  archived_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (id, organization_scope_key) [unique, name: 'project_id_organization_scope_unique']
    (organization_id, archived_at, id) [name: 'project_organization_archive_id_idx']
    (owner_id, archived_at, id) [name: 'project_owner_archive_id_idx']
  }
  Note: 'Stable owner of environments and project-wide resources, independent of fork lineage.'
}

Table workspace_fork_resource_map {
  id text [pk, not null]
  child_workspace_id text [not null]
  resource_type workspace_fork_resource_type [not null]
  parent_resource_id text [not null]
  child_resource_id text
  created_by text [note: 'SET NULL (not CASCADE): deleting the creating user must not delete the fork\'s identity mappings, which the edge depends on for every future promote.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (child_workspace_id, resource_type, parent_resource_id) [unique, name: 'workspace_fork_resource_map_child_type_parent_unique']
  }
}

Table workspace_fork_block_map {
  id text [pk, not null]
  child_workspace_id text [not null]
  parent_workflow_id text [not null]
  parent_block_id text [not null]
  child_workflow_id text [not null]
  child_block_id text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (child_workspace_id, parent_block_id) [unique, name: 'workspace_fork_block_map_child_ws_parent_unique']
    (child_workspace_id, child_block_id) [unique, name: 'workspace_fork_block_map_child_ws_child_unique']
    (child_workspace_id, parent_workflow_id) [name: 'workspace_fork_block_map_child_ws_parent_wf_idx']
    (child_workspace_id, child_workflow_id) [name: 'workspace_fork_block_map_child_ws_child_wf_idx']
  }
  Note: 'Stable 1:1 block-identity map between a fork (child) and its parent, per edge. Seeded at fork creation (parent block -> derived child block) and reconciled on every promote. Promote looks a source block up here to reuse its counterpart\'s EXISTING id instead of re-deriving: without it, pushing a fork\'s workflow over the parent would re-key the parent\'s blocks and change their webhook URLs (the path falls back to the block id). Each pair records BOTH workflow ids so a lookup can be scoped to the workflow it belongs to: a target workflow that was archived and re-created gets a fresh id (the pair no longer matches), which avoids reusing an archived workflow\'s block id and colliding on the global `workflow_blocks` primary key. Block ids are plain text (no FK to `workflow_blocks`, which is rewritten on every deploy); only the edge (`child_workspace_id`) cascades. A parent block can map to different children across sibling forks, so uniqueness is per (edge, parent) and per (edge, child).'
}

Table workspace_fork_dependent_value {
  id text [pk, not null]
  child_workspace_id text [not null]
  target_workflow_id text [not null]
  target_block_id text [not null]
  sub_block_key text [not null]
  value text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (child_workspace_id, target_workflow_id, target_block_id, sub_block_key) [unique, name: 'workspace_fork_dependent_value_field_unique']
  }
  Note: 'The user\'s stored dependent-field re-picks for an edge: a (target workflow, target block, subblock) -> selected value mapping (a Gmail label, a KB document, a sheet tab). The sync modal reads and writes this, and every promote applies it verbatim - it is the single source of truth for dependent values, replacing the old implicit "preserve the target\'s value if the credential is unchanged" path. Block ids are plain text (no FK to `workflow_blocks`, which is rewritten on every deploy); only the edge (`child_workspace_id`) cascades. The target workflow id encodes direction (push -> parent workflow, pull -> child workflow), so no separate direction column is needed.'
}

Table workspace_fork_promote_run {
  id text [pk, not null]
  child_workspace_id text [not null]
  source_workspace_id text [not null]
  target_workspace_id text [not null]
  direction workspace_fork_promote_direction [not null]
  snapshot jsonb [not null]
  created_by text [note: 'SET NULL (not CASCADE): deleting the creating user must not delete a pending undo point for a target workspace.']
  created_at timestamp [not null]
  indexes {
    (child_workspace_id, target_workspace_id) [unique, name: 'workspace_fork_promote_run_child_ws_target_unique']
    (target_workspace_id) [name: 'workspace_fork_promote_run_target_ws_idx']
  }
}

Table workspace_fork_workflow_sync {
  deployment_operation_id text [pk, not null]
  child_workspace_id text [not null]
  source_workflow_id text [not null]
  target_workflow_id text [not null]
  source_deployment_version_id text [not null]
  sequence bigint [increment]
  promote_run_id text [not null]
  activated_at timestamp
  rollback_operation_id text
  rolled_back_at timestamp
  indexes {
    (child_workspace_id, source_workflow_id, target_workflow_id, sequence) [name: 'workspace_fork_workflow_sync_baseline_idx']
    (promote_run_id, target_workflow_id) [name: 'workspace_fork_workflow_sync_run_idx']
    (rollback_operation_id) [name: 'workspace_fork_workflow_sync_rollback_idx']
    (source_workflow_id) [name: 'workspace_fork_workflow_sync_source_idx']
    (target_workflow_id) [name: 'workspace_fork_workflow_sync_target_idx']
    (child_workspace_id) [name: 'workspace_fork_workflow_sync_child_workspace_idx']
  }
  Note: 'Source provenance survives deployment-operation retention and deleted source snapshots.'
}

Table background_work_status {
  id text [pk, not null]
  workspace_id text [not null]
  workflow_id text
  kind background_work_kind [not null]
  status background_work_status_value [not null]
  message text
  error text
  metadata jsonb
  started_at timestamp [not null]
  completed_at timestamp
  updated_at timestamp [not null]
  indexes {
    (workspace_id, status) [name: 'background_work_status_workspace_status_idx']
    (workflow_id, status) [name: 'background_work_status_workflow_status_idx']
  }
  Note: 'Durable status for asynchronous background work (post-sync/rollback deployment side-effects and fork content copy), so the canvas can show a "work in progress" banner that survives a reload. A row scoped to a single workflow sets `workflowId`; workspace-spanning work (fork content copy) leaves it null.'
}

Table workspace_operation_receipt {
  id text [pk, not null]
  workspace_id text [not null]
  request_id text [not null]
  request_hash text [not null]
  kind text [not null]
  report jsonb [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id, request_id) [unique, name: 'workspace_operation_receipt_request_unique']
    (workspace_id, created_at, id) [name: 'workspace_operation_receipt_workspace_created_idx']
  }
  Note: 'Workspace-lifetime mutation deduplication and bounded, durable operation reports.'
}

Table workspace_file {
  id text [pk, not null]
  workspace_id text [not null]
  name text [not null]
  key text [not null, unique]
  size integer [not null]
  type text [not null]
  uploaded_by text [not null]
  deleted_at timestamp
  uploaded_at timestamp [not null]
  indexes {
    (workspace_id) [name: 'workspace_file_workspace_id_idx']
    (deleted_at) [name: 'workspace_file_deleted_at_idx']
    (workspace_id, deleted_at) [name: 'workspace_file_workspace_deleted_partial_idx']
    (uploaded_by) [name: 'workspace_file_uploaded_by_idx']
  }
}

Table dashboard {
  id text [pk, not null]
  workspace_id text [not null]
  content text [not null]
  revision integer [not null]
  created_by text
  updated_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id) [unique, name: 'dashboard_workspace_id_unique']
  }
  Note: 'A dashboard: YAML over live tables, built by Sim. `revision` guards against lost updates. The unique workspace index keeps one dashboard per workspace; dropping it allows several.'
}

Table workflow_test {
  id text [pk, not null]
  workspace_id text [not null]
  name text [not null]
  title text [not null]
  description text
  body_file_id text [not null]
  cases jsonb [not null, note: 'Every `describe > it` path in the file with its mode (`run`, `only`, `skip`).']
  source_hash text [not null, note: 'sha256 of the source `cases` was read from; a run reporting another hash is stale.']
  created_by_user_id text
  deleted_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id, name) [unique, name: 'workflow_test_workspace_name_unique']
    (body_file_id) [unique, name: 'workflow_test_body_file_unique']
  }
  Note: 'A workflow test file: one concern, read as `tests/<name>.test.js`. `tests create` sets the name, title, and description; the source is a workspace file with `context = \'test\'`, so it keeps versions and Sim\'s file edits, and `cases` is what its last accepted write declared.'
}

Table workflow_test_run {
  id text [pk, not null]
  test_id text [not null]
  workspace_id text [not null]
  version text [not null]
  status text [not null]
  passed integer [not null]
  failed integer [not null]
  skipped integer [not null]
  report jsonb [note: 'The sandbox report: every case\'s checks, judge reasons, logs, and executions.']
  error text [note: 'Why the file produced no report: it did not load, or the run itself failed.']
  source_hash text [note: 'sha256 of the source this run executed; null when it failed before reading the file.']
  ran_against jsonb [note: '`{ workflowId, deploymentVersionId }` for each workflow the run executed; null draft ids.']
  progress jsonb [note: 'Each case\'s status (`running`, `pass`, `fail`, `skip`) by `describe > it` path, as it runs.']
  triggered_by_actor jsonb [not null]
  triggered_by_user_id text
  started_at timestamp [not null]
  completed_at timestamp
  indexes {
    (test_id, version, started_at) [name: 'workflow_test_run_test_version_started_idx']
  }
  Note: 'One run of a test file against the draft or deployed workflows.'
}

Table changelog_release {
  id text [pk, not null]
  workspace_id text [not null]
  title text [not null]
  version_major integer [not null]
  version_minor integer [not null]
  version_patch integer [not null]
  bump_reason text [not null]
  body_file_id text [not null]
  revision integer [not null]
  published_at timestamp [not null]
  created_by text
  updated_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id, version_major, version_minor, version_patch) [unique, name: 'changelog_release_workspace_version_unique']
    (body_file_id) [unique, name: 'changelog_release_body_file_unique']
    (workspace_id, published_at, id) [name: 'changelog_release_workspace_published_idx']
  }
  Note: 'A published changelog release, read as `changelog/<id>.md`. The body is a workspace file with `context = \'changelog\'`, so it keeps versions and Sim\'s file edits. The version is a label: Sim picks the bump, the server computes the number, and people may relabel it; links use the id. `revision` guards the release\'s own fields against lost updates.'
}

Table changelog_change {
  id text [pk, not null]
  release_id text [not null]
  position integer [not null]
  text text [not null]
  workflow_id text
  deployment_version_id text
  chat_id uuid
  indexes {
    (release_id, position) [unique, name: 'changelog_change_release_position_unique']
  }
  Note: 'One line of a release: what changed, and where it came from when Sim knows.'
}

Table workspace_files {
  id text [pk, not null]
  project_id text [note: 'Direct owner, independent of creator, caller, and billing payer.']
  key text [not null]
  user_id text [not null]
  workspace_id text
  organization_id text
  folder_id text
  context text [not null, note: '\'workspace\', \'mothership\', \'copilot\', \'chat\', \'knowledge-base\', \'profile-pictures\', \'general\', \'execution\'']
  chat_id uuid
  message_id text [note: 'Logical id of the copilot message this file was born in (the user message the upload was attached to). Plain text with no FK: message ids are only unique per chat — the same id legitimately exists in the source chat and every fork of it, which is what lets a fork\'s "copy files at-or-before this message" cut match rows in both. NULL means "birth unknown / not tracked": rows predating this column and contexts that don\'t stamp it. Nulled together with chatId when a file is materialized to the workspace.']
  original_name text [not null]
  display_name text [note: 'Collision-disambiguated name exposed to the copilot VFS as `uploads/<displayName>`. For mothership chat uploads, identical originalNames within a chat get suffixed `(2)`, `(3)`, ... in upload order so the VFS path is unique per chat. NULL on legacy rows that predate this column — readers must coalesce to originalName. Stable for the row\'s lifetime; the partial unique index below enforces uniqueness for new (non-NULL) rows. NULLs are treated as distinct in PG unique indexes, so legacy collisions remain (acceptable: those uploads have already happened).']
  content_type text [not null]
  size_bytes bigint [note: 'Exact byte size.']
  width integer [note: 'Intrinsic pixel dimensions of an image file, captured lazily on first view (and stored so later views reserve layout space before the image loads, via aspect-ratio). NULL for non-images and for rows not yet backfilled. Purely a rendering hint — never affects stored file content.']
  height integer
  deleted_at timestamp
  uploaded_at timestamp [not null]
  updated_at timestamp [not null]
  content_updated_at timestamp [not null, note: 'Content-scoped version: advances ONLY when the file\'s CONTENT changes (upload / content overwrite), never on metadata writes (rename, move, soft-delete, restore). It is the optimistic-concurrency validator the collaborative-document persist guards on (RFC 7232 `If-Match` semantics: validate the representation, not the row) — so a rename can\'t make a racing live-doc persist see a stale token, reconcile stale durable content, and clobber in-flight edits. NOT NULL with a `now()` default: Postgres applies this as a fast-default (no table rewrite), existing rows get a stable timestamp that — like every metadata write — never advances it, and every insert path is covered without per-call plumbing. Only a content write (upload / overwrite) advances it. MILLISECOND precision is an invariant, not an incidental detail. This value is a revision identity that round-trips through JavaScript `Date` and JSON — search-index dispatch payloads, If-Match tokens, realtime versions — all of which truncate to milliseconds, while `now()` stores microseconds. A sub-millisecond value therefore stops comparing equal to its own round-trip, and every SQL equality keyed on it matches zero rows: a file whose `workspace_file_search_index.source_content_updated_at` came from such a round trip can never be claimed, indexed, or cleaned up. The default truncates, and the `workspace_files_content_version_millisecond` trigger enforces it for the writers a default cannot reach — explicit `CURRENT_TIMESTAMP` expressions, raw SQL inserts, and updates that change row data. Relationship fences that only advance the row version preserve an existing revision.']
  secret_provenance_version integer [note: 'Durable cutover marker for content secret provenance. NULL is reserved for legacy rows and writes from app versions that predate tracking. Provenance-aware writers set version 1 in the same transaction as the matching sidecar. A tracked version without a matching sidecar fails closed.']
  indexes {
    (project_id, id) [name: 'workspace_files_project_id_idx']
    (project_id, original_name) [unique, name: 'workspace_files_project_folder_name_active_unique']
    (key) [unique, name: 'workspace_files_key_active_unique']
    (workspace_id, original_name) [unique, name: 'workspace_files_workspace_folder_name_active_unique']
    (id) [name: 'workspace_files_search_owner_keyset_idx']
    (workspace_id, id) [name: 'workspace_files_workspace_active_keyset_idx']
    (workspace_id, uploaded_at, id) [name: 'workspace_files_workspace_active_uploaded_idx']
    (workspace_id, updated_at, id) [name: 'workspace_files_workspace_active_updated_idx']
    (workspace_id, uploaded_at, id) [name: 'workspace_files_workspace_folder_uploaded_idx']
    (workspace_id, original_name) [type: gin, name: 'workspace_files_workspace_name_trgm_idx']
    (workspace_id) [name: 'workspace_files_workspace_display_name_idx']
    (chat_id, display_name) [unique, name: 'workspace_files_chat_display_name_unique']
    (organization_id) [name: 'workspace_files_organization_id_idx']
    (key) [name: 'workspace_files_key_idx']
    (user_id) [name: 'workspace_files_user_id_idx']
    (workspace_id) [name: 'workspace_files_workspace_id_idx']
    (folder_id) [name: 'workspace_files_folder_id_idx']
    (context) [name: 'workspace_files_context_idx']
    (chat_id) [name: 'workspace_files_chat_id_idx']
    (deleted_at) [name: 'workspace_files_deleted_at_idx']
    (workspace_id, deleted_at) [name: 'workspace_files_workspace_deleted_partial_idx']
  }
}

Table workspace_file_search_index {
  file_id text [not null]
  workspace_id text [not null]
  source_content_updated_at timestamp [not null]
  status workspace_file_search_index_status [not null]
  partial boolean [not null]
  failure_reason text
  line_count integer [not null]
  indexed_bytes integer [not null]
  dispatched_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (file_id, source_content_updated_at) [pk]
    (workspace_id, status, source_content_updated_at) [name: 'workspace_file_search_index_workspace_status_idx']
    (workspace_id, updated_at, file_id, source_content_updated_at) [name: 'workspace_file_search_index_pending_dispatch_idx']
    (workspace_id, dispatched_at) [name: 'workspace_file_search_index_active_dispatch_idx']
  }
  Note: 'contract-pending(chunk search fully deployed): retire legacy index state and segments after rollback window.'
}

Table workspace_file_search_dispatch_queue {
  workspace_id text [pk, not null]
  enqueued_at timestamp [not null]
  last_dispatched_at timestamp
  updated_at timestamp [not null]
  indexes {
    (last_dispatched_at, enqueued_at, workspace_id) [name: 'workspace_file_search_dispatch_queue_schedule_idx']
  }
  Note: 'contract-pending(after owner-aware search workers are fully deployed): retire this queue and dual enqueue after old dispatchers and retries drain.'
}

Table file_search_dispatch_queue {
  entity_type text [not null]
  entity_id text [not null]
  enqueued_at timestamp [not null]
  last_dispatched_at timestamp
  updated_at timestamp [not null]
  indexes {
    (entity_type, entity_id) [pk]
    (last_dispatched_at, enqueued_at, entity_type, entity_id) [name: 'file_search_dispatch_schedule_idx']
  }
  Note: 'Owner-neutral dispatch replaces the workspace-only queue after older workers drain.'
}

Table workspace_file_search_backfill {
  id text [pk, not null]
  after_workspace_id text
  after_entity_type text
  after_entity_id text
  after_file_id text
  completed_at timestamp
  updated_at timestamp [not null]
  Note: 'Singleton keyset cursor for the resumable initial workspace-file search backfill.'
}

Table workspace_file_search_segment {
  file_id text [not null]
  workspace_id text [not null]
  source_content_updated_at timestamp [not null]
  line_number integer [not null]
  segment_number integer [not null]
  segment_start integer [not null]
  line_length integer [not null]
  content text [not null]
  indexes {
    (file_id, source_content_updated_at, line_number, segment_number) [pk]
    (workspace_id, file_id, source_content_updated_at) [name: 'workspace_file_search_segment_workspace_revision_idx']
    (workspace_id, content) [type: gin, name: 'workspace_file_search_segment_workspace_content_trgm_idx']
  }
  Note: 'Bounded, overlapping logical-line segments searched through PostgreSQL trigram indexes.'
}

Table workspace_file_search_build {
  id text [pk, not null]
  file_id text [not null]
  workspace_id text
  entity_type text
  entity_id text
  artifact_key text
  source_content_updated_at timestamp [not null]
  created_at timestamp [not null]
  expires_at timestamp [note: 'Null only for a completely published build; abandoned workers expire automatically.']
  indexes {
    (file_id) [name: 'workspace_file_search_build_file_idx']
    (expires_at, id) [name: 'workspace_file_search_build_cleanup_idx']
  }
  Note: 'Builds outlive file deletion so their text can be reclaimed in bounded background batches.'
}

Table workspace_file_search_revision {
  file_id text [pk, not null]
  workspace_id text
  entity_type text
  entity_id text
  source_content_updated_at timestamp [not null]
  status workspace_file_search_index_status [not null]
  build_id text
  failure_reason text
  line_count integer [not null]
  indexed_bytes integer [not null]
  chunk_count integer [not null]
  dispatched_at timestamp
  handoff_expires_at timestamp [note: 'Deadline for a claim\'s run to be handed off, in PostgreSQL time. Set with the claim and cleared once a run is known to exist: Trigger.dev accepted it, in-process indexing took it, or it began its build. A claim still carrying an expired deadline has no run known to exist and is released, and its token fences out any run it did get. NULL otherwise, including claims made before this column existed, which fall back to the stale-dispatch window.']
  updated_at timestamp [not null]
  indexes {
    (updated_at, file_id, source_content_updated_at) [name: 'file_search_revision_owner_pending_idx']
    (status, dispatched_at) [name: 'file_search_revision_owner_status_idx']
    (workspace_id, status) [name: 'workspace_file_search_revision_workspace_status_idx']
    (build_id) [name: 'workspace_file_search_revision_build_idx']
    (workspace_id, updated_at, file_id, source_content_updated_at) [name: 'workspace_file_search_revision_pending_idx']
    (dispatched_at, workspace_id) [name: 'workspace_file_search_revision_active_idx']
  }
  Note: 'One current revision per file. The build identity fences retries and publishes complete coverage.'
}

Table workspace_file_search_chunk {
  build_id text [not null]
  workspace_id text
  entity_type text
  entity_id text
  ordinal integer [not null]
  line_start integer [not null]
  fragment boolean [not null]
  overlap integer [not null]
  content text [not null]
  indexes {
    (build_id, ordinal) [pk]
    (entity_type, entity_id, content) [type: gin, name: 'file_search_chunk_owner_content_idx']
    (build_id, line_start, ordinal) [name: 'workspace_file_search_chunk_line_idx']
    (workspace_id, content) [type: gin, name: 'workspace_file_search_chunk_content_idx']
  }
  Note: 'UTF-8 byte-bounded blocks; long-line fragments overlap only for conservative candidate lookup.'
}

Table file_search_dependency {
  build_id text [not null]
  file_id text [not null]
  key text [not null]
  source_content_updated_at timestamp [not null]
  entity_type text [note: 'The build\'s canonical owner, always derived from the build by the `file_search_dependency_owner` trigger, so the dispatcher can find an owner\'s stale dependencies without testing every ready revision.']
  entity_id text
  indexes {
    (build_id, file_id) [pk]
    (file_id, build_id) [name: 'file_search_dependency_file_idx']
    (entity_type, entity_id, build_id) [name: 'file_search_dependency_owner_idx']
  }
  Note: 'A bounded compiled-input manifest outlives input deletion until its build is retired.'
}

Table upload_session {
  id text [pk, not null]
  token_hash text [not null]
  user_id text [not null]
  workspace_id text
  knowledge_base_id text
  workflow_id text
  execution_id text
  purpose upload_session_purpose [not null]
  method upload_session_method [not null]
  storage_context text [not null]
  final_key text [not null]
  storage_provider upload_session_provider [not null]
  provider_upload_id text
  provider_object_version text
  file_name text [not null]
  content_type text [not null]
  file_size bigint [not null]
  part_size integer
  part_count integer
  status upload_session_status [not null]
  metadata jsonb [not null]
  processing_lease_id text
  processing_lease_expires_at timestamp
  completed_file_id text
  error text
  created_at timestamp [not null]
  expires_at timestamp [not null]
  completed_at timestamp
  updated_at timestamp [not null]
  indexes {
    (token_hash) [unique, name: 'upload_session_token_hash_unique']
    (final_key) [unique, name: 'upload_session_final_key_unique']
    (status, expires_at) [name: 'upload_session_status_expires_at_idx']
  }
  Note: 'Durable control-plane state for direct-to-provider PUT and multipart uploads.'
}

Table workspace_file_secret_provenance {
  file_id text [pk, not null]
  content_updated_at timestamp [not null]
  status text [not null]
  entries jsonb [not null]
  updated_at timestamp [not null]
  Note: 'Private, durable provenance for bytes stored in `workspace_files`. Absence is reserved for legacy files that predate provenance tracking. `exact` records carry the encrypted values found in one content version (including an empty set); `unknown` records fail closed at model attachment boundaries. Keeping this one-to-one state outside `workspace_files` prevents private metadata from leaking through broad workspace-file record projections.'
}

Table workspace_file_collab_state {
  file_id text [pk, not null]
  doc_state bytea [not null, note: '`Y.encodeStateAsUpdate` of the collaborative doc at last persist — apply with `Y.applyUpdate`.']
  source_hash text [not null, note: 'sha256 (hex) of the markdown `docState` was derived from — the freshness tag for cold-start.']
  updated_at timestamp [not null]
  Note: 'Cached collaborative-document state for a workspace markdown file: the last-persisted Yjs binary and a hash of the markdown it was derived from. On a cold room open the seed loads this binary directly (the Hocuspocus load-document pattern) rather than re-converting markdown → Yjs — which avoids the "recreate the CRDT from a non-binary format" anti-pattern (fresh client ids / content duplication on reconnect) and the server-side headless-editor conversion. The row is STALE, and the seed re-converts from markdown, when `sourceHash` no longer matches the file\'s current markdown (edited externally by a copilot write or a direct save). One row per file; dropped by FK cascade when the file is deleted.'
}

Table workspace_file_version {
  id text [pk, not null]
  file_id text [not null]
  workspace_id text [note: 'Compatibility scope, checked against fileId; Project versions derive their owner from the file.']
  version integer [not null]
  key text [not null]
  size_bytes bigint [not null]
  content_type text [not null]
  content_hash text [note: 'sha256 (hex) of the bytes; NULL for an implicit version materialized without reading them.']
  superseded_at timestamp
  source workspace_file_version_source [not null]
  author_user_ids text [not null, note: 'Users who wrote these bytes, in first-contribution order; empty when unattributable.']
  restored_from_version integer
  secret_provenance_status text
  secret_provenance_entries jsonb [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (file_id, version) [unique, name: 'workspace_file_version_file_version_unique']
    (key) [unique, name: 'workspace_file_version_key_unique']
    (workspace_id, id) [name: 'workspace_file_version_workspace_id_idx']
    (workspace_id, superseded_at) [name: 'workspace_file_version_workspace_superseded_idx']
  }
  Note: 'One content state of a workspace file. Rows cover every state since versioning began, including the current one (the row whose `key` equals `workspace_files.key`); a file with no rows has an implicit version 1 that the first content write materializes. Each row owns an immutable storage object, so a key referenced here must never be deleted while the row exists. `supersededAt` is NULL only for the current version and is the age retention measures from. `secretProvenanceStatus` NULL means the bytes predate provenance tracking (reads as exact-empty, like `workspace_files.secret_provenance_version` NULL); otherwise the status and entries are a snapshot of the sidecar for exactly these bytes, which a revert must reinstate.'
}

Table public_share {
  id text [pk, not null]
  resource_type text [not null, note: '\'file\' | \'folder\' (folder reserved for future)']
  resource_id text [not null]
  entity_type text
  entity_id text
  workspace_id text
  created_by text [note: 'SET NULL (not CASCADE) so a share — and its public link — outlives the user who created it; the shared file keeps its durable owner.']
  token text [not null]
  is_active boolean [not null]
  auth_type text [not null, note: '\'public\' (anyone with the link) | \'password\' | \'email\' (OTP) | \'sso\'.']
  password text [note: 'AES-256-GCM encrypted share password; null unless authType is \'password\'.']
  allowed_emails json [note: 'Allowed emails/domains (e.g. \'@acme.com\') when authType is \'email\' or \'sso\'.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (entity_type, entity_id, resource_type) [name: 'public_share_entity_id_idx']
    (token) [unique, name: 'public_share_token_unique']
    (resource_type, resource_id) [unique, name: 'public_share_resource_unique']
    (resource_id) [name: 'public_share_resource_id_idx']
    (workspace_id) [name: 'public_share_workspace_id_idx']
  }
  Note: 'Public share links for workspace resources. Polymorphic on `resourceType` so a single mechanism serves files now and folders later. One row per resource (disable/re-enable flips `isActive` and keeps the same token).'
}

Table invitation_workspace_grant {
  id text [pk, not null]
  invitation_id text [not null]
  workspace_id text [not null]
  permission permission_type [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (invitation_id, workspace_id) [unique, name: 'invitation_workspace_grant_unique']
    (workspace_id) [name: 'invitation_workspace_grant_workspace_id_idx']
  }
}

Table permissions {
  id text [pk, not null]
  user_id text [not null]
  entity_type text [not null, note: '\'workspace\', \'workflow\', \'organization\', etc.']
  entity_id text [not null]
  permission_type permission_type [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (entity_type, entity_id) [name: 'permissions_entity_idx']
    (user_id, entity_type, permission_type) [name: 'permissions_user_entity_permission_idx']
    (user_id, entity_type, entity_id) [unique, name: 'permissions_unique_constraint']
  }
  Note: 'Polymorphic access grants: `entityType` + `entityId` reference a workspace, workflow, organization, etc. by id, but `entityId` is **not a foreign key** — so deleting the referenced entity does NOT cascade-delete these rows. Soft deletes (e.g. workspace archive) intentionally keep them: the entity is blocked everywhere by its `archivedAt`, so the rows are harmless, and a future restore would need them. Only a **hard** delete/purge of an entity must remove its grants explicitly — e.g. `DELETE FROM permissions WHERE entity_type = \'workspace\' AND entity_id = $id` — or they orphan.'
}

Table memory {
  id text [pk, not null]
  workspace_id text [not null]
  key text [not null]
  data jsonb [not null]
  storage_version integer [not null, note: 'Version 2 keeps data as an immutable prefix and appends ordered memory items.']
  encrypted_context_summary text [note: 'One replaceable derived context summary; never part of the public message projection.']
  secret_provenance_version integer [note: 'NULL is a legacy/untracked record; version 1 requires a fresh private sidecar.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
  indexes {
    (key) [name: 'memory_key_idx']
    (workspace_id, key) [unique, name: 'memory_workspace_key_idx']
    (workspace_id, deleted_at) [name: 'memory_workspace_deleted_partial_idx']
  }
}

Table memory_secret_provenance {
  memory_id text [pk, not null]
  content_hash text [not null]
  status text [not null]
  entries jsonb [not null]
  updated_at timestamp [not null]
  Note: 'Private provenance bound to one exact canonical hash of the persisted memory data.'
}

Table memory_item {
  id text [pk, not null]
  memory_id text [not null]
  sequence bigint [increment]
  append_key text [not null]
  turn_id text
  kind text [not null]
  data jsonb [not null]
  content_hash text [not null]
  provenance_status text [not null]
  provenance_entries jsonb [not null]
  created_at timestamp [not null]
  indexes {
    (memory_id, append_key) [unique, name: 'memory_item_append_unique']
    (memory_id, sequence) [name: 'memory_item_sequence_idx']
  }
  Note: 'Ordered additions to a conversation; exchange payloads remain private to Agent history.'
}

Table agent_memory_turn {
  id text [pk, not null]
  memory_id text [not null]
  workflow_id text [not null]
  execution_id text [not null]
  block_id text [not null]
  node_id text [not null]
  execution_order integer [not null]
  encrypted_state text
  revision integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (memory_id, workflow_id, execution_id, block_id, node_id, execution_order) [unique, name: 'agent_memory_turn_invocation_unique']
    (workflow_id) [name: 'agent_memory_turn_workflow_idx']
  }
  Note: 'Recovery journal for one logical Agent invocation; provider state is encrypted by its owner.'
}

Table memory_artifact {
  memory_id text [not null]
  key text [not null]
  indexes {
    (memory_id, key) [pk]
    (key) [name: 'memory_artifact_key_idx']
  }
  Note: 'Retains large tool results for the lifetime of their conversation rather than their run log.'
}

Table organization_search_integration {
  organization_id text [not null]
  connector_type text [not null]
  approved boolean [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id, connector_type) [pk]
  }
  Note: 'Organization Search approval is independent of credentials, sources, and sync status.'
}

Table knowledge_base {
  id text [pk, not null]
  user_id text [not null]
  workspace_id text
  organization_id text
  folder_id text
  name text [not null]
  description text
  is_search_index boolean [not null, note: 'Search indexes retain their identity independently of their display name.']
  token_count integer [not null]
  embedding_model text [not null]
  embedding_dimension integer [not null]
  chunking_config json [not null]
  deleted_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [name: 'kb_organization_id_idx']
    (organization_id) [unique, name: 'kb_organization_search_index_unique']
    (organization_id, name) [unique, name: 'kb_organization_name_active_unique']
    (workspace_id) [name: 'kb_workspace_id_idx']
    (user_id, workspace_id) [name: 'kb_user_workspace_idx']
    (folder_id) [name: 'kb_folder_id_idx']
    (deleted_at) [name: 'kb_deleted_at_idx']
    (workspace_id, deleted_at) [name: 'kb_workspace_deleted_partial_idx']
    (workspace_id, name) [unique, name: 'kb_workspace_name_active_unique']
    (workspace_id) [unique, name: 'kb_workspace_search_index_unique']
  }
}

Table knowledge_base_import {
  id text [pk, not null]
  workspace_id text [not null]
  user_id text [not null, note: 'Attribution only, with no foreign key: the row is the janitor\'s handle on the bundle and the base, so it must outlive its importer\'s account.']
  source_key text [not null, note: 'The uploaded archive, deleted once the import settles.']
  knowledge_base_id text
  status text [not null]
  documents_total integer [not null]
  documents_imported integer [not null]
  documents_failed integer [not null]
  vectors_reused boolean [not null, note: 'Whether the bundle\'s vectors matched this deployment\'s embedding model and were kept.']
  failures jsonb [not null, note: 'The first few documents that could not be imported, as `{ filename, message }`.']
  error text
  created_at timestamp [not null]
  started_at timestamp [note: 'When a worker claimed the import; unset, a retried completion dispatches it again.']
  updated_at timestamp [not null]
  completed_at timestamp
  indexes {
    (status, updated_at) [name: 'knowledge_base_import_watchdog_idx']
    (knowledge_base_id) [name: 'knowledge_base_import_knowledge_base_id_idx']
  }
  Note: 'One knowledge-base bundle import, from the moment its uploaded archive is complete. The id is the upload session\'s id, so the resource keeps one id across both halves of its life; the base it creates is linked once it exists.'
}

Table document {
  id text [pk, not null]
  knowledge_base_id text [not null]
  filename text [not null]
  file_url text [not null]
  storage_key text [note: 'Canonical storage key derived from fileUrl at write time (e.g. \'kb/<...>\'), or null for external/data: ingestion URLs. KB file authorization matches on this exact key rather than re-parsing the URL at read time.']
  file_size integer [not null, note: 'Size in bytes']
  mime_type text [not null, note: 'e.g., \'application/pdf\', \'text/plain\'']
  chunk_count integer [not null]
  token_count integer [not null]
  character_count integer [not null]
  processing_status text [not null, note: '\'pending\', \'processing\', \'completed\', \'failed\'']
  processing_attempts integer [not null, note: 'Dispatches spent on this document since its last successful pass. A bounded retry budget, not a dispatch generation. The stuck-document sweep re-dispatches a failing document every sync for the whole retry window, and each dispatch re-parses and re-embeds it — so a document that fails deterministically was billed once per sync indefinitely. Past the budget it becomes a dead letter: still visible and still user-retryable, but no longer swept. Reset to 0 whenever a pass completes.']
  processing_queued_at timestamp [note: 'When indexing was last dispatched to a worker, which is not when a worker picked it up — a document sits at `pending` in between. Recovery sweeps measure queue wait from here; `processingStartedAt` is written only once a worker actually starts. NULL means never dispatched, or dispatched before this column existed.']
  processing_queue_token text [note: 'Opaque dispatch generation; NULL identifies payloads created before token rollout.']
  processing_started_at timestamp
  processing_deferred_until timestamp [note: 'Scheduled execution time of an accepted durable quota continuation.']
  processing_completed_at timestamp
  processing_error text
  processing_recovery_after timestamp [note: 'Retry admission backoff, separate from an accepted worker continuation.']
  enabled boolean [not null]
  archived_at timestamp [note: 'Parent KB/workspace archive marker']
  deleted_at timestamp
  user_excluded boolean [not null, note: 'User explicitly excluded — skip on sync']
  tag1 text [note: 'Document tags for filtering (inherited by all chunks) Text tags (7 slots)']
  tag2 text
  tag3 text
  tag4 text
  tag5 text
  tag6 text
  tag7 text
  number1 "double precision" [note: 'Number tags (5 slots)']
  number2 "double precision"
  number3 "double precision"
  number4 "double precision"
  number5 "double precision"
  date1 timestamp [note: 'Date tags (2 slots)']
  date2 timestamp
  boolean1 boolean [note: 'Boolean tags (3 slots)']
  boolean2 boolean
  boolean3 boolean
  connector_id text
  external_id text
  content_hash text
  source_url text
  secret_provenance_version integer [note: 'NULL is a legacy/untracked source; version 1 requires a matching source sidecar.']
  uploaded_by text [note: 'User who uploaded the document, for usage attribution. Null for connector/cron-synced docs (and pre-migration rows) → indexing billing falls back to the workspace billed account.']
  acl text [not null, note: 'Sorted access-token list applied by every document read; the vocabulary is owned by `apps/sim/lib/knowledge/access/tokens.ts`. `{ws}` (the default) is any workspace member and `{}` is nobody. Uploads, API-created documents, and workspace-mode connectors keep the default; a members-mode connector materialises it from `knowledge_document_observation`.']
  acl_requirements jsonb [not null, note: 'Additional OR clauses, all of which must match; preserves source permission intersections.']
  acl_verified_at timestamp [note: 'Last authoritative source ACL evidence; NULL fails closed for mirrored permissions.']
  source_modified_at timestamp [note: 'Source last-modified time when the connector reports one; NULL for uploads.']
  source_seen_at timestamp [note: 'Start of the durable source-listing cycle that last observed this document.']
  uploaded_at timestamp [not null]
  indexes {
    (uploaded_by) [name: 'doc_uploaded_by_idx']
    (knowledge_base_id, source_modified_at) [name: 'doc_kb_source_modified_idx']
    (acl) [type: gin, name: 'doc_acl_gin_idx']
    (filename) [name: 'doc_filename_idx']
    (knowledge_base_id, processing_status) [name: 'doc_processing_status_idx']
    (connector_id, uploaded_at, id) [name: 'doc_connector_processing_recovery_idx']
    (connector_id, processing_status) [name: 'doc_connector_processing_status_idx']
    (connector_id, external_id) [unique, name: 'doc_connector_external_id_idx']
    (connector_id, external_id) [name: 'doc_connector_source_lookup_idx']
    (connector_id, id) [name: 'doc_connector_reconciliation_v2_idx']
    (knowledge_base_id, token_count) [name: 'doc_active_kb_token_count_idx']
    (storage_key) [name: 'doc_storage_key_idx']
    (archived_at) [name: 'doc_archived_at_partial_idx']
    (deleted_at) [name: 'doc_deleted_at_partial_idx']
    (connector_id) [name: 'doc_connector_tombstone_idx']
    (connector_id) [name: 'doc_connector_live_idx']
    (knowledge_base_id) [name: 'doc_kb_tag1_lower_idx']
    (knowledge_base_id) [name: 'doc_kb_tag2_lower_idx']
    (knowledge_base_id) [name: 'doc_kb_tag3_lower_idx']
    (knowledge_base_id) [name: 'doc_kb_tag4_lower_idx']
    (knowledge_base_id) [name: 'doc_kb_tag5_lower_idx']
    (knowledge_base_id) [name: 'doc_kb_tag6_lower_idx']
    (knowledge_base_id) [name: 'doc_kb_tag7_lower_idx']
    (number1) [name: 'doc_number1_idx']
    (number2) [name: 'doc_number2_idx']
    (number3) [name: 'doc_number3_idx']
    (number4) [name: 'doc_number4_idx']
    (number5) [name: 'doc_number5_idx']
    (date1) [name: 'doc_date1_idx']
    (date2) [name: 'doc_date2_idx']
    (boolean1) [name: 'doc_boolean1_idx']
    (boolean2) [name: 'doc_boolean2_idx']
    (boolean3) [name: 'doc_boolean3_idx']
  }
}

Table document_secret_provenance {
  document_id text [pk, not null]
  source_hash text [not null]
  status text [not null]
  entries jsonb [not null]
  updated_at timestamp [not null]
  Note: 'Private provenance for a document ingestion source, bound by a deterministic source hash.'
}

Table knowledge_base_tag_definitions {
  id text [pk, not null]
  knowledge_base_id text [not null]
  tag_slot text [not null]
  display_name text [not null]
  field_type text [not null, note: '\'text\', future: \'date\', \'number\', \'range\'']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (knowledge_base_id, tag_slot) [unique, name: 'kb_tag_definitions_kb_slot_idx']
    (knowledge_base_id, display_name) [unique, name: 'kb_tag_definitions_kb_display_name_idx']
  }
}

Table embedding {
  id text [pk, not null]
  knowledge_base_id text [not null]
  document_id text [not null]
  chunk_index integer [not null]
  chunk_hash text [not null]
  content text [not null]
  secret_provenance_version integer [note: 'NULL is a legacy/untracked chunk; version 1 requires a fresh private sidecar.']
  content_length integer [not null]
  token_count integer [not null]
  embedding vector [note: 'Vector embeddings. A chunk populates exactly the one column matching its knowledge base\'s `embedding_dimension`, and the others stay NULL: pgvector fixes a column\'s width, so one width per column is the only way to store models that emit different sizes in the same table. The widths cover what the popular embedding models emit — 384 (all-minilm), 768 (nomic-embed-text, embeddinggemma), 1024 (mxbai-embed-large, bge-m3, Voyage), 1536 (OpenAI\'s small model), 3072 (OpenAI\'s large model, gemini-embedding-001). `embedding` is the original 1536 column, kept under its bare name so every row written before the other widths existed stays exactly where it is.']
  embedding_384 vector
  embedding_768 vector
  embedding_1024 vector
  embedding_3072 vector
  embedding_model text [not null]
  start_offset integer [not null]
  end_offset integer [not null]
  tag1 text [note: 'Tag columns inherited from document for efficient filtering Text tags (7 slots)']
  tag2 text
  tag3 text
  tag4 text
  tag5 text
  tag6 text
  tag7 text
  number1 "double precision" [note: 'Number tags (5 slots)']
  number2 "double precision"
  number3 "double precision"
  number4 "double precision"
  number5 "double precision"
  date1 timestamp [note: 'Date tags (2 slots)']
  date2 timestamp
  boolean1 boolean [note: 'Boolean tags (3 slots)']
  boolean2 boolean
  boolean3 boolean
  enabled boolean [not null]
  content_tsv tsvector
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (document_id, chunk_index) [unique, name: 'emb_doc_chunk_idx']
    (knowledge_base_id, embedding_model) [name: 'emb_kb_model_idx']
    (knowledge_base_id, enabled) [name: 'emb_kb_enabled_idx']
    (document_id, enabled) [name: 'emb_doc_enabled_idx']
    (knowledge_base_id) [name: 'emb_kb_tag1_lower_idx']
    (knowledge_base_id) [name: 'emb_kb_tag2_lower_idx']
    (knowledge_base_id) [name: 'emb_kb_tag3_lower_idx']
    (knowledge_base_id) [name: 'emb_kb_tag4_lower_idx']
    (knowledge_base_id) [name: 'emb_kb_tag5_lower_idx']
    (knowledge_base_id) [name: 'emb_kb_tag6_lower_idx']
    (knowledge_base_id) [name: 'emb_kb_tag7_lower_idx']
    (number1) [name: 'emb_number1_idx']
    (number2) [name: 'emb_number2_idx']
    (number3) [name: 'emb_number3_idx']
    (number4) [name: 'emb_number4_idx']
    (number5) [name: 'emb_number5_idx']
    (date1) [name: 'emb_date1_idx']
    (date2) [name: 'emb_date2_idx']
    (boolean1) [name: 'emb_boolean1_idx']
    (boolean2) [name: 'emb_boolean2_idx']
    (boolean3) [name: 'emb_boolean3_idx']
    (content_tsv) [type: gin, name: 'emb_content_fts_idx']
  }
}

Table embedding_search {
  id text [pk, not null]
  knowledge_base_id text [not null]
  document_id text [not null]
  enabled boolean [not null]
  connector_id text [note: 'contract-pending(after #8528 is fully deployed and source/ACL projection writers have drained): drop connector_id — regular KB retrieval checks the parent document.']
  acl text [note: 'contract-pending(after #8528 is fully deployed and source/ACL projection writers have drained): drop acl — regular KB retrieval retains document-level access checks.']
  binary bit [note: 'contract-pending(after vector writers stop computing binary projections and embedding_search_width_check is replaced): drop binary and all binary_* columns — their ANN indexes were dropped in 0372 and no reader uses them.']
  binary_384 bit
  binary_768 bit
  binary_1024 bit
  binary_3072 bit
  vector halfvec
  vector_384 halfvec
  vector_512 halfvec
  vector_768 halfvec
  vector_1024 halfvec
  vector_3072 halfvec
  indexes {
    (knowledge_base_id) [name: 'embedding_search_kb_idx']
    (document_id, knowledge_base_id, id) [name: 'embedding_search_document_lookup_idx']
    (vector) [type: hnsw, name: 'embedding_search_cosine_hnsw_idx']
    (vector_512) [type: hnsw, name: 'embedding_search_512_cosine_hnsw_idx']
    (vector_384) [type: hnsw, name: 'embedding_search_384_cosine_hnsw_idx']
    (vector_768) [type: hnsw, name: 'embedding_search_768_cosine_hnsw_idx']
    (vector_1024) [type: hnsw, name: 'embedding_search_1024_cosine_hnsw_idx']
    (vector_3072) [type: hnsw, name: 'embedding_search_3072_cosine_hnsw_idx']
  }
  Note: 'Candidate projection. Keeping identities and half-precision vectors apart from content prevents candidate scans from fetching full-precision TOAST values. Application writers only change `embedding`: its trigger writes this projection in the writer\'s transaction, and deletes the row instead for a chunk of a retired Search knowledge base (`isSearchIndex`). A chunk write that skipped the trigger, as releases that deferred projection did, is written by the knowledge projector after the commit (see {@link knowledgeProjectionDirty}).'
}

Table knowledge_projection_dirty {
  document_id text [pk, not null]
  generation bigint [not null, note: 'Bumped by every mark; the projector removes the row only on the generation it read.']
  content boolean [not null, note: 'Whether chunk content changed, not only the document\'s source or ACL.']
  marked_at timestamptz [not null]
  indexes {
    (marked_at) [name: 'knowledge_projection_dirty_marked_at_idx']
  }
  Note: 'Documents whose search projection rows may lag their source rows. The `document` and `embedding` triggers mark a document here whenever they change what its projection rows carry, in the writer\'s transaction; the projector rewrites the rows and then removes the mark, but only on the generation it read, so a change made while it ran leaves the mark in place. A workspace document\'s mark with no content to project is removed without a pass: its writer already wrote the rows its searches read. Search-index search decides a marked document\'s rows on the document itself, so a mark never widens what a reader sees. A side table rather than a column on `document`: a mark is written by the writer that already holds the document row, but clearing it would otherwise take that row again, and readers probe this small table instead of joining `document` per ranked row. contract-pending(after deferred vector content is repaired and projection mark writers/workers are retired): drop knowledge_projection_dirty — legacy ACL copies need no repair, but unfinished vector repairs must survive retirement.'
}

Table embedding_secret_provenance {
  embedding_id text [pk, not null]
  content_hash text [not null]
  status text [not null]
  entries jsonb [not null]
  updated_at timestamp [not null]
  Note: 'Private provenance bound to one exact SHA-256 hash of the persisted chunk content.'
}

Table docs_embeddings {
  chunk_id uuid [pk, not null]
