  indexes {
    (status, available_at) [name: 'outbox_event_status_available_idx']
    (event_type, available_at, created_at, id) [name: 'outbox_event_pending_type_available_idx']
    (locked_at) [name: 'outbox_event_locked_at_idx']
    (event_type, created_at) [name: 'outbox_event_type_created_idx']
  }
}

Table mcp_servers {
  id text [pk, not null]
  workspace_id text
  organization_id text
  credential_group_id text
  managed_connector_id text
  oauth_config_version integer [not null]
  created_by text [note: 'Track who created the server, but workspace owns it']
  name text [not null]
  description text
  transport text [not null]
  url text
  auth_type text [not null]
  oauth_client_id text [note: 'Optional pre-registered OAuth credentials for servers that don\'t support Dynamic Client Registration (RFC 7591). When set, these shortcut the SDK\'s DCR step. `oauthClientSecret` is encrypted.']
  oauth_client_secret text
  headers json
  timeout integer
  retries integer
  enabled boolean [not null]
  last_connected timestamp
  connection_status text
  last_error text
  status_config jsonb
  tool_count integer
  last_tools_refresh timestamp
  total_requests integer
  last_used timestamp
  deleted_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (organization_id) [name: 'mcp_servers_organization_id_idx']
    (workspace_id, enabled) [name: 'mcp_servers_workspace_enabled_idx']
    (credential_group_id) [name: 'mcp_servers_credential_group_idx']
    (credential_group_id, managed_connector_id) [unique, name: 'mcp_servers_credential_group_managed_connector_unique']
    (workspace_id, deleted_at) [name: 'mcp_servers_workspace_deleted_partial_idx']
  }
}

Table mcp_server_oauth {
  id text [pk, not null]
  mcp_server_id text [not null]
  user_id text [note: 'Last workspace user who initiated/completed authorization.']
  workspace_id text
  organization_id text
  client_information text [note: 'Encrypted JSON of the RFC 7591 dynamic client registration result. Encrypted because some authorization servers may issue a client_secret even for clients advertising `token_endpoint_auth_method: \'none\'`.']
  tokens text [note: 'Encrypted JSON of the OAuth tokens (access + refresh).']
  code_verifier text [note: 'PKCE verifier held only between /authorize and /callback.']
  state text [note: 'Opaque state mint to correlate the callback.']
  state_created_at timestamp [note: 'When `state` was minted. Used to expire the active-flow window and the state replay window independently of `updatedAt`, which is touched by token refreshes and other writes.']
  last_refreshed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (mcp_server_id) [unique, name: 'mcp_server_oauth_server_unique']
    (state) [name: 'mcp_server_oauth_state_idx']
  }
  Note: 'Workspace-scoped OAuth state for an outbound MCP server. Holds the SDK-managed OAuth artifacts needed to drive the standard MCP OAuth 2.1 + PKCE + dynamic-client-registration flow against a remote MCP server. One row per MCP server; workspace members share the authorized connection just like they share the MCP server definition.'
}

Table sso_provider {
  id text [pk, not null]
  issuer text [not null]
  domain text [not null]
  oidc_config text
  saml_config text
  user_id text [not null]
  provider_id text [not null]
  organization_id text
  domain_verified boolean [not null, note: 'Better Auth\'s SSO `domainVerification` flag. Sim proves ownership itself via {@link ssoDomain} before registration, so this mirrors that decision rather than driving a second flow. It makes Better Auth treat the provider as authoritative for its domain and auto-link same-email accounts; without it, IdPs omitting `email_verified` (notably Entra) strand those users. Defaults to true so pre-existing providers keep signing in across deploy.']
  jit_provisioning_enabled boolean [not null, note: 'Whether a successful SSO sign-in may provision a new organization membership. Sim owns this admission path so seat checks, billing effects, session policy, and audit all use the same transaction as every other join. Defaults to true to preserve existing providers during a rolling deploy.']
  indexes {
    (provider_id) [unique, name: 'sso_provider_provider_id_unique']
    (domain) [name: 'sso_provider_domain_idx']
    (user_id) [name: 'sso_provider_user_id_idx']
    (organization_id) [name: 'sso_provider_organization_id_idx']
  }
}

Table sso_domain {
  id text [pk, not null]
  organization_id text [not null]
  domain text [not null, note: 'Normalized (lowercase, registrable) domain — see `normalizeSSODomain`.']
  status text [not null, note: '`\'pending\'` until the DNS TXT record is observed, then `\'verified\'`.']
  verification_token text [not null, note: 'High-entropy token placed in the domain\'s `_sim-challenge` TXT record.']
  verified_at timestamp
  primary_provider_id text [note: 'The provider sign-in uses for this domain when the organization has more than one on it, such as while moving from one identity provider to another. Holds the provider id, not a foreign key: it is honored only while that provider still belongs to this organization and serves this domain, and deleting the provider clears it. Null means the domain\'s first verified provider by id, which is also the only one when there is just one. See `sso-primary-provider.ts`.']
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (domain) [name: 'sso_domain_domain_idx']
    (organization_id, domain) [unique, name: 'sso_domain_org_domain_unique']
    (domain) [unique, name: 'sso_domain_verified_unique']
  }
  Note: 'An email domain an organization has claimed, and its verification state. A domain must be **verified** (via a DNS TXT challenge — the org places `verificationToken` in a `_sim-challenge.<domain>` record) before it can be configured for single sign-on: verifying proves the org controls the domain, which is the security precondition for wiring it to an identity provider. Existing `sso_provider` domains are grandfathered as `verified` by the backfill in migration 0266.'
}

Table oauth_client {
  id text [pk, not null]
  client_id text [not null, unique]
  client_secret text
  disabled boolean [not null]
  skip_consent boolean
  enable_end_session boolean
  subject_type text
  scopes text
  user_id text
  created_at timestamp
  updated_at timestamp
  name text
  uri text
  icon text
  contacts text
  tos text
  policy text
  software_id text
  software_version text
  software_statement text
  redirect_uris text [not null]
  post_logout_redirect_uris text
  token_endpoint_auth_method text
  grant_types text
  response_types text
  public boolean
  type text
  require_pkce boolean
  reference_id text
  metadata jsonb
  indexes {
    (user_id) [name: 'oauth_client_user_id_idx']
  }
  Note: 'OAuth 2.0 provider tables (Better Auth `@better-auth/oauth-provider`). Sim is the authorization server: a registered client (the Sim CLI, or an admin-created third-party app) sends a user through `/api/auth/oauth2/authorize`, the user consents, and the client redeems a code for an opaque access token and a rotating refresh token. Tokens are stored hashed; the plaintext exists only in the client. Column keys follow the plugin\'s model fields so the Better Auth drizzle adapter maps them without a per-field `fieldName` override.'
}

Table oauth_consent {
  id text [pk, not null]
  client_id text [not null]
  user_id text
  reference_id text
  scopes text [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (client_id) [name: 'oauth_consent_client_id_idx']
    (user_id, client_id, reference_id) [unique, name: 'oauth_consent_user_client_reference_unique']
  }
  Note: 'The scopes a user has granted a client; deleted when the user revokes the app.'
}

Table oauth_token_family {
  id text [pk, not null]
  client_id text [not null]
  session_id text
  user_id text [not null]
  reference_id text
  consent_id text
  current_generation integer [not null]
  created_at timestamp [not null]
  expires_at timestamp [not null]
  indexes {
    (client_id) [name: 'oauth_token_family_client_id_idx']
    (session_id) [name: 'oauth_token_family_session_id_idx']
    (user_id, client_id) [name: 'oauth_token_family_user_client_idx']
    (consent_id) [name: 'oauth_token_family_consent_id_idx']
    (expires_at) [name: 'oauth_token_family_expires_at_idx']
  }
  Note: 'One independently revocable login. Every rotating refresh token belongs to a stable family so replay and logout can atomically remove all descendants.'
}

Table oauth_refresh_token {
  id text [pk, not null]
  token text [not null, unique]
  client_id text [not null]
  session_id text
  user_id text [not null]
  reference_id text
  expires_at timestamp [not null]
  created_at timestamp [not null]
  revoked timestamp
  auth_time timestamp
  scopes text [not null]
  resource text
  family_id text [not null]
  generation integer [not null]
  indexes {
    (client_id) [name: 'oauth_refresh_token_client_id_idx']
    (session_id) [name: 'oauth_refresh_token_session_id_idx']
    (user_id, client_id) [name: 'oauth_refresh_token_user_client_idx']
    (expires_at) [name: 'oauth_refresh_token_expires_at_idx']
    (family_id, generation) [unique, name: 'oauth_refresh_token_family_generation_unique']
  }
  Note: 'A member of a rotating refresh-token family.'
}

Table oauth_access_token {
  id text [pk, not null]
  token text [not null, unique]
  client_id text [not null]
  session_id text
  user_id text
  reference_id text
  refresh_id text
  expires_at timestamp [not null]
  created_at timestamp [not null]
  scopes text [not null]
  resource text
  indexes {
    (client_id) [name: 'oauth_access_token_client_id_idx']
    (session_id) [name: 'oauth_access_token_session_id_idx']
    (refresh_id) [name: 'oauth_access_token_refresh_id_idx']
    (user_id, client_id) [name: 'oauth_access_token_user_client_idx']
    (expires_at) [name: 'oauth_access_token_expires_at_idx']
  }
  Note: 'An opaque access token, looked up by hash on every bearer-authenticated request.'
}

Table workflow_mcp_server {
  id text [pk, not null]
  workspace_id text [not null]
  created_by text [not null]
  name text [not null]
  description text
  is_public boolean [not null]
  deleted_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workspace_id) [name: 'workflow_mcp_server_workspace_id_idx']
    (created_by) [name: 'workflow_mcp_server_created_by_idx']
    (deleted_at) [name: 'workflow_mcp_server_deleted_at_idx']
    (workspace_id, deleted_at) [name: 'workflow_mcp_server_workspace_deleted_partial_idx']
  }
  Note: 'Workflow MCP Servers - User-created MCP servers that expose workflows as tools. These servers are accessible by external MCP clients via API key authentication, or publicly if isPublic is set to true.'
}

Table workflow_mcp_tool {
  id text [pk, not null]
  server_id text [not null]
  workflow_id text [not null]
  tool_name text [not null]
  tool_description text
  parameter_schema json [not null]
  parameter_description_overrides json [not null]
  archived_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (server_id) [name: 'workflow_mcp_tool_server_id_idx']
    (workflow_id) [name: 'workflow_mcp_tool_workflow_id_idx']
    (server_id, workflow_id) [unique, name: 'workflow_mcp_tool_server_workflow_unique']
    (archived_at) [name: 'workflow_mcp_tool_archived_at_partial_idx']
  }
  Note: 'Workflow MCP Tools - Workflows registered as tools within a Workflow MCP Server. Each tool maps to a deployed workflow\'s execute endpoint.'
}

Table custom_block {
  id text [pk, not null]
  organization_id text [not null]
  workflow_id text [not null]
  type text [not null]
  name text [not null]
  description text [not null]
  icon_url text [note: 'Uploaded icon image URL (workspace storage), or null for the default icon.']
  inputs json [note: 'Per-input authored overrides keyed by the source Start field\'s stable `id`: `Array<{ id, placeholder?, required? }>`. Only the placeholder and required flag are authored — the input field set and its name/type/description are always derived live from the deployed Start (so they can never go stale); an override whose field was removed is ignored. Absent/empty → no overrides; every deployed Start input is still exposed.']
  outputs json [note: 'Curated outputs exposed to consumers: `Array<{ blockId, path, name }>`. Each maps a child-workflow block output (blockId + dot-path) to a friendly output name on the block. Empty/absent → expose the child\'s whole `result`. Internal plumbing (child workflow id, trace spans) is never exposed.']
  enabled boolean [not null]
  trace_child_runs boolean [not null, note: 'The publisher\'s org-wide decision on whether this block\'s runs are joined into a consumer\'s trace. It is the ONLY policy — no viewer check runs downstream — so turning it on publishes the source workflow\'s block names, inputs, outputs, and prompts to anyone who can read a consuming workflow\'s logs, including consumers with no access to the source workspace. Defaults false because of that: this is the same boundary curated outputs and redacted errors exist to hold, and it may only open by an affirmative act of the publisher, never by a column default applied to rows nobody revisited.']
  created_by text
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (workflow_id) [name: 'custom_block_workflow_id_idx']
    (organization_id, type) [unique, name: 'custom_block_organization_type_unique']
  }
  Note: 'Custom Blocks - a deployed workflow published as a reusable, org-wide block. Scoped to an organization: available across every workspace in the org. Bound to a source `workflowId` and always executes that workflow\'s latest deployment. Start input fields are derived live (not snapshotted). `type` is the stable lowercase block-type slug (`custom_block_<shortId>`) that flows into the block registry overlay, the palette, and permission-group `allowedIntegrations` access control.'
}

Table audit_log {
  id text [pk, not null]
  workspace_id text
  actor_id text
  action text [not null]
  resource_type text [not null]
  resource_id text
  actor_name text
  actor_email text
  resource_name text
  description text
  metadata jsonb
  ip_address text
  user_agent text
  surface text [note: 'The official client the request came from (`web`, `desktop`, `cli`, `sdk-js`, `sdk-python`), as resolved from `X-Sim-Client-Info`. Null for background work and callers that do not identify themselves.']
  created_at timestamp [not null]
  indexes {
    (workspace_id, created_at) [name: 'audit_log_workspace_created_idx']
    (workspace_id, id) [name: 'audit_log_workspace_created_at_id_idx']
    (actor_id, created_at) [name: 'audit_log_actor_created_idx']
    (id) [name: 'audit_log_org_level_created_at_id_idx']
    (resource_type, resource_id) [name: 'audit_log_resource_idx']
    (action) [name: 'audit_log_action_idx']
  }
}

