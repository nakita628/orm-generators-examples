Table user {
  id integer [pk, not null]
  name text [not null]
  email text [not null, unique]
  created_at text [not null]
  updated_at text [not null]
  image text
  profile_views integer [not null]
  role text [not null]
  email_verified integer [not null]
  privacy text [not null]
  hide_aggregate_ratings integer [not null]
  grid_list_view integer [not null]
  show_onboarding integer [not null]
  show_update_modal integer [not null]
  background_image text [not null]
  rating_system text [not null]
  search_selector text [not null]
  auto_move_completed_tv_to_on_hold integer [not null]
  indexes {
    (name) [unique, name: 'user_name_unique']
  }
}

Table session {
  id integer [pk, not null]
  expires_at integer [not null]
  token text [not null, unique]
  created_at integer [not null]
  updated_at integer [not null]
  ip_address text
  user_agent text
  user_id integer [not null]
  indexes {
    (user_id) [name: 'session_user_id_idx']
  }
}

Table account {
  id integer [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id integer [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (user_id) [name: 'account_user_id_idx']
  }
}

Table verification {
  id integer [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer
  updated_at integer
  indexes {
    (identifier) [name: 'verification_identifier_idx']
  }
}

Table jwks {
  id integer [pk, not null]
  public_key text [not null]
  private_key text [not null]
  created_at integer [not null]
  expires_at integer
  alg text
  crv text
}

Table oauth_client {
  id integer [pk, not null]
  client_id text [not null, unique]
  client_secret text
  client_discovery_id text
  disabled integer
  skip_consent integer
  enable_end_session integer
  subject_type text
  scopes text
  client_credentials_scopes text
  user_id integer
  created_at integer
  updated_at integer
  name text
  uri text
  icon text
  contacts text
  tos text
  policy text
  software_id text
  software_version text
  software_statement text
  redirect_uris text [not null]
  post_logout_redirect_uris text
  backchannel_logout_uri text
  backchannel_logout_session_required integer
  token_endpoint_auth_method text
  application_type text
  jwks text
  jwks_uri text
  grant_types text
  response_types text
  require_pkce integer
  dpop_bound_access_tokens integer
  reference_id text
  metadata text
  indexes {
    (user_id) [name: 'oauthClient_userId_idx']
  }
}

Table oauth_resource {
  id integer [pk, not null]
  identifier text [not null, unique]
  name text [not null]
  access_token_ttl integer
  refresh_token_ttl integer
  signing_algorithm text
  signing_key_id text
  allowed_scopes text
  custom_claims text
  dpop_bound_access_tokens_required integer
  disabled integer
  created_at integer
  updated_at integer
  policy_version integer
  metadata text
}

Table oauth_client_resource {
  id integer [pk, not null]
  client_id text [not null]
  resource_id text [not null]
  metadata text
  created_at integer
  indexes {
    (client_id) [name: 'oauthClientResource_clientId_idx']
    (resource_id) [name: 'oauthClientResource_resourceId_idx']
    (client_id, resource_id) [unique, name: 'oauthClientResource_clientId_resourceId_uidx']
  }
}

Table oauth_refresh_token {
  id integer [pk, not null]
  token text [not null, unique]
  client_id text [not null]
  session_id integer
  user_id integer [not null]
  reference_id text
  authorization_code_id text
  resources text
  requested_user_info_claims text
  expires_at integer [not null]
  created_at integer [not null]
  revoked integer
  rotated_at integer
  rotation_replay_response text
  rotation_replay_expires_at integer
  auth_time integer
  confirmation text
  scopes text [not null]
  indexes {
    (user_id) [name: 'oauthRefreshToken_userId_idx']
    (client_id) [name: 'oauthRefreshToken_clientId_idx']
    (session_id) [name: 'oauthRefreshToken_sessionId_idx']
    (authorization_code_id) [name: 'oauthRefreshToken_authorizationCodeId_idx']
  }
}

Table oauth_access_token {
  id integer [pk, not null]
  token text [not null, unique]
  client_id text [not null]
  session_id integer
  user_id integer
  reference_id text
  authorization_code_id text
  resources text
  requested_user_info_claims text
  refresh_id integer
  expires_at integer [not null]
  created_at integer [not null]
  revoked integer
  confirmation text
  scopes text [not null]
  indexes {
    (user_id) [name: 'oauthAccessToken_userId_idx']
    (client_id) [name: 'oauthAccessToken_clientId_idx']
    (session_id) [name: 'oauthAccessToken_sessionId_idx']
    (refresh_id) [name: 'oauthAccessToken_refreshId_idx']
    (authorization_code_id) [name: 'oauthAccessToken_authorizationCodeId_idx']
  }
}

Table oauth_consent {
  id integer [pk, not null]
  client_id text [not null]
  user_id integer
  reference_id text
  resources text
  requested_user_info_claims text
  scopes text [not null]
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (client_id) [name: 'oauthConsent_clientId_idx']
    (user_id) [name: 'oauthConsent_userId_idx']
  }
}

Table oauth_client_assertion {
  id text [pk, not null]
  expires_at integer [not null]
}

Table mcp_revocation {
  user_id integer [not null]
  client_id text [not null]
  revoked_at integer [not null]
  indexes {
    (user_id, client_id) [pk]
  }
}

Table followers {
  follower_id integer [not null]
  followed_id integer [not null]
  status text [not null]
  indexes {
    (follower_id, followed_id) [unique, name: 'ux_followers_follower_followed']
    (followed_id, status, follower_id) [name: 'ix_followers_followed_status_follower']
  }
}

Table user_media_update {
  id integer [pk, not null]
  user_id integer [not null]
  media_id integer [not null]
