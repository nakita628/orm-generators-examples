    (user_id, last_activity_at) [name: 'ix_user_media_monthly_activity_user_last_activity']
    (user_id, media_id, media_type, month_bucket) [unique, name: 'ux_user_media_monthly_activity_bucket']
    (user_id, month_bucket, media_type, last_activity_at) [name: 'ix_user_media_monthly_activity_user_month_type_activity']
  }
}

