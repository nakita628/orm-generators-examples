  update_type text [not null]
  payload text
  timestamp text [not null]
  indexes {
    (media_type, media_id) [name: 'ix_user_media_update_media_type_media_id']
    (user_id, timestamp) [name: 'ix_user_media_update_user_timestamp']
    (user_id, media_type, media_id, update_type, timestamp) [name: 'ix_user_media_update_user_media_kind_timestamp']
    (timestamp) [name: 'ix_user_media_update_timestamp']
  }
}

