Table user {
  id text [pk, not null]
  last_login_at integer
  flag text [not null]
  plan text [not null, note: 'Set when the user activates Pro from the website, and re-checked twice a day while they are on Pro.']
  plan_checked_at integer [note: 'When the plan was last checked against the user\'s NFT holdings, null when never.']
  name text
  email text [unique]
  email_verified integer [not null]
  image text
  created_at integer [not null]
  updated_at integer [not null]
}

Table session {
  id text [pk, not null]
  expires_at integer [not null]
  token text [not null, unique]
  created_at integer [not null]
  updated_at integer [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  indexes {
    (user_id) [name: 'session_user_id_idx']
  }
}

Table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at integer
  refresh_token_expires_at integer
  scope text
  password text
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (user_id) [name: 'account_user_id_idx']
  }
}

Table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at integer [not null]
  created_at integer
  updated_at integer
  indexes {
    (identifier) [name: 'verification_identifier_idx']
  }
}

Table wallet_address {
  id text [pk, not null]
  user_id text [not null]
  address text [not null]
  chain_id integer [not null]
  is_primary integer [not null]
  created_at integer [not null]
  indexes {
    (user_id) [name: 'wallet_address_user_id_idx']
    (address, chain_id) [unique, name: 'wallet_address_address_chain_id_unique']
  }
  Note: 'Wallet identity model added by the sign-in-with-stacks better-auth plugin.'
}

Table draft {
  id text [pk, not null]
  title text [not null]
  content text [not null]
  meta_title text
  meta_description text
  cover_image text
  canonical_uri text
  arweave_tx_id text
  tx_status text [note: 'Publish state, null until the draft is first published.']
  publish_signature text [note: 'Signature of the signed post metadata the draft is publishing (or last attempted). `arweaveTxId` is a valid checkpoint only while it matches.']
  upload_claimed_at integer [note: 'Lease held by the worker uploading to Arweave, so concurrent workers for the same signature do not upload the same metadata twice.']
  tags text
  content_warning text
  created_at integer [not null]
  updated_at integer [not null]
  user_id text [not null]
  indexes {
    (user_id) [name: 'draft_user_id_idx']
  }
}

Table profile {
  address text [pk, not null, note: 'Stacks address the profile belongs to: the primary address of the user who saved it. Profiles published on Arweave before profiles moved to the database are kept, including those of addresses that never signed in.']
  display_name text
  description text
  website text
  twitter text
  picture text
  cover_picture text
  created_at integer [not null]
  updated_at integer [not null]
}

Table media_image {
  id text [pk, not null]
  status text [not null]
  mime_type text
  width integer
  height integer
  size integer
  thumbhash text [note: 'Base64 of the 25-byte ThumbHash placeholder.']
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (created_at) [name: 'media_image_pending_idx']
  }
}

Table post {
  id text [pk, not null]
  draft_id text [unique]
  version text [not null]
  arweave_tx_id text [not null, unique]
  arweave_block_height integer [note: 'Null until the bundle is included in an Arweave block; populated by a later queue.']
  metadata_uri text [not null]
  title text [not null]
  content text [not null]
  excerpt text [not null]
  meta_title text
  meta_description text
  cover_image text
  tags text
  canonical_uri text
  content_warning text
  signature text [unique]
  hidden_at integer [note: 'When the author hid the post from Sigle, null while it is shown. A hidden post stays on Arweave, but Sigle no longer serves it.']
  created_at integer [not null]
  updated_at integer [not null]
  user_id text [not null]
  indexes {
    (user_id) [name: 'post_user_id_idx']
    (created_at, id) [name: 'post_created_at_id_idx']
    (created_at) [name: 'post_arweave_pending_idx']
  }
}

Table post_ots {
  post_id text [pk, not null]
  status text [not null]
  content_hash text [not null, note: 'Hex SHA-256 of the exact metadata bytes stored on Arweave.']
  pending_proof blob [note: 'Pending `.ots` proof returned by the calendars, kept until it can be upgraded to a Bitcoin-anchored proof.']
  ots_tx_id text [note: 'Arweave transaction id of the upgraded `.ots` proof.']
  bitcoin_block_height integer
  bitcoin_block_hash text
  bitcoin_timestamp integer
  created_at integer [not null]
  updated_at integer [not null]
  indexes {
    (status) [name: 'post_ots_status_idx']
  }
  Note: 'One OpenTimestamps proof per published post. The post metadata JSON uploaded to Arweave is the file being anchored, identified by `contentHash`.'
}

Ref session_user_id_user_id_fk: session.user_id > user.id [delete: cascade]

Ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade]

Ref wallet_address_user_id_user_id_fk: wallet_address.user_id > user.id [delete: cascade]

Ref draft_user_id_user_id_fk: draft.user_id > user.id

Ref post_user_id_user_id_fk: post.user_id > user.id

Ref post_ots_post_id_post_id_fk: post_ots.post_id - post.id [delete: cascade]