Table djstripe_webhookendpoint {
  djstripe_created datetime [not null, note: 'default in Python: now()']
  djstripe_updated datetime [not null, note: 'default in Python: now()']
  stripe_data text [not null, note: 'default in Python: dict()']
  djstripe_id integer [pk, increment]
  id varchar(255) [unique, not null]
  djstripe_owner_account_id varchar(255) [note: 'The Stripe Account this object belongs to.']
  livemode bool [default: null, note: 'Null here indicates that the livemode status is unknown or was previously unrecorded. Otherwise, this field indicates whether this record comes from Stripe test mode or live mode operation.']
  created datetime [note: 'The datetime this object was created in stripe.']
  metadata text [note: 'A set of key/value pairs that you can attach to an object. It can be useful for storing additional information about an object in a structured format.']
  api_version varchar(64) [not null, note: 'The API version events are rendered as for this webhook endpoint. Defaults to the configured Stripe API Version.']
  enabled_events text [not null, note: 'The list of events to enable for this endpoint. [\'*\'] indicates that all events are enabled, except those that require explicit selection.']
  secret varchar(256) [not null, note: 'The endpoint\'s secret, used to generate webhook signatures.']
  status WebhookEndpointStatus [not null, note: 'The status of the webhook. It can be enabled or disabled.']
  url varchar(2048) [not null, note: 'The URL of the webhook endpoint.']
  application varchar(255) [not null, note: 'The ID of the associated Connect application.']
  djstripe_uuid char(32) [unique, not null, note: 'A UUID specific to dj-stripe generated for the endpoint. default in Python: uuid4()']
  djstripe_tolerance "smallint unsigned" [default: 300, not null, note: 'Controls the milliseconds tolerance which wards against replay attacks. Leave this to its default value unless you know what you\'re doing.']
  djstripe_validation_method WebhookEndpointDjstripeValidationMethod [default: 'verify_signature', not null, note: 'Controls the webhook validation method.']

  indexes {
    (djstripe_owner_account_id) [name: 'djstripe_webhookendpoint_djstripe_owner_account_id_f1ac5c9d']
  }

  Note: '''Columns from StripeModel (abstract): djstripe_id, id, djstripe_owner_account_id, livemode, created, metadata.

Columns from StripeBaseModel (abstract): djstripe_created, djstripe_updated, stripe_data.'''
}

Table djstripe_webhookeventtrigger {
  id integer [pk, increment]
  remote_ip char(39) [not null, note: 'IP address of the request client.']
  headers text [not null]
  body text [not null]
  valid bool [default: false, not null, note: 'Whether or not the webhook event has passed validation']
  processed bool [default: false, not null, note: 'Whether or not the webhook event has been successfully processed']
  exception varchar(128) [not null]
  traceback text [not null, note: 'Traceback if an exception was thrown during processing']
  event_id varchar(255) [note: 'Event object contained in the (valid) Webhook']
  djstripe_version varchar(32) [not null, note: 'The version of dj-stripe when the webhook was received. default in Python: _get_version()']
  created datetime [not null, note: 'default in Python: now()']
  updated datetime [not null, note: 'default in Python: now()']
  stripe_trigger_account_id varchar(255) [note: 'The Stripe Account this object belongs to.']
  webhook_endpoint_id varchar(255) [note: 'The endpoint this webhook was received on']

  indexes {
    (event_id) [name: 'djstripe_webhookeventtrigger_event_id_b2e08de6']
    (stripe_trigger_account_id) [name: 'djstripe_webhookeventtrigger_stripe_trigger_account_id_06d35fda']
    (webhook_endpoint_id) [name: 'djstripe_webhookeventtrigger_webhook_endpoint_id_6e762b2f']
  }

  Note: '''An instance of a request that reached the server endpoint for Stripe webhooks.

Webhook Events are initially **UNTRUSTED**, as it is possible for any web entity to
post any data to our webhook url. Data posted may be valid Stripe information,
garbage, or even malicious.
The \'valid\' flag in this model monitors this.'''
}

