}

Table djstripe_invoice {
  djstripe_created datetime [not null, note: 'default in Python: now()']
  djstripe_updated datetime [not null, note: 'default in Python: now()']
  stripe_data text [not null, note: 'default in Python: dict()']
  djstripe_id integer [pk, increment]
  id varchar(255) [unique, not null]
  djstripe_owner_account_id varchar(255) [note: 'The Stripe Account this object belongs to.']
  livemode bool [default: null, note: 'Null here indicates that the livemode status is unknown or was previously unrecorded. Otherwise, this field indicates whether this record comes from Stripe test mode or live mode operation.']
  created datetime [note: 'The datetime this object was created in stripe.']
  metadata text [note: 'A set of key/value pairs that you can attach to an object. It can be useful for storing additional information about an object in a structured format.']
  charge_id bigint [unique, note: 'The latest charge generated for this invoice, if any.']
  customer_id varchar(255) [not null, note: 'The customer associated with this invoice.']
  default_payment_method_id varchar(255) [note: 'Default payment method for the invoice. It must belong to the customer associated with the invoice. If not set, defaults to the subscription\'s default payment method, if any, or to the default payment method in the customer\'s invoice settings.']
  payment_intent_id bigint [unique, note: 'The PaymentIntent associated with this invoice. The PaymentIntent is generated when the invoice is finalized, and can then be used to pay the invoice.Note that voiding an invoice will cancel the PaymentIntent']
  subscription_id varchar(255) [note: 'The subscription that this invoice was prepared for, if any.']

  indexes {
    (djstripe_owner_account_id) [name: 'djstripe_invoice_djstripe_owner_account_id_cc0c7f79']
    (customer_id) [name: 'djstripe_invoice_customer_id_c0cd871c']
    (default_payment_method_id) [name: 'djstripe_invoice_default_payment_method_id_670990d5']
    (subscription_id) [name: 'djstripe_invoice_subscription_id_2dbc2461']
  }

  Note: '''Invoices are statements of what a customer owes for a particular billing
period, including subscriptions, invoice items, and any automatic proration
adjustments if necessary.

Once an invoice is created, payment is automatically attempted. Note that
the payment, while automatic, does not happen exactly at the time of invoice
creation. If you have configured webhooks, the invoice will wait until one
hour after the last webhook is successfully sent (or the last webhook times
out after failing).

Any customer credit on the account is applied before determining how much is
due for that invoice (the amount that will be actually charged).
If the amount due for the invoice is less than 50 cents (the minimum for a
charge), we add the amount to the customer\'s running account balance to be
added to the next invoice. If this amount is negative, it will act as a
credit to offset the next invoice. Note that the customer account balance
does not include unpaid invoices; it only includes balances that need to be
taken into account when calculating the amount due for the next invoice.

Stripe documentation: https://stripe.com/docs/api?lang=python#invoices

Columns from BaseInvoice (abstract): charge_id, customer_id, default_payment_method_id, payment_intent_id, subscription_id.

Columns from StripeModel (abstract): djstripe_id, id, djstripe_owner_account_id, livemode, created, metadata.

Columns from StripeBaseModel (abstract): djstripe_created, djstripe_updated, stripe_data.'''
}

