    (sales_contract_reference_provider_id) [name: 'openedx_ledger_historicaldeposit_sales_contract_reference_provider_id_1fcb607e']
    (history_date) [name: 'openedx_ledger_historicaldeposit_history_date_9be16baf']
    (history_user_id) [name: 'openedx_ledger_historicaldeposit_history_user_id_8017cbf4']
  }
