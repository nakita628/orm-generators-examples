  transaction_id char(32) [note: 'The Transaction instance which represents this deposit and influences the balance of the relevant ledger.. refers to openedx_ledger_transaction.uuid, with no foreign key in the database']
  sales_contract_reference_provider_id bigint [note: 'The system providing the source of truth for the sales contract which beget this deposit.. refers to openedx_ledger_salescontractreferenceprovider.id, with no foreign key in the database']
  history_id integer [pk, increment]
