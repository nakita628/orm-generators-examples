  transaction_id char(32) [unique, not null, note: 'The Transaction instance which adjusts the balance of the relevant ledger.']
  transaction_of_interest_id char(32) [unique, note: 'Any transaction of interest w.r.t. the reason for being of this adjustment. For example, the transaction of interest may point to some transaction record for which the enrolling user is unsatisfied, but for which we cannot issue a reversal due to business rules.']
  reason AdjustmentReason [default: 'technical_challenges', not null, note: 'The primary reason for the existence of this adjustment.']
  notes text [note: 'Any additional context you have for the existence of this adjustment.']

  indexes {
