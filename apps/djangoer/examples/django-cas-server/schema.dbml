Table cas_server_servicepattern {
  id integer [pk, increment]
  pos integer [default: 100, not null, note: 'service patterns are sorted using the position attribute']
  name varchar(255) [unique, note: 'A name for the service']
  pattern varchar(255) [unique, not null, note: 'A regular expression matching services. Will usually looks like \'^https://some\\.server\\.com/path/.*$\'.As it is a regular expression, special character must be escaped with a \'\\\'.']
  user_field varchar(255) [default: '', not null, note: 'Name of the attribute to transmit as username, empty = login']
  restrict_users bool [default: false, not null, note: 'Limit username allowed to connect to the list provided bellow']
  proxy bool [default: false, not null, note: 'Proxy tickets can be delivered to the service']
  proxy_callback bool [default: false, not null, note: 'can be used as a proxy callback to deliver PGT']
  single_log_out bool [default: false, not null, note: 'Enable SLO for the service']
  single_log_out_callback varchar(255) [default: '', not null, note: '''URL where the SLO request will be POST. empty = service url
This is usefull for non HTTP proxied services.''']

  Note: '''Bases: :class:`django.db.models.Model`

Allowed services pattern against services are tested to'''
}

