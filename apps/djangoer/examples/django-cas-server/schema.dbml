Table cas_server_replaceattributname {
  id integer [pk, increment]
  name varchar(255) [not null, note: 'name of an attribute to send to the service, use * for all attributes']
  replace varchar(255) [not null, note: 'name under which the attribute will be show to the service. empty = default name of the attribut']
  service_pattern_id bigint [not null]

  indexes {
    (service_pattern_id) [name: 'cas_server_replaceattributname_service_pattern_id_951038d2']
    (name, replace, service_pattern_id) [unique, name: 'cas_server_replaceattributname_name_replace_service_pattern_id_5e627e3c_uniq']
  }

  Note: '''Bases: :class:`django.db.models.Model`

A replacement of an attribute name for a :class:`ServicePattern`. It also tell to transmit
an attribute of :attr:`User.attributs` to the service. An empty :attr:`replace` mean
to use the original attribute name.'''
}

Table cas_server_filterattributvalue {
  id integer [pk, increment]
  attribut varchar(255) [not null, note: 'Name of the attribute which must verify pattern']
  pattern varchar(255) [not null, note: 'a regular expression']
  service_pattern_id bigint [not null]

  indexes {
    (service_pattern_id) [name: 'cas_server_filterattributvalue_service_pattern_id_9223c12f']
  }

  Note: '''Bases: :class:`django.db.models.Model`

A filter on :attr:`User.attributs` for a :class:`ServicePattern`. If a :class:`User` do not
have an attribute :attr:`attribut` or its value do not match :attr:`pattern`, then
:meth:`ServicePattern.check_user` will raises :class:`BadFilter` if called with that user.'''
}

Table cas_server_replaceattributvalue {
  id integer [pk, increment]
  attribut varchar(255) [not null, note: 'Name of the attribute for which the value must be replace']
  pattern varchar(255) [not null, note: 'An regular expression maching whats need to be replaced']
  replace varchar(255) [not null, note: 'replace expression, groups are capture by \\1, \\2 …']
  service_pattern_id bigint [not null]

  indexes {
    (service_pattern_id) [name: 'cas_server_replaceattributvalue_service_pattern_id_08190d2c']
  }

  Note: '''Bases: :class:`django.db.models.Model`

A replacement (using a regular expression) of an attribute value for a
:class:`ServicePattern`.'''
}

