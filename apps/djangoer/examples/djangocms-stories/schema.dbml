Table djangocms_stories_post {
  id integer [pk, increment]
  author_id integer
  date_created datetime [not null, note: 'default in Python: now()']
  date_modified datetime [not null, note: 'default in Python: now()']
  date_published datetime
  date_published_end datetime
  date_featured datetime
  include_in_rss bool [default: true, not null]
  main_image_id integer
  main_image_thumbnail_id integer
  main_image_full_id integer
  enable_comments bool [default: true, not null]
  app_config_id bigint [note: 'When selecting a value, the form is reloaded to get the updated default']

  indexes {
    (author_id) [name: 'djangocms_stories_post_author_id_6036105b']
    (main_image_id) [name: 'djangocms_stories_post_main_image_id_67803bda']
    (main_image_thumbnail_id) [name: 'djangocms_stories_post_main_image_thumbnail_id_4b7a78cd']
    (main_image_full_id) [name: 'djangocms_stories_post_main_image_full_id_03c6ec6c']
    (app_config_id) [name: 'djangocms_stories_post_app_config_id_079a5426']
  }

  Note: '''Represents a blog post or story entry with multilingual content, images, categories, tags, and publication metadata.
It is the "grouper model" for :class:`PostContent`.

This model supports translation, site-specific publishing, image handling, tagging, and flexible URL generation for posts.'''
}

Table djangocms_stories_postcontent {
  id integer [pk, increment]
  post_id bigint [not null]
  language varchar(15) [not null]
  title varchar(752) [not null]
  slug varchar(752) [not null]
  subtitle varchar(767) [default: '', not null]
  abstract text [default: '', not null]
  meta_description text [default: '', not null]
  meta_keywords text [default: '', not null]
  meta_title varchar(2000) [default: '', not null, note: 'used in title tag and social sharing']
  post_text text [default: '', not null]

