  available_from datetime
  available_until datetime
  subevent_mode DiscountSubeventMode [default: 'mixed', not null]
  condition_all_products bool [default: true, not null]
  condition_apply_to_addons bool [default: true, not null, note: 'Discounts never apply to bundled products']
  condition_ignore_voucher_discounted bool [default: false, not null, note: 'If this option is checked, products that already received a discount through a voucher will not be considered for this discount. However, products that use a voucher only to e.g. unlock a hidden product or gain access to sold-out quota will still be considered.']
  condition_min_count "integer unsigned" [default: 0, not null]
  condition_min_value decimal [not null, note: 'default in Python: Decimal(\'0.00\'). declared max_digits=13, decimal_places=2, which the database does not enforce']
  benefit_same_products bool [default: true, not null, note: 'By default, the discount is applied across the same selection of products than the condition for the discount given above. If you want, you can however also select a different selection of products.']
  benefit_discount_matching_percent decimal [not null, note: 'default in Python: Decimal(\'0.00\'). declared max_digits=10, decimal_places=2, which the database does not enforce']
  benefit_only_apply_to_cheapest_n_matches "integer unsigned" [note: 'This option allows you to create discounts of the type "buy X get Y reduced/for free". For example, if you set "Minimum number of matching products" to four and this value to two, the customer\'s cart will be split into groups of four tickets and the cheapest two tickets within every group will be discounted. If you want to grant the discount on all matching products, keep this field empty.']
  benefit_apply_to_addons bool [default: true, not null, note: 'Discounts never apply to bundled products']
  benefit_ignore_voucher_discounted bool [default: false, not null, note: 'If this option is checked, products that already received a discount through a voucher will not be discounted. However, products that use a voucher only to e.g. unlock a hidden product or gain access to sold-out quota will still receive the discount.']
  subevent_date_from datetime
  subevent_date_until datetime

  indexes {
    (event_id) [name: 'pretixbase_discount_event_id_15ffc96d']
  }
}

