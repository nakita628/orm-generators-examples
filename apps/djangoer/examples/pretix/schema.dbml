  description text [not null]
  position integer [default: 0, not null]
  is_addon bool [default: false, not null, note: 'If selected, the products belonging to this category are not for sale on their own. They can only be bought in combination with a product that has this category configured as a possible source for add-ons.']
  cross_selling_mode ItemCategoryCrossSellingMode
  cross_selling_condition ItemCategoryCrossSellingCondition

  indexes {
    (event_id) [name: 'pretixbase_itemcategory_event_id_0827a86a']
