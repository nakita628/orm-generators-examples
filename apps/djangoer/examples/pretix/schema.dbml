Table pretixbase_event {
  id integer [pk, increment]
  organizer_id bigint [not null]
  testmode bool [default: false, not null]
  name text [not null]
  slug varchar(50) [not null, note: 'Should be short, only contain lowercase letters, numbers, dots, and dashes, and must be unique among your events. We recommend some kind of abbreviation or a date with less than 10 characters that can be easily remembered, but you can also choose to use a random value. This will be used in URLs, order codes, invoice numbers, and bank transfer references.']
  live bool [default: false, not null]
  currency EventCurrency [default: 'EUR', not null]
  date_from datetime [not null]
  date_to datetime
  date_admission datetime
  is_public bool [default: true, not null, note: 'If selected, this event will show up publicly on the list of events for your organizer account.']
  presale_end datetime [note: 'Optional. No products will be sold after this date. If you do not set this value, the presale will end after the end date of your event.']
  presale_start datetime [note: 'Optional. No products will be sold before this date.']
  location text
  is_remote bool [default: false, not null, note: 'This will be used to let users know if the event is in a different timezone, and to let us calculate the local time of a user.']
  geo_lat real
  geo_lon real
  plugins text [not null]
  comment text
  has_subevents bool [default: false, not null]
  seating_plan_id bigint
  last_modified datetime [not null, note: 'default in Python: now()']
  all_sales_channels bool [default: true, not null]

  indexes {
    (organizer_id) [name: 'pretixbase_event_organizer_id_f31b86fa']
    (slug) [name: 'pretixbase_event_slug_8033ce26']
    (seating_plan_id) [name: 'pretixbase_event_seating_plan_id_11bc56fa']
    (last_modified) [name: 'pretixbase_event_last_modified_fe031b38']
    (organizer_id, slug) [unique, name: 'pretixbase_event_organizer_id_slug_ef87d553_uniq']
  }

  Note: '''This model represents an event. An event is anything you can buy
tickets for.

:param organizer: The organizer this event belongs to
:type organizer: Organizer
:param testmode: This event is in test mode
:type testmode: bool
:param name: This event\'s full title
:type name: str
:param slug: A short, alphanumeric, all-lowercase name for use in URLs. The slug has to
             be unique among the events of the same organizer.
:type slug: str
:param live: Whether or not the shop is publicly accessible
:type live: bool
:param currency: The currency of all prices and payments of this event
:type currency: str
:param date_from: The datetime this event starts
:type date_from: datetime
:param date_to: The datetime this event ends
:type date_to: datetime
:param presale_start: No tickets will be sold before this date.
:type presale_start: datetime
:param presale_end: No tickets will be sold after this date.
:type presale_end: datetime
:param location: venue
:type location: str
:param plugins: A comma-separated list of plugin names that are active for this event.
:type plugins: str
:param has_subevents: Enable event series functionality
:type has_subevents: bool
:param all_sales_channels: A flag indicating that this event is available on all channels and limit_sales_channels will be ignored.
:type all_sales_channels: bool
:param limit_sales_channels: A list of sales channel identifiers, that this event is available for sale on
:type limit_sales_channels: list'''
}

