Table pretixbase_user {
  id integer [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  email varchar(190) [unique]
  is_verified bool [default: false, not null]
  fullname varchar(255)
  is_active bool [default: true, not null]
  is_staff bool [default: false, not null]
  date_joined datetime [not null, note: 'default in Python: now()']
  needs_password_change bool [default: false, not null]
  locale UserLocale [default: 'en', not null]
  timezone varchar(100) [default: 'UTC', not null]
  require_2fa bool [default: false, not null]
  notifications_send bool [default: true, not null, note: 'If turned off, you will not get any notifications.']
  notifications_token varchar(255) [not null, note: 'default in Python: generate_notifications_token()']
  auth_backend varchar(255) [default: 'native', not null]
  auth_backend_identifier varchar(190)
  session_token varchar(32) [not null, note: 'default in Python: generate_session_token()']

  indexes {
    (auth_backend_identifier) [name: 'pretixbase_user_auth_backend_identifier_44ab37d0']
    (auth_backend, auth_backend_identifier) [unique, name: 'pretixbase_user_auth_backend_auth_backend_identifier_8727d359_uniq']
  }

  Note: '''This is the user model used by pretix for authentication.

:param email: The user\'s email address, used for identification.
:type email: str
:param fullname: The user\'s full name. May be empty or null.
:type fullname: str
:param is_active: Whether this user account is activated.
:type is_active: bool
:param is_staff: ``True`` for system operators.
:type is_staff: bool
:param date_joined: The datetime of the user\'s registration.
:type date_joined: datetime
:param locale: The user\'s preferred locale code.
:type locale: str
:param needs_password_change: Whether this user\'s password needs to be changed.
:type needs_password_change: bool
:param timezone: The user\'s preferred timezone.
:type timezone: str
:param auth_backend: The identifier of the authentication backend plugin responsible for managing this user.
:type auth_backend: str
:param auth_backend_identifier: The native identifier of the user provided by a non-native authentication backend.
:type auth_backend_identifier: str

Columns from AbstractBaseUser (abstract): password, last_login.'''
}

