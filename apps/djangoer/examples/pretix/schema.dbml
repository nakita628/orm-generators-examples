Table pretixbase_team {
  id integer [pk, increment]
  organizer_id bigint [not null]
  name varchar(190) [not null]
  require_2fa bool [default: false, not null, note: 'If you turn this on, all members of the team will be required to either set up two-factor authentication or leave the team. The setting may take a few minutes to become effective for all users.']
  all_events bool [default: false, not null]
  all_event_permissions bool [default: false, not null]
  limit_event_permissions text [not null, note: 'default in Python: dict()']
  all_organizer_permissions bool [default: false, not null]
  limit_organizer_permissions text [not null, note: 'default in Python: dict()']

  indexes {
    (organizer_id) [name: 'pretixbase_team_organizer_id_05a40a53']
  }

  Note: '''A team is a collection of people given certain access rights to one or more events of an organizer.

:param name: The name of this team
