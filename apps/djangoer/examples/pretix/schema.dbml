  ignore_in_statistics bool [default: false, not null]
  consider_tickets_used bool [default: true, not null, note: 'This is relevant in various situations, e.g. for deciding if a ticket can still be canceled by the customer.']
  include_pending bool [default: false, not null, note: 'With this option, people will be able to check in even if the order has not been paid.']
  addon_match bool [default: false, not null, note: 'A scan will only be possible if the check-in list is configured such that there is always exactly one matching add-on ticket. Ambiguous scans will be rejected..']
  allow_entry_after_exit bool [default: true, not null]
  allow_multiple_entries bool [default: false, not null, note: 'Use this option to turn off warnings if a ticket is scanned a second time.']
  exit_all_at datetime
  rules text [not null, note: 'default in Python: dict()']

  indexes {
    (event_id) [name: 'pretixbase_checkinlist_event_id_cf987659']
