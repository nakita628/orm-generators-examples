:type position: int'''
}

Table pretixbase_subeventitem {
  id integer [pk, increment]
  subevent_id bigint [not null]
  item_id bigint [not null]
  price decimal [note: 'declared max_digits=13, decimal_places=2, which the database does not enforce']
  disabled bool [default: false, not null]
  available_from datetime [note: 'This product will not be sold before the given date.']
  available_until datetime [note: 'This product will not be sold after the given date.']

  indexes {
    (subevent_id) [name: 'pretixbase_subeventitem_subevent_id_2da8e314']
    (item_id) [name: 'pretixbase_subeventitem_item_id_87c1ba29']
  }

  Note: '''This model can be used to change the price of a product for a single subevent (i.e. a
date in an event series).

:param subevent: The date this belongs to
:type subevent: SubEvent
