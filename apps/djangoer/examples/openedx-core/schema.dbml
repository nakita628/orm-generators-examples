}

Table oel_tagging_tag {
  id integer [pk, increment]
  taxonomy_id bigint [default: null, note: 'Namespace and rules for using a given set of tags.']
  parent_id bigint [default: null, note: 'Tag that lives one level up from the current tag, forming a hierarchy.']
  value varchar(500) [not null, note: 'Content of a given tag, occupying the \'value\' part of the key:value pair.']
  external_id varchar(255) [not null, note: 'Used to link an Open edX Tag with a tag in an externally-defined taxonomy.']
  depth integer [default: 0, not null, note: 'Number of ancestors this tag has. Zero for root tags, one for their children, and so on. Set automatically by save(); do not set manually.']
  lineage varchar(3006) [default: '', not null, note: 'Tab-separated ancestor path including this tag: \'Root\\tParent\\t...\\tThisValue\\t\'. Used for depth-first tree ordering and descendant prefix matching. Set automatically by save(); do not set manually.']
  archived bool [default: false, not null, note: 'Hides this tag from active use by default, without removing it.']

  indexes {
    (taxonomy_id) [name: 'oel_tagging_tag_taxonomy_id_5ffdeb8b']
    (parent_id) [name: 'oel_tagging_tag_parent_id_2d99b9b4']
    (taxonomy_id, external_id) [unique, name: 'oel_tagging_tag_taxonomy_id_external_id_f308f968_uniq']
    (taxonomy_id, value) [unique, name: 'oel_tagging_tag_taxonomy_id_value_f0e6dab9_uniq']
    (taxonomy_id, value) [name: 'oel_tagging_taxonom_89e779_idx']
    (taxonomy_id, external_id) [name: 'oel_tagging_taxonom_44e355_idx']
    (lineage) [name: 'oel_tagging_lineage_d65f82_idx']
  }

  checks {
    `("parent_id" IS NULL OR "depth" > 0)` [name: 'oel_tagging_tag_depth_parent_check']
    `"lineage" LIKE '%' || REPLACE(REPLACE(REPLACE((COALESCE("value", '') || COALESCE('	', '')), '\', '\\'), '%', '\%'), '_', '\_') ESCAPE '\'` [name: 'oel_tagging_tag_lineage_ends_with_value']
    `"depth" = ((LENGTH("lineage") - LENGTH(REPLACE("lineage", '	', ''))) - 1)` [name: 'oel_tagging_tag_lineage_tab_count_check']
  }

  Note: '''Represents a single value in a list or tree of values which can be applied to a particular Open edX object.

Open edX tags are "name:value" pairs which can be applied to objects like content libraries, units, or people.
Tag.taxonomy.name provides the "name" and the Tag.value provides the "value".
(And an ObjectTag links a Tag with an object.)'''
}

Table oel_tagging_taxonomy {
  id integer [pk, increment]
  name varchar(255) [not null, note: 'User-facing label used when applying tags from this taxonomy to Open edX objects.']
  description text [not null, note: 'Provides extra information for the user when applying tags from this taxonomy to an object.']
  enabled bool [default: true, not null, note: 'Only enabled taxonomies will be shown to authors.']
  allow_multiple bool [default: true, not null, note: 'Indicates that multiple tags from this taxonomy may be added to an object.']
  allow_free_text bool [default: false, not null, note: 'Indicates that tags in this taxonomy need not be predefined; authors may enter their own tag values.']
  visible_to_authors bool [default: true, not null, note: 'Indicates whether this taxonomy should be visible to object authors.']
  export_id varchar(255) [unique, not null, note: 'User-facing ID that is used on import/export. Should only contain alphanumeric characters or \'_\' \'-\' \'.\'']
  read_only bool [default: false, not null, note: 'Indicates that the tags in this taxonomy are maintained by the system or an external integration; taxonomy admins will not be permitted to add, edit, or delete its tags.']
  archived bool [default: false, not null, note: 'Hides this taxonomy from active use by default, without removing it. Unlike disabling it with \'enabled\', archiving marks the taxonomy as retired.']

  indexes {
    (name) [name: 'oel_tagging_taxonomy_name_41aebebd']
  }

  Note: '''Represents a namespace and rules for a group of tags.'''
}

Table oel_tagging_objecttag {
  id integer [pk, increment]
  object_id varchar(255) [not null, note: 'Identifier for the object being tagged']
  taxonomy_id bigint [default: null, note: 'Taxonomy that this object tag belongs to. Used for validating the tag and provides the tag\'s \'name\' if set.']
  tag_id bigint [default: null, note: 'Tag associated with this object tag. Provides the tag\'s \'value\' if set.']
  is_copied bool [default: false, not null, note: 'True if this object tag has been copied from one object to another using \'copy_tags\' api function']
  _export_id varchar(255) [not null, note: 'User-facing label used for this tag, stored in case taxonomy is (or becomes) null. If the taxonomy field is set, then taxonomy.export_id takes precedence over this field.']
  _value varchar(500) [not null, note: 'User-facing value used for this tag, stored in case tag is null, e.g if taxonomy is free text, or if it becomes null (e.g. if the Tag is deleted). If the tag field is set, then tag.value takes precedence over this field.']
  archived bool [default: false, not null, note: 'Hides this association from active use by default, without removing it.']
  deletion_locked bool [default: false, not null, note: 'Set when something outside the tagging app depends on this association; a delete archives it instead of removing it.']

  indexes {
    (object_id) [name: 'oel_tagging_objecttag_object_id_c810f770']
    (taxonomy_id) [name: 'oel_tagging_objecttag_taxonomy_id_48a985b4']
    (tag_id) [name: 'oel_tagging_objecttag_tag_id_6c23e4f0']
    (object_id, taxonomy_id, tag_id) [unique, name: 'oel_tagging_objecttag_object_id_taxonomy_id_tag_id_900a25fb_uniq']
    (object_id, taxonomy_id, _value) [unique, name: 'oel_tagging_objecttag_object_id_taxonomy_id__value_6243e6d6_uniq']
    (taxonomy_id, object_id) [name: 'oel_tagging_taxonom_aa24e6_idx']
    (taxonomy_id, _value) [name: 'oel_tagging_taxonom_3668ec_idx']
  }

  Note: '''Represents the association between a tag and an Open edX object.

Tagging content in Open edX involves linking the object to a particular name:value "tag", where the "name" is the
tag\'s label, and the value is the content of the tag itself.

Tagging objects can be time-consuming for users, and so we guard against the deletion of Taxonomies and Tags by
providing fields to cache the name:value stored for an object.

However, sometimes Taxonomy names or Tag values change (e.g if there\'s a typo, or a policy change about how a label
is used), and so we still store a link to the original Taxonomy and Tag, so that these changes will take precedence
over the original name:value used.

Also, if an ObjectTag is associated with free-text Taxonomy, then the tag\'s value won\'t be stored as a standalone
Tag in the database -- it\'ll be stored here.'''
}

Table oel_tagging_tagimporttask {
  id integer [pk, increment]
  taxonomy_id bigint [not null, note: 'Taxonomy associated with this import']
  log text [default: null, not null, note: 'Action execution logs']
  status TagImportTaskState [not null, note: 'Task status']
  creation_date datetime [not null, note: 'default in Python: now()']

  indexes {
    (taxonomy_id) [name: 'oel_tagging_tagimporttask_taxonomy_id_955bb3a3']
    (taxonomy_id, creation_date) [name: 'oel_tagging_taxonom_5e948c_idx', note: 'descending: creation_date']
  }

  Note: '''Stores the state, plan and logs of a tag import task'''
}

