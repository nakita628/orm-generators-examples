Table djangocms_googlemap_googlemap {
  template GoogleMapTemplate [default: 'default', not null]
  title varchar(255) [not null]
  width varchar(6) [default: '100%', not null, note: 'Width of the map, including the CSS length units (e.g. "100%", "400px" or "400rem").']
  height varchar(6) [default: '400px', not null, note: 'Height of the map, including the CSS length units (e.g. "400px" or "400rem").']
  style text [not null, note: 'Provide a valid (escaped) JSON configuration. See http://developers.google.com/maps/documentation/javascript/styling']
  map_id varchar(32) [not null, note: 'Map ID of Cloud-based maps styling. See https://developers.google.com/maps/documentation/cloud-customization/overview']
  lat real [note: 'Default Geographical latitude in degrees (e.g. "46.947973").']
  lng real [note: 'Default Geographical longitude in degrees (e.g. "7.447446").']
  zoom GoogleMapZoom [default: 13, not null]
  map_type_control GoogleMapMapTypeControl [default: 'ROADMAP', not null]
  zoom_control bool [default: true, not null, note: 'Enabling zooming allows the user to view the map at different scales.']
  street_view_control bool [default: true, not null, note: 'Street View allows the user to see street-level imagery.']
  rotate_control bool [default: true, not null, note: 'Allows the user to change the orientation of the map.']
  scale_control bool [default: true, not null, note: 'Displays a linear distance scale on the map.']
  fullscreen_control bool [default: true, not null, note: 'Allows the user to select a fullscreen view of the map.']
  pan_control bool [default: true, not null, note: 'Allows the user to move the map using the cursor keys to see new areas.']
  double_click_zoom bool [default: true, not null, note: 'Allows the user to zoom and centre the map with a double-click or double-tap.']
  draggable bool [default: true, not null, note: 'Allows the user to drag the map to see new areas.']
  keyboard_shortcuts bool [default: true, not null, note: 'Allows the user to control the map using the keyboard.']
  scrollwheel bool [default: true, not null, note: 'Allows the user to control the zoom level with a scroll-wheel.']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a GoogleMap is a CMSPlugin (multi-table inheritance)']

  Note: '''Renders the Google Maps wrapper'''
}

