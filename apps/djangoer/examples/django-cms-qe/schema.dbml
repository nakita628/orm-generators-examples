Table cms_qe_auth_user {
  id integer [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  is_superuser bool [default: false, not null, note: 'Designates that this user has all permissions without explicitly assigning them.']
  username varchar(150) [unique, not null, note: 'Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.']
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff bool [default: false, not null, note: 'Designates whether the user can log into this admin site.']
  is_active bool [default: true, not null, note: 'Designates whether this user should be treated as active. Unselect this instead of deleting accounts.']
  date_joined datetime [not null, note: 'default in Python: now()']

  Note: '''Columns from AbstractUser (abstract): username, first_name, last_name, email, is_staff, is_active, date_joined.

Columns from AbstractBaseUser (abstract): password, last_login.

Columns from PermissionsMixin (abstract): is_superuser.'''
}

Table cms_qe_menu_menupluginmodel {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a MenuPluginModel is a CMSPlugin (multi-table inheritance)']
  orientation MenuPluginModelOrientation [default: 1, not null]
  start_page varchar(50) [not null, note: 'ID of page in advanced settings.']
  end_level integer [default: 2, not null, note: '''Specify at which level the navigation should stop.

            Keep in mind that Bootstrap by default does not support dropdown submenu.
            Any deep dropdown menu is not very well accessible from mobile devices.''']
  submenu_in_inactive_item bool [default: true, not null]
}

Table cms_qe_newsletter_newsletterpluginmodel {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a NewsletterPluginModel is a CMSPlugin (multi-table inheritance)']
  title varchar(150) [not null, note: 'The title of subscribes that will be shown to users']
  fullname_show bool [default: false, not null]
  fullname_require bool [default: false, not null]

  Note: '''Configuration model for newsletter plugin.
Allows to set:
* Title
* Mail lists on mailchimp to which subscribers will be added
* Show or hide full name
* Require full name or not'''
}

Table cms_qe_newsletter_mailinglist {
  id integer [pk, increment]
  name varchar(50) [not null]
  external_service MailingListExternalService [default: 1, not null]
  external_id varchar(10)

  Note: '''Mailing list model which also synchronize with external services like Mailchimp.
If ``external_id`` is not set then subscriber is not synchronized.'''
}

Table cms_qe_newsletter_subscriber {
  id integer [pk, increment]
  mailing_list_id bigint [not null]
  email varchar(254) [not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  external_id varchar(50)

  indexes {
    (mailing_list_id) [name: 'cms_qe_newsletter_subscriber_mailing_list_id_2776912a']
  }

  Note: '''Subscriber model which also synchronize with external services like Mailchimp.
If ``external_id`` is not set then subscriber is not synchronized.'''
}

Table cms_qe_newsletter_subscribetask {
  id integer [pk, increment]
  mailing_list_id bigint
  email varchar(254) [not null]
  first_name varchar(50)
  last_name varchar(50)
  external_id varchar(10)
  type SubscribeTaskType [not null]
  created datetime [not null, note: 'default in Python: now()']
  attempts "smallint unsigned" [default: 0, not null]
  last_error text [not null]

  indexes {
    (mailing_list_id) [name: 'cms_qe_newsletter_subscribetask_mailing_list_id_356da1d6']
  }

  Note: '''Item for task queue for subscribing and unsubscribing members on the external
service like Mailchimp. The queue can is processed by ``cms-qe-newsletter-sync`` command.'''
}

Table cms_qe_table_tablepluginmodel {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a TablePluginModel is a CMSPlugin (multi-table inheritance)']
  table varchar(100) [not null]
  columns text [not null, note: 'default in Python: dict()']
  filter text [not null, note: 'default in Python: dict()']
  paging_show bool [default: true, not null]
  paging_per_page integer [default: 20, not null]

  Note: '''Configuration model for plugin Table for Django CMS QE. Possibility to specify
table, columns, order, filtering etc. etc.'''
}

Table cms_qe_video_sourcefilevideoplayer {
  label varchar(255) [not null]
  poster_id integer
  width integer [note: 'Leave it blank to make a video player of the default width of video source']
  height integer [note: 'Leave it blank to make a video player of the default width of video source']
  controls bool [default: true, not null]
  autoplay bool [default: false, not null]
  loop bool [default: false, not null]
  other_attributes text [not null, note: 'default in Python: dict()']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a SourceFileVideoPlayer is a CMSPlugin (multi-table inheritance)']
  source_file_id integer
  text_title varchar(255) [not null]
  text_description text [not null]
  attributes text [not null, note: 'default in Python: dict()']
  muted bool [default: false, not null]

  indexes {
    (poster_id) [name: 'cms_qe_video_sourcefilevideoplayer_poster_id_5d111ef3']
    (source_file_id) [name: 'cms_qe_video_sourcefilevideoplayer_source_file_id_70953750']
  }

  Note: '''Configuration model for video player to play video from file on local disk.

Columns from AbstractVideoPlayer (abstract): label, poster_id, width, height, controls, autoplay, loop, other_attributes, cmsplugin_ptr_id.'''
}

Table cms_qe_video_hostingvideoplayer {
  label varchar(255) [not null]
  poster_id integer
  width integer [note: 'Leave it blank to make a video player of the default width of video source']
  height integer [note: 'Leave it blank to make a video player of the default width of video source']
  controls bool [default: true, not null]
  autoplay bool [default: false, not null]
  loop bool [default: false, not null]
  other_attributes text [not null, note: 'default in Python: dict()']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a HostingVideoPlayer is a CMSPlugin (multi-table inheritance)']
  video_hosting_service HostingVideoPlayerVideoHostingService [default: 3, not null]
  video_url varchar(255) [not null, note: 'Use this field to embed videos from external services such as YouTube, Vimeo or others.']

  indexes {
    (poster_id) [name: 'cms_qe_video_hostingvideoplayer_poster_id_30161606']
  }

  Note: '''Configuration model for video player to play video from video hosting services.

Columns from AbstractVideoPlayer (abstract): label, poster_id, width, height, controls, autoplay, loop, other_attributes, cmsplugin_ptr_id.'''
}

Table cms_qe_video_videotrack {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a VideoTrack is a CMSPlugin (multi-table inheritance)']
  kind VideoTrackKind [not null]
  src_id integer
  srclang varchar(255) [not null, note: 'Examples: "en" or "de" etc.']
  label varchar(255) [not null]
  attributes text [not null, note: 'default in Python: dict()']

  indexes {
    (src_id) [name: 'cms_qe_video_videotrack_src_id_481fb094']
  }

  Note: '''Renders the HTML <track> element inside <video>.'''
}

Table cms_qe_plugins_script {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a Script is a CMSPlugin (multi-table inheritance)']
  src varchar(255) [not null, note: 'Specifies the location of the linked script.']
  asyncf bool [default: false, not null, note: 'Specifies that the script is downloaded in parallel to parsing the page, and executed as soon as it is available (before parsing completes) (only for external scripts)']
  cross_origin ScriptCrossOrigin [default: null, note: 'Sets the mode of the request to an HTTP CORS Request.']
  defer bool [default: false, not null, note: 'Specifies that the script is downloaded in parallel to parsing the page, and executed after the page has finished parsing (only for external scripts)']
  integrity varchar(255) [note: 'Allows a browser to check the fetched script to ensure that the code is never loaded if the source has been manipulated']
  nomodule bool [default: false, not null, note: 'Specifies that the script should not be executed in browsers supporting ES2015 modules.']
  referrer_policy ScriptReferrerPolicy [default: null, note: 'Specifies which referrer to use when fetching the resource.']
  type varchar(255) [note: 'Specifies the media type of the script.']
  attributes text [note: 'More attributes as JSON data. E.g. {"data-name": "value", "id": 42}']

  Note: '''HTML Script tag.'''
}

Table cms_qe_plugins_link {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a cms_qe_plugins.Link is a CMSPlugin (multi-table inheritance)']
  href varchar(255) [not null, note: 'Specifies the location of the linked document.']
  rel CmsQePluginsLinkRel [default: 'stylesheet', not null, note: 'Required. Specifies the relationship between the current document and the linked document.']
  cross_origin CmsQePluginsLinkCrossOrigin [default: null, note: 'Specifies how the element handles cross-origin requests.']
  hreflang varchar(30) [note: 'Specifies the language of the text in the linked document.']
  media varchar(255) [note: 'Specifies on what device the linked document will be displayed.']
  referrer_policy CmsQePluginsLinkReferrerPolicy [default: null, note: 'Specifies which referrer to use when fetching the resource.']
  sizes varchar(255) [note: 'Specifies the size of the linked resource. Only for rel="icon".']
  title varchar(255) [note: 'Defines a preferred or an alternate stylesheet.']
  type varchar(255) [note: 'Specifies the media type of the linked document. E.g. \'text/css\'.']
  attributes text [note: 'More attributes as JSON data. E.g. {"data-name": "value", "id": 42}']

  Note: '''HTML Link tag.'''
}

Table cms_qe_plugins_iframe {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a Iframe is a CMSPlugin (multi-table inheritance)']
  src varchar(255) [not null, note: 'Specifies the address of the document to embed in the &lt;iframe&gt;.']
  allow varchar(255) [note: 'Specifies a feature policy for the &lt;iframe&gt;. Form more see <a href=\'https://developer.mozilla.org/en-US/docs/Web/HTML/Element/iframe#allow\' target=\'_blank\'>IFrame attributes.</a>.']
  allow_full_screen bool [note: 'Set to true if the &lt;iframe&gt; can activate fullscreen mode by calling the requestFullscreen() method.']
  allow_payment_request bool [note: 'Set to true if a cross-origin &lt;iframe&gt; should be allowed to invoke the Payment Request API.']
  height integer [note: 'Specifies the height of an &lt;iframe&gt;. Default height is 150 pixels.']
  width integer [note: 'Specifies the width of an &lt;iframe&gt;. Default width is 300 pixels.']
  loading IframeLoading [default: null, note: 'Specifies whether a browser should load an iframe immediately or to defer loading of iframes until some conditions are met.']
  name varchar(255) [note: 'Specifies the name of an &lt;iframe&gt;.']
  referrer_policy IframeReferrerPolicy [default: null, note: 'Specifies which referrer information to send when fetching the iframe.']
  sandbox IframeSandbox [default: null, note: 'Enables an extra set of restrictions for the content in an &lt;iframe&gt;.']
  src_doc text [note: 'Specifies the HTML content of the page to show in the &lt;iframe&gt;.']
  attributes text [note: 'More attributes as JSON data. E.g. {"data-name": "value", "id": 42}']

  Note: '''HTML Iframe tag.'''
}

Table django_admin_log {
  id integer [pk, increment]
  action_time datetime [not null, note: 'default in Python: now()']
  user_id bigint [not null]
  content_type_id integer
  object_id text
  object_repr varchar(200) [not null]
  action_flag LogEntryActionFlag [not null]
  change_message text [not null]

  indexes {
    (user_id) [name: 'django_admin_log_user_id_c564eba6']
    (content_type_id) [name: 'django_admin_log_content_type_id_c4bce8eb']
  }
}

Table auth_permission {
  id integer [pk, increment]
  name varchar(255) [not null]
  content_type_id integer [not null]
  codename varchar(100) [not null]

  indexes {
    (content_type_id) [name: 'auth_permission_content_type_id_2f476e4b']
    (content_type_id, codename) [unique, name: 'auth_permission_content_type_id_codename_01ab375a_uniq']
  }

  Note: '''The permissions system provides a way to assign permissions to specific
users and groups of users.

The permission system is used by the Django admin site, but may also be
useful in your own code. The Django admin site uses permissions as follows:

    - The "add" permission limits the user\'s ability to view the "add" form
      and add an object.
    - The "change" permission limits a user\'s ability to view the change
      list, view the "change" form and change an object.
    - The "delete" permission limits the ability to delete an object.
    - The "view" permission limits the ability to view an object.

Permissions are set globally per type of object, not per specific object
instance. It is possible to say "Mary may change news stories," but it\'s
not currently possible to say "Mary may change news stories, but only the
ones she created herself" or "Mary may only change news stories that have a
certain status or publication date."

The permissions listed above are automatically created for each model.'''
}

Table auth_group {
  id integer [pk, increment]
  name varchar(150) [unique, not null]

  Note: '''Groups are a generic way of categorizing users to apply permissions, or
some other label, to those users. A user can belong to any number of
groups.

A user in a group automatically has all the permissions granted to that
group. For example, if the group \'Site editors\' has the permission
can_edit_home_page, any user in that group will have that permission.

Beyond permissions, groups are a convenient way to categorize users to
apply some label, or extended functionality, to them. For example, you
could create a group \'Special users\', and you could write code that would
do special things to those users -- such as giving them access to a
members-only portion of your site, or sending them members-only email
messages.'''
}

Table django_content_type {
  id integer [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]

  indexes {
    (app_label, model) [unique, name: 'django_content_type_app_label_model_76bd3d3b_uniq']
  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date datetime [not null]

  indexes {
    (expire_date) [name: 'django_session_expire_date_a5c62663']
  }

  Note: '''Django provides full support for anonymous sessions. The session
framework lets you store and retrieve arbitrary data on a
per-site-visitor basis. It stores data on the server side and
abstracts the sending and receiving of cookies. Cookies contain a
session ID -- not the data itself.

The Django sessions framework is entirely cookie-based. It does
not fall back to putting session IDs in URLs. This is an intentional
design decision. Not only does that behavior make URLs ugly, it makes
your site vulnerable to session-ID theft via the "Referer" header.

For complete documentation on using Sessions in your code, consult
the sessions documentation that is shipped with Django (also available
on the Django web site).

Columns from AbstractBaseSession (abstract): session_key, session_data, expire_date.'''
}

Table django_site {
  id integer [pk, increment]
  domain varchar(100) [unique, not null]
  name varchar(50) [not null]
}

Table cms_usersettings {
  id integer [pk, increment]
  user_id bigint [unique, not null]
  language UserSettingsLanguage [not null, note: 'The language for the admin interface and toolbar']
  clipboard_id integer

  indexes {
    (clipboard_id) [name: 'cms_usersettings_clipboard_id_3ae17c19']
  }
}

Table cms_page {
  id integer [pk, increment]
  path varchar(255) [unique, not null]
  depth "integer unsigned" [not null]
  numchild "integer unsigned" [default: 0, not null]
  parent_id integer
  site_id integer [not null]
  created_by varchar(255) [not null]
  changed_by varchar(255) [not null]
  creation_date datetime [not null, note: 'default in Python: now()']
  changed_date datetime [not null, note: 'default in Python: now()']
  reverse_id varchar(40) [note: 'A unique identifier that is used with the page_url templatetag for linking to this page']
  navigation_extenders varchar(80)
  login_required bool [default: false, not null]
  is_home bool [default: false, not null]
  application_urls varchar(200)
  application_namespace varchar(200)
  is_page_type bool [default: false, not null, note: 'Mark this page as a page type']

  indexes {
    (parent_id) [name: 'cms_page_parent_id_f89b72e4']
    (site_id) [name: 'cms_page_site_id_4323d3ff']
    (reverse_id) [name: 'cms_page_reverse_id_ffc9ede2']
    (navigation_extenders) [name: 'cms_page_navigation_extenders_c24af8dd']
    (is_home) [name: 'cms_page_is_home_edadca07']
    (application_urls) [name: 'cms_page_application_urls_9ef47497']
  }

  Note: '''A ``Page`` is the basic unit of site structure in django CMS. The CMS uses a hierarchical page model: each page
stands in relation to other pages as parent, child or sibling. This hierarchy is managed by the `django-treebeard
<http://django-treebeard.readthedocs.io/en/latest/>`_ library.

A ``Page`` is an abstract entity. It does not have any content associated with it, nor does is provide any slugs to
build a URL. This is part of the model :class:`~cms.models.contentmodels.PageContent` and
:class:`~cms.models.pagemodel.PageUrl` respectively.

Proxy models: PageType.

Columns from MP_Node (abstract): path, depth, numchild.'''
}

Table cms_pageurl {
  id integer [pk, increment]
  slug varchar(255) [not null]
  path varchar(255)
  language varchar(15) [not null]
  page_id integer [not null]
  site_id integer [not null]
  managed bool [default: false, not null]

  indexes {
    (slug) [name: 'cms_pageurl_slug_f8d42287']
    (path) [name: 'cms_pageurl_path_9f26e673']
    (language) [name: 'cms_pageurl_language_a10302dc']
    (page_id) [name: 'cms_pageurl_page_id_dbf4793a']
    (site_id) [name: 'cms_pageurl_site_id_7d6fd976']
    (page_id, language) [unique, name: 'unique_together_page_language']
    (site_id, language, path) [unique, name: 'unique_site_language_path']
  }
}

Table cms_globalpagepermission {
  id integer [pk, increment]
  user_id bigint
  group_id integer
  can_change bool [default: true, not null]
  can_add bool [default: true, not null]
  can_delete bool [default: true, not null]
  can_publish bool [default: true, not null]
  can_change_advanced_settings bool [default: false, not null]
  can_change_permissions bool [default: false, not null, note: 'Allows this user to grant and revoke page permissions for other users.']
  can_move_page bool [default: true, not null]
  can_view bool [default: false, not null, note: 'Grants frontend view access. Note: as soon as any user or group is given view access to a page, that page becomes restricted — only users/groups with view access can then see it on the frontend.']
  can_recover_page bool [default: true, not null, note: 'can recover any deleted page']

  indexes {
    (user_id) [name: 'cms_globalpagepermission_user_id_a227cee1']
    (group_id) [name: 'cms_globalpagepermission_group_id_991b4733']
  }

  Note: '''Permissions for all pages (global).

Columns from AbstractPagePermission (abstract): user_id, group_id, can_change, can_add, can_delete, can_publish, can_change_advanced_settings, can_change_permissions, can_move_page, can_view.'''
}

Table cms_pagepermission {
  id integer [pk, increment]
  user_id bigint
  group_id integer
  can_change bool [default: true, not null]
  can_add bool [default: true, not null]
  can_delete bool [default: true, not null]
  can_publish bool [default: true, not null]
  can_change_advanced_settings bool [default: false, not null]
  can_change_permissions bool [default: false, not null, note: 'Allows this user to grant and revoke page permissions for other users.']
