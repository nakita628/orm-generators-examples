  contentguard_ptr_id uuid [pk, note: 'parent link: a RBACContentGuard is a ContentGuard (multi-table inheritance)']

  Note: '''A content guard that protects content based on RBAC permissions.'''
}

Table core_contentredirectcontentguard {
  contentguard_ptr_id uuid [pk, note: 'parent link: a ContentRedirectContentGuard is a ContentGuard (multi-table inheritance)']
