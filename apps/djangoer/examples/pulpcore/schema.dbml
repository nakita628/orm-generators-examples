  Note: '''Content guard to allow preauthenticated redirects to the content app.'''
}

Table core_headercontentguard {
  contentguard_ptr_id uuid [pk, note: 'parent link: a HeaderContentGuard is a ContentGuard (multi-table inheritance)']
  header_name text [not null]
  header_value text [not null]
  jq_filter text

  Note: '''Content guard to protect content based on a header value.'''
}

Table core_envvarheadercontentguard {
  contentguard_ptr_id uuid [pk, note: 'parent link: a EnvVarHeaderContentGuard is a ContentGuard (multi-table inheritance)']
  header_name text [not null]
  env_var text [not null]

  Note: '''Content guard that validates a Base64-encoded header against a server-side environment variable.

Clients and proxies must send the expected secret as a Base64-encoded UTF-8 string in
``header_name``. Pulp decodes the header, then compares the result to the value of
``os.environ[env_var]`` using a timing-safe comparison.

``env_var`` must be listed in ``settings.ENVVAR_HEADER_CONTENT_GUARD_ALLOWED_VARS``.
The expected secret is read from the content-app process environment at request time
so rotation only requires updating the environment and redeploying.'''
}

Table core_compositecontentguard {
  contentguard_ptr_id uuid [pk, note: 'parent link: a CompositeContentGuard is a ContentGuard (multi-table inheritance)']

  Note: '''Content guard to allow a list of contentguards to be evaluated on access.

Content-guards in the `guards` list have their permit() calls issued in order. At the
first "pass" result, access is permitted. Only if ALL guards in the list forbid access,
is access forbidden.

guards (django.db.models.ManyToManyField): ContentGuards to invoke.'''
}

Table core_distribution {
  pulp_id uuid [pk, note: 'default in Python: pulp_uuid()']
  pulp_created "timestamp with time zone" [not null, note: 'default in Python: now()']
  pulp_last_updated "timestamp with time zone" [note: 'default in Python: now()']
  pulp_type text [default: null, not null]
  name text [not null]
  pulp_labels hstore [not null, note: 'default in Python: dict()']
  base_path relative_path [not null]
  pulp_domain_id uuid [not null, note: 'default in Python: get_domain_pk()']
  hidden boolean [default: false]
  checkpoint boolean [default: false, not null]
  content_guard_id uuid
  publication_id uuid
  remote_id uuid
  repository_id uuid
  repository_version_id uuid

  indexes {
    (pulp_type) [name: 'core_distribution_pulp_type_5de1abde']
    (pulp_type) [name: 'core_distribution_pulp_type_5de1abde_like', note: 'text_pattern_ops']
    (name) [name: 'core_distribution_name_c10ccb23']
    (name) [name: 'core_distribution_name_c10ccb23_like', note: 'text_pattern_ops']
    (pulp_domain_id) [name: 'core_distribution_pulp_domain_id_096b6a5b']
    (content_guard_id) [name: 'core_distribution_content_guard_id_64c5c91a']
    (publication_id) [name: 'core_distribution_publication_id_fb4e0f9c']
    (remote_id) [name: 'core_distribution_remote_id_fff5b712']
    (repository_id) [name: 'core_distribution_repository_id_27bc2475']
    (repository_version_id) [name: 'core_distribution_repository_version_id_6ac2a9bf']
    (name, pulp_domain_id) [unique, name: 'core_distribution_name_pulp_domain_id_cc58b558_uniq']
    (base_path, pulp_domain_id) [unique, name: 'core_distribution_base_path_pulp_domain_id_c05ad346_uniq']
    (base_path) [name: 'core_distribution_base_path_text', note: 'using spgist; text_ops; include (pulp_domain_id)']
  }

  Note: '''A Distribution defines how the Content App distributes a publication or repository_version.

This master model can be used by plugin writers to create detail Distribution objects.

The `name` must be unique.

The `base_path` must have no overlapping components. So if a Distribution with `base_path`
of `a/path/foo` existed, you could not make a second Distribution with a `base_path` of
`a/path` or `a` because both are subpaths of `a/path/foo`.

Subclasses are expected to use either the `publication` or `repository_version` field, but
not both. The content app that serves content is not prepared to serve content both ways at the
same time.

Fields:
    name (models.TextField): The name of the distribution. Examples: "rawhide" and "stable".
    pulp_labels (HStoreField): Dictionary of string values.
    base_path (models.TextField): The base (relative) path component of the published url.
    hidden (models.BooleanField): Whether this distribution should be hidden in the content app.
    checkpoint (models.BooleanField): Whether this distribution serves checkpoint publications.

Relations:
    content_guard (models.ForeignKey): An optional content-guard.
    publication (models.ForeignKey): Publication to be served.
    remote (models.ForeignKey): A remote that the content app can use to find content not
        yet stored in Pulp.
    repository (models.ForeignKey): The latest RepositoryVersion for this Repository will be
        served.
    repository_version (models.ForeignKey): RepositoryVersion to be served.
    pulp_domain (models.ForeignKey): The domain the Distribution is a part of.

Columns from MasterModel (abstract): pulp_type.

Columns from BaseModel (abstract): pulp_id, pulp_created, pulp_last_updated.'''
}

