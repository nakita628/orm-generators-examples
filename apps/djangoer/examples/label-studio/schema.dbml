Table project {
  id integer [pk, increment]
  title varchar(50) [default: '', note: 'Project name. Must be between 3 and 50 characters long.']
  description text [default: '', note: 'Project description']
  organization_id integer
  label_config text [default: '<View></View>', note: 'Label config in XML format. See more about it in documentation']
  parsed_label_config text [default: null, note: 'Parsed label config in JSON format. See more about it in documentation']
  label_config_hash bigint [default: null]
  expert_instruction text [default: '', note: 'Labeling instructions in HTML format']
  show_instruction bool [default: false, not null, note: 'Show instructions to the annotator before they start']
  show_skip_button bool [default: true, not null, note: 'Show a skip button in interface and allow annotators to skip the task']
  enable_empty_annotation bool [default: true, not null, note: 'Allow annotators to submit empty annotations']
  reveal_preannotations_interactively bool [default: false, not null, note: 'Reveal pre-annotations interactively']
  show_annotation_history bool [default: false, not null, note: 'Show annotation history to annotator']
  show_collab_predictions bool [default: true, not null, note: 'If set, the annotator can view model predictions']
  evaluate_predictions_automatically bool [default: false, not null, note: 'Retrieve and display predictions when loading a task']
  token varchar(256) [note: 'default in Python: create_hash()']
  result_count integer [default: 0, not null, note: 'Total results inside of annotations counter']
  color varchar(16) [default: '#FFFFFF']
  created_by_id integer
  maximum_annotations integer [default: 1, not null, note: 'Maximum number of annotations for one task. If the number of annotations per task is equal or greater to this value, the task is completed (is_labeled=True)']
  min_annotations_to_start_training integer [default: 0, not null, note: 'Minimum number of completed tasks after which model training is started']
  control_weights text [note: 'Dict of weights for each control tag in metric calculation. Each control tag (e.g. label or choice) will have it\'s own key in control weight dict with weight for each label and overall weight.For example, if bounding box annotation with control tag named my_bbox should be included with 0.33 weight in agreement calculation, and the first label Car should be twice more important than Airplaine, then you have to need the specify: {\'my_bbox\': {\'type\': \'RectangleLabels\', \'labels\': {\'Car\': 1.0, \'Airplaine\': 0.5}, \'overall\': 0.33}. default in Python: dict()']
  model_version text [default: '', note: 'Machine learning model version']
  data_types text [note: 'default in Python: dict()']
  is_draft bool [default: false, not null, note: 'Whether or not the project is in the middle of being created']
  is_published bool [default: false, not null, note: 'Whether or not the project is published to annotators']
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  sampling ProjectSampling [default: 'Sequential sampling']
  skip_queue ProjectSkipQueue [default: 'REQUEUE_FOR_OTHERS']
  show_ground_truth_first bool [default: false, not null, note: 'Onboarding mode (true): show ground truth tasks first in the labeling stream']
  annotator_evaluation_enabled bool [default: 0, not null, note: 'Enable annotator evaluation for the project']
  show_overlap_first bool [default: false, not null]
  overlap_cohort_percentage integer [default: 100, not null]
  task_data_login varchar(256) [note: 'Task data credentials: login']
  task_data_password varchar(256) [note: 'Task data credentials: password']
  pinned_at datetime [default: null, note: 'Pinned date and time']
  custom_task_lock_ttl integer [default: null, note: 'Custom task lock TTL in seconds. If not set, the default value is used']
  deleted_at datetime
  deleted_by_id integer
  purge_at datetime
  search_vector text

  indexes {
    (organization_id) [name: 'project_organization_id_3c9f74fb']
    (created_by_id) [name: 'project_created_by_id_6cc13408']
    (pinned_at, created_at) [name: 'project_pinned__a39ccb_idx']
  }
}

Table projects_projectonboardingsteps {
  id integer [pk, increment]
  code ProjectOnboardingStepsCode
  title varchar(1000) [not null]
  description text [not null]
  order integer [default: 0, not null]
