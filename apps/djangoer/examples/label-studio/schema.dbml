Table fsm_taskstate {
  id char(32) [pk, note: 'UUID7 provides natural time ordering and global uniqueness. default in Python: generate_uuid7()']
  organization_id "integer unsigned" [note: 'Organization ID that owns this state record (for multi-tenant applications)']
  previous_state varchar(50) [note: 'Previous state before this transition']
  transition_name varchar(100) [note: 'Name of the transition method that triggered this state change']
  triggered_by_id integer [note: 'User who triggered this state transition']
  context_data text [not null, note: 'Additional context data for this transition (e.g., validation results, external IDs). default in Python: dict()']
  reason text [not null, note: 'Human-readable reason for this state transition']
  created_at datetime [not null, note: 'Human-readable timestamp for debugging (UUID7 id contains precise timestamp). default in Python: now()']
  task_id integer [not null]
  state ProjectStateChoices [not null]
  project_id "integer unsigned" [not null, note: 'From task.project_id - denormalized for performance']

  indexes {
    (organization_id) [name: 'fsm_taskstate_organization_id_192d4ce3']
    (triggered_by_id) [name: 'fsm_taskstate_triggered_by_id_1f1dfd8f']
    (task_id) [name: 'fsm_taskstate_task_id_94042c41']
    (state) [name: 'fsm_taskstate_state_d158253a']
    (project_id) [name: 'fsm_taskstate_project_id_4e135c45']
    (task_id, id) [name: 'task_current_state_idx', note: 'descending: id']
    (project_id, state, id) [name: 'task_project_state_idx', note: 'descending: id']
    (organization_id, state, id) [name: 'task_org_reporting_idx', note: 'descending: id']
    (task_id, id) [name: 'task_history_idx']
  }

  Note: '''Core task state tracking for Label Studio.
Provides basic task state management with:
- Simple 3-state workflow (CREATED → IN_PROGRESS → COMPLETED)
- High-performance queries with UUID7 ordering

Columns from BaseState (abstract): id, organization_id, state, previous_state, transition_name, triggered_by_id, context_data, reason, created_at.'''
}

