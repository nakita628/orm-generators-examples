Table task {
  id integer [pk, increment]
  data text [not null, note: 'User imported or uploaded data for a task. Data is formatted according to the project label config. You can find examples of data for your project on the Import page in the Label Studio Data Manager UI.']
  meta text [note: 'Meta is user imported (uploaded) data and can be useful as input for an ML Backend for embeddings, advanced vectors, and other info. It is passed to ML during training/predicting steps.. default in Python: dict()']
  project_id integer [note: 'Project ID for this task']
  created_at datetime [not null, note: 'Time a task was created. default in Python: now()']
  updated_at datetime [not null, note: 'Last time a task was updated. default in Python: now()']
  updated_by_id integer [note: 'Last annotator or reviewer who updated this task']
  is_labeled bool [default: false, not null, note: 'True if the number of annotations for this task is greater than or equal to the number of maximum_completions for the project']
  allow_skip bool [default: true, note: 'Whether this task can be skipped. Set to False to make task unskippable.']
  overlap integer [default: 1, not null, note: 'Number of distinct annotators that processed the current task']
  file_upload_id integer [note: 'Uploaded file used as data source for this task']
  inner_id bigint [default: 0, note: 'Internal task ID in the project, starts with 1']
  total_annotations integer [default: 0, not null, note: 'Number of total annotations for the current task except cancelled annotations']
  cancelled_annotations integer [default: 0, not null, note: 'Number of total cancelled annotations for the current task']
  total_predictions integer [default: 0, not null, note: 'Number of total predictions for the current task']
  precomputed_agreement real [note: 'Average agreement score for the task']
  comment_count integer [default: 0, not null, note: 'Number of comments in the task including all annotations']
  unresolved_comment_count integer [default: 0, not null, note: 'Number of unresolved comments in the task including all annotations']
  last_comment_updated_at datetime [default: null, note: 'When the last comment was updated']

  indexes {
    (project_id) [name: 'task_project_id_963d6354']
    (updated_by_id) [name: 'task_updated_by_id_c9d9ddfb']
    (overlap) [name: 'task_overlap_455a13f0']
    (file_upload_id) [name: 'task_file_upload_id_549188ed']
    (total_annotations) [name: 'task_total_annotations_e77e347b']
    (cancelled_annotations) [name: 'task_cancelled_annotations_60dfe3b9']
    (total_predictions) [name: 'task_total_predictions_f1a6b218']
    (comment_count) [name: 'task_comment_count_049355cc']
    (unresolved_comment_count) [name: 'task_unresolved_comment_count_8707d0c7']
    (last_comment_updated_at) [name: 'task_last_comment_updated_at_d1bc3403']
    (project_id, is_labeled) [name: 'task_project_6acf5f_idx']
    (project_id, inner_id) [name: 'task_project_499b59_idx']
    (id, project_id) [name: 'task_id_aef988_idx']
    (id, overlap) [name: 'task_id_7a9aca_idx']
    (overlap) [name: 'task_overlap_6a196e_idx']
    (project_id, id) [name: 'task_project_7b1c80_idx']
  }

  Note: '''Business tasks from project'''
}

Table task_completion {
  id integer [pk, increment]
  result text [default: null, note: 'The main value of annotator work - labeling result in JSON format']
  task_id integer [note: 'Corresponding task for this annotation']
  project_id integer [note: 'Project ID for this annotation']
  completed_by_id integer [note: 'User ID of the person who created this annotation']
  updated_by_id integer [note: 'Last user who updated this annotation']
  was_cancelled bool [default: false, not null, note: 'User skipped the task']
  ground_truth bool [default: false, not null, note: 'This annotation is a Ground Truth (ground_truth)']
  created_at datetime [not null, note: 'Creation time. default in Python: now()']
  updated_at datetime [not null, note: 'Last updated time. default in Python: now()']
  draft_created_at datetime [default: null, note: 'Draft creation time']
  lead_time real [default: null, note: 'How much time it took to annotate the task']
  prediction text [note: 'Prediction viewed at the time of annotation. default in Python: dict()']
  result_count integer [default: 0, not null, note: 'Results inside of annotation counter']
  parent_prediction_id integer [note: 'Points to the prediction from which this annotation was created']
  parent_annotation_id integer [note: 'Points to the parent annotation from which this annotation was created']
  unique_id char(32) [unique, note: 'default in Python: uuid4()']
  import_id bigint [default: null, note: 'Original annotation ID that was at the import step or NULL if this annotation wasn\'t imported']
  last_action ActionType [default: null, note: 'Action which was performed in the last annotation history item']
  last_created_by_id integer [default: null, note: 'User who created the last annotation history item']
  bulk_created bool [default: 0, note: 'Annotation was created in bulk mode']

  indexes {
    (task_id) [name: 'task_completion_task_id_b9049fbc']
    (project_id) [name: 'task_completion_project_id_94072c87']
    (completed_by_id) [name: 'task_completion_completed_by_id_3f3206b1']
    (updated_by_id) [name: 'task_completion_updated_by_id_1164a739']
    (parent_prediction_id) [name: 'task_completion_parent_prediction_id_053d00d9']
    (parent_annotation_id) [name: 'task_completion_parent_annotation_id_58398c37']
    (import_id) [name: 'task_completion_import_id_e434c5af']
    (last_created_by_id) [name: 'task_completion_last_created_by_id_a04457d1']
    (created_at) [name: 'task_comple_created_f55e6f_idx']
    (ground_truth) [name: 'task_comple_ground__088a1b_idx']
    (id, task_id) [name: 'task_comple_id_653858_idx']
    (last_action) [name: 'task_comple_last_ac_777e69_idx']
    (project_id, ground_truth) [name: 'task_comple_project_2cbbfc_idx']
    (project_id, id) [name: 'task_comple_project_c7e507_idx']
    (project_id, was_cancelled) [name: 'task_comple_project_5c60f3_idx']
    (task_id, completed_by_id) [name: 'task_comple_task_id_d49cd7_idx']
    (task_id, ground_truth) [name: 'task_comple_task_id_e82920_idx']
    (task_id, was_cancelled) [name: 'task_comple_task_id_8072c3_idx']
    (was_cancelled) [name: 'task_comple_was_can_f87d4e_idx']
  }

  Note: '''Annotations & Labeling results'''
}

