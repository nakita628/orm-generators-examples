  basic_auth_pass text [default: '', note: 'HTTP Basic Auth password']
  description text [default: '', note: 'Description for the machine learning backend']
  extra_params text [note: 'Any extra parameters passed to the ML Backend during the setup']
  model_version text [default: '', note: 'Current model version associated with this machine learning backend']
  timeout real [default: 100.0, not null, note: 'Response model timeout']
  project_id integer [not null]
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  auto_update bool [default: true, not null, note: 'If false, model version is set by the user, if true - getting latest version from backend.']

  indexes {
    (project_id) [name: 'ml_mlbackend_project_id_ca08142d']
  }
}

