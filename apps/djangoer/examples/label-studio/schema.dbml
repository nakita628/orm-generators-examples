Table prediction {
  id integer [pk, increment]
  result text [note: 'Prediction result. default in Python: dict()']
  score real [default: null, note: 'Prediction score']
  model_version text [default: '', note: 'A string value that for model version that produced the prediction. Used in both live models and when uploading offline predictions.']
  model_id integer [note: 'An ML Backend instance that created the prediction.']
  model_run_id integer [note: 'A run of a ModelVersion that created the prediction.']
  cluster integer [default: null, note: 'Cluster for the current prediction']
  neighbors text [note: 'Array of task IDs of the closest neighbors']
  mislabeling real [default: 0.0, not null, note: 'Related task mislabeling score']
  task_id integer [not null]
  project_id integer
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (model_id) [name: 'prediction_model_id_f9d54ad0']
    (model_run_id) [name: 'prediction_model_run_id_9d95621b']
    (task_id) [name: 'prediction_task_id_4e4fb4d3']
    (project_id) [name: 'prediction_project_id_ec1ad819']
  }

  Note: '''ML backend / Prompts predictions'''
}

Table tasks_failedprediction {
  id integer [pk, increment]
