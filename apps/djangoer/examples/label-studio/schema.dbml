  model_version text [default: null, note: 'A string value that for model version that produced the failed prediction. Used in both live models and when uploading offline predictions.']
  model_run_id integer [note: 'A run of a ModelVersion that created the failed prediction.']
  project_id integer
  task_id integer [not null]
  created_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (ml_backend_model_id) [name: 'tasks_failedprediction_ml_backend_model_id_5813a377']
    (model_run_id) [name: 'tasks_failedprediction_model_run_id_eec73944']
    (project_id) [name: 'tasks_failedprediction_project_id_6b803bbe']
    (task_id) [name: 'tasks_failedprediction_task_id_ed2f3848']
  }

  Note: '''Class for storing failed prediction(s) for a task'''
}

Table prediction_meta {
  id integer [pk, increment]
  prediction_id integer [unique, note: 'Reference to the associated prediction']
  failed_prediction_id integer [unique, note: 'Reference to the associated failed prediction']
  inference_time real [note: 'Time taken for inference in seconds']
  prompt_tokens_count integer [note: 'Number of tokens in the prompt']
  completion_tokens_count integer [note: 'Number of tokens in the completion']
  total_tokens_count integer [note: 'Total number of tokens']
  prompt_cost real [note: 'Cost of the prompt']
  completion_cost real [note: 'Cost of the completion']
  total_cost real [note: 'Total cost']
  extra text [note: 'Additional metadata in JSON format']

  checks {
    `(("prediction_id" IS NOT NULL AND "failed_prediction_id" IS NULL) OR ("prediction_id" IS NULL AND "failed_prediction_id" IS NOT NULL))` [name: 'prediction_or_failed_prediction_not_null']
  }
}

