  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date datetime [not null]

  indexes {
    (expire_date) [name: 'django_session_expire_date_a5c62663']
  }

  Note: '''Django provides full support for anonymous sessions. The session
framework lets you store and retrieve arbitrary data on a
per-site-visitor basis. It stores data on the server side and
abstracts the sending and receiving of cookies. Cookies contain a
session ID -- not the data itself.

The Django sessions framework is entirely cookie-based. It does
not fall back to putting session IDs in URLs. This is an intentional
design decision. Not only does that behavior make URLs ugly, it makes
your site vulnerable to session-ID theft via the "Referer" header.

For complete documentation on using Sessions in your code, consult
the sessions documentation that is shipped with Django (also available
on the Django web site).

Columns from AbstractBaseSession (abstract): session_key, session_data, expire_date.'''
}

Table fobi_formelement {
  id integer [pk, increment]
  plugin_uid varchar(255) [unique, not null]

  Note: '''Form element.

Form field plugin. Used when ``fobi.settings.RESTRICT_PLUGIN_ACCESS``
is set to True.

:Properties:

    - `plugin_uid` (str): Plugin UID.
    - `users` (django.contrib.auth.models.User): White list of the users
      allowed to use the form element plugin.
    - `groups` (django.contrib.auth.models.Group): White list of the user
      groups allowed to use the form element plugin.'''
}

Table fobi_formhandler {
  id integer [pk, increment]
  plugin_uid varchar(255) [unique, not null]

  Note: '''Form handler plugin. Used when ``fobi.settings.RESTRICT_PLUGIN_ACCESS``
is set to True.

:Properties:

    - `plugin_uid` (str): Plugin UID.
    - `users` (django.contrib.auth.models.User): White list of the users
      allowed to use the form handler plugin.
    - `groups` (django.contrib.auth.models.Group): White list of the
      user groups allowed to use the form handler plugin.'''
}

Table fobi_formwizardhandler {
  id integer [pk, increment]
  plugin_uid varchar(255) [unique, not null]

  Note: '''Form wizard handler plugin. Used when
``fobi.settings.RESTRICT_PLUGIN_ACCESS`` is set to True.

:Properties:

    - `plugin_uid` (str): Plugin UID.
    - `users` (django.contrib.auth.models.User): White list of the users
      allowed to use the form handler plugin.
    - `groups` (django.contrib.auth.models.Group): White list of the
      user groups allowed to use the form handler plugin.'''
}

Table fobi_formwizardentry {
  id integer [pk, increment]
  user_id integer [not null]
  name varchar(255) [not null]
  title varchar(255) [note: 'Shown in templates if available.']
  slug varchar(50) [unique, not null]
  is_public bool [default: false, not null, note: 'Makes your form wizard visible to the public.']
  is_cloneable bool [default: false, not null, note: 'Makes your form wizard cloneable by other users.']
  success_page_title varchar(255) [note: 'Custom message title to display after valid form is submitted']
  success_page_message text [note: 'Custom message text to display after valid form is submitted']
  show_all_navigation_buttons bool [default: false, not null, note: 'Show all navigation buttons.']
  wizard_type FormWizardEntryWizardType [default: 'SessionWizardView', not null, note: 'Type of the form wizard.']
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']

  indexes {
    (user_id) [name: 'fobi_formwizardentry_user_id_231dc66c']
    (user_id, slug) [unique, name: 'fobi_formwizardentry_user_id_slug_d03683d1_uniq']
    (user_id, name) [unique, name: 'fobi_formwizardentry_user_id_name_e8dd542c_uniq']
  }

  Note: '''Form wizard entry.'''
}

Table fobi_formentry {
  id integer [pk, increment]
  user_id integer [not null]
  name varchar(255) [not null]
  title varchar(255) [note: 'Shown in templates if available.']
  slug varchar(50) [unique, not null]
  is_public bool [default: false, not null, note: 'Makes your form visible to the public.']
  active_date_from datetime [note: 'Date and time when the form becomes active in the format: \'YYYY-MM-DD HH:MM\'. Leave it blank to activate immediately.']
  active_date_to datetime [note: 'Date and time when the form becomes inactive in the format: \'YYYY-MM-DD HH:MM\'. Leave it blank to keep active forever.']
  inactive_page_title varchar(255) [note: 'Custom message title to display if form is inactive.']
  inactive_page_message text [note: 'Custom message text to display if form is inactive.']
  is_cloneable bool [default: false, not null, note: 'Makes your form cloneable by other users.']
  success_page_title varchar(255) [note: 'Custom message title to display after valid form is submitted']
  success_page_message text [note: 'Custom message text to display after valid form is submitted']
  action varchar(255) [note: 'Custom form action; don\'t fill this field, unless really necessary.']
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']

  indexes {
    (user_id) [name: 'fobi_formentry_user_id_dd71895a']
    (user_id, slug) [unique, name: 'fobi_formentry_user_id_slug_de82881b_uniq']
    (user_id, name) [unique, name: 'fobi_formentry_user_id_name_1ed0a04a_uniq']
  }

  Note: '''Form entry.'''
}

