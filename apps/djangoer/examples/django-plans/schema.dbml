  payment_provider varchar(255) [default: null, note: 'Provider, that will be used for payment renewal']
  pricing_id bigint [default: null, note: 'Recurring pricing']
  amount decimal [note: 'declared max_digits=7, decimal_places=2, which the database does not enforce']
  tax decimal [note: 'declared max_digits=4, decimal_places=2, which the database does not enforce']
  currency varchar(3)
  renewal_triggered_by RecurringUserPlanRenewalTriggeredBy [default: 2, not null, note: 'The source of the associated plan\'s renewal (USER = user-initiated renewal, TASK = autorenew_account-task-initiated renewal, OTHER = renewal is triggered using another mechanism).']
  has_automatic_renewal bool [default: false, not null, note: 'Automatic renewal is enabled for associated plan. If False, the plan renewal can be still initiated by user.']
  token_verified bool [default: false, not null, note: 'The recurring token has been verified by at least one payment to be working.']
  card_expire_year integer
  card_expire_month integer
  card_masked_number varchar(255)
  last_renewal_attempt datetime

  indexes {
