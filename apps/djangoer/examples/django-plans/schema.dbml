  }

  Note: '''Columns from AbstractRecurringUserPlan (abstract): user_plan_id, token, payment_provider, pricing_id, amount, tax, currency, renewal_triggered_by, _has_automatic_renewal_backup_deprecated, token_verified, card_expire_year, card_expire_month, card_masked_number, last_renewal_attempt.

Columns from BaseMixin (abstract): created, updated_at.'''
}

