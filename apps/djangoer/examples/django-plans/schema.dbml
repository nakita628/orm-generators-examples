Table plans_order {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated_at datetime [note: 'default in Python: now()']
  user_id integer [not null]
  flat_name varchar(200)
  plan_id bigint [not null]
  pricing_id bigint
  completed datetime
  plan_extended_from date [note: 'The plan was extended from this date']
  plan_extended_until date [note: 'The plan was extended until this date']
  userplan_expire_before date [note: 'Snapshot of ``UserPlan.expire`` taken before this order extended the user\'s plan. Used to restore expire on refund.']
  userplan_active_before bool [note: 'Snapshot of ``UserPlan.active`` taken before this order extended the user\'s plan. Doubles as the marker that a snapshot was taken: it\'s None for legacy orders completed before the snapshot fields existed and either True or False for new orders.']
  userplan_plan_before_id bigint [note: 'Snapshot of ``UserPlan.plan`` taken before this order extended the user\'s plan. Used to restore the plan on refund when the order is fully unwound: without it, refunding a first purchase (free -> paid) would leave the user on the paid plan with expire=None. None for legacy orders predating this field.']
  amount decimal [not null, note: 'declared max_digits=7, decimal_places=2, which the database does not enforce']
  tax decimal [note: 'declared max_digits=4, decimal_places=2, which the database does not enforce']
  gross_amount decimal [note: 'Tax-inclusive total of the order, for orders priced tax-inclusive (e.g. a fixed amount charged by the payment provider). When set, it is the order total and the tax amount is the difference between it and the net amount; the net amount is then expected to be derived from it with net_from_gross(). Leave empty to compute the total from the net amount and the tax rate.. declared max_digits=7, decimal_places=2, which the database does not enforce']
  currency varchar(3) [default: 'EUR', not null]
  status OrderStatus [default: 1, not null]

  indexes {
    (created) [name: 'plans_order_created_643392c9']
    (user_id) [name: 'plans_order_user_id_d59f4b51']
    (plan_id) [name: 'plans_order_plan_id_a7d62a45']
    (pricing_id) [name: 'plans_order_pricing_id_0dbc53e8']
    (completed) [name: 'plans_order_completed_6c33dd84']
    (userplan_plan_before_id) [name: 'plans_order_userplan_plan_before_id_7b2d56f3']
    (amount) [name: 'plans_order_amount_b26e68f2']
    (tax) [name: 'plans_order_tax_1ee29bf0']
  }

  Note: '''Columns from AbstractOrder (abstract): user_id, flat_name, plan_id, pricing_id, completed, plan_extended_from, plan_extended_until, userplan_expire_before, userplan_active_before, userplan_plan_before_id, amount, tax, gross_amount, currency, status.

Columns from BaseMixin (abstract): created, updated_at.'''
}

