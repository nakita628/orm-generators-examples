Table django_admin_log {
  id integer [pk, increment]
  action_time datetime [not null, note: 'default in Python: now()']
  user_id integer [not null]
  content_type_id integer
  object_id text
  object_repr varchar(200) [not null]
  action_flag LogEntryActionFlag [not null]
  change_message text [not null]

  indexes {
    (user_id) [name: 'django_admin_log_user_id_c564eba6']
    (content_type_id) [name: 'django_admin_log_content_type_id_c4bce8eb']
  }
}

Table auth_permission {
  id integer [pk, increment]
  name varchar(255) [not null]
  content_type_id integer [not null]
  codename varchar(100) [not null]

  indexes {
    (content_type_id) [name: 'auth_permission_content_type_id_2f476e4b']
    (content_type_id, codename) [unique, name: 'auth_permission_content_type_id_codename_01ab375a_uniq']
  }

  Note: '''The permissions system provides a way to assign permissions to specific
users and groups of users.

The permission system is used by the Django admin site, but may also be
useful in your own code. The Django admin site uses permissions as follows:

    - The "add" permission limits the user\'s ability to view the "add" form
      and add an object.
    - The "change" permission limits a user\'s ability to view the change
      list, view the "change" form and change an object.
    - The "delete" permission limits the ability to delete an object.
    - The "view" permission limits the ability to view an object.

Permissions are set globally per type of object, not per specific object
instance. It is possible to say "Mary may change news stories," but it\'s
not currently possible to say "Mary may change news stories, but only the
ones she created herself" or "Mary may only change news stories that have a
certain status or publication date."

The permissions listed above are automatically created for each model.'''
}

Table auth_group {
  id integer [pk, increment]
  name varchar(150) [unique, not null]

  Note: '''Groups are a generic way of categorizing users to apply permissions, or
some other label, to those users. A user can belong to any number of
groups.

A user in a group automatically has all the permissions granted to that
group. For example, if the group \'Site editors\' has the permission
can_edit_home_page, any user in that group will have that permission.

Beyond permissions, groups are a convenient way to categorize users to
apply some label, or extended functionality, to them. For example, you
could create a group \'Special users\', and you could write code that would
do special things to those users -- such as giving them access to a
members-only portion of your site, or sending them members-only email
messages.'''
}

Table auth_user {
  id integer [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  is_superuser bool [default: false, not null, note: 'Designates that this user has all permissions without explicitly assigning them.']
  username varchar(150) [unique, not null, note: 'Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.']
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff bool [default: false, not null, note: 'Designates whether the user can log into this admin site.']
  is_active bool [default: true, not null, note: 'Designates whether this user should be treated as active. Unselect this instead of deleting accounts.']
  date_joined datetime [not null, note: 'default in Python: now()']

  Note: '''Users within the Django authentication system are represented by this
model.

Username and password are required. Other fields are optional.

Columns from AbstractUser (abstract): username, first_name, last_name, email, is_staff, is_active, date_joined.

Columns from AbstractBaseUser (abstract): password, last_login.

Columns from PermissionsMixin (abstract): is_superuser.'''
}

Table django_content_type {
  id integer [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]

  indexes {
    (app_label, model) [unique, name: 'django_content_type_app_label_model_76bd3d3b_uniq']
  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date datetime [not null]

  indexes {
    (expire_date) [name: 'django_session_expire_date_a5c62663']
  }

  Note: '''Django provides full support for anonymous sessions. The session
framework lets you store and retrieve arbitrary data on a
per-site-visitor basis. It stores data on the server side and
abstracts the sending and receiving of cookies. Cookies contain a
session ID -- not the data itself.

The Django sessions framework is entirely cookie-based. It does
not fall back to putting session IDs in URLs. This is an intentional
design decision. Not only does that behavior make URLs ugly, it makes
your site vulnerable to session-ID theft via the "Referer" header.

For complete documentation on using Sessions in your code, consult
the sessions documentation that is shipped with Django (also available
on the Django web site).

Columns from AbstractBaseSession (abstract): session_key, session_data, expire_date.'''
}

Table django_celery_beat_solarschedule {
  id integer [pk, increment]
  event SolarScheduleEvent [not null, note: 'The type of solar event when the job should run']
  latitude decimal [not null, note: 'Run the task when the event happens at this latitude. declared max_digits=9, decimal_places=6, which the database does not enforce']
  longitude decimal [not null, note: 'Run the task when the event happens at this longitude. declared max_digits=9, decimal_places=6, which the database does not enforce']

  indexes {
    (event, latitude, longitude) [unique, name: 'django_celery_beat_solarschedule_event_latitude_longitude_ba64999a_uniq']
  }

  Note: '''Schedule following astronomical patterns.

Example: to run every sunrise in New York City:

>>> event=\'sunrise\', latitude=40.7128, longitude=74.0060'''
}

Table django_celery_beat_intervalschedule {
  id integer [pk, increment]
  every integer [not null, note: 'Number of interval periods to wait before running the task again']
  period IntervalSchedulePeriod [not null, note: 'The type of period between task runs (Example: days)']

  Note: '''Schedule executing on a regular interval.

Example: execute every 2 days:

>>> every=2, period=DAYS'''
}

Table django_celery_beat_clockedschedule {
  id integer [pk, increment]
  clocked_time datetime [not null, note: 'Run the task at clocked time']

  Note: '''clocked schedule.'''
}

Table django_celery_beat_crontabschedule {
  id integer [pk, increment]
  minute varchar(240) [default: '*', not null, note: 'Cron Minutes to Run. Use "*" for "all". (Example: "0,30")']
  hour varchar(96) [default: '*', not null, note: 'Cron Hours to Run. Use "*" for "all". (Example: "8,20")']
  day_of_month varchar(124) [default: '*', not null, note: 'Cron Days Of The Month to Run. Use "*" for "all". (Example: "1,15")']
  month_of_year varchar(64) [default: '*', not null, note: 'Cron Months (1-12) Of The Year to Run. Use "*" for "all". (Example: "1,12")']
  day_of_week varchar(64) [default: '*', not null, note: 'Cron Days Of The Week to Run. Use "*" for "all", Sunday is 0 or 7, Monday is 1. (Example: "0,5")']
  timezone CrontabScheduleTimezone [not null, note: 'Timezone to Run the Cron Schedule on. Default is UTC.. default in Python: crontab_schedule_celery_timezone()']

  Note: '''Timezone Aware Crontab-like schedule.

Example:  Run every hour at 0 minutes for days of month 10-15:

>>> minute="0", hour="*", day_of_week="*",
... day_of_month="10-15", month_of_year="*"'''
}

Table django_celery_beat_periodictasks {
  ident smallint [pk, default: 1]
  last_update datetime [not null]

  Note: '''Helper table for tracking updates to periodic tasks.

This stores a single row with ``ident=1``. ``last_update`` is updated via
signals whenever anything changes in the :class:`~.PeriodicTask` model.
Basically this acts like a DB data audit trigger.
Doing this so we also track deletions, and not just insert/update.'''
}

Table django_celery_beat_periodictask {
  id integer [pk, increment]
  name varchar(200) [unique, not null, note: 'Short Description For This Task']
  task varchar(200) [not null, note: 'The Name of the Celery Task that Should be Run.  (Example: "proj.tasks.import_contacts")']
  interval_id integer [note: 'Interval Schedule to run the task on.  Set only one schedule type, leave the others null.']
  crontab_id integer [note: 'Crontab Schedule to run the task on.  Set only one schedule type, leave the others null.']
  solar_id integer [note: 'Solar Schedule to run the task on.  Set only one schedule type, leave the others null.']
  clocked_id integer [note: 'Clocked Schedule to run the task on.  Set only one schedule type, leave the others null.']
  args text [default: '[]', not null, note: 'JSON encoded positional arguments (Example: ["arg1", "arg2"])']
  kwargs text [default: '{}', not null, note: 'JSON encoded keyword arguments (Example: {"argument": "value"})']
  queue varchar(200) [default: null, note: 'Queue defined in CELERY_TASK_QUEUES. Leave None for default queuing.']
  exchange varchar(200) [default: null, note: 'Override Exchange for low-level AMQP routing']
  routing_key varchar(200) [default: null, note: 'Override Routing Key for low-level AMQP routing']
  headers text [default: '{}', not null, note: 'JSON encoded message headers for the AMQP message.']
  priority "integer unsigned" [default: null, note: 'Priority Number between 0 and 255. Supported by: RabbitMQ, Redis (priority reversed, 0 is highest).']
  expires datetime [note: 'Datetime after which the schedule will no longer trigger the task to run']
  expire_seconds "integer unsigned" [note: 'Timedelta with seconds which the schedule will no longer trigger the task to run']
  one_off bool [default: false, not null, note: 'If True, the schedule will only run the task a single time']
  start_time datetime [note: 'Datetime when the schedule should begin triggering the task to run']
  enabled bool [default: true, not null, note: 'Set to False to disable the schedule']
  last_run_at datetime [note: 'Datetime that the schedule last triggered the task to run. Reset to None if enabled is set to False.']
  total_run_count "integer unsigned" [default: 0, not null, note: 'Running count of how many times the schedule has triggered the task']
  date_changed datetime [not null, note: 'Datetime that this PeriodicTask was last modified. default in Python: now()']
  description text [not null, note: 'Detailed description about the details of this Periodic Task']

  indexes {
    (interval_id) [name: 'django_celery_beat_periodictask_interval_id_a8ca27da']
    (crontab_id) [name: 'django_celery_beat_periodictask_crontab_id_d3cba168']
    (solar_id) [name: 'django_celery_beat_periodictask_solar_id_a87ce72c']
    (clocked_id) [name: 'django_celery_beat_periodictask_clocked_id_47a69f82']
  }

  Note: '''Model representing a periodic task.'''
}

Table django_celery_results_taskresult {
  id integer [pk, increment]
  task_id varchar(255) [unique, not null, note: 'Celery ID for the Task that was run']
  periodic_task_name varchar(255) [note: 'Name of the Periodic Task which was run']
  task_name varchar(255) [note: 'Name of the Task which was run']
  task_args text [note: 'JSON representation of the positional arguments used with the task']
  task_kwargs text [note: 'JSON representation of the named arguments used with the task']
  status varchar(50) [default: 'PENDING', not null, note: 'Current state of the task being run']
  worker varchar(100) [default: null, note: 'Worker that executes the task']
  content_type varchar(128) [not null, note: 'Content type of the result data']
  content_encoding varchar(64) [not null, note: 'The encoding used to save the task result data']
  result text [default: null, note: 'The data returned by the task.  Use content_encoding and content_type fields to read.']
  date_created datetime [not null, note: 'Datetime field when the task result was created in UTC. default in Python: now()']
  date_started datetime [default: null, note: 'Datetime field when the task was started in UTC']
  date_done datetime [not null, note: 'Datetime field when the task was completed in UTC. default in Python: now()']
  traceback text [note: 'Text of the traceback if the task generated one']
  meta text [default: null, note: 'JSON meta information about the task, such as information on child tasks']

  indexes {
    (task_name) [name: 'django_cele_task_na_08aec9_idx']
    (status) [name: 'django_cele_status_9b6201_idx']
    (worker) [name: 'django_cele_worker_d54dd8_idx']
    (date_created) [name: 'django_cele_date_cr_f04a50_idx']
    (date_done) [name: 'django_cele_date_do_f59aad_idx']
    (periodic_task_name) [name: 'django_cele_periodi_1993cf_idx']
  }

  Note: '''Task result/status.'''
}

Table django_celery_results_chordcounter {
  id integer [pk, increment]
  group_id varchar(255) [unique, not null, note: 'Celery ID for the Chord header group']
  sub_tasks text [not null, note: 'JSON serialized list of task result tuples. use .group_result() to decode']
  count "integer unsigned" [not null, note: 'Starts at len(chord header) and decrements after each task is finished']

  Note: '''Chord synchronisation.'''
}

Table django_celery_results_groupresult {
  id integer [pk, increment]
  group_id varchar(255) [unique, not null, note: 'Celery ID for the Group that was run']
  date_created datetime [not null, note: 'Datetime field when the group result was created in UTC. default in Python: now()']
  date_done datetime [not null, note: 'Datetime field when the group was completed in UTC. default in Python: now()']
  content_type varchar(128) [not null, note: 'Content type of the result data']
  content_encoding varchar(64) [not null, note: 'The encoding used to save the task result data']
  result text [default: null, note: 'The data returned by the task.  Use content_encoding and content_type fields to read.']

  indexes {
    (date_created) [name: 'django_cele_date_cr_bd6c1d_idx']
    (date_done) [name: 'django_cele_date_do_caae0e_idx']
  }

  Note: '''Task Group result/status.'''
}

