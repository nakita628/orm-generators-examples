Table cms_page {
  id integer [pk, increment]
  created_by varchar(255) [not null]
  changed_by varchar(255) [not null]
  creation_date datetime [not null, note: 'default in Python: now()']
  changed_date datetime [not null, note: 'default in Python: now()']
  publication_date datetime [note: 'When the page should go live. Status must be "Published" for page to go live.']
  publication_end_date datetime [note: 'When to expire the page. Leave empty to never expire.']
  in_navigation bool [default: true, not null]
  soft_root bool [default: false, not null, note: 'All ancestors will not be displayed in the navigation']
  reverse_id varchar(40) [note: 'A unique identifier that is used with the page_url templatetag for linking to this page']
  navigation_extenders varchar(80)
  template PageTemplate [default: 'INHERIT', not null, note: 'The template used to render the content.']
  login_required bool [default: false, not null]
  limit_visibility_in_menu PageLimitVisibilityInMenu [default: null, note: 'limit when this page is visible in the menu']
  is_home bool [default: false, not null]
  application_urls varchar(200)
  application_namespace varchar(200)
  publisher_is_draft bool [default: true, not null]
  publisher_public_id integer [unique]
  languages varchar(255)
  xframe_options PageXframeOptions [default: 0, not null]
  is_page_type bool [default: false, not null]
  node_id integer [not null]

  indexes {
    (publication_date) [name: 'cms_page_publication_date_684fabf7']
    (publication_end_date) [name: 'cms_page_publication_end_date_12a0c46a']
    (in_navigation) [name: 'cms_page_in_navigation_01c24279']
    (soft_root) [name: 'cms_page_soft_root_51efccbe']
    (reverse_id) [name: 'cms_page_reverse_id_ffc9ede2']
    (navigation_extenders) [name: 'cms_page_navigation_extenders_c24af8dd']
    (limit_visibility_in_menu) [name: 'cms_page_limit_visibility_in_menu_30db6aa6']
    (is_home) [name: 'cms_page_is_home_edadca07']
    (application_urls) [name: 'cms_page_application_urls_9ef47497']
    (publisher_is_draft) [name: 'cms_page_publisher_is_draft_141cba60']
    (node_id) [name: 'cms_page_node_id_c87b85a9']
    (node_id, publisher_is_draft) [unique, name: 'cms_page_node_id_publisher_is_draft_c1293d6a_uniq']
  }

  Note: '''A simple hierarchical page model

Proxy models: PageType.'''
}

