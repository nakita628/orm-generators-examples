Table filer_folder {
  id integer [pk, increment]
  parent_id integer
  name varchar(255) [not null]
  owner_id integer
  uploaded_at datetime [not null, note: 'default in Python: now()']
  created_at datetime [not null, note: 'default in Python: now()']
  modified_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (parent_id) [name: 'filer_folder_parent_id_308aecda']
    (owner_id) [name: 'filer_folder_owner_id_be530fb4']
    (parent_id, name) [unique, name: 'filer_folder_parent_id_name_bc773258_uniq']
  }

  Note: '''Represents a Folder that things (files) can be put into. Folders are *NOT*
mirrored in the Filesystem and can have any unicode chars as their name.
Other models may attach to a folder with a ForeignKey. If the related name
ends with "_files" they will automatically be listed in the
folder.files list along with all the other models that link to the folder
in this way. Make sure the linked models obey the AbstractFile interface
(Duck Type).'''
}

Table filer_folderpermission {
  id integer [pk, increment]
  folder_id integer
  type FolderPermissionType [default: 0, not null]
  user_id integer
  group_id integer
  everybody bool [default: false, not null]
  can_read FolderPermissionCanRead [default: null]
  can_edit FolderPermissionCanEdit [default: null]
  can_add_children FolderPermissionCanAddChildren [default: null]

  indexes {
    (folder_id) [name: 'filer_folderpermission_folder_id_5d02f1da']
    (user_id) [name: 'filer_folderpermission_user_id_7673d4b6']
    (group_id) [name: 'filer_folderpermission_group_id_8901bafa']
  }
}

Table filer_file {
  id integer [pk, increment]
  polymorphic_ctype_id integer
  folder_id integer
  file varchar(255)
  _file_size bigint
  sha1 varchar(40) [default: '', not null]
  has_all_mandatory_data bool [default: false, not null]
  original_filename varchar(255)
  name varchar(255) [default: '', not null]
  description text
  owner_id integer
  uploaded_at datetime [not null, note: 'default in Python: now()']
  modified_at datetime [not null, note: 'default in Python: now()']
  is_public bool [not null, note: 'Disable any permission checking for this file. File will be publicly accessible to anyone.. default in Python: is_public_default()']
  mime_type varchar(255) [default: 'application/octet-stream', not null, note: 'MIME type of uploaded content']

  indexes {
    (polymorphic_ctype_id) [name: 'filer_file_polymorphic_ctype_id_f44903c1']
    (folder_id) [name: 'filer_file_folder_id_af803bbb']
    (owner_id) [name: 'filer_file_owner_id_b9e32671']
  }

  Note: '''Columns from PolymorphicModel (abstract): polymorphic_ctype_id.'''
}

