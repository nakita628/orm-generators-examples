  twitter_meta bool [default: true, not null, note: 'Shows content as a card when linking to this site on Twitter. See https://developer.twitter.com/en/docs/twitter-for-websites/cards']
  twitter_site varchar(16) [not null, note: 'The @username of the website owner’s Twitter handle.']
  struct_meta bool [default: true, not null, note: 'Optimizes information about your organization for search engines. See https://schema.org/']
  og_image_default_id integer [note: 'Shown when linking to this page on social media. This can also be customized on each page.']

  indexes {
