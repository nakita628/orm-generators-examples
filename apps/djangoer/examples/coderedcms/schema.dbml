Table coderedcms_coderedpage {
  page_ptr_id integer [pk, note: 'parent link: a CoderedPage is a Page (multi-table inheritance)']
  canonical_url varchar(255) [not null, note: 'Leave blank to use the page\'s URL.']
  og_image_id integer [note: 'Shown when linking to this page on social media. If blank, may show an image from the page, or the default from Settings > SEO.']
  cover_image_id integer
  index_show_subpages bool [default: false, not null]
  index_order_by_classifier_id integer [note: 'Child pages will first be sorted following the order of this classifier’s terms (from Snippets > Classifiers).']
  index_order_by CoderedPageIndexOrderBy [default: '', not null, note: 'Child pages will then be sorted by this attribute.']
  index_num_per_page "integer unsigned" [default: 10, not null]
  related_show bool [default: false, not null]
  related_num "integer unsigned" [default: 3, not null]
  related_classifier_term_id integer [note: 'When getting related pages, pages with this term will be weighted over other classifier terms. By default, pages with the greatest number of classifiers in common are ranked highest.']
  custom_template varchar(255) [not null]
  content_walls text [not null]

  indexes {
    (og_image_id) [name: 'coderedcms_coderedpage_og_image_id_ded00310']
    (cover_image_id) [name: 'coderedcms_coderedpage_cover_image_id_07449f7d']
    (index_order_by_classifier_id) [name: 'coderedcms_coderedpage_index_order_by_classifier_id_2965a4ee']
    (related_classifier_term_id) [name: 'coderedcms_coderedpage_related_classifier_term_id_f8260ac9']
  }

  Note: '''General use page with caching, templating, and SEO functionality.
All pages should inherit from this.

Columns from SeoMixin (abstract): page_ptr_id.

Columns from SeoMetaFields (abstract): canonical_url, og_image_id.'''
}

