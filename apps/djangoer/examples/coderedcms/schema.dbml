Table coderedcms_layoutsettings {
  id integer [pk, increment]
  site_id integer [unique, not null]
  logo_id integer [note: 'Brand logo used in the navbar and throughout the site']
  favicon_id integer
  navbar_color_scheme varchar(50) [default: '', not null, note: 'Optimizes text and other navbar elements for use with light or dark backgrounds.']
  navbar_class varchar(255) [default: '', not null, note: 'Custom classes applied to navbar e.g. "bg-light", "bg-dark", "bg-primary".']
  navbar_fixed bool [default: false, not null, note: 'Fixed navbar will remain at the top of the page when scrolling.']
  navbar_content_fluid bool [default: false, not null, note: 'Content within the navbar will fill edge to edge.']
  navbar_collapse_mode varchar(50) [default: '', not null, note: 'Control on what screen sizes to show and collapse the navbar menu links.']
  navbar_format varchar(50) [default: '', not null]
  navbar_search bool [default: true, not null, note: 'Show search box in navbar']
  from_email_address varchar(255) [not null, note: 'The default email address this site appears to send from. For example: "sender@example.com" or "Sender Name <sender@example.com>" (without quotes)']
  search_num_results "integer unsigned" [default: 10, not null]
  external_new_tab bool [default: false, not null]
  spam_service LayoutSettingsSpamService [default: 'honeypot', not null, note: 'Choose a technique or 3rd party service to help block spam submissions.']
  recaptcha_threshold decimal [default: 0.5, not null, note: 'reCAPTCHA v3 returns a score (0.0 is very likely a bot, 1.0 is very likely a good interaction). Reject submissions below this score (recommended 0.5).. declared max_digits=2, decimal_places=1, which the database does not enforce']
  recaptcha_public_key varchar(255) [not null, note: 'Create this key in the Google reCAPTCHA or Google Cloud dashboard.']
  recaptcha_secret_key varchar(255) [not null, note: 'Create this key in the Google reCAPTCHA or Google Cloud dashboard.']
  google_maps_api_key varchar(255) [not null, note: 'The API Key used for Google Maps.']
  mailchimp_api_key varchar(255) [not null, note: 'The API Key used for Mailchimp.']

  indexes {
    (logo_id) [name: 'coderedcms_layoutsettings_logo_id_ef53b3c9']
    (favicon_id) [name: 'coderedcms_layoutsettings_favicon_id_bdb026a2']
  }

  Note: '''Branding, navbar, and theme settings.

Columns from BaseSiteSetting (abstract): site_id.'''
}

