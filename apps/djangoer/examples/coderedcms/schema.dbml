Table wagtailseo_seosettings {
  id integer [pk, increment]
  site_id integer [unique, not null]
  struct_org_type SeoSettingsStructOrgType [default: '', not null, note: 'Organization business type.']
  struct_org_name varchar(255) [default: '', not null, note: 'Leave blank to use the site name in Settings > Sites']
  struct_org_logo_id integer [note: 'Logo representative of the organisation. Must be 112x112px minimum; take note that it will be displayed on a white background']
  struct_org_image_id integer [note: 'A photo of the facility. This photo will be cropped to 1:1, 4:3, and 16:9 aspect ratios automatically.']
  struct_org_phone varchar(255) [not null, note: 'Include country code for best results. For example: +1-216-555-8000']
  struct_org_address_street varchar(255) [not null, note: 'House number and street. For example, 55 Public Square Suite 1710']
  struct_org_address_locality varchar(255) [not null, note: 'City or locality. For example, Cleveland']
  struct_org_address_region varchar(255) [not null, note: 'State, province, county, or region. For example, OH']
  struct_org_address_postal varchar(255) [not null, note: 'Zip or postal code. For example, 44113']
  struct_org_address_country varchar(255) [not null, note: 'For example, USA. Two-letter ISO 3166-1 alpha-2 country code is also acceptable https://en.wikipedia.org/wiki/ISO_3166-1']
