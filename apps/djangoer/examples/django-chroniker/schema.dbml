Enum LogEntryActionFlag {
  "1"
  "2"
  "3"
}

Enum JobFrequency {
  "YEARLY"
  "MONTHLY"
  "WEEKLY"
  "DAILY"
  "HOURLY"
  "MINUTELY"
  "SECONDLY"
}

Table django_admin_log {
  id integer [pk, increment]
  action_time datetime [not null, note: 'default in Python: now()']
  user_id integer [not null]
  content_type_id integer
  object_id text
  object_repr varchar(200) [not null]
  action_flag LogEntryActionFlag [not null]
  change_message text [not null]

  indexes {
    (user_id) [name: 'django_admin_log_user_id_c564eba6']
    (content_type_id) [name: 'django_admin_log_content_type_id_c4bce8eb']
  }
}

Table auth_permission {
  id integer [pk, increment]
  name varchar(255) [not null]
  content_type_id integer [not null]
  codename varchar(100) [not null]

  indexes {
    (content_type_id) [name: 'auth_permission_content_type_id_2f476e4b']
    (content_type_id, codename) [unique, name: 'auth_permission_content_type_id_codename_01ab375a_uniq']
  }

  Note: '''The permissions system provides a way to assign permissions to specific
users and groups of users.

The permission system is used by the Django admin site, but may also be
useful in your own code. The Django admin site uses permissions as follows:

    - The "add" permission limits the user\'s ability to view the "add" form
      and add an object.
    - The "change" permission limits a user\'s ability to view the change
      list, view the "change" form and change an object.
    - The "delete" permission limits the ability to delete an object.
    - The "view" permission limits the ability to view an object.

Permissions are set globally per type of object, not per specific object
instance. It is possible to say "Mary may change news stories," but it\'s
not currently possible to say "Mary may change news stories, but only the
ones she created herself" or "Mary may only change news stories that have a
certain status or publication date."

The permissions listed above are automatically created for each model.'''
}

Table auth_group {
  id integer [pk, increment]
  name varchar(150) [unique, not null]

  Note: '''Groups are a generic way of categorizing users to apply permissions, or
some other label, to those users. A user can belong to any number of
groups.

A user in a group automatically has all the permissions granted to that
group. For example, if the group \'Site editors\' has the permission
can_edit_home_page, any user in that group will have that permission.

Beyond permissions, groups are a convenient way to categorize users to
apply some label, or extended functionality, to them. For example, you
could create a group \'Special users\', and you could write code that would
do special things to those users -- such as giving them access to a
members-only portion of your site, or sending them members-only email
messages.'''
}

Table auth_user {
  id integer [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  is_superuser bool [default: false, not null, note: 'Designates that this user has all permissions without explicitly assigning them.']
  username varchar(150) [unique, not null, note: 'Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.']
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff bool [default: false, not null, note: 'Designates whether the user can log into this admin site.']
  is_active bool [default: true, not null, note: 'Designates whether this user should be treated as active. Unselect this instead of deleting accounts.']
  date_joined datetime [not null, note: 'default in Python: now()']

  Note: '''Users within the Django authentication system are represented by this
model.

Username and password are required. Other fields are optional.

Columns from AbstractUser (abstract): username, first_name, last_name, email, is_staff, is_active, date_joined.

Columns from AbstractBaseUser (abstract): password, last_login.

Columns from PermissionsMixin (abstract): is_superuser.'''
}

Table django_content_type {
  id integer [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]

  indexes {
    (app_label, model) [unique, name: 'django_content_type_app_label_model_76bd3d3b_uniq']
  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date datetime [not null]

  indexes {
    (expire_date) [name: 'django_session_expire_date_a5c62663']
  }

  Note: '''Django provides full support for anonymous sessions. The session
framework lets you store and retrieve arbitrary data on a
per-site-visitor basis. It stores data on the server side and
abstracts the sending and receiving of cookies. Cookies contain a
session ID -- not the data itself.

The Django sessions framework is entirely cookie-based. It does
not fall back to putting session IDs in URLs. This is an intentional
design decision. Not only does that behavior make URLs ugly, it makes
your site vulnerable to session-ID theft via the "Referer" header.

For complete documentation on using Sessions in your code, consult
the sessions documentation that is shipped with Django (also available
on the Django web site).

Columns from AbstractBaseSession (abstract): session_key, session_data, expire_date.'''
}

Table django_site {
  id integer [pk, increment]
  domain varchar(100) [unique, not null]
  name varchar(50) [not null]
}

Table chroniker_jobdependency {
  id integer [pk, increment]
  dependent_id integer [not null, note: 'The thing that cannot run until another job completes.']
  dependee_id integer [not null, note: 'The thing that has other jobs waiting on it to complete.']
  wait_for_completion bool [default: true, not null, note: 'If checked, the dependent job will not run until the dependee job has completed.']
  wait_for_success bool [default: true, not null, note: 'If checked, the dependent job will not run until the dependee job has completed successfully.']
  wait_for_next_run bool [default: true, not null, note: 'If checked, the dependent job will not run until the dependee job has a next_run greater than its next_run.']

  indexes {
    (dependent_id) [name: 'chroniker_jobdependency_dependent_id_48fb0cbb']
    (dependee_id) [name: 'chroniker_jobdependency_dependee_id_5107f29f']
    (dependent_id, dependee_id) [unique, name: 'chroniker_jobdependency_dependent_id_dependee_id_a59a3257_uniq']
  }

  Note: '''Represents a scheduling dependency between two jobs.'''
}

Table chroniker_job {
  id integer [pk, increment]
  name varchar(200) [not null]
  frequency JobFrequency [not null]
  params text [note: 'Semicolon-separated list of <a href="http://labix.org/python-dateutil" target="_blank">rrule parameters</a>. e.g: interval:15;byhour:7,8,9']
  command varchar(200) [not null, note: 'A valid django-admin command to run.']
  args varchar(200) [not null, note: 'Space separated list; e.g: arg1 option1=True']
  raw_command varchar(1000) [note: '''The raw shell command to run.
            This is mutually exclusive with `command`.''']
  enabled bool [default: true, not null, note: '''If checked, this job will be run automatically according
            to the frequency options.''']
  next_run datetime [note: 'If you don\'t set this it will be determined automatically']
  jitter_seconds "integer unsigned" [default: 0, not null, note: 'If given, a random offset of up to this many seconds is added to each scheduled run time.<br/>Useful for spreading load when several jobs or servers would otherwise fire at the same instant.<br/>A value of 0 disables jitter.']
  last_run_start_timestamp datetime
  last_run datetime
  last_heartbeat datetime
  is_running bool [default: false, not null]
  last_run_successful bool
  email_errors_to_subscribers bool [default: true, not null, note: 'If checked, the stdout and stderr of a job will be emailed to the subscribers if an error occur.']
  email_success_to_subscribers bool [default: false, not null, note: 'If checked, the stdout of a job will be emailed to the subscribers if not errors occur.']
  lock_file varchar(255) [not null]
  force_run bool [default: false, not null, note: 'If checked, then this job will be run immediately.']
  force_stop bool [default: false, not null, note: 'If checked, and running then this job will be stopped.']
  timeout_seconds "integer unsigned" [default: 0, not null, note: '''When non-zero, the job will be forcibly killed if
            running for more than this amount of time.''']
  hostname varchar(700) [note: '<function hostname_help_text_setter at 0xffffa5dba980>']
  current_hostname varchar(700) [note: 'The name of the host currently running the job.']
  current_pid varchar(50) [note: 'The ID of the process currently running the job.']
  total_parts_complete "integer unsigned" [default: 0, not null, note: 'The total number of complete parts.']
  total_parts "integer unsigned" [default: 0, not null, note: 'The total number of parts of the task.']
  is_monitor bool [default: false, not null, note: 'If checked, will appear in the monitors section.']
  monitor_url varchar(255) [note: 'URL provided to further explain the monitor.']
  monitor_error_template text [default: '\\nThe monitor "{{ job.name }}" has indicated a problem.\\n\\nPlease review this monitor at {{ url }}\\n\\n{{ job.monitor_description_safe }}\\n\\n{{ stderr }}\\n', note: 'If this is a monitor, this is the template used to compose the error text email.<br/>Available variables: {{ job }} {{ stderr }} {{ url }}']
  monitor_description text [note: 'An explanation of the monitor\'s purpose.']
  monitor_records integer [note: 'The number of records that need attention.']
  maximum_log_entries "integer unsigned" [default: 1000, not null, note: 'The maximum number of most recent log entries to keep.<br/>A value of 0 keeps all log entries.']
  log_stdout bool [default: true, not null, note: '''If checked, all characters printed to stdout will be
            saved in a log record.''']
  log_stderr bool [default: true, not null, note: '''If checked, all characters printed to stderr will be
            saved in a log record.''']

  indexes {
    (current_pid) [name: 'chroniker_job_current_pid_9996fbd0']
  }

  Note: '''A recurring ``django-admin`` command to be run.

Proxy models: Monitor.'''
}

Table chroniker_log {
  id integer [pk, increment]
  job_id integer [not null]
  run_start_datetime datetime [not null, note: 'default in Python: now()']
  run_end_datetime datetime
  duration_seconds "integer unsigned"
  stdout text [not null]
  stderr text [not null]
  hostname varchar(700) [note: 'The hostname this job was executed on.']
  success bool [default: true, not null]
  on_time bool [default: true, not null, note: '''If true, indicates job completed of its own accord.
            If false, the job exceeded a timeout threshold and was forcibly
            killed.''']

  indexes {
    (job_id) [name: 'chroniker_log_job_id_b73a0dc9']
    (run_start_datetime) [name: 'chroniker_log_run_start_datetime_ed601856']
    (run_end_datetime) [name: 'chroniker_log_run_end_datetime_ee9ac252']
    (duration_seconds) [name: 'chroniker_log_duration_seconds_34305844']
    (success) [name: 'chroniker_log_success_9d4f1251']
    (on_time) [name: 'chroniker_log_on_time_75c95897']
  }

  Note: '''A record of stdout and stderr of a ``Job``.'''
}

