  score decimal [note: 'declared max_digits=10, decimal_places=2, which the database does not enforce']

  indexes {
    (submission_id) [name: 'submission_review_submission_id_b6f4a64a']
    (user_id) [name: 'submission_review_user_id_5ba496fe']
    (user_id, submission_id) [unique, name: 'submission_review_user_id_submission_id_a2df67c7_uniq']
  }

  Note: '''Reviews model the opinion of reviewers of a.

:class:`~pretalx.submission.models.submission.Submission`.

They can, but don\'t have to, include a score and a text.

:param text: The review itself. May be empty.
:param score: This score is calculated from all the related ``scores``
    and their weights. Do not set it directly; call
    ``pretalx.submission.domain.review.update_review_score`` after
    modifying the m2m scores.

Columns from TimestampedModel (abstract): created, updated.'''
}

Table submission_reviewphase {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  event_id integer [not null]
  name varchar(100) [not null]
  start datetime
  end datetime
  is_active bool [default: false, not null]
  can_review bool [default: true, not null]
  proposal_visibility ReviewPhaseProposalVisibility [default: 'all', not null, note: 'If you select “all”, reviewers can review all proposals that their teams have access to (so either all, or specific tracks). In this mode, assigned proposals will be highlighted and will be shown first in the review workflow.']
  can_see_other_reviews ReviewPhaseCanSeeOtherReviews [default: 'after_review', not null]
  can_see_speaker_names bool [default: true, not null]
  can_see_reviewer_names bool [default: true, not null]
  can_change_submission_state bool [default: false, not null]
  can_tag_submissions ReviewPhaseCanTagSubmissions [default: 'never', not null]
  speakers_can_change_submissions bool [default: false, not null, note: 'By default, modification of proposals is locked after the CfP ends, and is re-enabled once the proposal was accepted.']

  indexes {
    (event_id) [name: 'submission_reviewphase_event_id_7cbfc828']
  }

  Note: '''ReviewPhases determine reviewer access rights during a (potentially
open) time frame.

Phases are ordered by ``(start, end)``, with null-start phases first.

:param is_active: Is this phase currently active? There can be only one
    active phase per event. Use
    ``pretalx.submission.domain.review.activate_review_phase`` to
    activate a phase, since it enforces that invariant.

Columns from TimestampedModel (abstract): created, updated.'''
}

