Table event_event {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  name text [not null]
  slug varchar(50) [unique, not null, note: 'The slug may only contain letters, numbers, dots and dashes.']
  organiser_id integer
  is_public bool [default: false, not null]
  date_from date [not null]
  date_to date [not null]
  timezone EventTimezone [default: 'UTC', not null, note: 'All event dates will be localised and interpreted to be in this timezone.']
  email varchar(254) [not null, note: 'Will be used as Reply-To in emails.']
  custom_domain varchar(200) [note: 'Enter a custom domain, such as https://my.event.example.org']
  feature_flags text [not null, note: 'default in Python: default_feature_flags()']
  display_settings text [not null, note: 'default in Python: default_display_settings()']
  review_settings text [not null, note: 'default in Python: default_review_settings()']
  mail_settings text [not null, note: 'default in Python: default_mail_settings()']
  attendee_signup_settings text [not null, note: 'default in Python: default_attendee_signup_settings()']
  primary_color varchar(7) [note: 'Provide a hex value like #00ff00 if you want to style pretalx in your event’s colour scheme.']
  custom_css varchar(100) [note: 'Upload a custom CSS file if changing the primary colour is not sufficient for you.']
  logo varchar(100) [note: 'If you provide a logo image, your event’s name will not be shown in the event header. The logo will be scaled down to a height of 140px.']
  header_image varchar(100) [note: 'If you provide a header image, it will be displayed instead of your event’s color and/or header pattern at the top of all event pages. It will be center-aligned, so when the window shrinks, the center parts will continue to be displayed, and not stretched.']
  og_image varchar(100) [note: 'This image will be shown as a preview when links to your event are shared on social media or messaging apps. For best results, use an image at least 1200x630 pixels. If not set, the logo or header image will be used instead.']
  locales text [not null, note: 'default in Python: default_locales()']
  content_locales text [not null, note: 'default in Python: default_locales()']
  locale EventLocale [default: 'en', not null]
  landing_page_text text [note: 'This text will be shown on the landing page, alongside with links to the CfP and schedule, if appropriate. You can use <a href="https://docs.pretalx.org/user/markdown/" target="_blank" rel="noopener">Markdown</a> here.']
  featured_sessions_text text [note: 'This text will be shown at the top of the featured sessions page instead of the default text. You can use <a href="https://docs.pretalx.org/user/markdown/" target="_blank" rel="noopener">Markdown</a> here.']
  plugins text

  indexes {
    (organiser_id) [name: 'event_event_organiser_id_5182de02']
    (`LOWER("slug")`) [unique, name: 'event_slug_lower_unique']
  }

  Note: '''The Event class has direct or indirect relations to all other models.

Since most models depend on the Event model in some way, they should
preferably be accessed via the reverse relation on the event model to
prevent data leaks.

:param is_public: Is this event public yet? Should only be set via the
    ``pretalx.orga.views.EventLive`` view or in another way that processes
    the ``pretalx.orga.signals.activate_event`` signal.
:param locales: Contains the event’s active locales as a list of
    language codes.
:param content_locales: Contains the event’s active locales available
    for proposals as a list of language codes.
:param primary_color: Main event colour. Accepts hex values like
    ``#00ff00``.
:param custom_css: Custom event CSS. Has to pass fairly restrictive
    validation for security considerations.
:param custom_domain: Custom event domain, starting with ``https://``.
:param plugins: A list of active plugins as a comma-separated string.
    Please use the ``plugin_list`` property for interaction.
:param feature_flags: A JSON field containing feature flags for this event.
    Please use the ``get_feature_flag`` method to check for features,
    so that new feature flags can be added without breaking existing events.

Columns from TimestampedModel (abstract): created, updated.'''
}

