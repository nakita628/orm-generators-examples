Table event_organiser {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  name text [not null]
  slug varchar(50) [unique, not null, note: 'Should be short, only contain lowercase letters and numbers, and must be unique, as it is used in URLs.']

  Note: '''The Organiser model represents the entity responsible for at least one.

:class:`~pretalx.event.models.event.Event`.

Columns from TimestampedModel (abstract): created, updated.'''
}

Table event_team {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  organiser_id integer [not null]
  name varchar(190) [not null]
  all_events bool [default: false, not null]
  can_create_events bool [default: false, not null]
  can_change_teams bool [default: false, not null]
  can_change_organiser_settings bool [default: false, not null]
  can_change_event_settings bool [default: false, not null]
  can_change_submissions bool [default: false, not null]
  is_reviewer bool [default: false, not null]
  force_hide_speaker_names bool [default: false, not null, note: 'Normally, anonymisation is configured in the event review settings. This setting will <strong>override the event settings</strong> and always hide speaker names for this team.']

  indexes {
    (organiser_id) [name: 'event_team_organiser_id_feade463']
  }

  Note: '''A team is a group of people working for the same organiser.

Team members (of type :class:`~pretalx.person.models.user.User`) share
permissions for one or several events of
:class:`~pretalx.event.models.organiser.Organiser`.  People can be in
multiple Teams, and will have all permissions *any* of their teams has.

Columns from TimestampedModel (abstract): created, updated.'''
}

Table event_teaminvite {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  team_id integer [not null]
  email varchar(254)
  token varchar(64) [unique, note: 'default in Python: generate_invite_token()']

  indexes {
