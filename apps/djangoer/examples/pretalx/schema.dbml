Table submission_submissioninvitation {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  submission_id integer [not null]
  email varchar(254) [not null]
  token varchar(64) [unique, not null, note: 'default in Python: generate_invite_code()']

  indexes {
    (submission_id) [name: 'submission_submissioninvitation_submission_id_62474769']
    (submission_id, email) [unique, name: 'submission_submissioninvitation_submission_id_email_985c90da_uniq']
  }

  Note: '''Track pending speaker invitations for submissions.

When a speaker is invited to a submission, a SubmissionInvitation is created
with a unique token. The invitation is deleted when the invited person accepts
it, or can be retracted by organisers or the submitter.

Columns from TimestampedModel (abstract): created, updated.'''
}

Table submission_tag {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  event_id integer [not null]
  tag varchar(50) [not null]
  description text [not null]
  color varchar(7) [not null]
  is_public bool [default: false, not null, note: 'Public tags can be selected by submitters in the CfP if you activate the tags field. In a future release of pretalx, public tags may also be shown in the public schedule.']

  indexes {
    (event_id) [name: 'submission_tag_event_id_46923e90']
    (event_id, tag) [unique, name: 'unique_tag_per_event']
  }

  Note: '''Columns from TimestampedModel (abstract): created, updated.'''
}

Table submission_track {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  event_id integer [not null]
  name text [not null]
  description text [not null]
  color varchar(7) [not null]
  position "integer unsigned" [note: 'The position field is used to determine the order that tracks are displayed in (lowest first).']
  requires_access_code bool [default: false, not null, note: 'This track will only be shown to submitters with a matching access code.']
  attendee_signup_required bool [default: false, not null, note: 'Sessions will require attendee signup by default. You can always override this setting for individual sessions.']

  indexes {
    (event_id) [name: 'submission_track_event_id_b380882e']
  }

  Note: '''A track groups :class:`~pretalx.submission.models.submission.Submission`
objects within an :class:`~pretalx.event.models.event.Event`, e.g. by
topic.

:param color: The track colour, in the format #012345.

Columns from TimestampedModel (abstract): created, updated.'''
}

Table submission_submissiontype {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  event_id integer [not null]
  name text [not null]
  default_duration "integer unsigned" [default: 30, not null, note: 'Duration in minutes']
  deadline datetime [note: 'If you want a different deadline than the global deadline for this session type, enter it here.']
  requires_access_code bool [default: false, not null, note: 'This session type will only be shown to submitters with a matching access code.']
  attendee_signup_required bool [default: false, not null, note: 'Sessions will require attendee signup by default. You can always override this setting for individual sessions.']

  indexes {
    (event_id) [name: 'submission_submissiontype_event_id_01588962']
  }

  Note: '''Each :class:`~pretalx.submission.models.submission.Submission` has one
SubmissionType.

SubmissionTypes are used to group submissions by default duration (which
can be overridden on a per-submission basis), and to be able to offer
different deadlines for some parts of the
:class:`~pretalx.event.models.event.Event`.

Columns from TimestampedModel (abstract): created, updated.'''
}

