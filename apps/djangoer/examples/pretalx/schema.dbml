  }

  Note: '''Through model connecting speaker and submission.'''
}

Table submission_submission {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  code varchar(16) [unique, not null]
  event_id integer [not null]
  title varchar(200) [not null]
  submission_type_id integer [not null]
  track_id integer
  state SubmissionStates [default: 'submitted', not null]
  pending_state SubmissionStates [default: null]
  abstract text
  description text
  notes text [note: 'These notes are meant for the organisers and won’t be made public.']
  internal_notes text [note: 'Internal notes for other organisers/reviewers. Not visible to the speakers or the public.']
  duration "integer unsigned" [note: 'Duration in minutes']
  slot_count integer [default: 1, not null, note: 'How often this session takes place.']
  attendee_signup_required bool [note: 'Override whether attendees must sign up to attend this session.']
  attendee_signup_capacity "integer unsigned" [note: 'Override the room capacity for this session.']
  content_locale varchar(32) [default: 'en', not null]
  is_featured bool [default: false, not null]
  do_not_record bool [default: false, not null]
  image varchar(100) [note: 'Use this if you want an illustration to go with your proposal.']
  invitation_token varchar(32) [not null, note: 'default in Python: generate_invite_code()']
  access_code_id integer
  review_code varchar(32) [unique, note: 'default in Python: generate_invite_code()']
  anonymised text
  draft_additional_speakers text [not null, note: 'default in Python: list()']

  indexes {
    (event_id) [name: 'submission_submission_event_id_7de3d909']
    (submission_type_id) [name: 'submission_submission_submission_type_id_6d540489']
    (track_id) [name: 'submission_submission_track_id_a80cae77']
    (access_code_id) [name: 'submission_submission_access_code_id_2f86d9fe']
  }

  Note: '''Submissions are, next to :class:`~pretalx.event.models.event.Event`, the
central model in pretalx.

State changes must go through :func:`pretalx.submission.domain.submission.set_submission_state`,
which is called by the ``accept()``, ``reject()`` etc model methods.

Columns from TimestampedModel (abstract): created, updated.'''
}

