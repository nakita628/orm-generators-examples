  }

  Note: '''A TeamInvite is someone who has been invited to a team but hasn\'t accept
the invitation yet.

Columns from TimestampedModel (abstract): created, updated.'''
}

Table mail_queuedmail {
  id integer [pk, increment]
  created datetime [note: 'default in Python: now()']
  updated datetime [note: 'default in Python: now()']
  event_id integer
  template_id integer
  to varchar(1000) [note: 'One email address or several addresses separated by commas.']
  reply_to varchar(1000) [note: 'By default, the organiser address is used as Reply-To.']
  cc varchar(1000) [note: 'One email address or several addresses separated by commas.']
  bcc varchar(1000) [note: 'One email address or several addresses separated by commas.']
  subject varchar(200) [not null]
  text text [not null]
  text_html text
  sent datetime
  state QueuedMailStates [default: 'draft', not null]
  error_data text [default: null]
  error_timestamp datetime
  locale varchar(32)
  attachments text [default: null]

  indexes {
    (event_id) [name: 'mail_queuedmail_event_id_ca510901']
    (template_id) [name: 'mail_queuedmail_template_id_00a74b04']
    (state) [name: 'mail_queuedmail_state_4b73bea9']
  }

  Note: '''Emails in pretalx are rarely sent directly, hence the name QueuedMail.

This mechanism allows organisers to make sure they send out the right
content, and to include personal changes in emails.

:param sent: ``None`` if the mail has not been sent yet.
:param to_users: All known users to whom this email is addressed.
:param to: A comma-separated list of email addresses to whom this email
    is addressed. Does not contain any email addresses known to belong
    to users.

Columns from TimestampedModel (abstract): created, updated.'''
}

