}

Table time_entry {
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  created_by_id char(32)
  updated_by_id char(32)
  id char(32) [pk, note: 'default in Python: uuid4()']
  org_id char(32) [not null]
  case_id char(32)
  project_id char(32)
  task_id char(32)
  profile_id char(32) [not null]
  started_at datetime [not null]
  ended_at datetime [note: 'Null while the timer is running.']
  duration_minutes "integer unsigned" [default: 0, not null, note: 'Recomputed on save when both timestamps are present.']
  description text [default: '', not null]
  billable bool [default: false, not null]
  hourly_rate decimal [note: 'Snapshot at log time so future rate changes do not alter history.. declared max_digits=10, decimal_places=2, which the database does not enforce']
  currency TimeEntryCurrency [default: 'USD', not null]
  invoice_id char(32) [note: 'Set when this entry has been pushed to a draft invoice.']
  auto_stopped bool [default: false, not null, note: 'Set by the auto-stop Celery task when a forgotten timer is killed.']
  is_sample bool [default: false, not null, note: 'True only for demo rows created by common.packs.applier._apply_sample_data. Server-set exclusively, never expose this as a writable field on any serializer. It is the sole key common.packs.applier.clear_sample_data uses to decide what to delete, so a client-writable path here would let a user mark an arbitrary real record as sample and have it deleted.']

  indexes {
    (created_by_id) [name: 'time_entry_created_by_id_4dbe7c82']
    (updated_by_id) [name: 'time_entry_updated_by_id_aa034132']
    (org_id) [name: 'time_entry_org_id_ed339d66']
    (case_id) [name: 'time_entry_case_id_b60cf3ee']
    (project_id) [name: 'time_entry_project_id_6ff68888']
    (task_id) [name: 'time_entry_task_id_a9fac639']
    (profile_id) [name: 'time_entry_profile_id_26ecd493']
    (invoice_id) [name: 'time_entry_invoice_id_e63c8dc2']
    (profile_id) [unique, name: 'one_active_timer_per_profile', note: 'where "ended_at" IS NULL']
    (org_id, profile_id, started_at) [name: 'time_entry_org_id_93126d_idx']
    (case_id, started_at) [name: 'time_entry_case_id_b266ff_idx']
    (project_id, started_at) [name: 'time_entry_project_2c3494_idx']
    (billable, invoice_id) [name: 'time_entry_billabl_2174a0_idx']
  }

  checks {
    `("case_id" IS NULL OR "project_id" IS NULL)` [name: 'time_entry_one_parent']
    `("ended_at" IS NULL OR "ended_at" >= ("started_at"))` [name: 'time_entry_end_after_start']
  }

  Note: '''One agent\'s logged time on a ticket or a project (Tier 3 time-tracking).

Every write sets exactly one of ``case`` and ``project``; the database
refuses both. Deleting a project keeps its entries with ``project``
cleared, so an entry may end up with neither (see docs/features/projects.md).

Per `docs/cases/COORDINATION_DECISIONS.md` D2 we inherit BaseModel and
declare our own org FK; RLS is enforced via the migration policy. The
`one_active_timer_per_profile` partial unique index guarantees a profile
cannot have two running timers concurrently. The start endpoint relies
on this constraint as a race-defense in addition to its own existence
check.

Columns from BaseModel (abstract): id.

Columns from TimeAuditModel (abstract): created_at, updated_at.

Columns from UserAuditModel (abstract): created_by_id, updated_by_id.'''
}

