  expected_days "integer unsigned"
  warning_days "integer unsigned"

  indexes {
    (created_by_id) [name: 'opportunity_pipeline_stage_created_by_id_1b76c1b4']
    (updated_by_id) [name: 'opportunity_pipeline_stage_updated_by_id_36f5561d']
