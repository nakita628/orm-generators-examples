Table inbound_mailbox {
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  created_by_id char(32)
  updated_by_id char(32)
  id char(32) [pk, note: 'default in Python: uuid4()']
  org_id char(32) [not null]
  address varchar(254) [not null]
  provider InboundMailboxProvider [default: 'ses', not null]
  webhook_secret varchar(128) [default: '', not null, note: 'Postmark\'s basic-auth password or Mailgun\'s HTTP webhook signing key, which the webhook checks on every delivery; a Postmark or Mailgun mailbox without one accepts nothing. Unused for SES, which is proven by the SNS signature and the topic_arn pin below. Write-only: the API never returns it.']
  topic_arn varchar(256) [default: '', not null, note: 'SNS Topic ARN this mailbox accepts mail from. A valid SNS signature only proves a message came from some topic in some AWS account, so the webhook also requires this exact match. An admin can enter it. Left blank, it is pinned from the first verified SubscriptionConfirmation whose topic belongs to an AWS account listed in the INBOUND_SNS_ACCOUNT_IDS setting, and a topic in any other account pins nothing. Until it is set, every message is rejected.']
  imap_host varchar(255) [default: '', not null]
  imap_port "integer unsigned"
  imap_username varchar(255) [default: '', not null]
  imap_password_enc varchar(512) [default: '', not null]
  default_priority InboundMailboxDefaultPriority [default: 'Normal', not null]
  default_case_type InboundMailboxDefaultCaseType
  default_assignee_id char(32)
  is_active bool [default: true, not null]
  creates InboundMailboxCreates [default: 'tickets', not null]
  lead_source varchar(64) [default: 'email', not null]
  lead_source_detail varchar(100) [default: '', not null]
  is_generated bool [default: false, not null]

  indexes {
    (created_by_id) [name: 'inbound_mailbox_created_by_id_13fb35ed']
    (updated_by_id) [name: 'inbound_mailbox_updated_by_id_1e037329']
    (org_id) [name: 'inbound_mailbox_org_id_346da248']
    (default_assignee_id) [name: 'inbound_mailbox_default_assignee_id_4cc8c629']
    (org_id, address) [unique, name: 'uniq_inbound_mailbox_per_org_address']
    (address) [unique, name: 'uniq_generated_inbound_address', note: 'where "is_generated" = 1']
    (org_id, is_active) [name: 'inbound_mai_org_id_0a00ff_idx']
  }

  Note: '''Per-org inbound email address configuration. See
docs/integrations/inbound-email.md.

SES, Postmark and Mailgun deliver to the mailbox\'s webhook. The IMAP fields
are nullable so IMAP can be wired in later without a schema migration.

Columns from BaseModel (abstract): id.

Columns from TimeAuditModel (abstract): created_at, updated_at.

Columns from UserAuditModel (abstract): created_by_id, updated_by_id.'''
}

Table email_message {
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  created_by_id char(32)
  updated_by_id char(32)
  id char(32) [pk, note: 'default in Python: uuid4()']
  org_id char(32) [not null]
  case_id char(32) [note: 'Null when the message was dropped (spam/bounce/auto-reply) but we still want an audit trail.']
  mailbox_id char(32) [note: 'The inbound address this message arrived through. Set at ingest; SET_NULL keeps the audit row if the mailbox is later deleted. Null on historical rows the backfill could not attribute.']
  direction EmailMessageDirection [default: 'inbound', not null]
  message_id varchar(512) [not null]
  in_reply_to varchar(512) [default: '', not null]
  references text [default: '', not null, note: 'Whitespace-separated list of RFC-5322 Message-IDs from the References header.']
  from_address varchar(254) [not null]
  to_addresses text [default: '', not null]
  cc_addresses text [default: '', not null]
  subject varchar(512) [default: '', not null]
  body_text text [default: '', not null]
  body_html text [default: '', not null]
  received_at datetime [not null]
  drop_reason varchar(64) [default: '', not null, note: 'If non-empty, the message was rejected (spam/bounce/etc.) before any Case was touched. `case` will be null in this case.']

  indexes {
    (created_by_id) [name: 'email_message_created_by_id_974f3cb1']
    (updated_by_id) [name: 'email_message_updated_by_id_04313a48']
    (org_id) [name: 'email_message_org_id_00016b75']
    (case_id) [name: 'email_message_case_id_9e5e592c']
    (mailbox_id) [name: 'email_message_mailbox_id_9d5eaa86']
    (message_id) [name: 'email_message_message_id_a919d27a']
    (in_reply_to) [name: 'email_message_in_reply_to_347b0504']
    (org_id, message_id) [unique, name: 'uniq_email_message_per_org_id']
    (org_id, received_at) [name: 'email_messa_org_id_631bc3_idx', note: 'descending: received_at']
    (case_id, received_at) [name: 'email_messa_case_id_bc66f7_idx', note: 'descending: received_at']
    (in_reply_to) [name: 'email_messa_in_repl_216d84_idx']
    (mailbox_id, created_at) [name: 'email_messa_mailbox_ea8dfa_idx']
  }

  Note: '''One row per inbound or outbound email handled by the system.

`message_id` is the RFC-5322 Message-ID and is the primary threading key.
`in_reply_to` and `references` are the secondary keys used when the first
inbound message of a thread has already been turned into a Case.

Columns from BaseModel (abstract): id.

Columns from TimeAuditModel (abstract): created_at, updated_at.

Columns from UserAuditModel (abstract): created_by_id, updated_by_id.'''
}

Table routing_rule {
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  created_by_id char(32)
  updated_by_id char(32)
  id char(32) [pk, note: 'default in Python: uuid4()']
  org_id char(32) [not null]
  name varchar(255) [not null]
  priority_order "integer unsigned" [default: 100, not null, note: 'Lower runs first; ties broken by created_at.']
  is_active bool [default: true, not null]
  conditions text [not null, note: 'List of {field, op, value} triples; AND across entries.. default in Python: list()']
  strategy RoutingRuleStrategy [default: 'direct', not null]
  target_team_id char(32)
  stop_processing bool [default: true, not null, note: 'If a rule matches and this is True, skip lower-priority rules.']

  indexes {
    (created_by_id) [name: 'routing_rule_created_by_id_f11940f7']
    (updated_by_id) [name: 'routing_rule_updated_by_id_883c4fd8']
    (org_id) [name: 'routing_rule_org_id_c8f98174']
    (priority_order) [name: 'routing_rule_priority_order_a2797a1d']
    (target_team_id) [name: 'routing_rule_target_team_id_65f1c772']
    (org_id, is_active, priority_order) [name: 'rr_eval_idx']
  }

  Note: '''Per-org auto-assignment rule for newly created Cases.

See docs/cases/tier1/auto-routing.md. The engine in `cases.routing.evaluate`
walks active rules ordered by `priority_order`, runs the first match\'s
`strategy`, and (when `stop_processing=True`) skips lower-priority rules.

`conditions` is a list of `{field, op, value}` dicts. Supported `field`s:
`priority`, `case_type`, `account`, `tags`, `custom_fields.<key>`,
`from_email_domain`, `mailbox_id`. Supported `op`s: `eq`, `in`, `contains`,
`regex`. AND across conditions; OR is modeled by writing multiple rules.

Columns from BaseModel (abstract): id.

Columns from TimeAuditModel (abstract): created_at, updated_at.

Columns from UserAuditModel (abstract): created_by_id, updated_by_id.'''
}

