  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  created_by_id char(32)
  updated_by_id char(32)
  id char(32) [pk, note: 'default in Python: uuid4()']
  title varchar(255) [not null]
  body text [default: '', not null]
  scope MacroScope [default: 'org', not null]
  owner_id char(32)
  is_active bool [default: true, not null]
  usage_count "integer unsigned" [default: 0, not null]
  set_status MacroSetStatus [default: '', not null]
  set_priority MacroSetPriority [default: '', not null]
  org_id char(32) [not null]

  indexes {
    (created_by_id) [name: 'macro_created_by_id_eb307fde']
    (updated_by_id) [name: 'macro_updated_by_id_8314b7aa']
    (owner_id) [name: 'macro_owner_id_0a541851']
    (org_id) [name: 'macro_org_id_c0481b06']
    (org_id, scope, is_active) [name: 'macro_org_id_baa53d_idx']
    (owner_id, created_at) [name: 'macro_owner_i_4b5777_idx', note: 'descending: created_at']
  }

  checks {
    `(("owner_id" IS NULL AND "scope" = 'org') OR ("owner_id" IS NOT NULL AND "scope" = 'personal'))` [name: 'macro_scope_owner_consistent']
  }

  Note: '''Reusable canned response template applied to a case comment composer.

Per `docs/cases/COORDINATION_DECISIONS.md` D2 we inherit BaseModel and
declare our own org FK rather than using BaseOrgModel. Macros are either
`org`-scoped (visible to everyone in the org, admin-managed) or
`personal` (visible only to the owning Profile).

Optional actions ride along with the text: a status, a priority, a set of
assignees (replacing the ticket\'s) and tags (added to the ticket\'s). They
are applied through `cases.updates.update_case`, the ticket PATCH\'s own
path, by `POST /macros/<id>/apply/`. Blank or empty means "no change".
A macro may be actions only, with an empty body.

Columns from BaseModel (abstract): id.

Columns from TimeAuditModel (abstract): created_at, updated_at.

Columns from UserAuditModel (abstract): created_by_id, updated_by_id.'''
}

Table web_form {
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']
  created_by_id char(32)
  updated_by_id char(32)
  id char(32) [pk, note: 'default in Python: uuid4()']
  org_id char(32) [not null, note: 'Organization this record belongs to']
  name varchar(255) [not null]
  target WebFormTarget [default: 'lead', not null, note: 'What an accepted submission creates. Fixed once the form has submissions, so its history never mixes leads and tickets.']
  is_published bool [default: false, not null, note: 'Only published forms accept submissions. Flipped through the publish and unpublish endpoints, never through a plain update.']
  allowed_origins text [not null, note: 'Origins permitted to frame this form or POST to it. An empty list means unrestricted.. default in Python: list()']
  submit_button_label varchar(64) [default: 'Submit', not null]
  success_mode WebFormSuccessMode [default: 'message', not null]
  success_message text [default: 'Thanks. We will be in touch shortly.', not null]
  redirect_url varchar(500) [default: '', not null]
  assignment_mode WebFormAssignmentMode [default: 'person', not null]
  assign_to_id char(32)
  rotation_cap "integer unsigned"
  rotation_last_assigned_id char(32)
  lead_source varchar(64) [default: 'web form', not null]
  ticket_priority WebFormTicketPriority [default: 'Normal', not null]
  ticket_type WebFormTicketType [default: '', not null]
  captcha_provider WebFormCaptchaProvider [default: '', not null]
  captcha_site_key varchar(255) [default: '', not null]
  captcha_secret varchar(255) [default: '', not null]
  reject_disposable_email bool [default: true, not null]
  legacy_api_setting_id char(32) [unique, note: 'Set by the backfill migration. Links a legacy web-to-lead API key to the form that now backs it.']

  indexes {
