    (org_id, created_at) [name: 'project_rat_org_id_fbbefe_idx', note: 'descending: created_at']
  }

  checks {
    `"hourly_rate" >= '0'` [name: 'project_rate_non_negative']
  }

  Note: '''One person\'s hourly rate on one project, ahead of the project\'s own.

Columns from BaseOrgModel (abstract): org_id.

Columns from BaseModel (abstract): id.

Columns from TimeAuditModel (abstract): created_at, updated_at.

Columns from UserAuditModel (abstract): created_by_id, updated_by_id.'''
}

