Enum LogEntryActionFlag {
  "1"
  "2"
  "3"
}

Enum TeamSubmissionStatus {
  "D"
  "A"
}

Enum SubmissionStatus {
  "D"
  "A"
}

Enum ExternalGraderDetailStatus {
  "pending"
  "pulled"
  "retired"
  "failed"
  "retry"
}

Table django_admin_log {
  id integer [pk, increment]
  action_time datetime [not null, note: 'default in Python: now()']
  user_id integer [not null]
  content_type_id integer
  object_id text
  object_repr varchar(200) [not null]
  action_flag LogEntryActionFlag [not null]
  change_message text [not null]

  indexes {
    (user_id) [name: 'django_admin_log_user_id_c564eba6']
    (content_type_id) [name: 'django_admin_log_content_type_id_c4bce8eb']
  }
}

Table auth_permission {
  id integer [pk, increment]
  name varchar(255) [not null]
  content_type_id integer [not null]
  codename varchar(100) [not null]

  indexes {
    (content_type_id) [name: 'auth_permission_content_type_id_2f476e4b']
    (content_type_id, codename) [unique, name: 'auth_permission_content_type_id_codename_01ab375a_uniq']
  }

  Note: '''The permissions system provides a way to assign permissions to specific
users and groups of users.

The permission system is used by the Django admin site, but may also be
useful in your own code. The Django admin site uses permissions as follows:

    - The "add" permission limits the user\'s ability to view the "add" form
      and add an object.
    - The "change" permission limits a user\'s ability to view the change
      list, view the "change" form and change an object.
    - The "delete" permission limits the ability to delete an object.
    - The "view" permission limits the ability to view an object.

Permissions are set globally per type of object, not per specific object
instance. It is possible to say "Mary may change news stories," but it\'s
not currently possible to say "Mary may change news stories, but only the
ones she created herself" or "Mary may only change news stories that have a
certain status or publication date."

The permissions listed above are automatically created for each model.'''
}

Table auth_group {
  id integer [pk, increment]
  name varchar(150) [unique, not null]

  Note: '''Groups are a generic way of categorizing users to apply permissions, or
some other label, to those users. A user can belong to any number of
groups.

A user in a group automatically has all the permissions granted to that
group. For example, if the group \'Site editors\' has the permission
can_edit_home_page, any user in that group will have that permission.

Beyond permissions, groups are a convenient way to categorize users to
apply some label, or extended functionality, to them. For example, you
could create a group \'Special users\', and you could write code that would
do special things to those users -- such as giving them access to a
members-only portion of your site, or sending them members-only email
messages.'''
}

Table auth_user {
  id integer [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  is_superuser bool [default: false, not null, note: 'Designates that this user has all permissions without explicitly assigning them.']
  username varchar(150) [unique, not null, note: 'Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.']
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  email varchar(254) [not null]
  is_staff bool [default: false, not null, note: 'Designates whether the user can log into this admin site.']
  is_active bool [default: true, not null, note: 'Designates whether this user should be treated as active. Unselect this instead of deleting accounts.']
  date_joined datetime [not null, note: 'default in Python: now()']

  Note: '''Users within the Django authentication system are represented by this
model.

Username and password are required. Other fields are optional.

Columns from AbstractUser (abstract): username, first_name, last_name, email, is_staff, is_active, date_joined.

Columns from AbstractBaseUser (abstract): password, last_login.

Columns from PermissionsMixin (abstract): is_superuser.'''
}

Table django_content_type {
  id integer [pk, increment]
  app_label varchar(100) [not null]
  model varchar(100) [not null]

  indexes {
    (app_label, model) [unique, name: 'django_content_type_app_label_model_76bd3d3b_uniq']
  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date datetime [not null]

  indexes {
    (expire_date) [name: 'django_session_expire_date_a5c62663']
  }

  Note: '''Django provides full support for anonymous sessions. The session
framework lets you store and retrieve arbitrary data on a
per-site-visitor basis. It stores data on the server side and
abstracts the sending and receiving of cookies. Cookies contain a
session ID -- not the data itself.

The Django sessions framework is entirely cookie-based. It does
not fall back to putting session IDs in URLs. This is an intentional
design decision. Not only does that behavior make URLs ugly, it makes
your site vulnerable to session-ID theft via the "Referer" header.

For complete documentation on using Sessions in your code, consult
the sessions documentation that is shipped with Django (also available
on the Django web site).

Columns from AbstractBaseSession (abstract): session_key, session_data, expire_date.'''
}

Table submissions_studentitem {
  id integer [pk, increment]
  student_id varchar(255) [not null]
  course_id varchar(255) [not null]
  item_id varchar(255) [not null]
  item_type varchar(100) [not null]

  indexes {
    (student_id) [name: 'submissions_studentitem_student_id_8e72bcd9']
    (course_id) [name: 'submissions_studentitem_course_id_05ee1efe']
    (item_id) [name: 'submissions_studentitem_item_id_6c409784']
    (course_id, student_id, item_id) [unique, name: 'submissions_studentitem_course_id_student_id_item_id_5b02ecf8_uniq']
  }

  Note: '''Represents a single item for a single course for a single user.

This is typically an XBlock problem, but could be something more generic
like class participation.

.. no_pii:'''
}

Table submissions_teamsubmission {
  id integer [pk, increment]
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'default in Python: now()']
  uuid char(32) [not null, note: 'default in Python: uuid4()']
  attempt_number "integer unsigned" [not null]
  submitted_at datetime [not null, note: 'default in Python: now()']
  course_id varchar(255) [not null]
  item_id varchar(255) [not null]
  team_id varchar(255) [not null]
  submitted_by_id integer
  status TeamSubmissionStatus [default: 'A', not null]

  indexes {
    (uuid) [name: 'submissions_teamsubmission_uuid_4d1aef87']
    (submitted_at) [name: 'submissions_teamsubmission_submitted_at_74e28ed6']
    (course_id) [name: 'submissions_teamsubmission_course_id_68c6908d']
    (item_id) [name: 'submissions_teamsubmission_item_id_2bdcb26c']
    (team_id) [name: 'submissions_teamsubmission_team_id_5fda0e54']
    (submitted_by_id) [name: 'submissions_teamsubmission_submitted_by_id_5a27162a']
  }

  Note: '''A single response by a team for a given problem (ORA2) in a given course.
An abstraction layer over Submission used to for teams. Since we create a submission record for every team member,
there is a need to have a single point to connect the team to the workflows.
TeamSubmission is a 1 to many with Submission

.. no_pii:

Columns from TimeStampedModel (abstract): created, modified.'''
}

Table submissions_submission {
  id integer [pk, increment]
  uuid char(32) [not null, note: 'default in Python: uuid4()']
  student_item_id bigint [not null]
  attempt_number "integer unsigned" [not null]
  submitted_at datetime [not null, note: 'default in Python: now()']
  created_at datetime [not null, note: 'default in Python: now()']
  raw_answer text [not null]
  status SubmissionStatus [default: 'A', not null]
  team_submission_id bigint

  indexes {
    (uuid) [name: 'submissions_submission_uuid_210428ab']
    (student_item_id) [name: 'submissions_submission_student_item_id_9d087470']
    (submitted_at) [name: 'submissions_submission_submitted_at_9653124d']
    (created_at) [name: 'submissions_submission_created_at_01c4bf22']
    (team_submission_id) [name: 'submissions_submission_team_submission_id_40e6bc97']
  }

  Note: '''A single response by a student for a given problem in a given course.

A student may have multiple submissions for the same problem. Submissions
should never be mutated. If the student makes another Submission, or if we
have to make corrective Submissions to fix bugs, those should be new
objects. We want to keep Submissions immutable both for audit purposes, and
because it makes caching trivial.

.. no_pii:'''
}

Table submissions_score {
  id integer [pk, increment]
  student_item_id bigint [not null]
  submission_id bigint
  points_earned "integer unsigned" [default: 0, not null]
  points_possible "integer unsigned" [default: 0, not null]
  created_at datetime [not null, note: 'default in Python: now()']
  reset bool [default: false, not null]

  indexes {
    (student_item_id) [name: 'submissions_score_student_item_id_de4f5954']
    (submission_id) [name: 'submissions_score_submission_id_ba095829']
    (created_at) [name: 'submissions_score_created_at_b65f0390']
  }

  Note: '''What the user scored for a given StudentItem at a given time.

Note that while a Score *can* be tied to a Submission, it doesn\'t *have* to.
Specifically, if we want to have scores for things that are not a part of
the courseware (like "class participation"), there would be no corresponding
Submission.

.. no_pii:'''
}

Table submissions_scoresummary {
  id integer [pk, increment]
  student_item_id bigint [unique, not null]
  highest_id bigint [not null]
  latest_id bigint [not null]

  indexes {
    (highest_id) [name: 'submissions_scoresummary_highest_id_3efe897d']
    (latest_id) [name: 'submissions_scoresummary_latest_id_dd8a17bb']
  }

  Note: '''Running store of the highest and most recent Scores for a StudentItem.

.. no_pii:'''
}

Table submissions_scoreannotation {
  id integer [pk, increment]
  score_id bigint [not null]
  annotation_type varchar(255) [not null]
  creator varchar(255) [not null]
  reason text [not null]

  indexes {
    (score_id) [name: 'submissions_scoreannotation_score_id_2dda6e02']
    (annotation_type) [name: 'submissions_scoreannotation_annotation_type_117a2607']
    (creator) [name: 'submissions_scoreannotation_creator_5cc126cc']
  }

  Note: '''Annotate individual scores with extra information if necessary.

.. no_pii:'''
}

Table submissions_externalgraderdetail {
  id integer [pk, increment]
  submission_id bigint [unique, not null]
  queue_name varchar(128) [not null]
  queue_key varchar(128)
  grader_file_name varchar(128) [default: '', not null]
  points_possible "integer unsigned" [default: 1, not null]
  status ExternalGraderDetailStatus [default: 'pending', not null]
  pullkey varchar(128)
  grader_reply text
  status_time datetime [not null, note: 'default in Python: now()']
  created_at datetime [not null, note: 'default in Python: now()']
  num_failures "integer unsigned" [default: 0, not null]

  indexes {
    (status_time) [name: 'submissions_externalgraderdetail_status_time_1f2a6499']
    (created_at) [name: 'submissions_externalgraderdetail_created_at_e1618de1']
    (queue_name, status, status_time) [name: 'submissions_queue_n_fbabd8_idx']
  }

  Note: '''Tracks queue processing information for a Submission.'''
}

Table submissions_submissionfile {
  id integer [pk, increment]
  uuid char(32) [not null, note: 'default in Python: uuid4()']
  external_grader_id bigint
  file varchar(512) [not null]
  original_filename varchar(255) [not null]
  created_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (external_grader_id) [name: 'submissions_submissionfile_external_grader_id_b21f9730']
    (external_grader_id, uuid) [name: 'submissions_externa_ff8089_idx']
  }

  Note: '''Model to handle files associated with submissions'''
}

