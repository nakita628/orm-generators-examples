Table hyperkitty_threadcategory {
  id integer [pk, increment]
  name varchar(255) [unique, not null]
  color varchar(7) [not null]
}

Table hyperkitty_thread {
  id integer [pk, increment]
  mailinglist_id integer [not null]
  thread_id varchar(255) [not null]
  date_active datetime [not null, note: 'default in Python: now()']
  category_id integer
  starting_email_id integer [unique]

  indexes {
    (mailinglist_id) [name: 'hyperkitty_thread_mailinglist_id_ff80772b']
    (thread_id) [name: 'hyperkitty_thread_thread_id_1eb0910a']
    (date_active) [name: 'hyperkitty_thread_date_active_34994eb8']
    (category_id) [name: 'hyperkitty_thread_category_id_0d7a8102']
    (mailinglist_id, thread_id) [unique, name: 'hyperkitty_thread_mailinglist_id_thread_id_d832e465_uniq']
  }

  Note: '''A thread of archived email, from a mailing-list. It is identified by both
the list name and the thread id.'''
}

Table hyperkitty_lastview {
  id integer [pk, increment]
  thread_id integer [not null]
  user_id integer [not null]
  view_date datetime [not null, note: 'default in Python: now()']

  indexes {
    (thread_id) [name: 'hyperkitty_lastview_thread_id_5bd4f0ad']
    (user_id) [name: 'hyperkitty_lastview_user_id_5586ea1f']
  }
}

Table hyperkitty_mailinglist {
  id integer [pk, increment]
  name varchar(254) [unique, not null]
  list_id varchar(254) [unique]
  display_name varchar(255) [not null]
  description text
  subject_prefix varchar(255) [not null]
  archive_policy MailingListArchivePolicy [default: 2, not null]
  created_at datetime [not null, note: 'default in Python: now()']
  archive_rendering_mode varchar(255)

  Note: '''An archived mailing-list.'''
}

Table hyperkitty_vote {
  id integer [pk, increment]
  email_id integer [not null]
  user_id integer [not null]
  value smallint [not null]

  indexes {
    (email_id) [name: 'hyperkitty_vote_email_id_73a50f4d']
    (user_id) [name: 'hyperkitty_vote_user_id_30d9d03b']
    (value) [name: 'hyperkitty_vote_value_8b62f468']
    (email_id, user_id) [unique, name: 'hyperkitty_vote_email_id_user_id_61fb1880_uniq']
  }

  Note: '''A User\'s vote on a message'''
}

Table hyperkitty_email {
  id integer [pk, increment]
  mailinglist_id integer [not null]
  message_id varchar(255) [not null]
  message_id_hash varchar(255) [not null]
  sender_id varchar(255) [not null]
  sender_name varchar(255)
  subject varchar(512) [not null]
  content text [not null]
  date datetime [not null]
  timezone smallint [not null]
  in_reply_to varchar(255)
  parent_id integer [note: 'refers to hyperkitty_email.id, with no foreign key in the database']
  thread_id integer [not null]
  archived_date datetime [not null, note: 'default in Python: now()']
  thread_depth integer [default: 0, not null]
  thread_order integer

  indexes {
    (mailinglist_id) [name: 'hyperkitty_email_mailinglist_id_2c2b6f03']
    (message_id) [name: 'hyperkitty_email_message_id_584fd58b']
    (message_id_hash) [name: 'hyperkitty_email_message_id_hash_8a4a6406']
    (sender_id) [name: 'hyperkitty_email_sender_id_218742c7']
    (subject) [name: 'hyperkitty_email_subject_7ae9de90']
    (date) [name: 'hyperkitty_email_date_5a028303']
