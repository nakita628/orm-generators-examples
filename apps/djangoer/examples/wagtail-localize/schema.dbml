    (redirect_page_id) [name: 'wagtailredirects_redirect_redirect_page_id_b5728a8f']
    (old_path, site_id) [unique, name: 'wagtailredirects_redirect_old_path_site_id_783622d7_uniq']
  }
}

Table wagtailembeds_embed {
  id integer [pk, increment]
  url text [not null]
  max_width smallint
  hash varchar(32) [unique, not null]
  type EmbedType [not null]
  html text [not null]
  title text [not null]
  author_name text [not null]
  provider_name text [not null]
  thumbnail_url text [not null]
  width integer
  height integer
  last_updated datetime [not null, note: 'default in Python: now()']
  cache_until datetime

  indexes {
    (cache_until) [name: 'wagtailembeds_embed_cache_until_26c94bb0']
  }

  Note: '''When embed code is fetched from a provider (eg, youtube) we cache that code
in the database so we don\'t need to ask for it again.

This model is used for caching the embed html code. It also stores some
metadata which gets displayed in the editor.

If an instance of this model is deleted, it will be automatically refetched
next time the embed code is needed.'''
}

Table wagtailusers_userprofile {
  id integer [pk, increment]
  user_id integer [unique, not null]
  submitted_notifications bool [default: true, not null, note: 'Receive notification when a page is submitted for moderation']
  approved_notifications bool [default: true, not null, note: 'Receive notification when your page edit is approved']
  rejected_notifications bool [default: true, not null, note: 'Receive notification when your page edit is rejected']
  updated_comments_notifications bool [default: true, not null, note: 'Receive notification when comments have been created, resolved, or deleted on a page that you have subscribed to receive comment notifications on']
  preferred_language varchar(10) [default: '', not null, note: 'Select language for the admin']
  current_time_zone varchar(40) [default: '', not null, note: 'Select your current time zone']
  avatar varchar(100) [not null]
  dismissibles text [not null, note: 'default in Python: dict()']
  theme UserProfileAdminColorThemes [default: 'system', not null]
  contrast UserProfileAdminContrastThemes [default: 'system', not null]
  density UserProfileAdminDensityThemes [default: 'default', not null]
  keyboard_shortcuts bool [default: true, not null, note: 'Enable custom keyboard shortcuts specific to Wagtail.']
}

