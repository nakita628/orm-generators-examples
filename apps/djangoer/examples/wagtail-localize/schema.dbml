Table wagtail_localize_localesynchronization {
  id integer [pk, increment]
  locale_id integer [unique, not null]
  sync_from_id integer [not null]

  indexes {
    (sync_from_id) [name: 'wagtail_localize_localesynchronization_sync_from_id_1bc4c2eb']
  }

  Note: '''Stores the "Sync from" setting that users can add to Locales.

This tells Wagtail Localize to synchronise the contents of the \'sync_from\' Locale to the \'locale\' Locale.

Attributes:
    locale (ForeignKey to Locale): The destination Locale of the synchronisation
    sync_from (ForeignKey to Locale): The source Locale of the synchronisation'''
}

