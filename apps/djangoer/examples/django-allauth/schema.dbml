}

Table socialaccount_socialtoken {
  id integer [pk, increment]
  app_id integer
  account_id integer [not null]
  token text [not null, note: '"oauth_token" (OAuth1) or access token (OAuth2)']
  token_secret text [not null, note: '"oauth_token_secret" (OAuth1) or refresh token (OAuth2)']
  expires_at datetime

  indexes {
    (app_id) [name: 'socialaccount_socialtoken_app_id_636a42d7']
    (account_id) [name: 'socialaccount_socialtoken_account_id_951f210e']
    (app_id, account_id) [unique, name: 'socialaccount_socialtoken_app_id_account_id_fca4e0ac_uniq']
  }
}

Table mfa_authenticator {
  id integer [pk, increment]
  user_id integer [not null]
  type AuthenticatorType [not null]
  data text [not null]
  created_at datetime [not null, note: 'default in Python: now()']
  last_used_at datetime

  indexes {
    (user_id) [name: 'mfa_authenticator_user_id_0c3a50c0']
    (user_id, type) [unique, name: 'unique_authenticator_type', note: 'where "type" IN (\'totp\', \'recovery_codes\')']
  }
}

Table usersessions_usersession {
  id integer [pk, increment]
  user_id integer [not null]
  created_at datetime [not null, note: 'default in Python: now()']
  ip char(39) [not null]
  last_seen_at datetime [not null, note: 'default in Python: now()']
  session_key varchar(40) [unique, not null]
  user_agent varchar(200) [not null]
  data text [not null, note: 'default in Python: dict()']

  indexes {
    (user_id) [name: 'usersessions_usersession_user_id_af5e0a6d']
  }
}

Table allauth_idp_oidc_client {
  id varchar(100) [pk, note: 'default in Python: default_client_id()']
  name varchar(100) [not null]
  secret varchar(200) [not null, note: 'default in Python: default_client_secret()']
  scopes text [default: 'openid', not null, note: 'The scope(s) the client is allowed to request. Provide one value per line, e.g.: openid(ENTER)profile(ENTER)email(ENTER)']
  default_scopes text [default: '', not null, note: 'In case the client does not specify any scope, these default scopes are used. Provide one value per line, e.g.: openid(ENTER)profile(ENTER)email(ENTER)']
  type ClientType [default: 'confidential', not null]
  grant_types text [default: 'authorization_code', not null, note: 'A list of allowed grant types. Provide one value per line, e.g.: authorization_code(ENTER)client_credentials(ENTER)refresh_token(ENTER)']
  redirect_uris text [default: '', not null, note: 'A list of allowed redirect (callback) URLs, one per line.']
  cors_origins text [default: '', not null, note: 'A list of allowed origins for cross-origin requests, one per line.']
  allow_uri_wildcards bool [default: false, not null, note: 'Allow wildcards (*) in redirect URIs and CORS origins. When enabled, URIs can contain a single asterisk to match subdomains.']
  response_types text [default: 'code', not null, note: 'A list of allowed response types. Provide one value per line, e.g.: code(ENTER)id_token token(ENTER)']
  owner_id integer
  skip_consent bool [default: false, not null, note: 'Flag to allow skip the consent screen for this client']
  created_at datetime [not null, note: 'default in Python: now()']
  data text [default: null]

  indexes {
    (owner_id) [name: 'allauth_idp_oidc_client_owner_id_1f1eb0f1']
  }
}

Table allauth_idp_oidc_token {
  id integer [pk, increment]
  type TokenType [not null]
  hash varchar(255) [not null]
  client_id varchar(100)
  user_id integer
  data text [default: null]
  created_at datetime [not null, note: 'default in Python: now()']
  expires_at datetime
  scopes text [default: '', not null]

  indexes {
    (client_id) [name: 'allauth_idp_oidc_token_client_id_cad2cd57']
    (user_id) [name: 'allauth_idp_oidc_token_user_id_3e9a005f']
    (expires_at) [name: 'allauth_idp_oidc_token_expires_at_f6e6261a']
    (type, hash) [unique, name: 'allauth_idp_oidc_token_type_hash_cca00f1c_uniq']
  }
}

