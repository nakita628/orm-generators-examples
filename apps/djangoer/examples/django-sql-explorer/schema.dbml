  id integer [pk, increment]
  prompt text [not null]
  user_request text [not null]
  response text [not null]
  run_by_user_id integer
  run_at datetime [not null, note: 'default in Python: now()']
  duration real
  model varchar(128) [default: '', not null]
  error text
  database_connection_id integer

  indexes {
    (run_by_user_id) [name: 'explorer_promptlog_run_by_user_id_ec301ea7']
    (database_connection_id) [name: 'explorer_promptlog_database_connection_id_eb15d329']
  }
}

Table explorer_tabledescription {
  id integer [pk, increment]
  database_connection_id integer [not null]
  table_name varchar(512) [not null]
  description text [not null]

  indexes {
    (database_connection_id) [name: 'explorer_tabledescription_database_connection_id_16e24fab']
    (database_connection_id, table_name) [unique, name: 'explorer_tabledescription_database_connection_id_table_name_73ac361d_uniq']
  }
}

Table explorer_query {
  id integer [pk, increment]
  title varchar(255) [not null]
  sql text [not null]
  description text [not null]
  created_by_user_id integer
  created_at datetime [not null, note: 'default in Python: now()']
  last_run_date datetime [not null, note: 'default in Python: now()']
  snapshot bool [default: false, not null, note: 'Include in snapshot task (if enabled)']
  connection varchar(128) [default: '', not null, note: 'Name of DB connection (as specified in settings) to use for this query.Will use EXPLORER_DEFAULT_CONNECTION if left blank']
  database_connection_id integer
  few_shot bool [default: false, not null, note: 'Will be included as a good example of SQL in assistant queries that use relevant tables']

  indexes {
    (created_by_user_id) [name: 'explorer_query_created_by_user_id_182dd868']
    (database_connection_id) [name: 'explorer_query_database_connection_id_64440483']
  }
}

Table explorer_querylog {
  id integer [pk, increment]
  sql text [not null]
  query_id integer
  run_by_user_id integer
  run_at datetime [not null, note: 'default in Python: now()']
  duration real
  connection varchar(128) [default: '', not null]
  database_connection_id integer
  success bool [default: true, not null]
  error text

  indexes {
    (query_id) [name: 'explorer_querylog_query_id_1635a6b4']
    (run_by_user_id) [name: 'explorer_querylog_run_by_user_id_cf26a49f']
    (database_connection_id) [name: 'explorer_querylog_database_connection_id_cf8ddd6a']
  }
}

