  sha256 varchar(64) [not null]
  version varchar(128) [not null, note: 'collation pulp_ansible_semver']
  version_major integer [not null]
  version_minor integer [not null]
  version_patch integer [not null]
  version_prerelease varchar(128) [not null]
  tags "varchar(64)[]" [not null, note: 'default in Python: list()']
  collection_id uuid [not null]
  search_vector tsvector [default: '', not null]
  _pulp_domain_id uuid [not null, note: 'default in Python: get_domain_pk()']

  indexes {
    (sha256) [name: 'ansible_collectionversion_sha256_a4d120ab']
