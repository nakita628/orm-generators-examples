Table core_remoteartifact {
  pulp_id uuid [pk, note: 'default in Python: pulp_uuid()']
  pulp_created "timestamp with time zone" [not null, note: 'default in Python: now()']
  pulp_last_updated "timestamp with time zone" [note: 'default in Python: now()']
  url text [not null]
  size bigint
  md5 varchar(32)
  sha1 varchar(40)
  sha224 varchar(56)
  sha256 varchar(64)
  sha384 varchar(96)
  sha512 varchar(128)
  failed_at "timestamp with time zone"
  content_artifact_id uuid [not null]
  remote_id uuid [not null]
  pulp_domain_id uuid [not null, note: 'default in Python: get_domain_pk()']

  indexes {
    (md5) [name: 'core_remoteartifact_md5_57731448']
    (md5) [name: 'core_remoteartifact_md5_57731448_like', note: 'varchar_pattern_ops']
    (sha1) [name: 'core_remoteartifact_sha1_851e329a']
    (sha1) [name: 'core_remoteartifact_sha1_851e329a_like', note: 'varchar_pattern_ops']
    (sha224) [name: 'core_remoteartifact_sha224_57d86c5d']
    (sha224) [name: 'core_remoteartifact_sha224_57d86c5d_like', note: 'varchar_pattern_ops']
    (sha256) [name: 'core_remoteartifact_sha256_dd4b07a2']
    (sha256) [name: 'core_remoteartifact_sha256_dd4b07a2_like', note: 'varchar_pattern_ops']
    (sha384) [name: 'core_remoteartifact_sha384_fd48993e']
    (sha384) [name: 'core_remoteartifact_sha384_fd48993e_like', note: 'varchar_pattern_ops']
    (sha512) [name: 'core_remoteartifact_sha512_de82fc24']
    (sha512) [name: 'core_remoteartifact_sha512_de82fc24_like', note: 'varchar_pattern_ops']
    (content_artifact_id) [name: 'core_remoteartifact_content_artifact_id_54377af5']
    (remote_id) [name: 'core_remoteartifact_remote_id_af9354ce']
    (pulp_domain_id) [name: 'core_remoteartifact_pulp_domain_id_507b2f03']
    (content_artifact_id, remote_id, pulp_domain_id) [unique, name: 'core_remoteartifact_content_artifact_id_remo_f11e4ef2_uniq']
  }

  Note: '''Represents a content artifact that is provided by a remote (external) repository.

Remotes that want to support deferred download policies should use this model to store
information required for downloading an Artifact at some point in the future. At a minimum this
includes the URL, the ContentArtifact, and the Remote that created it. It can also store
expected size and any expected checksums.

Fields:

    url (models.TextField): The URL where the artifact can be retrieved.
    size (models.BigIntegerField): The expected size of the file in bytes.
    md5 (models.CharField): The expected MD5 checksum of the file.
    sha1 (models.CharField): The expected SHA-1 checksum of the file.
    sha224 (models.CharField): The expected SHA-224 checksum of the file.
    sha256 (models.CharField): The expected SHA-256 checksum of the file.
    sha384 (models.CharField): The expected SHA-384 checksum of the file.
    sha512 (models.CharField): The expected SHA-512 checksum of the file.
    failed_at (models.DateTimeField): The datetime of last download attempt failure.

Relations:

    content_artifact (pulpcore.app.models.ForeignKey)
        ContentArtifact associated with this RemoteArtifact.
    remote (django.db.models.ForeignKey) Remote that created the
        RemoteArtifact.
    pulp_domain (django.db.models.ForeignKey) Domain the RemoteArtifact is a part of.

Columns from BaseModel (abstract): pulp_id, pulp_created, pulp_last_updated.'''
}

