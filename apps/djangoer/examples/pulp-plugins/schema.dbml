Table python_packageyank {
  content_ptr_id uuid [pk, note: 'parent link: a PackageYank is a Content (multi-table inheritance)']
  name_normalized text [not null]
  version text [not null]
  yanked_reason text [default: '', not null]
  _pulp_domain_id uuid [not null, note: 'default in Python: get_domain_pk()']

  indexes {
    (_pulp_domain_id) [name: 'python_packageyank__pulp_domain_id_0acb011b']
    (name_normalized, version, yanked_reason, _pulp_domain_id) [unique, name: 'python_packageyank_name_normalized_version__96a211ce_uniq']
  }

  Note: '''A marker content type indicating a package version is yanked in a repository (PEP 592).

Its presence in a repository version means all files for the matching
(name_normalized, version) pair are yanked. Yank/unyank operations
add/remove this marker, creating new repository versions.'''
}

Table python_pythonpublication {
  publication_ptr_id uuid [pk, note: 'parent link: a PythonPublication is a Publication (multi-table inheritance)']

  Note: '''A Publication for PythonContent.'''
}

Table python_pythonremote {
  remote_ptr_id uuid [pk, note: 'parent link: a PythonRemote is a Remote (multi-table inheritance)']
  prereleases boolean [default: false, not null]
  includes jsonb [not null, note: 'default in Python: list()']
  excludes jsonb [not null, note: 'default in Python: list()']
  package_types PythonRemotePackageTypes [not null, note: 'default in Python: list()']
  keep_latest_packages integer [default: 0, not null]
  exclude_platforms PythonRemoteExcludePlatforms [not null, note: 'default in Python: list()']
  provenance boolean [default: false, not null]
  vulnerabilities boolean [default: false, not null]

  Note: '''A Remote for Python Content.

Fields:

    prereleases (models.BooleanField): Whether to sync pre-release versions of packages.'''
}

Table python_pythonrepository {
  repository_ptr_id uuid [pk, note: 'parent link: a PythonRepository is a Repository (multi-table inheritance)']
  autopublish boolean [default: false, not null]
  allow_package_substitution boolean [default: true, not null]
  error_on_reject boolean [default: true, not null]

  Note: '''Repository for "python" content.'''
}

Table python_pythonblocklistentry {
  pulp_id uuid [pk, note: 'default in Python: pulp_uuid()']
  pulp_created "timestamp with time zone" [not null, note: 'default in Python: now()']
  pulp_last_updated "timestamp with time zone" [note: 'default in Python: now()']
  name text [default: null]
  version text [default: null]
  filename text [default: null]
  added_by text [default: '', not null]
  repository_id uuid [not null]

  indexes {
    (repository_id) [name: 'python_pythonblocklistentry_repository_id_e10c20b5']
  }

  Note: '''An entry in a PythonRepository\'s package blocklist.

Blocklist entries prevent packages from being added to the repository.
Entries can match by package `name` (all versions), package `name` + `version`,
or exact `filename`. Exactly one of `name` or `filename` must be provided.

Columns from BaseModel (abstract): pulp_id, pulp_created, pulp_last_updated.'''
}

