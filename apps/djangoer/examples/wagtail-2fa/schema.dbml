Table wagtailcore_page {
  id integer [pk, increment]
  path varchar(255) [unique, not null]
  depth "integer unsigned" [not null]
  numchild "integer unsigned" [default: 0, not null]
  translation_key char(32) [not null, note: 'default in Python: uuid4()']
  locale_id integer [not null]
  latest_revision_id integer
  live bool [default: true, not null]
  has_unpublished_changes bool [default: false, not null]
  first_published_at datetime
  last_published_at datetime
  live_revision_id integer
  go_live_at datetime
  expire_at datetime
  expired bool [default: false, not null]
  locked bool [default: false, not null]
  locked_at datetime
  locked_by_id integer
  title varchar(255) [not null, note: 'The page title as you\'d like it to be seen by the public']
  draft_title varchar(255) [not null]
  slug varchar(255) [not null, note: 'The name of the page as it will appear in URLs e.g http://domain.com/blog/[my-slug]/']
  content_type_id integer [not null]
  url_path text [not null]
  owner_id integer
  latest_revision_created_at datetime
  alias_of_id integer
  show_in_menus bool [default: false, not null, note: 'Whether a link to this page will appear in automatically generated menus']
  seo_title varchar(255) [not null, note: 'The name of the page displayed on search engine results as the clickable headline.']
  search_description text [not null, note: 'The descriptive text displayed underneath a headline in search engine results.']

  indexes {
    (locale_id) [name: 'wagtailcore_page_locale_id_3c7e30a6']
    (latest_revision_id) [name: 'wagtailcore_page_latest_revision_id_e60fef51']
    (first_published_at) [name: 'wagtailcore_page_first_published_at_2b5dd637']
    (live_revision_id) [name: 'wagtailcore_page_live_revision_id_930bd822']
    (locked_by_id) [name: 'wagtailcore_page_locked_by_id_bcb86245']
    (slug) [name: 'wagtailcore_page_slug_e7c11b8f']
    (content_type_id) [name: 'wagtailcore_page_content_type_id_c28424df']
    (owner_id) [name: 'wagtailcore_page_owner_id_fbf7c332']
    (alias_of_id) [name: 'wagtailcore_page_alias_of_id_12945502']
    (translation_key, locale_id) [unique, name: 'wagtailcore_page_translation_key_locale_id_9b041bad_uniq']
  }

  Note: '''Columns from AbstractPage (abstract): title, draft_title, slug, content_type_id, url_path, owner_id, latest_revision_created_at, alias_of_id.

Columns from DraftStateMixin (abstract): live, has_unpublished_changes, first_published_at, last_published_at, live_revision_id, go_live_at, expire_at, expired.

Columns from LockableMixin (abstract): locked, locked_at, locked_by_id.

Columns from RevisionMixin (abstract): latest_revision_id.

Columns from TranslatableMixin (abstract): translation_key, locale_id.

Columns from MP_Node (abstract): path, depth, numchild.

Columns from DefaultBasePageMixin (abstract): seo_title, search_description.

Columns from ShowInMenusMixin (abstract): show_in_menus.'''
}

