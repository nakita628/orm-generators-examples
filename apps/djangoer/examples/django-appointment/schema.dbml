Table appointment_unavailability {
  id integer [pk, increment]
  staff_member_id bigint [not null]
  description varchar(255)
  date date [not null]
  start_time time [not null]
  end_time time [not null]
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (staff_member_id) [name: 'appointment_unavailability_staff_member_id_17b40658']
  }

  checks {
    `"start_time" < ("end_time")` [name: 'unavailability_start_time_before_end_time']
  }
}

Table appointment_workinghours {
  id integer [pk, increment]
  staff_member_id bigint [not null]
  day_of_week WorkingHoursDayOfWeek [not null]
  start_time time [not null]
  end_time time [not null]
  created_at datetime [not null, note: 'default in Python: now()']
  updated_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (staff_member_id) [name: 'appointment_workinghours_staff_member_id_8e0c8746']
    (staff_member_id, day_of_week) [unique, name: 'appointment_workinghours_staff_member_id_day_of_week_d1d65265_uniq']
  }

  checks {
    `"start_time" < ("end_time")` [name: 'working_hours_start_time_before_end_time']
  }
}

