Table django_comments {
  id integer [pk, increment]
  content_type_id integer [not null]
  object_pk varchar(64) [not null, note: 'content_object: with content_type_id, a generic foreign key to a row of any model']
  site_id integer [not null]
  user_id integer
  user_name varchar(50) [not null]
  user_email varchar(254) [not null]
  user_url varchar(200) [not null]
  comment text [not null]
  submit_date datetime [default: null, not null]
  ip_address char(39)
  is_public bool [default: true, not null, note: 'Uncheck this box to make the comment effectively disappear from the site.']
  is_removed bool [default: false, not null, note: 'Check this box if the comment is inappropriate. A "This comment has been removed" message will be displayed instead.']

  indexes {
    (content_type_id) [name: 'django_comments_content_type_id_c4afe962']
    (object_pk) [name: 'django_comments_object_pk_7fc98e83']
    (site_id) [name: 'django_comments_site_id_9dcf666e']
    (user_id) [name: 'django_comments_user_id_a0a440a1']
    (submit_date) [name: 'django_comments_submit_date_514ed2d9']
    (is_removed) [name: 'django_comments_is_removed_52a03ae3']
  }

  Note: '''Columns from CommentAbstractModel (abstract): user_id, user_name, user_email, user_url, comment, submit_date, ip_address, is_public, is_removed.

Columns from BaseCommentAbstractModel (abstract): content_type_id, object_pk, site_id.'''
}

Table django_comment_flags {
  id integer [pk, increment]
  user_id integer [not null]
  comment_id integer [not null]
  flag varchar(30) [not null]
  flag_date datetime [default: null, not null]

  indexes {
    (user_id) [name: 'django_comment_flags_user_id_f3f81f0a']
    (comment_id) [name: 'django_comment_flags_comment_id_d8054933']
    (flag) [name: 'django_comment_flags_flag_8b141fcb']
    (user_id, comment_id, flag) [unique, name: 'django_comment_flags_user_id_comment_id_flag_537f77a7_uniq']
  }

  Note: '''Records a flag on a comment. This is intentionally flexible; right now, a
flag could be:

    * A "removal suggestion" -- where a user suggests a comment for (potential) removal.

    * A "moderator deletion" -- used when a moderator deletes a comment.

You can (ab)use this model to add other flags, if needed. However, by
design users are only allowed to flag a comment with a given flag once;
if you want rating look elsewhere.'''
}

Table generic_threadedcomment {
  comment_ptr_id integer [pk, note: 'parent link: a ThreadedComment is a Comment (multi-table inheritance)']
  rating_count integer [default: 0, not null]
  rating_sum integer [default: 0, not null]
  rating_average real [default: 0, not null]
  by_author bool [default: false, not null]
  replied_to_id integer

  indexes {
    (replied_to_id) [name: 'generic_threadedcomment_replied_to_id_d0a08d73']
  }

  Note: '''Extend the ``Comment`` model from ``django_comments`` to
add comment threading. ``Comment`` provides its own site foreign key,
so we can\'t inherit from ``SiteRelated`` in ``mezzanine.core``, and
therefore need to set the site on ``save``. ``CommentManager``
inherits from Mezzanine\'s ``CurrentSiteManager``, so everything else
site related is already provided.'''
}

