Table pages_page {
  id integer [pk, increment]
  keywords_string varchar(500) [not null]
  site_id integer [not null]
  title varchar(500) [not null]
  slug varchar(2000) [not null, note: 'Leave blank to have the URL auto-generated from the title.']
  _meta_title varchar(500) [note: 'Optional title to be used in the HTML title tag. If left blank, the main title field will be used.']
  description text [not null]
  gen_description bool [default: true, not null, note: 'If checked, the description will be automatically generated from content. Uncheck if you want to manually set a custom description.']
  created datetime
  updated datetime
  status PageStatus [default: 2, not null, note: 'With Draft chosen, will only be shown for admin users on the site.']
  publish_date datetime [note: 'With Published chosen, won\'t be shown until this time']
  expiry_date datetime [note: 'With Published chosen, won\'t be shown after this time']
  short_url varchar(200)
  in_sitemap bool [default: true, not null]
  _order integer
  content_model varchar(50)
  parent_id bigint
  in_menus PageInMenus
  titles varchar(1000)
  login_required bool [default: false, not null, note: 'If checked, only logged in users can view this page']

  indexes {
    (site_id) [name: 'pages_page_site_id_47a43e5b']
    (publish_date) [name: 'pages_page_publish_date_eb7c8d46']
    (parent_id) [name: 'pages_page_parent_id_133fa4d3']
  }

  Note: '''A page in the page tree. This is the base class that custom content types
need to subclass.

Columns from Orderable (abstract): _order.

Columns from Displayable (abstract): status, publish_date, expiry_date, short_url, in_sitemap.

Columns from Slugged (abstract): title, slug.

Columns from SiteRelated (abstract): site_id.

Columns from MetaData (abstract): _meta_title, description, gen_description.

Columns from TimeStamped (abstract): created, updated.

Columns from ContentTyped (abstract): content_model.'''
}

