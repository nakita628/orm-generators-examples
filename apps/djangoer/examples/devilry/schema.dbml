  id integer [pk, increment]
  feedbackset_id integer [unique]
  passed_previous_period_type FeedbacksetPassedPreviousPeriodPassedPreviousPeriodType [not null]
  assignment_short_name varchar(20) [default: '', not null, note: 'Up to 20 letters of lowercase english letters (a-z), numbers, underscore ("_") and hyphen ("-"). Used when the name takes too much space.']
  assignment_long_name varchar(100) [default: '', not null]
  assignment_max_points integer [default: 0]
  assignment_passing_grade_min_points integer [default: 0]
  period_short_name varchar(20) [default: '', not null, note: 'Up to 20 letters of lowercase english letters (a-z), numbers, underscore ("_") and hyphen ("-"). Used when the name takes too much space.']
