Table devilry_message_message {
  id integer [pk, increment]
  created_datetime "timestamp with time zone" [note: 'default in Python: now()']
  created_by_id integer [default: null]
  status MessageStatus [default: 'draft', not null]
  status_data jsonb [not null, note: 'default in Python: dict()']
  metadata jsonb [not null, note: 'default in Python: dict()']
  context_type MessageContextType [default: 'other', not null]
  message_type "varchar(30)[]" [not null]
  virtual_message_receivers jsonb [not null, note: 'default in Python: dict()']

  indexes {
    (created_by_id) [name: 'devilry_message_message_created_by_id_a8eedba2']
    (status) [name: 'devilry_message_message_status_a1e70f20']
    (status) [name: 'devilry_message_message_status_a1e70f20_like', note: 'varchar_pattern_ops']
  }

  Note: '''The `Message`-class handles preparing and sending of different messages in the Devilry-system.

This model contains metadata about a message sent to one or multiple users, what type of message it is, the overall
status of the message and creates recipients for the email to be sent.

Notes:
    The actual subject and message-content is stored on each :class:`.MessageReceiver` with a
    foreignkey to this class. The reason for this being that we want to save the subject and content
    in the preferred language of the user.'''
}

Table devilry_message_messagereceiver {
  id integer [pk, increment]
  created_datetime "timestamp with time zone" [note: 'default in Python: now()']
  status MessageReceiverStatus [default: 'not_sent', not null]
  status_data jsonb [not null, note: 'default in Python: dict()']
  metadata jsonb [not null, note: 'default in Python: dict()']
  subject varchar(255) [default: '', not null]
  message_content_plain text [default: '', not null]
  message_content_html text [default: '', not null]
  message_id integer [not null]
  message_type varchar(30) [not null]
  send_to varchar(255) [default: '', not null]
  user_id integer [not null]
  sent_datetime "timestamp with time zone"
  sending_failed_count integer [default: 0, not null]
  sending_success_count integer [default: 0, not null]

  indexes {
    (message_id) [name: 'devilry_message_messagereceiver_message_id_d1452084']
    (message_type) [name: 'devilry_message_messagereceiver_message_type_c7e2d924']
    (message_type) [name: 'devilry_message_messagereceiver_message_type_c7e2d924_like', note: 'varchar_pattern_ops']
    (user_id) [name: 'devilry_message_messagereceiver_user_id_06b01621']
  }

  Note: '''This class represents a single message to a single user.

Contains data about the specific message for a user:
    - ForeignKey to a user.
    - The status of the sending.
    - How many time the message has been successfully and unsuccessfully sent to the user.
    - The subject.
    - The content as both html and plaintext.
    - When the message was successfully sent.

The subject and message-content is stored in the users preferred language when the first
message was created.'''
}

Table devilry_report_devilryreport {
  id integer [pk, increment]
  generated_by_user_id integer [not null]
  created_datetime "timestamp with time zone" [not null, note: 'default in Python: now()']
  started_datetime "timestamp with time zone" [default: null]
  finished_datetime "timestamp with time zone" [default: null]
  generator_type varchar(255) [not null]
  generator_options jsonb [not null, note: 'default in Python: dict()']
  status DevilryReportStatus [default: 'unprocessed', not null]
  status_data jsonb [not null, note: 'default in Python: dict()']
  output_filename varchar(255) [default: '']
  content_type varchar(255) [default: '']
  result bytea [not null]

  indexes {
    (generated_by_user_id) [name: 'devilry_report_devilryreport_generated_by_user_id_4120a74b']
  }

  Note: '''A model representing a report of various data, e.g complete user report.

The model is designed for being updated asynchronously with a continuously
updated status while generating a report. Of course, the a report can also be generated synchronously,
but usually the report generators will perform time-consuming tasks.

Report data is stored as binary data, and is always generated for a specific user.'''
}

