Table core_assignment {
  id integer [pk, increment]
  short_name varchar(20) [not null, note: 'Up to 20 letters of lowercase english letters (a-z), numbers, underscore ("_") and hyphen ("-"). Used when the name takes too much space.']
  long_name varchar(100) [not null]
  gradeform_setup_json text
  parentnode_id integer [not null]
  publishing_time "timestamp with time zone" [not null, note: 'The time when the assignment is to be published (visible to students and examiners).']
  deprecated_field_anonymous boolean [default: false, not null, note: 'Deprecated anonymous field. Will be removed in 3.1.']
  uses_custom_candidate_ids boolean [default: false, not null, note: 'If this is enabled, the assignment does not inherit candidate IDs from the semester, and instead have their own set of candidate IDs only for this assignment.']
  anonymizationmode AssignmentAnonymizationmode [default: 'off', not null]
  students_can_see_points boolean [default: false, not null]
  delivery_types AssignmentDeliveryTypes [default: 0, not null, note: 'This option controls what types of deliveries this assignment accepts. See the Delivery documentation for more info.']
  deadline_handling AssignmentDeadlineHandling [not null, note: 'With HARD deadlines, students will be unable to make deliveries when a deadline has expired. With SOFT deadlines students will be able to make deliveries after the deadline has expired. All deliveries after their deadline are clearly highligted. NOTE: Devilry is designed from the bottom up to gracefully handle SOFT deadlines. Students have to perform an extra confirm-step when adding deliveries after their active deadline, and assignments where the deadline has expired is clearly marked for both students and examiners.. default in Python: get_deadline_handling_default()']
  scale_points_percent integer [default: 100, not null, note: 'Percent to scale points on this assignment by for period overviews. The default is 100, which means no change to the points.']
  first_deadline "timestamp with time zone" [not null]
  max_points integer [default: 1]
  passing_grade_min_points integer [default: 1]
  points_to_grade_mapper AssignmentPointsToGradeMapper [default: 'passed-failed']
  grading_system_plugin_id AssignmentGradingSystemPluginId [default: 'devilry_gradingsystemplugin_approved']
  students_can_create_groups boolean [default: false, not null, note: 'Select this if students should be allowed to join/leave groups. Even if this is not selected, you can still organize your students in groups manually.']
  students_can_not_create_groups_after "timestamp with time zone" [default: null, note: 'Students can not create project groups after this time. Ignored if "Students can create project groups" is not selected.']
  feedback_workflow AssignmentFeedbackWorkflow [default: '', not null]
  examiners_can_self_assign boolean [default: false, not null, note: 'Select this if you want examiners to be able to self-assign to the assignment.']
  examiner_self_assign_limit integer [default: 1, not null, note: 'The max number of examiners that are allowed to self-assign to each project group within the assignment.']

  indexes {
    (short_name) [name: 'core_assignment_short_name_c4ce3028']
    (short_name) [name: 'core_assignment_short_name_c4ce3028_like', note: 'varchar_pattern_ops']
    (long_name) [name: 'core_assignment_long_name_67693a1c']
    (long_name) [name: 'core_assignment_long_name_67693a1c_like', note: 'varchar_pattern_ops']
    (parentnode_id) [name: 'core_assignment_parentnode_id_4d94c25f']
    (anonymizationmode) [name: 'core_assignment_anonymizationmode_1c86bb06']
    (anonymizationmode) [name: 'core_assignment_anonymizationmode_1c86bb06_like', note: 'varchar_pattern_ops']
    (short_name, parentnode_id) [unique, name: 'core_assignment_short_name_parentnode_id_41a7b9eb_uniq']
  }

  Note: '''Data model for an assignment.

.. attribute:: gradeform_setup_json

    A django.db.models.TextField_ for the json representing a blank
    gradeform used for this \'Assignment_\'

.. attribute:: parentnode

    A django.db.models.ForeignKey_ that points to the parent node,
    which is always a `Period`_.

.. attribute:: publishing_time

    A django.db.models.DateTimeField_ representing the publishing time of
    the assignment.

.. attribute:: admins

    A django.db.models.ManyToManyField_ that holds all the admins of the
    Node.

.. attribute:: assignmentgroups

    A set of :class:`assignmentgroups <devilry.apps.core.models.AssignmentGroup>` for this assignment

.. attribute:: scale_points_percent

    Percent to scale points on this assignment by for period overviews. The default is 100,
    which means no change to the points.

.. attribute:: delivery_types

    An integer identifying the type of deliveries allowed. Possible values:

        0
            Electronic deliveries using Devilry
        1
            Non-electronic deliveries, or deliveries made through another
            electronic system.
        2
            An alias/link to a delivery made in another Period.

.. attribute:: deadline_handling

    An integer identifying how deadlines are handled.

        0
            Soft deadlines. Deliveries can be added until groups are closed.
        1
            Hard deadlines. Deliveries can not be added after the deadline
            has expired.

.. attribute:: first_deadline

    A DateTimeField containing an optional first deadline for this
    assignment. This is metadata that the UI can use where it is
    natural.

.. attribute:: max_points

    An IntegerField that contains the maximum number of points possible to achieve on
    this assignment. This field may be ``None``, and it is normally set by the
    grading system plugin.

    DO NOT UPDATE MANUALLY. You can safely set an initial value for this
    manually when you create a new assignment, but when you update this
    field, do so using :meth:`.set_max_points`.

.. attribute:: passing_grade_min_points

    An IntegerField that contains the minimum number of points required to
    achive a passing grade on this assignment. This means that any feedback
    with more this number of points or more is considered a passing grade.

    WARNING: Changing this does not have any effect on existing feedback.
    To actually change existing feedback, you would have to update all
    feedback on the assignment, effectively creating new StaticFeedbacks
    from the latest published FeedbackDrafts for each AssignmentGroup.

.. attribute:: grading_system_plugin_id

    A CharField containing the ID of the grading system plugin this
    assignment uses.


.. attribute:: students_can_create_groups

    BooleanField specifying if students can join/leave groups on
    their own.

    If this is ``True`` students should be allowed to join/leave groups.
    If :attr:`.students_can_not_create_groups_after` is specified, this
    students can not create groups after ``students_can_not_create_groups_after``
    even if this is ``True``.ar 16 2017, 17:45 : This delivery was corrected, and given:

    This does not in any way affect an admins ability to organize students
    in groups manually.

.. attribute:: students_can_not_create_groups_after

    Students can not create project groups after this time. Ignored if
    :attr:`.students_can_create_groups` is ``False``.

    DateTimeField that defaults to ``None`` (null).

.. attribute:: feedback_workflow

    The feedback workflow used on the assignment. A feedback workflow
    defines how examiners and administrators work together to make
    feedback available to students.

    Introduced in :devilryissue:`765`.'''
}

Table core_pointtogrademap {
  id integer [pk, increment]
  assignment_id integer [unique, not null]
  invalid boolean [default: true, not null]

  Note: '''Data structure to store the mapping from a point ranges to grades
when using custom-table.

The basic idea is described in https://github.com/devilry/devilry-django/issues/511,
but we decided to add this OneToOne table to represent a mapping table
to avoid adding complexity to Assignment that is only needed when the
custom-table ``points_to_grade_mapper`` is used.

.. attribute:: assignment

    Foreign Key to the assignment.

.. attribute:: invalid

    This is set to ``True`` when the map has been invalidated because of
    changes to :attr:`devilry.apps.core.models.Assignment.max_points`,
    or when the map has been created, but it is empty.'''
}

Table core_pointrangetograde {
  id integer [pk, increment]
  point_to_grade_map_id integer [not null]
  minimum_points integer [not null]
  maximum_points integer [not null]
  grade varchar(12) [not null]

  indexes {
    (point_to_grade_map_id) [name: 'core_pointrangetograde_point_to_grade_map_id_82a8e56b']
    (point_to_grade_map_id, grade) [unique, name: 'core_pointrangetograde_point_to_grade_map_id_gr_222e49f3_uniq']
  }

  Note: '''Data structure to store the mapping from a single point-range to grade
when using custom-table.

First described in https://github.com/devilry/devilry-django/issues/511.

.. attribute:: point_to_grade_map

    Foreign Key to the PointToGradeMap.

.. attribute:: minimum_points

    Minimum value for points that matches this table entry.

.. attribute:: maximum_points
    Minimum value for points that matches this table entry.

.. attribute:: grade

    The grade that this entry represents a match for.'''
}

Table core_assignmentgroup {
  id integer [pk, increment]
  parentnode_id integer [not null]
  name varchar(30) [default: '', not null, note: 'An optional name for the group. Typically used a project name on project assignments.']
  is_open boolean [default: true, not null, note: 'If this is checked, the group can add deliveries.']
  etag "timestamp with time zone" [not null, note: 'default in Python: now()']
  batchoperation_id integer
  copied_from_id integer
  created_datetime "timestamp with time zone" [not null, note: 'default in Python: now()']
  internal_is_being_deleted boolean [default: false, not null]

  indexes {
    (parentnode_id) [name: 'core_assignmentgroup_parentnode_id_87cccd37']
    (batchoperation_id) [name: 'core_assignmentgroup_batchoperation_id_38d6850d']
    (copied_from_id) [name: 'core_assignmentgroup_copied_from_id_e9b414dc']
  }

  Note: '''Represents a student or a group of students.

.. attribute:: parentnode

    A django.db.models.ForeignKey_ that points to the parent node,
    which is always an Assignment.

.. attribute:: name

    An optional name for the group.

.. attribute:: candidates

    A django ``RelatedManager`` that holds the :class:`candidates <devilry.apps.core.models.Candidate>`
    on this group.

.. attribute:: examiners

    A django.db.models.ManyToManyField_ that holds the examiner(s) that are
    to correct and grade the assignment.

.. attribute:: is_open

    A django.db.models.BooleanField_ that tells you if the group can add
    deliveries or not.

.. attribute:: tags

    A django ``RelatedManager`` that holds the :class:`tags <devilry.apps.core.models.AssignmentGroupTag>`
    on this group.

.. attribute:: etag

   A DateTimeField containing the etag for this object.

.. attribute:: cached_data

    A Django RelatedManager of :class:`cached_data <devilry.devilry_dbcache.models.AssignmentGroupCachedData>` for this AssignmentGroup.

.. attribute:: feedbackset

    A Django RelatedManager :class:`devilry.apps.core.models.FeedbackSet` for this AssignmentGroup

Note:
    Postgres triggers create a :class:`devilry.apps.core.models.FeedbackSet` on INSERT'''
}

