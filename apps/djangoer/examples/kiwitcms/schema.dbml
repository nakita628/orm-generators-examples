}

Table django_comment_flags {
  id integer [pk, increment]
  user_id integer [not null]
  comment_id integer [not null]
  flag varchar(30) [not null]
  flag_date datetime [default: null, not null]

  indexes {
    (user_id) [name: 'django_comment_flags_user_id_f3f81f0a']
    (comment_id) [name: 'django_comment_flags_comment_id_d8054933']
    (flag) [name: 'django_comment_flags_flag_8b141fcb']
    (user_id, comment_id, flag) [unique, name: 'django_comment_flags_user_id_comment_id_flag_537f77a7_uniq']
  }

  Note: '''Records a flag on a comment. This is intentionally flexible; right now, a
flag could be:

    * A "removal suggestion" -- where a user suggests a comment for (potential) removal.

    * A "moderator deletion" -- used when a moderator deletes a comment.

You can (ab)use this model to add other flags, if needed. However, by
design users are only allowed to flag a comment with a given flag once;
if you want rating look elsewhere.'''
}

