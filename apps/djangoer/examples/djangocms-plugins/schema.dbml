  show_file_size bool [default: false, not null, note: 'Appends the file size at the end of the name.']
  attributes text [not null, note: 'default in Python: dict()']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a djangocms_file.Folder is a CMSPlugin (multi-table inheritance)']

  indexes {
    (folder_src_id) [name: 'djangocms_file_folder_folder_src_id_9558406a']
  }

