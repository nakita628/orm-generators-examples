Table djangocms_picture_picture {
  template PictureTemplate [default: 'default', not null]
  picture_id integer
  external_picture varchar(255) [note: 'If provided, overrides the embedded image. Certain options such as cropping are not applicable to external images.']
  width "integer unsigned" [note: 'The image width as number in pixels. Example: "720" and not "720px".']
  height "integer unsigned" [note: 'The image height as number in pixels. Example: "720" and not "720px".']
  alignment PictureAlignment [not null, note: 'Aligns the image according to the selected option.']
  caption_text text [note: 'Provide a description, attribution, copyright or other information.']
  attributes text [not null, note: 'default in Python: dict()']
  link_url varchar(2040) [note: 'Wraps the image in a link to an external URL.']
  link_page_id integer [note: 'Wraps the image in a link to an internal (page) URL.']
  link_target PictureLinkTarget [not null]
  link_attributes text [not null, note: 'default in Python: dict()']
  use_automatic_scaling bool [default: true, not null, note: 'Uses the placeholder dimensions to automatically calculate the size.']
  use_no_cropping bool [default: false, not null, note: 'Outputs the raw image without cropping.']
  use_crop bool [default: false, not null, note: 'Crops the image according to the thumbnail settings provided in the template.']
  use_upscale bool [default: false, not null, note: 'Upscales the image to the size of the thumbnail settings in the template.']
  use_responsive_image PictureUseResponsiveImage [default: 'inherit', not null, note: 'Uses responsive image technique to choose better image to display based upon screen viewport. This configuration only applies to uploaded images (external pictures will not be affected).']
  thumbnail_options_id integer [note: 'Overrides width, height, and crop; scales up to the provided preset dimensions.']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a Picture is a CMSPlugin (multi-table inheritance)']

  indexes {
    (picture_id) [name: 'djangocms_picture_picture_picture_id_f7d6711b']
    (link_page_id) [name: 'djangocms_picture_picture_link_page_id_dbec9beb']
    (thumbnail_options_id) [name: 'djangocms_picture_picture_thumbnail_options_id_59cf80d1']
  }

  Note: '''Columns from AbstractPicture (abstract): template, picture_id, external_picture, width, height, alignment, caption_text, attributes, link_url, link_page_id, link_target, link_attributes, use_automatic_scaling, use_no_cropping, use_crop, use_upscale, use_responsive_image, thumbnail_options_id, cmsplugin_ptr_id.'''
}

Table djangocms_file_file {
  template DjangocmsFileFileTemplate [default: 'default', not null]
  file_src_id integer
  file_name varchar(255) [not null, note: 'Overrides the default file name with the given value.']
  link_target DjangocmsFileFileLinkTarget [default: '', not null]
  link_title varchar(255) [not null]
  show_file_size bool [default: false, not null, note: 'Appends the file size at the end of the name.']
  attributes text [not null, note: 'default in Python: dict()']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a djangocms_file.File is a CMSPlugin (multi-table inheritance)']

  indexes {
    (file_src_id) [name: 'djangocms_file_file_file_src_id_74ac14a5']
  }

  Note: '''Columns from AbstractFile (abstract): template, file_src_id, file_name, link_target, link_title, show_file_size, attributes, cmsplugin_ptr_id.'''
}

Table djangocms_file_folder {
  template DjangocmsFileFolderTemplate [default: 'default', not null]
  folder_src_id integer
