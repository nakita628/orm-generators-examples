}

Table djangocms_video_videoplayer {
  template VideoPlayerTemplate [default: 'default', not null]
  label varchar(255) [not null]
  embed_link text [not null, note: 'Use this field to embed videos from external services such as YouTube, Vimeo or others. Leave it blank to upload video files by adding nested "Source" plugins.']
  parameters text [not null, note: 'Parameters are appended to the video link if provided.. default in Python: dict()']
  poster_id integer
  attributes text [not null, note: 'default in Python: dict()']
  show_controls bool [default: true, not null, note: 'If enabled, the video will be shown with Play, Pause and Seek elements that allow the user to control playback.']
  autoplay bool [default: false, not null, note: 'If enabled, the video will automatically play once the page is loaded. This might not work depending on how the user has configured their browser.']
  cmsplugin_ptr_id integer [pk, note: 'parent link: a VideoPlayer is a CMSPlugin (multi-table inheritance)']

  indexes {
    (poster_id) [name: 'djangocms_video_videoplayer_poster_id_07790e24']
  }

  Note: '''Renders either an Iframe when ``link`` is provided or the HTML5 <video> tag'''
}

Table djangocms_video_videosource {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a VideoSource is a CMSPlugin (multi-table inheritance)']
  source_file_id integer
  text_title varchar(255) [not null]
  text_description text [not null]
  attributes text [not null, note: 'default in Python: dict()']

  indexes {
    (source_file_id) [name: 'djangocms_video_videosource_source_file_id_16f11167']
  }

  Note: '''Renders the HTML <source> element inside of <video>.'''
}

Table djangocms_video_hlsstreamsource {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a HlsStreamSource is a CMSPlugin (multi-table inheritance)']
  hls_source_url varchar(200) [not null]

  Note: '''Renders the HTML <source> element inside of <video> for an HLS stream defined by a .m3u8 URL.'''
}

Table djangocms_video_videotrack {
  cmsplugin_ptr_id integer [pk, note: 'parent link: a VideoTrack is a CMSPlugin (multi-table inheritance)']
  kind VideoTrackKind [not null]
  src_id integer
  srclang varchar(255) [not null, note: 'Examples: "en" or "de" etc.']
  label varchar(255) [not null]
  attributes text [not null, note: 'default in Python: dict()']

  indexes {
    (src_id) [name: 'djangocms_video_videotrack_src_id_e5a015d8']
  }

  Note: '''Renders the HTML <track> element inside <video>.'''
}

