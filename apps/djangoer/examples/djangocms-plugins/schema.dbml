  can_view bool [default: false, not null, note: 'Grants frontend view access. Note: as soon as any user or group is given view access to a page, that page becomes restricted — only users/groups with view access can then see it on the frontend.']
  can_recover_page bool [default: true, not null, note: 'can recover any deleted page']

  indexes {
