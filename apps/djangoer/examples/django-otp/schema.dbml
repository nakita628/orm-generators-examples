    (app_label, model) [unique, name: 'django_content_type_app_label_model_76bd3d3b_uniq']
  }
}

Table django_session {
  session_key varchar(40) [pk]
  session_data text [not null]
  expire_date datetime [not null]

  indexes {
    (expire_date) [name: 'django_session_expire_date_a5c62663']
  }

  Note: '''Django provides full support for anonymous sessions. The session
framework lets you store and retrieve arbitrary data on a
per-site-visitor basis. It stores data on the server side and
abstracts the sending and receiving of cookies. Cookies contain a
session ID -- not the data itself.

The Django sessions framework is entirely cookie-based. It does
not fall back to putting session IDs in URLs. This is an intentional
design decision. Not only does that behavior make URLs ugly, it makes
your site vulnerable to session-ID theft via the "Referer" header.

For complete documentation on using Sessions in your code, consult
the sessions documentation that is shipped with Django (also available
on the Django web site).

Columns from AbstractBaseSession (abstract): session_key, session_data, expire_date.'''
}

Table otp_static_staticdevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed bool [default: true, not null, note: 'Is this device ready for use?']
  throttling_failure_timestamp datetime [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count "integer unsigned" [default: 0, not null, note: 'Number of successive failed attempts.']
  created_at datetime [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at datetime [note: 'The most recent date and time this device was used.']

  indexes {
    (user_id) [name: 'otp_static_staticdevice_user_id_7f9cff2b']
  }

  Note: '''A static :class:`~django_otp.models.Device` simply consists of random
tokens shared by the database and the user.

These are frequently used as emergency tokens in case a user\'s normal
device is lost or unavailable. They can be consumed in any order; each
token will be removed from the database as soon as it is used.

This model has no fields of its own, but serves as a container for
:class:`StaticToken` objects.

.. attribute:: token_set

    The RelatedManager for our tokens.

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table otp_static_statictoken {
  id integer [pk, increment]
  device_id integer [not null]
  token varchar(16) [not null]

  indexes {
    (device_id) [name: 'otp_static_statictoken_device_id_74b7c7d1']
    (token) [name: 'otp_static_statictoken_token_d0a51866']
  }

  Note: '''A single token belonging to a :class:`StaticDevice`.

.. attribute:: device

    *ForeignKey*: A foreign key to :class:`StaticDevice`.

.. attribute:: token

    *CharField*: A random string up to 16 characters.'''
}

Table otp_totp_totpdevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed bool [default: true, not null, note: 'Is this device ready for use?']
  throttling_failure_timestamp datetime [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count "integer unsigned" [default: 0, not null, note: 'Number of successive failed attempts.']
  created_at datetime [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at datetime [note: 'The most recent date and time this device was used.']
  key varchar(80) [not null, note: 'A hex-encoded secret key of up to 40 bytes.. default in Python: default_key()']
  step "smallint unsigned" [default: 30, not null, note: 'The time step in seconds.']
  t0 bigint [default: 0, not null, note: 'The Unix time at which to begin counting steps.']
  digits TOTPDeviceDigits [default: 6, not null, note: 'The number of digits to expect in a token.']
  tolerance "smallint unsigned" [default: 1, not null, note: 'The number of time steps in the past or future to allow.']
  drift smallint [default: 0, not null, note: 'The number of time steps the prover is known to deviate from our clock.']
  last_t bigint [default: -1, not null, note: 'The t value of the latest verified token. The next token must be at a higher time step.']

  indexes {
    (user_id) [name: 'otp_totp_totpdevice_user_id_0fb18292']
  }

  Note: '''A generic TOTP :class:`~django_otp.models.Device`. The model fields mostly
correspond to the arguments to :func:`django_otp.oath.totp`. They all have
sensible defaults, including the key, which is randomly generated.

.. attribute:: key

    *CharField*: A hex-encoded secret key of up to 40 bytes. (Default: 20
    random bytes)

.. attribute:: step

    *PositiveSmallIntegerField*: The time step in seconds. (Default: 30)

.. attribute:: t0

    *BigIntegerField*: The Unix time at which to begin counting steps.
    (Default: 0)

.. attribute:: digits

    *PositiveSmallIntegerField*: The number of digits to expect in a token
    (6 or 8).  (Default: 6)

.. attribute:: tolerance

    *PositiveSmallIntegerField*: The number of time steps in the past or
    future to allow. For example, if this is 1, we\'ll accept any of three
    tokens: the current one, the previous one, and the next one. (Default:
    1)

.. attribute:: drift

    *SmallIntegerField*: The number of time steps the prover is known to
    deviate from our clock.  If :setting:`OTP_TOTP_SYNC` is ``True``, we\'ll
    update this any time we match a token that is not the current one.
    (Default: 0)

.. attribute:: last_t

    *BigIntegerField*: The time step of the last verified token. To avoid
    verifying the same token twice, this will be updated on each successful
    verification. Only tokens at a higher time step will be verified
    subsequently. (Default: -1)

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table otp_hotp_hotpdevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed bool [default: true, not null, note: 'Is this device ready for use?']
  throttling_failure_timestamp datetime [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count "integer unsigned" [default: 0, not null, note: 'Number of successive failed attempts.']
  created_at datetime [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at datetime [note: 'The most recent date and time this device was used.']
  key varchar(80) [not null, note: 'A hex-encoded secret key of up to 40 bytes.. default in Python: default_key()']
  digits HOTPDeviceDigits [default: 6, not null, note: 'The number of digits to expect in a token.']
  tolerance "smallint unsigned" [default: 5, not null, note: 'The number of missed tokens to tolerate.']
  counter bigint [default: 0, not null, note: 'The next counter value to expect.']

  indexes {
    (user_id) [name: 'otp_hotp_hotpdevice_user_id_831afee3']
  }

  Note: '''A generic HOTP :class:`~django_otp.models.Device`. The model fields mostly
correspond to the arguments to :func:`django_otp.oath.hotp`. They all have
sensible defaults, including the key, which is randomly generated.

.. attribute:: key

    *CharField*: A hex-encoded secret key of up to 40 bytes. (Default: 20
    random bytes)

.. attribute:: digits

    *PositiveSmallIntegerField*: The number of digits to expect from the
    token generator (6 or 8). (Default: 6)

.. attribute:: tolerance

    *PositiveSmallIntegerField*: The number of missed tokens to tolerate.
    (Default: 5)

.. attribute:: counter

    *BigIntegerField*: The next counter value to expect. (Initial: 0)

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table otp_email_emaildevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed bool [default: true, not null, note: 'Is this device ready for use?']
  token varchar(16)
  valid_until datetime [not null, note: 'The timestamp of the moment of expiry of the saved token.. default in Python: now()']
  last_generated_timestamp datetime [note: 'The last time a token was generated for this device.']
  throttling_failure_timestamp datetime [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count "integer unsigned" [default: 0, not null, note: 'Number of successive failed attempts.']
  created_at datetime [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at datetime [note: 'The most recent date and time this device was used.']
  email varchar(254) [note: 'Optional alternative email address to send tokens to']

  indexes {
    (user_id) [name: 'otp_email_emaildevice_user_id_0215c274']
  }

  Note: '''A :class:`~django_otp.models.SideChannelDevice` that delivers a token to
the email address saved in this object or alternatively to the user\'s
registered email address (``user.email``).

The tokens are valid for :setting:`OTP_EMAIL_TOKEN_VALIDITY` seconds. Once
a token has been accepted, it is no longer valid.

Note that if you allow users to reset their passwords by email, this may
provide little additional account security. It may still be useful for,
e.g., requiring the user to re-verify their email address on new devices.

.. attribute:: email

    *EmailField*: An alternative email address to send the tokens to.

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from CooldownMixin (abstract): last_generated_timestamp.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from SideChannelDevice (abstract): token, valid_until.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table two_factor_phonedevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed bool [default: true, not null, note: 'Is this device ready for use?']
  throttling_failure_timestamp datetime [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count "integer unsigned" [default: 0, not null, note: 'Number of successive failed attempts.']
  number varchar(128) [not null]
  key varchar(40) [not null, note: 'Hex-encoded secret key. default in Python: random_hex()']
  method PhoneDeviceMethod [not null]

  indexes {
    (user_id) [name: 'two_factor_phonedevice_user_id_54718003']
  }

  Note: '''Model with phone number and token seed linked to a user.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from Device (abstract): user_id, name, confirmed.'''
}

