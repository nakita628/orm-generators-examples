Enum PostVisibility {
  "public"
  "followers"
  "mentioned"
}

Enum MediaKind {
  "image"
  "video"
  "gif"
}

Enum NotificationVerb {
  "followed"
  "liked"
  "replied"
  "mentioned"
  "reposted"
}

Table social_profile {
  user_id integer [pk]
  handle varchar(30) [unique, not null]
  display_name varchar(50) [not null]
  bio varchar(160) [not null]
  avatar varchar(200) [not null]
  is_private bool [default: false, not null]
}

Table social_follow {
  id integer [pk, increment]
  follower_id integer [not null]
  followee_id integer [not null]
  approved bool [default: true, not null, note: 'False while a private profile has not accepted']
  created_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (follower_id) [name: 'social_follow_follower_id_a92b1c63']
    (followee_id) [name: 'social_follow_followee_id_f37e3ad7']
    (follower_id, followee_id) [unique, name: 'follow_once']
  }

  checks {
    `NOT ("follower_id" = ("followee_id"))` [name: 'no_self_follow']
  }
}

Table social_hashtag {
  id integer [pk, increment]
  name varchar(100) [unique, not null]
}

Table social_like {
  id integer [pk, increment]
  profile_id integer [not null]
  content_type_id integer [not null]
  object_id "bigint unsigned" [not null, note: 'target: with content_type_id, a generic foreign key to a row of any model (from Post.likes, Comment.likes)']
  created_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (profile_id) [name: 'social_like_profile_id_48845ebd']
    (content_type_id) [name: 'social_like_content_type_id_41c5dd37']
    (profile_id, content_type_id, object_id) [unique, name: 'like_once']
  }
}

Table social_post {
  id integer [pk, increment]
  author_id integer [not null]
  text varchar(500) [not null]
  reply_to_id bigint
  repost_of_id bigint
  visibility PostVisibility [default: 'public', not null]
  created_at datetime [not null, note: 'default in Python: now()']
  edited_at datetime

  indexes {
    (author_id) [name: 'social_post_author_id_db6459ee']
    (reply_to_id) [name: 'social_post_reply_to_id_450e9a95']
    (repost_of_id) [name: 'social_post_repost_of_id_0c70b976']
    (author_id, created_at) [name: 'post_timeline', note: 'descending: created_at']
  }
}

Table social_media {
  id integer [pk, increment]
  post_id bigint [not null]
  kind MediaKind [not null]
  file varchar(100) [not null]
  alt_text varchar(400) [not null]
  width "integer unsigned"
  height "integer unsigned"
  _order integer [not null]

  indexes {
    (post_id) [name: 'social_media_post_id_8cfab698']
  }
}

Table social_comment {
  id integer [pk, increment]
  post_id bigint [not null]
  author_id integer [not null]
  parent_id bigint
  text text [not null]
  created_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (post_id) [name: 'social_comment_post_id_c5f61de0']
    (author_id) [name: 'social_comment_author_id_efe921df']
    (parent_id) [name: 'social_comment_parent_id_a94a370c']
  }
}

Table social_notification {
  id integer [pk, increment]
  recipient_id integer [not null]
  actor_id integer [not null]
  verb NotificationVerb [not null]
  target_type_id integer
  target_id "bigint unsigned" [note: 'target: with target_type_id, a generic foreign key to a row of any model']
  read_at datetime
  created_at datetime [not null, note: 'default in Python: now()']

  indexes {
    (recipient_id) [name: 'social_notification_recipient_id_392d8c89']
    (actor_id) [name: 'social_notification_actor_id_78e4b611']
    (target_type_id) [name: 'social_notification_target_type_id_ded844a5']
    (recipient_id, created_at) [name: 'notification_inbox', note: 'descending: created_at']
    (recipient_id) [name: 'notification_unread', note: 'where "read_at" IS NULL']
  }
}

Table django_content_type {
  id integer [pk, increment]

  Note: '''Not in these docs: a model of the contenttypes app, shown as far as it is referred to.'''
}

Table auth_user {
  id integer [pk, increment]

  Note: '''Not in these docs: a model of the auth app, shown as far as it is referred to.'''
}

Ref social_profile_user_id_fk: social_profile.user_id - auth_user.id [delete: cascade]

Table social_profile_blocked {
  id integer [pk, increment]
  from_profile_id integer [not null]
  to_profile_id integer [not null]

  indexes {
    (from_profile_id) [name: 'social_profile_blocked_from_profile_id_b8773f9e']
    (to_profile_id) [name: 'social_profile_blocked_to_profile_id_a2c8223d']
    (from_profile_id, to_profile_id) [unique, name: 'social_profile_blocked_from_profile_id_to_profile_id_d5cbd823_uniq']
  }
}

Ref social_profile_blocked_from_profile_id_fk: social_profile_blocked.from_profile_id > social_profile.user_id [delete: cascade]

Ref social_profile_blocked_to_profile_id_fk: social_profile_blocked.to_profile_id > social_profile.user_id [delete: cascade]

Ref social_follow_follower_id_fk: social_follow.follower_id > social_profile.user_id [delete: cascade]

Ref social_follow_followee_id_fk: social_follow.followee_id > social_profile.user_id [delete: cascade]

Ref social_like_profile_id_fk: social_like.profile_id > social_profile.user_id [delete: cascade]

Ref social_like_content_type_id_fk: social_like.content_type_id > django_content_type.id [delete: cascade]

Ref social_post_author_id_fk: social_post.author_id > social_profile.user_id [delete: cascade]

Ref social_post_reply_to_id_fk: social_post.reply_to_id > social_post.id [delete: set null]

Ref social_post_repost_of_id_fk: social_post.repost_of_id > social_post.id [delete: cascade]

Table social_post_hashtags {
  id integer [pk, increment]
  post_id bigint [not null]
  hashtag_id bigint [not null]

  indexes {
    (post_id) [name: 'social_post_hashtags_post_id_806245da']
    (hashtag_id) [name: 'social_post_hashtags_hashtag_id_9837d0aa']
    (post_id, hashtag_id) [unique, name: 'social_post_hashtags_post_id_hashtag_id_e84c0358_uniq']
  }
}

Ref social_post_hashtags_post_id_fk: social_post_hashtags.post_id > social_post.id [delete: cascade]

Ref social_post_hashtags_hashtag_id_fk: social_post_hashtags.hashtag_id > social_hashtag.id [delete: cascade]

Table social_post_mentions {
  id integer [pk, increment]
  post_id bigint [not null]
  profile_id integer [not null]

  indexes {
    (post_id) [name: 'social_post_mentions_post_id_a5dfe4d0']
    (profile_id) [name: 'social_post_mentions_profile_id_9f4b2f7d']
    (post_id, profile_id) [unique, name: 'social_post_mentions_post_id_profile_id_ec44e6d7_uniq']
  }
}

Ref social_post_mentions_post_id_fk: social_post_mentions.post_id > social_post.id [delete: cascade]

Ref social_post_mentions_profile_id_fk: social_post_mentions.profile_id > social_profile.user_id [delete: cascade]

Ref social_media_post_id_fk: social_media.post_id > social_post.id [delete: cascade]

Ref social_comment_post_id_fk: social_comment.post_id > social_post.id [delete: cascade]

Ref social_comment_author_id_fk: social_comment.author_id > social_profile.user_id [delete: cascade]

Ref social_comment_parent_id_fk: social_comment.parent_id > social_comment.id [delete: cascade]

Ref social_notification_recipient_id_fk: social_notification.recipient_id > social_profile.user_id [delete: cascade]

Ref social_notification_actor_id_fk: social_notification.actor_id > social_profile.user_id [delete: cascade]

Ref social_notification_target_type_id_fk: social_notification.target_type_id > django_content_type.id [delete: cascade]
