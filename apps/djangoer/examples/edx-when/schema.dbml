    (location) [name: 'edx_when_contentdate_location_485206ea']
    (policy_id, location, field) [unique, name: 'edx_when_contentdate_policy_id_location_field_a26790ec_uniq']
    (course_id, block_type) [name: 'edx_when_course_block_type_idx']
  }

  Note: '''Ties a DatePolicy to a specific piece of course content. (e.g. a due date for a homework).

.. no_pii:'''
}

Table edx_when_userdate {
  id integer [pk, increment]
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'default in Python: now()']
