.. no_pii:

Columns from TimeStampedModel (abstract): created, modified.'''
}

Table edx_when_contentdate {
  id integer [pk, increment]
  course_id varchar(255) [not null]
  policy_id bigint [not null]
  location varchar(255) [default: null]
  field varchar(255) [default: '', not null]
  active bool [default: true, not null]
  block_type varchar(255)
  assignment_title varchar(255) [default: '', not null]
  course_name varchar(255) [default: '', not null]
  subsection_name varchar(255) [default: '', not null]

  indexes {
