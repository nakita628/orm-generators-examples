Table addons_addon {
  id integer [pk, increment]
  component_id integer
  project_id integer
  category_id integer
  name varchar(100) [not null]
  configuration jsonb [not null, note: 'default in Python: dict()']
  state jsonb [not null, note: 'default in Python: dict()']
  repo_scope boolean [default: false, not null]

  indexes {
    (component_id) [name: 'addons_addon_component_id_87dbd2fc']
    (project_id) [name: 'addons_addon_project_id_d2181050']
    (category_id) [name: 'addons_addon_category_id_99fed34f']
    (repo_scope) [name: 'addons_addon_repo_scope_20c74be8']
  }
}

Table addons_event {
  id integer [pk, increment]
  addon_id integer [not null]
  event AddonEvent [not null]

  indexes {
    (addon_id, event) [unique, name: 'addons_event_addon_id_event_2407a5ef_uniq']
  }
}

Table addons_addonactivitylog {
  id integer [pk, increment]
  addon_id integer [not null]
  component_id integer
  event AddonEvent [not null]
  created "timestamp with time zone" [not null, note: 'default in Python: now()']
  details jsonb [not null, note: 'default in Python: dict()']
  status AddonActivityLogStatus [default: 1, not null]

  indexes {
    (addon_id) [name: 'addons_addonactivitylog_addon_id_44e38f98']
    (component_id) [name: 'addons_addonactivitylog_component_id_baafffdc']
  }
}

Table kotlin_sdk_kotlinsdkcleanup {
  id integer [pk, increment]
  path text [unique, not null]
  build_id integer [unique]

  indexes {
    (path) [name: 'kotlin_sdk_kotlinsdkcleanup_path_eac6eb18_like', note: 'text_pattern_ops']
  }

  Note: '''Internal deletion intent for a retired manifest or uninstalled add-on.'''
}

Table kotlin_sdk_kotlinsdkbuild {
  id integer [pk, increment]
  addon_id integer [not null]
  package_name varchar(127) [not null]
  version_code bigint [not null]
  metadata jsonb [not null, note: 'default in Python: dict()']
  pending_manifest jsonb [not null, note: 'default in Python: dict()']
  digest varchar(64) [not null]
  created "timestamp with time zone" [not null, note: 'default in Python: now()']
  retired "timestamp with time zone"
  status varchar(16) [default: 'pending', not null]
  error text [not null]
  published "timestamp with time zone"

  indexes {
    (addon_id) [name: 'kotlin_sdk_kotlinsdkbuild_addon_id_7ab4618d']
    (addon_id, package_name, version_code) [unique, name: 'kotlin_sdk_build_unique']
  }
}

Table kotlin_sdk_kotlinsdkartifact {
  id integer [pk, increment]
  addon_id integer [not null]
  digest varchar(64) [not null]
  unreferenced "timestamp with time zone"

  indexes {
    (addon_id) [name: 'kotlin_sdk_kotlinsdkartifact_addon_id_ebe8e551']
    (addon_id, digest) [unique, name: 'kotlin_sdk_artifact_unique']
  }
}

Table weblate_auth_permission {
  id integer [pk, increment]
  codename varchar(100) [unique, not null]
  name varchar(200) [not null]

  indexes {
    (codename) [name: 'weblate_auth_permission_codename_b551931f_like', note: 'varchar_pattern_ops']
  }
}

Table weblate_auth_role {
  id integer [pk, increment]
  name varchar(200) [unique, not null]

  indexes {
    (name) [name: 'weblate_auth_role_name_97854f8d_like', note: 'varchar_pattern_ops']
  }
}

Table weblate_auth_group {
  id integer [pk, increment]
  name varchar(150) [not null]
  defining_project_id integer
  defining_workspace_id uuid
  project_selection WeblateAuthGroupProjectSelection [default: 0, not null]
  language_selection WeblateAuthGroupLanguageSelection [default: 0, not null]
  internal boolean [default: false, not null]
  enforced_2fa boolean [default: false, not null, note: 'Requires users to have two-factor authentication configured.']

  indexes {
    (defining_project_id) [name: 'weblate_auth_group_defining_project_id_b2ad81a7']
    (defining_workspace_id) [name: 'weblate_auth_group_defining_workspace_id_84f40bfd']
    (defining_workspace_id, name) [unique, name: 'weblate_auth_group_unique_workspace_name', note: 'where "defining_workspace_id" IS NOT NULL']
  }

  checks {
    `("defining_project_id" IS NULL OR "defining_workspace_id" IS NULL)` [name: 'weblate_auth_group_single_definition']
  }
}

Table weblate_auth_user_groups {
  id integer [pk, increment]
  user_id integer [not null]
  group_id integer [not null]

  indexes {
    (user_id) [name: 'weblate_auth_user_groups_user_id_37e61ff1']
    (group_id) [name: 'weblate_auth_user_groups_group_id_48c0a977']
    (user_id, group_id) [unique, name: 'weblate_auth_user_groups_user_id_group_id_16cfc05b_uniq']
  }
}

Table weblate_auth_user {
  id integer [pk, increment]
  password varchar(128) [not null]
  last_login "timestamp with time zone"
  username varchar(150) [unique, not null, note: 'Username may only contain letters, numbers or the following characters: @ . + - _']
  full_name varchar(150) [not null]
  email varchar(190) [unique]
  is_superuser boolean [default: false, not null, note: 'User has all possible permissions.']
  is_active boolean [default: true, not null, note: 'Mark user as inactive instead of removing.']
  is_bot boolean [default: false, not null]
  date_expires "timestamp with time zone" [default: null, note: 'The account will be disabled after the expiry.']
  date_joined "timestamp with time zone" [not null, note: 'default in Python: now()']

  indexes {
    (username) [name: 'weblate_auth_user_username_d226e4a0_like', note: 'varchar_pattern_ops']
    (email) [name: 'weblate_auth_user_email_aaabd769_like', note: 'varchar_pattern_ops']
    (is_bot) [name: 'weblate_auth_user_is_bot_f4b1c6fb']
    (`UPPER("username")`) [unique, name: 'weblate_auth_user_username_ci']
    (`LOWER(("email") COLLATE "C")`) [unique, name: 'weblate_auth_user_email_ci']
  }

  Note: '''Columns from AbstractBaseUser (abstract): password, last_login.'''
}

Table weblate_auth_autogroup {
  id integer [pk, increment]
  match varchar(200) [default: '^$', not null, note: 'Users with e-mail addresses found to match will be added to this team.']
  group_id integer [not null]

  indexes {
    (group_id) [name: 'weblate_auth_autogroup_group_id_37b7ff0b']
  }
}

Table weblate_auth_userblock {
  id integer [pk, increment]
  user_id integer [not null]
  project_id integer [not null]
  expiry "timestamp with time zone"
  note text [not null, note: 'Internal notes regarding blocking the user that are not visible to the user.']

  indexes {
    (project_id) [name: 'weblate_auth_userblock_project_id_44aae0be']
    (user_id, project_id) [unique, name: 'weblate_auth_userblock_user_id_project_id_7e74a707_uniq']
  }
}

Table weblate_auth_invitation {
  uuid uuid [pk, note: 'default in Python: uuid4()']
  backup_authorship boolean [default: false, not null]
  timestamp "timestamp with time zone" [not null, note: 'default in Python: now()']
  author_id integer [not null]
  user_id integer [note: 'Please type in an existing Weblate account name or e-mail address.']
  username varchar(150) [not null, note: 'Suggest username for the user. It can be changed later.']
  full_name varchar(150) [not null, note: 'Suggest full name for the user. It can be changed later.']
  group_id integer [not null, note: 'The user is granted all permissions included in membership of these teams.']
  email varchar(190) [not null]
  automatic boolean [default: false, not null]
  team_admin boolean [default: false, not null]
  is_superuser boolean [default: false, not null, note: 'User has all possible permissions.']

  indexes {
    (author_id) [name: 'weblate_auth_invitation_author_id_a713ef92']
    (user_id) [name: 'weblate_auth_invitation_user_id_6a0c6dec']
    (group_id) [name: 'weblate_auth_invitation_group_id_07a52aff']
  }

  Note: '''User invitation store.

Either user or e-mail attribute is set, this is to invite current and new users.'''
}

Table checks_check {
  id integer [pk, increment]
  unit_id integer [not null]
  name CheckName [not null]
  dismissed boolean [default: false, not null]
  metadata jsonb [not null, note: 'default in Python: dict()']

  indexes {
    (dismissed) [name: 'checks_check_dismissed_a11836a3']
    (unit_id, name) [unique, name: 'checks_check_unit_id_name_ea73a317_uniq']
    (unit_id) [name: 'checks_active_unit_idx', note: 'where NOT "dismissed"']
  }
}

Table machinery_machineryinstallation {
  id integer [pk, increment]
  engine varchar(100) [not null]
  slug varchar(100) [not null]
  configuration jsonb [not null, note: 'default in Python: dict()']
  enabled boolean [default: true, not null]
  workspace_id uuid
  project_id integer

  indexes {
    (slug) [name: 'machinery_machineryinstallation_slug_620b370d']
    (slug) [name: 'machinery_machineryinstallation_slug_620b370d_like', note: 'varchar_pattern_ops']
    (workspace_id) [name: 'machinery_machineryinstallation_workspace_id_071d1875']
    (project_id) [name: 'machinery_machineryinstallation_project_id_7821aa7d']
    (slug) [unique, name: 'machinery_site_slug', note: 'where ("project_id" IS NULL AND "slug" > \'\' AND "workspace_id" IS NULL)']
    (workspace_id, slug) [unique, name: 'machinery_workspace_slug', note: 'where ("slug" > \'\' AND "workspace_id" IS NOT NULL)']
    (project_id, slug) [unique, name: 'machinery_project_slug', note: 'where ("project_id" IS NOT NULL AND "slug" > \'\')']
  }

  checks {
    `("workspace_id" IS NULL OR "project_id" IS NULL)` [name: 'machinery_one_scope']
  }

  Note: '''One configured instance of a translation service.'''
}

Table machinery_machineryerror {
  id integer [pk, increment]
  installation_id integer [not null]
  timestamp "timestamp with time zone" [not null, note: 'default in Python: now()']
  error text [not null]

  indexes {
    (installation_id) [name: 'machinery_machineryerror_installation_id_721886a4']
    (timestamp) [name: 'machinery_machineryerror_timestamp_07d8c763']
    (installation_id, timestamp, id) [name: 'machinery_m_install_ec7c4c_idx', note: 'descending: timestamp, id']
  }

  Note: '''An operational error belonging to one translation service installation.'''
}

Table machinery_machineryexclusion {
  id integer [pk, increment]
  workspace_id uuid
  project_id integer
  installation_id integer
  engine varchar(100) [not null]

  indexes {
    (workspace_id) [name: 'machinery_machineryexclusion_workspace_id_7aa4f8fd']
    (project_id) [name: 'machinery_machineryexclusion_project_id_d1dfc73d']
    (installation_id) [name: 'machinery_machineryexclusion_installation_id_f938fc8b']
    (workspace_id, installation_id) [unique, name: 'machinery_workspace_installation_exclusion']
    (project_id, installation_id) [unique, name: 'machinery_project_installation_exclusion']
    (workspace_id, engine) [unique, name: 'machinery_workspace_engine_exclusion', note: 'where NOT ("engine" = \'\')']
    (project_id, engine) [unique, name: 'machinery_project_engine_exclusion', note: 'where NOT ("engine" = \'\')']
  }

  checks {
    `(("workspace_id" IS NULL AND "project_id" IS NOT NULL) OR ("workspace_id" IS NOT NULL AND "project_id" IS NULL))` [name: 'machinery_exclusion_one_scope']
    `(("installation_id" IS NULL AND NOT ("engine" = '')) OR ("installation_id" IS NOT NULL AND "engine" = ''))` [name: 'machinery_exclusion_one_target']
  }

  Note: '''Hide inherited installations at a workspace or project scope.'''
}

Table workspaces_workspace {
  id uuid [pk, note: 'default in Python: uuid4()']
  metric_id integer [unique, default: `((nextval('workspaces_workspace_metric_id_seq'::regclass)))`, not null]
  name varchar(100) [not null, note: 'Display name']
  propagation_scope WorkspacePropagationScope [default: 'project', not null, note: 'Where translations of matching strings are propagated.']
  name_managed boolean [default: false, not null, note: 'Whether Weblate can update the name automatically.']
  use_workspace_tm boolean [default: false, not null, note: 'Uses the pool of shared translations between projects in this workspace.']
  contribute_workspace_tm boolean [default: false, not null, note: 'Contributes translations to the pool shared between projects in this workspace.']
  license WorkspaceLicense [default: '', not null]
  agreement text [default: '', not null, note: 'Contributor license agreement which needs to be approved before a user can translate components in this workspace.']
  new_lang WorkspaceNewLang [default: 'add', not null, note: 'How to handle requests for creating new translations.']
  language_code_style WorkspaceLanguageCodeStyle [default: '', not null, note: 'Customize language code used to generate the filename for translations created by Weblate.']
  secondary_language_id integer [default: null, note: 'Additional language to show together with the source language while translating.']
  check_flags text [default: '', not null, note: 'Additional comma-separated flags to influence Weblate behavior.']
  enforced_checks jsonb [not null, note: 'List of checks which can not be dismissed.. default in Python: list()']
  inherit_enforced_checks boolean [default: true, not null, note: 'Use enforced checks from the workspace.']
  commit_message text [default: 'chore(l10n): update {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nProgress: {{ stats.translated_percent }}% ({{ stats.translated }} of {{ stats.all }} strings)\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  add_message text [default: 'chore(l10n): add {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  delete_message text [default: 'chore(l10n): remove {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  merge_message text [default: 'chore(l10n): merge remote changes\\n\\nTranslation: {{ component_full_name }}\\nRemote-Branch: {{ component_remote_branch }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  addon_message text [default: 'chore(l10n): update translation files\\n\\nAdd-on: {{ addon_name }}\\nTranslation: {{ component_full_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  pull_message text [default: 'chore(l10n): update translations\\n\\nTranslations updated in [{{ site_title }}]({{ site_url }}) for [{{ component_full_name }}]({{ url }}).\\n\\n{% if component_linked_children %}\\nIncluded components:\\n{% for linked in component_linked_children %}\\n* [{{ linked.full_name }}]({{ linked.url }})\\n{% endfor %}\\n{% endif %}\\n\\nTranslation status:\\n\\n![Weblate translation status]({{widget_url}})\\n', not null, note: 'You can use template language for various info, please consult the documentation for more details.']

  indexes {
    (secondary_language_id) [name: 'workspaces_workspace_secondary_language_id_b8ff77e6']
  }
}

Table trans_contributoragreement {
  id integer [pk, increment]
  user_id integer [not null]
  component_id integer
  project_id integer
  category_id integer
  workspace_id uuid
  timestamp "timestamp with time zone" [not null, note: 'default in Python: now()']

  indexes {
    (component_id) [name: 'trans_contributoragreement_component_id_31bafbef']
    (project_id) [name: 'trans_contributoragreement_project_id_5761269c']
    (category_id) [name: 'trans_contributoragreement_category_id_16151d5d']
    (workspace_id) [name: 'trans_contributoragreement_workspace_id_34926ae5']
    (user_id, component_id) [unique, name: 'contributor_agreement_unique_component', note: 'where "component_id" IS NOT NULL']
    (user_id, project_id) [unique, name: 'contributor_agreement_unique_project', note: 'where "project_id" IS NOT NULL']
    (user_id, category_id) [unique, name: 'contributor_agreement_unique_category', note: 'where "category_id" IS NOT NULL']
    (user_id, workspace_id) [unique, name: 'contributor_agreement_unique_workspace', note: 'where "workspace_id" IS NOT NULL']
  }

  checks {
    `(("component_id" IS NOT NULL AND "project_id" IS NULL AND "category_id" IS NULL AND "workspace_id" IS NULL) OR ("component_id" IS NULL AND "project_id" IS NOT NULL AND "category_id" IS NULL AND "workspace_id" IS NULL) OR ("component_id" IS NULL AND "project_id" IS NULL AND "category_id" IS NOT NULL AND "workspace_id" IS NULL) OR ("component_id" IS NULL AND "project_id" IS NULL AND "category_id" IS NULL AND "workspace_id" IS NOT NULL))` [name: 'contributor_agreement_single_scope']
  }
}

Table trans_alert {
  id integer [pk, increment]
  component_id integer [not null]
  timestamp "timestamp with time zone" [not null, note: 'default in Python: now()']
  updated "timestamp with time zone" [not null, note: 'default in Python: now()']
  name varchar(150) [not null]
  dismissed_at "timestamp with time zone"
  dismissed_by_id integer
  dismissal_reason varchar(500) [not null]
  dismissal_fingerprint varchar(64) [not null]
  severity AlertSeverity [default: 100, not null]
  details jsonb [not null, note: 'default in Python: dict()']

  indexes {
