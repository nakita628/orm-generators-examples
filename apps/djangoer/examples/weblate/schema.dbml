  vcs ComponentVcs [default: 'git', not null, note: 'Version control system to use to access your repository containing translations. You can also choose additional integration with third party providers to submit pull/merge requests.']
  vcs_params jsonb [not null, note: 'default in Python: dict()']
  repo varchar(300) [not null, note: 'URL of a repository, use weblate://project/component to share it with other component.']
  linked_component_id integer
  push varchar(300) [not null, note: 'URL of a push repository, pushing is turned off if empty. When using pull/merge requests, keep empty to fork the repository.']
  repoweb varchar(200) [not null, note: 'Link to repository browser, use {{branch}} for branch, {{filename}} and {{line}} as filename and line placeholders. You might want to strip leading directory by using {{filename|parentdir}}.']
  repoweb_translations varchar(200) [not null, note: 'Link to repository browser for translation files, use {{branch}} for branch, {{filename}} and {{line}} as filename and line placeholders. If left empty, the Repository browser above will be used. You might want to strip leading directory by using {{filename|parentdir}}.']
  git_export varchar(220) [not null, note: 'URL of repository where users can fetch changes from Weblate']
  report_source_bugs varchar(190) [not null, note: 'E-mail address for reports on errors in source strings. Leave empty for no e-mails.']
  branch varchar(200) [default: '', not null, note: 'Repository branch to translate']
  push_branch varchar(200) [default: '', not null, note: 'Branch for pushing changes. Leave empty to use repository branch when pushing directly to the repository. When using pull/merge requests, specify a branch name different from the repository branch.']
  filemask varchar(400) [not null, note: 'Path of files to translate relative to repository root, use * instead of language code, for example: po/*.po or locale/*/LC_MESSAGES/django.po.']
  screenshot_filemask varchar(400) [not null, note: 'Path of screenshots relative to repository root, for example: docs/screenshots/*.png.']
  template varchar(400) [not null, note: 'Filename of translation base file, containing all strings and their source for monolingual translations.']
  edit_template boolean [default: true, not null, note: 'Whether users will be able to edit the base file for monolingual translations.']
  intermediate varchar(400) [not null, note: 'Filename of intermediate translation file. In most cases this is a translation file provided by developers and is used when creating actual source strings.']
  new_base varchar(400) [not null, note: 'Filename of file used for creating new translations. For gettext choose .pot file.']
  file_format ComponentFileFormat [not null]
  file_format_params jsonb [not null, note: 'default in Python: dict()']
  locked boolean [default: false, not null, note: 'Locked component will not get any translation updates.']
  hide_glossary_matches boolean [default: false, not null, note: 'Hides the glossary panel in the translation editor.']
  allow_translation_propagation boolean [default: true, not null, note: 'Whether translation updates in other components will cause automatic translation in this one']
  contribute_project_tm boolean [default: true, not null, note: 'Allow this component\'s translations to be added to the project-level translation memory.']
  enable_suggestions boolean [default: true, not null, note: 'Whether to allow translation suggestions at all.']
  suggestion_voting boolean [default: false, not null, note: 'Allows users to vote on suggestions.']
  suggestion_autoaccept smallint [default: 0, not null, note: 'Automatically accept suggestions with this number of votes, use 0 to turn it off.']
  check_flags text [default: '', not null, note: 'Additional comma-separated flags to influence Weblate behavior.']
  enforced_checks jsonb [not null, note: 'List of checks which can not be dismissed.. default in Python: list()']
  inherit_enforced_checks boolean [default: true, not null, note: 'Use enforced checks from the project, category or workspace.']
  license ComponentLicense [default: '', not null]
  inherit_license boolean [default: true, not null, note: 'Use the translation license configured in the category or project.']
  agreement text [default: '', not null, note: 'Contributor license agreement which needs to be approved before a user can translate this component.']
  inherit_agreement boolean [default: true, not null, note: 'Use the contributor license agreement configured in the category or project.']
  new_lang ComponentNewLang [default: 'add', not null, note: 'How to handle requests for creating new translations.']
  inherit_new_lang boolean [default: true, not null, note: 'Use the adding new translations setting configured in the category or project.']
  language_code_style ComponentLanguageCodeStyle [default: '', not null, note: 'Customize language code used to generate the filename for translations created by Weblate.']
  inherit_language_code_style boolean [default: true, not null, note: 'Use the language code style configured in the category or project.']
  manage_units boolean [default: false, not null, note: 'Enables adding, removing, and editing source strings and keys in Weblate. If your strings are extracted from the source code or managed externally you probably want to keep it disabled.']
  merge_style ComponentMergeStyle [default: 'rebase', not null, note: 'Define whether Weblate should merge the upstream repository or rebase changes onto it.']
  commit_message text [default: 'chore(l10n): update {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nProgress: {{ stats.translated_percent }}% ({{ stats.translated }} of {{ stats.all }} strings)\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_commit_message boolean [default: true, not null, note: 'Use the commit message when translating configured in the category or project.']
  add_message text [default: 'chore(l10n): add {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_add_message boolean [default: true, not null, note: 'Use the commit message when adding translation configured in the category or project.']
  delete_message text [default: 'chore(l10n): remove {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_delete_message boolean [default: true, not null, note: 'Use the commit message when removing translation configured in the category or project.']
  merge_message text [default: 'chore(l10n): merge remote changes\\n\\nTranslation: {{ component_full_name }}\\nRemote-Branch: {{ component_remote_branch }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_merge_message boolean [default: true, not null, note: 'Use the commit message when merging translation configured in the category or project.']
  addon_message text [default: 'chore(l10n): update translation files\\n\\nAdd-on: {{ addon_name }}\\nTranslation: {{ component_full_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_addon_message boolean [default: true, not null, note: 'Use the commit message when add-on makes a change configured in the category or project.']
  pull_message text [default: 'chore(l10n): update translations\\n\\nTranslations updated in [{{ site_title }}]({{ site_url }}) for [{{ component_full_name }}]({{ url }}).\\n\\n{% if component_linked_children %}\\nIncluded components:\\n{% for linked in component_linked_children %}\\n* [{{ linked.full_name }}]({{ linked.url }})\\n{% endfor %}\\n{% endif %}\\n\\nTranslation status:\\n\\n![Weblate translation status]({{widget_url}})\\n', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_pull_message boolean [default: true, not null, note: 'Use the merge request message configured in the category or project.']
  push_on_commit boolean [default: true, not null, note: 'Whether the repository should be pushed upstream on every commit.']
  push_on_update boolean [default: true, not null, note: 'Whether the repository should be pushed upstream after updating it, even when the update did not commit any translations. When turned off, commits made by the update are pushed with the next translation commit.']
  commit_pending_age smallint [default: 24, not null, note: 'Time in hours after which any pending changes will be committed to the VCS.']
  auto_lock_error boolean [default: true, not null, note: 'Whether the component should be locked on repository errors.']
  source_language_id integer [not null, note: 'Language used for source strings in all components. default in Python: get_default_lang()']
  language_regex varchar(500) [default: '^[^.]+$', not null, note: 'Regular expression used to filter translation files when scanning for file mask.']
  variant_regex varchar(190) [default: '', not null, note: 'Regular expression used to determine variants of a string.']
  priority ComponentPriority [default: 100, not null, note: 'Components with higher priority are offered first to translators.']
  restricted boolean [default: false, not null, note: 'Restrict access to the component to only those explicitly given permission.']
  is_glossary boolean [default: false, not null, note: 'Glossaries are different from regular translations but help keep track of and share consistent terminology.']
  glossary_color ColorChoices [default: 'silver', not null]
  remote_revision varchar(200) [default: '', not null]
  local_revision varchar(200) [default: '', not null]
  processed_revision varchar(200) [default: '', not null]
  pull_request_url varchar(2048) [default: '', not null]
  key_filter varchar(500) [default: '', not null, note: 'Regular expression used to filter keys. This is only available for monolingual formats.']
  secondary_language_id integer [default: null, note: 'Additional language to show together with the source language while translating. This setting is inherited from the project if left empty.']
  inherit_secondary_language boolean [default: true, not null, note: 'Use the secondary language configured in the category or project.']

  indexes {
    (slug) [name: 'trans_component_slug_5bd48be1']
    (slug) [name: 'trans_component_slug_5bd48be1_like', note: 'varchar_pattern_ops']
    (category_id) [name: 'trans_component_category_id_7c9c5306']
    (linked_component_id) [name: 'trans_component_linked_component_id_82b0de9e']
    (source_language_id) [name: 'trans_component_source_language_id_2610b49e']
    (restricted) [name: 'trans_component_restricted_ec682d06']
    (is_glossary) [name: 'trans_component_is_glossary_b4b922b7']
    (secondary_language_id) [name: 'trans_component_secondary_language_id_496a8d45']
    (project_id, category_id, slug) [unique, name: 'component_slug_unique', note: 'nulls not distinct']
    (project_id, category_id, name) [unique, name: 'component_name_unique', note: 'nulls not distinct']
    (project_id, allow_translation_propagation) [name: 'trans_compo_project_d044e1_idx']
    (repo, branch) [name: 'trans_comp_repo_branch_idx']
  }
}

