Table django_celery_beat_solarschedule {
  id integer [pk, increment]
  event SolarScheduleEvent [not null, note: 'The type of solar event when the job should run']
  latitude "numeric(9, 6)" [not null, note: 'Run the task when the event happens at this latitude']
  longitude "numeric(9, 6)" [not null, note: 'Run the task when the event happens at this longitude']

  indexes {
    (event, latitude, longitude) [unique, name: 'django_celery_beat_solar_event_latitude_longitude_ba64999a_uniq']
  }

  Note: '''Schedule following astronomical patterns.

Example: to run every sunrise in New York City:

>>> event=\'sunrise\', latitude=40.7128, longitude=74.0060'''
}

Table django_celery_beat_intervalschedule {
  id integer [pk, increment]
