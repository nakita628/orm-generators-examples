Table trans_category {
  id integer [pk, increment]
  name varchar(100) [not null, note: 'Display name']
  slug varchar(100) [not null, note: 'Name used in URLs and filenames.']
  project_id integer [not null]
  category_id integer
  check_flags text [default: '', not null, note: 'Additional comma-separated flags to influence Weblate behavior.']
  enforced_checks jsonb [not null, note: 'List of checks which can not be dismissed.. default in Python: list()']
  inherit_enforced_checks boolean [default: true, not null, note: 'Use enforced checks from the parent category, project or workspace.']
  license CategoryLicense [default: '', not null]
  inherit_license boolean [default: true, not null, note: 'Use the translation license configured in the parent category or project.']
  agreement text [default: '', not null, note: 'Contributor license agreement which needs to be approved before a user can translate components in this category.']
  inherit_agreement boolean [default: true, not null, note: 'Use the contributor license agreement configured in the parent category or project.']
  new_lang CategoryNewLang [default: 'add', not null, note: 'How to handle requests for creating new translations.']
  inherit_new_lang boolean [default: true, not null, note: 'Use the adding new translations setting configured in the parent category or project.']
  language_code_style CategoryLanguageCodeStyle [default: '', not null, note: 'Customize language code used to generate the filename for translations created by Weblate.']
  inherit_language_code_style boolean [default: true, not null, note: 'Use the language code style configured in the parent category or project.']
  secondary_language_id integer [default: null, note: 'Additional language to show together with the source language while translating.']
  inherit_secondary_language boolean [default: true, not null, note: 'Use the secondary language configured in the parent category or project.']
  commit_message text [default: 'chore(l10n): update {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nProgress: {{ stats.translated_percent }}% ({{ stats.translated }} of {{ stats.all }} strings)\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_commit_message boolean [default: true, not null, note: 'Use the commit message when translating configured in the parent category or project.']
  add_message text [default: 'chore(l10n): add {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_add_message boolean [default: true, not null, note: 'Use the commit message when adding translation configured in the parent category or project.']
  delete_message text [default: 'chore(l10n): remove {{ language_name }} translation\\n\\nTranslation: {{ component_full_name }}\\nLanguage: {{ language_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_delete_message boolean [default: true, not null, note: 'Use the commit message when removing translation configured in the parent category or project.']
  merge_message text [default: 'chore(l10n): merge remote changes\\n\\nTranslation: {{ component_full_name }}\\nRemote-Branch: {{ component_remote_branch }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_merge_message boolean [default: true, not null, note: 'Use the commit message when merging translation configured in the parent category or project.']
  addon_message text [default: 'chore(l10n): update translation files\\n\\nAdd-on: {{ addon_name }}\\nTranslation: {{ component_full_name }}\\nTranslate-URL: {{ url }}', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_addon_message boolean [default: true, not null, note: 'Use the commit message when add-on makes a change configured in the parent category or project.']
  pull_message text [default: 'chore(l10n): update translations\\n\\nTranslations updated in [{{ site_title }}]({{ site_url }}) for [{{ component_full_name }}]({{ url }}).\\n\\n{% if component_linked_children %}\\nIncluded components:\\n{% for linked in component_linked_children %}\\n* [{{ linked.full_name }}]({{ linked.url }})\\n{% endfor %}\\n{% endif %}\\n\\nTranslation status:\\n\\n![Weblate translation status]({{widget_url}})\\n', not null, note: 'You can use template language for various info, please consult the documentation for more details.']
  inherit_pull_message boolean [default: true, not null, note: 'Use the merge request message configured in the parent category or project.']

  indexes {
    (slug) [name: 'trans_category_slug_52f13beb']
    (slug) [name: 'trans_category_slug_52f13beb_like', note: 'varchar_pattern_ops']
    (project_id) [name: 'trans_category_project_id_7dc717ed']
    (category_id) [name: 'trans_category_category_id_0f21e824']
    (secondary_language_id) [name: 'trans_category_secondary_language_id_3b074b19']
    (project_id, category_id, slug) [unique, name: 'category_slug_unique', note: 'nulls not distinct']
    (project_id, category_id, name) [unique, name: 'category_name_unique', note: 'nulls not distinct']
  }
}

Table trans_project {
  id integer [pk, increment]
  name varchar(60) [unique, not null, note: 'Display name']
  slug varchar(60) [unique, not null, note: 'Name used in URLs and filenames.']
  web varchar(200) [not null, note: 'Main website of translated project.']
  instructions text [not null, note: 'You can use Markdown and mention users by @username.']
  workspace_id uuid [note: 'Workspace this project belongs to. Standalone projects do not need one.']
  use_shared_tm boolean [default: true, not null, note: 'Uses the pool of shared translations between projects.']
  contribute_shared_tm boolean [default: true, not null, note: 'Publishes source strings, translations, and project and component origin to the global shared translation memory. Project access control does not restrict this shared data.']
  use_workspace_tm boolean [default: false, not null, note: 'Uses the pool of shared translations between projects in the workspace.']
  contribute_workspace_tm boolean [default: false, not null, note: 'Contributes translations to the pool shared between projects in the workspace.']
