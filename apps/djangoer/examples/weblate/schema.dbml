}

Table django_celery_beat_crontabschedule {
  id integer [pk, increment]
  minute varchar(240) [default: '*', not null, note: 'Cron Minutes to Run. Use "*" for "all". (Example: "0,30")']
  hour varchar(96) [default: '*', not null, note: 'Cron Hours to Run. Use "*" for "all". (Example: "8,20")']
  day_of_month varchar(124) [default: '*', not null, note: 'Cron Days Of The Month to Run. Use "*" for "all". (Example: "1,15")']
  month_of_year varchar(64) [default: '*', not null, note: 'Cron Months (1-12) Of The Year to Run. Use "*" for "all". (Example: "1,12")']
  day_of_week varchar(64) [default: '*', not null, note: 'Cron Days Of The Week to Run. Use "*" for "all", Sunday is 0 or 7, Monday is 1. (Example: "0,5")']
  timezone CrontabScheduleTimezone [not null, note: 'Timezone to Run the Cron Schedule on. Default is UTC.. default in Python: crontab_schedule_celery_timezone()']

  Note: '''Timezone Aware Crontab-like schedule.

Example:  Run every hour at 0 minutes for days of month 10-15:

>>> minute="0", hour="*", day_of_week="*",
... day_of_month="10-15", month_of_year="*"'''
}

Table django_celery_beat_periodictasks {
  ident smallint [pk, default: 1]
  last_update "timestamp with time zone" [not null]

  Note: '''Helper table for tracking updates to periodic tasks.

This stores a single row with ``ident=1``. ``last_update`` is updated via
signals whenever anything changes in the :class:`~.PeriodicTask` model.
Basically this acts like a DB data audit trigger.
Doing this so we also track deletions, and not just insert/update.'''
}

Table django_celery_beat_periodictask {
  id integer [pk, increment]
  name varchar(200) [unique, not null, note: 'Short Description For This Task']
  task varchar(200) [not null, note: 'The Name of the Celery Task that Should be Run.  (Example: "proj.tasks.import_contacts")']
  interval_id integer [note: 'Interval Schedule to run the task on.  Set only one schedule type, leave the others null.']
  crontab_id integer [note: 'Crontab Schedule to run the task on.  Set only one schedule type, leave the others null.']
  solar_id integer [note: 'Solar Schedule to run the task on.  Set only one schedule type, leave the others null.']
  clocked_id integer [note: 'Clocked Schedule to run the task on.  Set only one schedule type, leave the others null.']
  args text [default: '[]', not null, note: 'JSON encoded positional arguments (Example: ["arg1", "arg2"])']
  kwargs text [default: '{}', not null, note: 'JSON encoded keyword arguments (Example: {"argument": "value"})']
  queue varchar(200) [default: null, note: 'Queue defined in CELERY_TASK_QUEUES. Leave None for default queuing.']
  exchange varchar(200) [default: null, note: 'Override Exchange for low-level AMQP routing']
  routing_key varchar(200) [default: null, note: 'Override Routing Key for low-level AMQP routing']
  headers text [default: '{}', not null, note: 'JSON encoded message headers for the AMQP message.']
  priority integer [default: null, note: 'Priority Number between 0 and 255. Supported by: RabbitMQ, Redis (priority reversed, 0 is highest).']
  expires "timestamp with time zone" [note: 'Datetime after which the schedule will no longer trigger the task to run']
  expire_seconds integer [note: 'Timedelta with seconds which the schedule will no longer trigger the task to run']
  one_off boolean [default: false, not null, note: 'If True, the schedule will only run the task a single time']
  start_time "timestamp with time zone" [note: 'Datetime when the schedule should begin triggering the task to run']
  enabled boolean [default: true, not null, note: 'Set to False to disable the schedule']
  last_run_at "timestamp with time zone" [note: 'Datetime that the schedule last triggered the task to run. Reset to None if enabled is set to False.']
  total_run_count integer [default: 0, not null, note: 'Running count of how many times the schedule has triggered the task']
  date_changed "timestamp with time zone" [not null, note: 'Datetime that this PeriodicTask was last modified. default in Python: now()']
  description text [not null, note: 'Detailed description about the details of this Periodic Task']

  indexes {
    (name) [name: 'django_celery_beat_periodictask_name_265a36b7_like', note: 'varchar_pattern_ops']
    (interval_id) [name: 'django_celery_beat_periodictask_interval_id_a8ca27da']
    (crontab_id) [name: 'django_celery_beat_periodictask_crontab_id_d3cba168']
    (solar_id) [name: 'django_celery_beat_periodictask_solar_id_a87ce72c']
    (clocked_id) [name: 'django_celery_beat_periodictask_clocked_id_47a69f82']
  }

  Note: '''Model representing a periodic task.'''
}

Table otp_static_staticdevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed boolean [default: true, not null, note: 'Is this device ready for use?']
  throttling_failure_timestamp "timestamp with time zone" [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count integer [default: 0, not null, note: 'Number of successive failed attempts.']
  created_at "timestamp with time zone" [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at "timestamp with time zone" [note: 'The most recent date and time this device was used.']

  indexes {
    (user_id) [name: 'otp_static_staticdevice_user_id_7f9cff2b']
  }

  Note: '''A static :class:`~django_otp.models.Device` simply consists of random
tokens shared by the database and the user.

These are frequently used as emergency tokens in case a user\'s normal
device is lost or unavailable. They can be consumed in any order; each
token will be removed from the database as soon as it is used.

This model has no fields of its own, but serves as a container for
:class:`StaticToken` objects.

.. attribute:: token_set

    The RelatedManager for our tokens.

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table otp_static_statictoken {
  id integer [pk, increment]
  device_id integer [not null]
  token varchar(16) [not null]

  indexes {
    (device_id) [name: 'otp_static_statictoken_device_id_74b7c7d1']
    (token) [name: 'otp_static_statictoken_token_d0a51866']
    (token) [name: 'otp_static_statictoken_token_d0a51866_like', note: 'varchar_pattern_ops']
  }

  Note: '''A single token belonging to a :class:`StaticDevice`.

.. attribute:: device

    *ForeignKey*: A foreign key to :class:`StaticDevice`.

.. attribute:: token

    *CharField*: A random string up to 16 characters.'''
}

Table otp_totp_totpdevice {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed boolean [default: true, not null, note: 'Is this device ready for use?']
  throttling_failure_timestamp "timestamp with time zone" [default: null, note: 'A timestamp of the last failed verification attempt. Null if last attempt succeeded.']
  throttling_failure_count integer [default: 0, not null, note: 'Number of successive failed attempts.']
  created_at "timestamp with time zone" [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at "timestamp with time zone" [note: 'The most recent date and time this device was used.']
  key varchar(80) [not null, note: 'A hex-encoded secret key of up to 40 bytes.. default in Python: default_key()']
  step smallint [default: 30, not null, note: 'The time step in seconds.']
  t0 bigint [default: 0, not null, note: 'The Unix time at which to begin counting steps.']
  digits TOTPDeviceDigits [default: 6, not null, note: 'The number of digits to expect in a token.']
  tolerance smallint [default: 1, not null, note: 'The number of time steps in the past or future to allow.']
  drift smallint [default: 0, not null, note: 'The number of time steps the prover is known to deviate from our clock.']
  last_t bigint [default: -1, not null, note: 'The t value of the latest verified token. The next token must be at a higher time step.']

  indexes {
    (user_id) [name: 'otp_totp_totpdevice_user_id_0fb18292']
  }

  Note: '''A generic TOTP :class:`~django_otp.models.Device`. The model fields mostly
correspond to the arguments to :func:`django_otp.oath.totp`. They all have
sensible defaults, including the key, which is randomly generated.

.. attribute:: key

    *CharField*: A hex-encoded secret key of up to 40 bytes. (Default: 20
    random bytes)

.. attribute:: step

    *PositiveSmallIntegerField*: The time step in seconds. (Default: 30)

.. attribute:: t0

    *BigIntegerField*: The Unix time at which to begin counting steps.
    (Default: 0)

.. attribute:: digits

    *PositiveSmallIntegerField*: The number of digits to expect in a token
    (6 or 8).  (Default: 6)

.. attribute:: tolerance

    *PositiveSmallIntegerField*: The number of time steps in the past or
    future to allow. For example, if this is 1, we\'ll accept any of three
    tokens: the current one, the previous one, and the next one. (Default:
    1)

.. attribute:: drift

    *SmallIntegerField*: The number of time steps the prover is known to
    deviate from our clock.  If :setting:`OTP_TOTP_SYNC` is ``True``, we\'ll
    update this any time we match a token that is not the current one.
    (Default: 0)

.. attribute:: last_t

    *BigIntegerField*: The time step of the last verified token. To avoid
    verifying the same token twice, this will be updated on each successful
    verification. Only tokens at a higher time step will be verified
    subsequently. (Default: -1)

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from ThrottlingMixin (abstract): throttling_failure_timestamp, throttling_failure_count.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table django_otp_webauthn_webauthncredential {
  id bigint [pk, increment]
  user_id integer [not null, note: 'The user that this device belongs to.']
  name varchar(64) [not null, note: 'The human-readable name of this device.']
  confirmed boolean [default: true, not null, note: 'Is this device ready for use?']
  created_at "timestamp with time zone" [note: 'The date and time when this device was initially created in the system.. default in Python: now()']
  last_used_at "timestamp with time zone" [note: 'The most recent date and time this device was used.']
  credential_type WebAuthnCredentialCredentialType [default: 'public-key', not null]
  credential_id bytea [not null]
  public_key bytea [not null]
  transports jsonb [not null, note: 'default in Python: list()']
  sign_count integer [default: 0, not null]
  backup_eligible boolean [default: false, not null]
  backup_state boolean [default: false, not null]
  aaguid varchar(36) [not null]
  credential_id_sha256 varchar(64) [unique, not null]
  discoverable boolean [default: null]

  indexes {
    (user_id) [name: 'django_otp_webauthn_webauthncredential_user_id_023391d8']
    (credential_id_sha256) [name: 'django_otp_webauthn_weba_credential_id_sha256_1a385252_like', note: 'varchar_pattern_ops']
    (credential_id_sha256) [name: 'webauthncredential_sha256_idx']
  }

  Note: '''A OTP device that validates against a user\'s credential.

See https://www.w3.org/TR/webauthn-3/ for more information about the FIDO 2
Web Authentication standard.

Columns from AbstractWebAuthnCredential (abstract): credential_type, credential_id, public_key, transports, sign_count, backup_eligible, backup_state, aaguid, credential_id_sha256, discoverable.

Columns from TimestampMixin (abstract): created_at, last_used_at.

Columns from Device (abstract): user_id, name, confirmed.'''
}

Table django_otp_webauthn_webauthnattestation {
  id bigint [pk, increment]
  fmt WebAuthnAttestationFmt [not null]
  data bytea [not null]
  client_data_json bytea [not null]
  credential_id bigint [unique, not null]

  Note: '''Model to store attestation for registered credentials for future reference

Columns from AbstractWebAuthnAttestation (abstract): fmt, data, client_data_json.'''
}

Table django_otp_webauthn_webauthnuserhandle {
  handle_hex varchar(128) [unique, not null]
  user_id integer [pk]

  indexes {
    (handle_hex) [name: 'django_otp_webauthn_webauthnuserhandle_handle_hex_ebcf77a1_like', note: 'varchar_pattern_ops']
  }

  Note: '''Model to store WebAuthn \'user handles\'[^1] for individual users.

User handles are used as by authenticators to identify credentials belonging
to the same user. This allows authenticators to identify if they already
have a credential for a given user. In practice this is used to avoid having
multiple credentials for the same user on the same authenticator.

This models follows the recommendation [^2] in the WebAuthn Level 3
specification to let the user handle be 64 random bytes, stored with the
user account.

For practical compatibility reasons, we store the user handle as a hex
string so it can be indexed across multiple database vendors.

- [^1]: https://www.w3.org/TR/webauthn-3/#user-handle
- [^2]: https://www.w3.org/TR/webauthn-3/#sctn-user-handle-privacy'''
}

