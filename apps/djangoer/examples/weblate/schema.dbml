  checks {
    `(("category_id" IS NULL AND "component_id" IS NULL AND "project_id" IS NULL AND "workspace_id" IS NULL) OR ("category_id" IS NULL AND "component_id" IS NULL AND "project_id" IS NULL AND "workspace_id" IS NOT NULL) OR ("category_id" IS NULL AND "component_id" IS NULL AND "project_id" IS NOT NULL AND "workspace_id" IS NULL) OR ("category_id" IS NOT NULL AND "component_id" IS NULL AND "project_id" IS NULL AND "workspace_id" IS NULL) OR ("category_id" IS NULL AND "component_id" IS NOT NULL AND "project_id" IS NULL AND "workspace_id" IS NULL))` [name: 'trans_report_single_scope']
