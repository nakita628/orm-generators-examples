    (priority) [name: 'offer_conditionaloffer_priority_4c2fc582']
  }

  Note: '''Columns from AbstractConditionalOffer (abstract): name, slug, description, offer_type, exclusive, status, condition_id, benefit_id, priority, start_datetime, end_datetime, max_global_applications, max_user_applications, max_basket_applications, max_discount, total_discount, num_applications, num_orders, redirect_url, date_created.'''
}

