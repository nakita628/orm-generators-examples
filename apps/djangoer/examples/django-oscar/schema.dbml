  max_basket_applications "integer unsigned" [note: 'The number of times this offer can be applied to a cart (and order)']
  max_discount decimal [note: 'When an offer has given more discount to orders than this threshold, then the offer becomes unavailable. declared max_digits=12, decimal_places=2, which the database does not enforce']
  total_discount decimal [not null, note: 'default in Python: Decimal(\'0.00\'). declared max_digits=12, decimal_places=2, which the database does not enforce']
