  logo varchar(100) [not null, note: 'Leave blank to use the default Django logo']
  logo_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  logo_max_width "smallint unsigned" [default: 400, not null]
  logo_max_height "smallint unsigned" [default: 100, not null]
  logo_visible bool [default: true, not null]
  favicon varchar(100) [not null, note: '(.ico|.png|.gif - 16x16|32x32 px)']
  env_name varchar(50) [not null]
  env_color varchar(10) [default: '#E74C3C', not null, note: '(red: #E74C3C, orange: #E67E22, yellow: #F1C40F, green: #2ECC71, blue: #3498DB)']
  env_visible_in_header bool [default: true, not null]
  env_visible_in_favicon bool [default: true, not null]
  language_chooser_active bool [default: true, not null]
  language_chooser_control ThemeLanguageChooserControl [default: 'default-select', not null]
  language_chooser_display ThemeLanguageChooserDisplay [default: 'code', not null]
  css_header_background_color varchar(10) [default: '#0C4B33', not null, note: '#0C4B33']
  css_header_text_color varchar(10) [default: '#44B78B', not null, note: '#44B78B']
  css_header_link_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  css_header_link_hover_color varchar(10) [default: '#C9F0DD', not null, note: '#C9F0DD']
  css_module_background_color varchar(10) [default: '#44B78B', not null, note: '#44B78B']
  css_module_background_selected_color varchar(10) [default: '#FFFFCC', not null, note: '#FFFFCC']
  css_module_text_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  css_module_link_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  css_module_link_selected_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  css_module_link_hover_color varchar(10) [default: '#C9F0DD', not null, note: '#C9F0DD']
  css_module_rounded_corners bool [default: true, not null]
  css_generic_link_color varchar(10) [default: '#0C3C26', not null, note: '#0C3C26']
  css_generic_link_hover_color varchar(10) [default: '#156641', not null, note: '#156641']
  css_generic_link_active_color varchar(10) [default: '#29B864', not null, note: '#29B864']
  css_save_button_background_color varchar(10) [default: '#0C4B33', not null, note: '#0C4B33']
  css_save_button_background_hover_color varchar(10) [default: '#0C3C26', not null, note: '#0C3C26']
  css_save_button_text_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  css_delete_button_background_color varchar(10) [default: '#BA2121', not null, note: '#BA2121']
  css_delete_button_background_hover_color varchar(10) [default: '#A41515', not null, note: '#A41515']
  css_delete_button_text_color varchar(10) [default: '#FFFFFF', not null, note: '#FFFFFF']
  related_modal_active bool [default: true, not null]
  related_modal_background_color varchar(10) [default: '#000000', not null, note: '#000000']
  related_modal_background_opacity ThemeRelatedModalBackgroundOpacity [default: '0.3', not null, note: '20%']
  related_modal_rounded_corners bool [default: true, not null]
  related_modal_close_button_visible bool [default: true, not null]
  list_filter_highlight bool [default: true, not null]
  list_filter_dropdown bool [default: true, not null]
  list_filter_sticky bool [default: true, not null]
  list_filter_removal_links bool [default: true, not null]
  foldable_apps bool [default: true, not null]
  show_fieldsets_as_tabs bool [default: false, not null]
  show_inlines_as_tabs bool [default: false, not null]
  collapsible_stacked_inlines bool [default: false, not null]
  collapsible_stacked_inlines_collapsed bool [default: true, not null]
  collapsible_tabular_inlines bool [default: false, not null]
  collapsible_tabular_inlines_collapsed bool [default: true, not null]
  recent_actions_visible bool [default: true, not null]
  form_actions_sticky bool [default: true, not null]
  form_submit_sticky bool [default: true, not null]
  form_pagination_sticky bool [default: true, not null]
}

