Table actstream_action {
  id integer [pk, increment]
  actor_content_type_id integer [not null]
  actor_object_id varchar(255) [not null, note: 'actor: with actor_content_type_id, a generic foreign key to a row of any model (from Group.actor_actions, User.actor_actions, AccessControlList.actor_actions, LoginAttempt.actor_actions, Asset.actor_actions, StoredCredential.actor_actions, StoredDashboard.actor_actions, Key.actor_actions, SavedResultset.actor_actions, Cache.actor_actions, CachePartition.actor_actions, Message.actor_actions, Role.actor_actions, StoredPermission.actor_actions, Quota.actor_actions, DownloadFile.actor_actions, Announcement.actor_actions, DocumentType.actor_actions, DocumentTypeFilename.actor_actions, Document.actor_actions, DocumentFile.actor_actions, DocumentVersion.actor_actions, DocumentVersionPage.actor_actions, DocumentFilePage.actor_actions, Cabinet.actor_actions, Comment.actor_actions, IndexTemplate.actor_actions, DetachedSignature.actor_actions, EmbeddedSignature.actor_actions, Workflow.actor_actions, WorkflowState.actor_actions, WorkflowTransition.actor_actions, WorkflowTransitionField.actor_actions, WorkflowInstance.actor_actions, WorkflowStateAction.actor_actions, WorkflowStateEscalation.actor_actions, WorkflowTransitionTriggerEvent.actor_actions, StoredDriver.actor_actions, SmartLink.actor_actions, SmartLinkCondition.actor_actions, UserMailer.actor_actions, MetadataType.actor_actions, DocumentTypeMetadataType.actor_actions, Sequence.actor_actions, SignatureCapture.actor_actions, Source.actor_actions, Tag.actor_actions, WebLink.actor_actions)']
  verb varchar(255) [not null]
  description text
  target_content_type_id integer
  target_object_id varchar(255) [note: 'target: with target_content_type_id, a generic foreign key to a row of any model (from Group.target_actions, User.target_actions, AccessControlList.target_actions, LoginAttempt.target_actions, Asset.target_actions, StoredCredential.target_actions, StoredDashboard.target_actions, Key.target_actions, SavedResultset.target_actions, Cache.target_actions, CachePartition.target_actions, Message.target_actions, Role.target_actions, StoredPermission.target_actions, Quota.target_actions, DownloadFile.target_actions, Announcement.target_actions, DocumentType.target_actions, DocumentTypeFilename.target_actions, Document.target_actions, DocumentFile.target_actions, DocumentVersion.target_actions, DocumentVersionPage.target_actions, DocumentFilePage.target_actions, Cabinet.target_actions, Comment.target_actions, IndexTemplate.target_actions, DetachedSignature.target_actions, EmbeddedSignature.target_actions, Workflow.target_actions, WorkflowState.target_actions, WorkflowTransition.target_actions, WorkflowTransitionField.target_actions, WorkflowInstance.target_actions, WorkflowStateAction.target_actions, WorkflowStateEscalation.target_actions, WorkflowTransitionTriggerEvent.target_actions, StoredDriver.target_actions, SmartLink.target_actions, SmartLinkCondition.target_actions, UserMailer.target_actions, MetadataType.target_actions, DocumentTypeMetadataType.target_actions, Sequence.target_actions, SignatureCapture.target_actions, Source.target_actions, Tag.target_actions, WebLink.target_actions)']
  action_object_content_type_id integer
  action_object_object_id varchar(255) [note: 'action_object: with action_object_content_type_id, a generic foreign key to a row of any model (from Group.action_object_actions, User.action_object_actions, AccessControlList.action_object_actions, LoginAttempt.action_object_actions, Asset.action_object_actions, StoredCredential.action_object_actions, StoredDashboard.action_object_actions, Key.action_object_actions, SavedResultset.action_object_actions, Cache.action_object_actions, CachePartition.action_object_actions, Message.action_object_actions, Role.action_object_actions, StoredPermission.action_object_actions, Quota.action_object_actions, DownloadFile.action_object_actions, Announcement.action_object_actions, DocumentType.action_object_actions, DocumentTypeFilename.action_object_actions, Document.action_object_actions, DocumentFile.action_object_actions, DocumentVersion.action_object_actions, DocumentVersionPage.action_object_actions, DocumentFilePage.action_object_actions, Cabinet.action_object_actions, Comment.action_object_actions, IndexTemplate.action_object_actions, DetachedSignature.action_object_actions, EmbeddedSignature.action_object_actions, Workflow.action_object_actions, WorkflowState.action_object_actions, WorkflowTransition.action_object_actions, WorkflowTransitionField.action_object_actions, WorkflowInstance.action_object_actions, WorkflowStateAction.action_object_actions, WorkflowStateEscalation.action_object_actions, WorkflowTransitionTriggerEvent.action_object_actions, StoredDriver.action_object_actions, SmartLink.action_object_actions, SmartLinkCondition.action_object_actions, UserMailer.action_object_actions, MetadataType.action_object_actions, DocumentTypeMetadataType.action_object_actions, Sequence.action_object_actions, SignatureCapture.action_object_actions, Source.action_object_actions, Tag.action_object_actions, WebLink.action_object_actions)']
  timestamp datetime [not null, note: 'default in Python: now()']
  public bool [default: true, not null]

  indexes {
    (actor_content_type_id) [name: 'actstream_action_actor_content_type_id_d5e5ec2a']
    (actor_object_id) [name: 'actstream_action_actor_object_id_72ef0cfa']
    (verb) [name: 'actstream_action_verb_83f768b7']
    (target_content_type_id) [name: 'actstream_action_target_content_type_id_187fa164']
    (target_object_id) [name: 'actstream_action_target_object_id_e080d801']
    (action_object_content_type_id) [name: 'actstream_action_action_object_content_type_id_ee623c15']
    (action_object_object_id) [name: 'actstream_action_action_object_object_id_6433bdf7']
    (timestamp) [name: 'actstream_action_timestamp_a23fe3ae']
    (public) [name: 'actstream_action_public_ac0653e9']
  }

  Note: '''Action model describing the actor acting out a verb (on an optional
target).
Nomenclature based on http://activitystrea.ms/specs/atom/1.0/

Generalized Format::

    <actor> <verb> <time>
    <actor> <verb> <target> <time>
    <actor> <verb> <action_object> <target> <time>

Examples::

    <justquick> <reached level 60> <1 minute ago>
    <brosner> <commented on> <pinax/pinax> <2 hours ago>
    <washingtontimes> <started follow> <justquick> <8 minutes ago>
    <mitsuhiko> <closed> <issue 70> on <mitsuhiko/flask> <about 2 hours ago>

Unicode Representation::

    justquick reached level 60 1 minute ago
    mitsuhiko closed issue 70 on mitsuhiko/flask 3 hours ago

HTML Representation::

    <a href="http://oebfare.com/">brosner</a> commented on <a href="http://github.com/pinax/pinax">pinax/pinax</a> 2 hours ago'''
}

