Table task_manager_taskdeduplicationentry {
  id integer [pk, increment]
  dotted_path varchar(255) [not null, note: 'Python path of the task type the marker suppresses.']
  key text [not null, note: 'Serialized keyword arguments identifying the unit of work requested.']
  key_hash varchar(64) [not null, note: 'Hash of the key. The unique constraint is applied to this field and not to the key itself because the length of a key is decided by the task requesting the work, and an index over an unbounded column exceeds the size limit of some database managers.']
  datetime_created datetime [not null, note: 'Date and time the work was requested or last re-dispatched. A marker whose work has not begun stops suppressing requests once this is older than the queued interval, which is what allows a worker that ended before publishing its task to recover without intervention.. default in Python: now()']
  datetime_started datetime [note: 'Date and time a worker began performing the work. Until it is set, the task the marker stands for is still waiting in the queue and has not read the object it will act on, so a request arriving in that period asks for work the queued task is already going to perform.']
  is_dirty bool [default: false, not null, note: 'A new request for the same unit of work arrived after the task began performing it, therefore too late for the task to take it into account. The work is dispatched once more when the task completes.']

  indexes {
    (dotted_path) [name: 'task_manager_taskdeduplicationentry_dotted_path_3a38748b']
    (datetime_created) [name: 'task_manager_taskdeduplicationentry_datetime_created_c6213bd3']
    (datetime_started) [name: 'task_manager_taskdeduplicationentry_datetime_started_4807565c']
    (dotted_path, key_hash) [unique, name: 'task_manager_taskdeduplicationentry_unique_key']
  }
}

