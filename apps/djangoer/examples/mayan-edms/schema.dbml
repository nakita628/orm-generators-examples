  ip_address char(39)
  username varchar(255)
  http_accept varchar(1025) [not null]
  path_info varchar(255) [not null]
  attempt_time datetime [not null, note: 'default in Python: now()']
  get_data text [not null]
  post_data text [not null]
  failures_since_start "integer unsigned" [not null]

  indexes {
    (user_agent) [name: 'axes_accessattempt_user_agent_ad89678b']
    (ip_address) [name: 'axes_accessattempt_ip_address_10922d9c']
    (username) [name: 'axes_accessattempt_username_3f2d4ca0']
    (username, ip_address, user_agent) [unique, name: 'axes_accessattempt_username_ip_address_user_agent_8ea22282_uniq']
  }

  Note: '''Columns from AccessBase (abstract): user_agent, ip_address, username, http_accept, path_info, attempt_time.'''
}

