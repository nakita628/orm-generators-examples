  Note: '''A revisioned collection of FileDiffs.'''
}

Table diffviewer_diffcommit {
  id integer [pk, increment]
  filename varchar(256) [not null, note: 'The original file name of the diff.']
  diffset_id integer [not null]
  author_name varchar(256) [not null, note: 'The name of the commit author.']
  author_email varchar(256) [not null, note: 'The e-mail address of the commit author.']
  author_date_utc datetime [not null, note: 'The date the commit was authored in UTC.']
  author_date_offset integer [not null, note: 'The author\'s UTC offset.']
  committer_name varchar(256) [note: 'The name of the committer (if applicable).']
  committer_email varchar(256) [note: 'The e-mail address of the committer (if applicable).']
  committer_date_utc datetime [note: 'The date the commit was committed in UTC (if applicable).']
  committer_date_offset integer [note: 'The committer\'s UTC offset (if applicable).']
  commit_message text [not null, note: 'The commit message.']
  commit_id varchar(64) [not null, note: 'The unique identifier of the commit.']
  parent_id varchar(64) [not null, note: 'The unique identifier of the parent commit.']
  last_modified datetime [not null, note: 'default in Python: now()']
  extra_data text

  indexes {
    (diffset_id) [name: 'diffviewer_diffcommit_diffset_id_8c3c2dbb']
    (diffset_id, commit_id) [unique, name: 'diffviewer_diffcommit_diffset_id_commit_id_61b21cc8_uniq']
  }

  Note: '''A representation of a commit from a version control system.

A DiffSet on a Review Request that represents a commit history will have
one or more DiffCommits. Each DiffCommit will have one or more associated
FileDiffs (which also belong to the parent DiffSet).

The information stored herein is intended to fully represent the state of
a single commit in that history. The series of DiffCommits can be used to
re-create the original series of commits posted for review.'''
}

Table diffviewer_diffsethistory {
  id integer [pk, increment]
  name varchar(256) [not null]
  timestamp datetime [not null, note: 'default in Python: now()']
  last_diff_updated datetime [default: null]
  extra_data text

  Note: '''A collection of diffsets.

This gives us a way to store and keep track of multiple revisions of
diffsets belonging to an object.'''
}

Table diffviewer_filediffdata {
  binary_hash varchar(40) [pk]
  binary text [not null]
  extra_data text

  Note: '''Deprecated, legacy class for base64-encoded diff data.

This is no longer populated, and exists solely to store legacy data
that has not been migrated to :py:class:`RawFileDiffData`.'''
}

Table diffviewer_rawfilediffdata {
  id integer [pk, increment]
  binary_hash varchar(40) [unique, not null]
  binary BLOB [not null]
  compression RawFileDiffDataCompression
  extra_data text

  Note: '''Stores raw diff data as binary content in the database.

This is the class used in Review Board 2.5+ to store diff content.
Unlike in previous versions, the content is not base64-encoded. Instead,
it is stored either as bzip2-compressed data (if the resulting
compressed data is smaller than the raw data), or as the raw data itself.'''
}

