  diff_against_file_attachment_id integer

  indexes {
    (issue_status) [name: 'reviews_fileattachmentcomment_issue_status_775b5a50']
    (reply_to_id) [name: 'reviews_fileattachmentcomment_reply_to_id_17c9efca']
    (file_attachment_id) [name: 'reviews_fileattachmentcomment_file_attachment_id_8db79ee7']
    (diff_against_file_attachment_id) [name: 'reviews_fileattachmentcomment_diff_against_file_attachment_id_8a13f559']
  }

  Note: '''A comment on a file attachment.

Columns from BaseComment (abstract): issue_opened, issue_status, reply_to_id, timestamp, text, rich_text, extra_data.'''
}

Table reviews_generalcomment {
  id integer [pk, increment]
  issue_opened bool [default: false, not null]
  issue_status GeneralCommentIssueStatus
  reply_to_id integer
  timestamp datetime [not null, note: 'default in Python: now()']
  text text [not null]
  rich_text bool [default: false, not null]
  extra_data text

  indexes {
    (issue_status) [name: 'reviews_generalcomment_issue_status_4b49c612']
    (reply_to_id) [name: 'reviews_generalcomment_reply_to_id_d0a69bbf']
  }

  Note: '''A comment on a review request that is not tied to any code or file.

A general comment on a review request is used when a comment is not tied
to specific lines of code or a special file attachment, and an issue is
opened. Examples include suggestions for testing or pointing out errors
in the change description.

Columns from BaseComment (abstract): issue_opened, issue_status, reply_to_id, timestamp, text, rich_text, extra_data.'''
}

Table reviews_screenshot {
  id integer [pk, increment]
  caption varchar(256) [not null]
  draft_caption varchar(256) [not null]
  image varchar(100) [not null]

  Note: '''A screenshot associated with a review request.

Like diffs, a screenshot can have comments associated with it.
These comments are of type
:py:class:`reviewboard.reviews.models.ScreenshotComment`.'''
}

Table reviews_reviewrequest {
  id integer [pk, increment]
  description text [not null]
  description_rich_text bool [default: false, not null]
  testing_done text [not null]
  testing_done_rich_text bool [default: false, not null]
  bugs_closed varchar(300) [not null]
  branch varchar(300) [not null]
  commit_id varchar(64)
  extra_data text
  rich_text bool [default: false, not null]
  summary varchar(300) [not null]
  submitter_id integer [not null]
  time_added datetime [not null, note: 'default in Python: now()']
  last_updated datetime [not null]
  status ReviewRequestStatus [not null]
  public bool [default: false, not null]
  changenum "integer unsigned"
  repository_id integer
  email_message_id varchar(255)
  time_emailed datetime [default: null]
  diffset_history_id integer
  last_review_timestamp datetime [default: null]
  shipit_count integer [default: 0]
  issue_open_count integer [default: null]
  issue_resolved_count integer [default: null]
  issue_dropped_count integer [default: null]
  issue_verifying_count integer [default: null]
  screenshots_count integer [default: null]
  inactive_screenshots_count integer [default: null]
  file_attachments_count integer [default: null]
  inactive_file_attachments_count integer [default: null]
  local_site_id integer
  local_id integer

  indexes {
    (commit_id) [name: 'reviews_reviewrequest_commit_id_e7104524']
    (submitter_id) [name: 'reviews_reviewrequest_submitter_id_0a5fadde']
    (status) [name: 'reviews_reviewrequest_status_63d3e3fd']
    (changenum) [name: 'reviews_reviewrequest_changenum_a119b782']
    (repository_id) [name: 'reviews_reviewrequest_repository_id_a411142d']
    (diffset_history_id) [name: 'reviews_reviewrequest_diffset_history_id_803728bf']
    (local_site_id) [name: 'reviews_reviewrequest_local_site_id_7eadf98c']
    (commit_id, repository_id) [unique, name: 'reviews_reviewrequest_commit_id_repository_id_8d48574b_uniq']
    (changenum, repository_id) [unique, name: 'reviews_reviewrequest_changenum_repository_id_4aa9bc58_uniq']
    (local_site_id, local_id) [unique, name: 'reviews_reviewrequest_local_site_id_local_id_8ee6145b_uniq']
  }

  Note: '''A review request.

This is one of the primary models in Review Board. Most everything
is associated with a review request.

The ReviewRequest model contains detailed information on a review
request. Some fields are user-modifiable, while some are used for
internal state.

Columns from BaseReviewRequestDetails (abstract): description, description_rich_text, testing_done, testing_done_rich_text, bugs_closed, branch, commit_id, extra_data, rich_text.'''
}

Table reviews_screenshotcomment {
  id integer [pk, increment]
  issue_opened bool [default: false, not null]
  issue_status ScreenshotCommentIssueStatus
  reply_to_id integer
  timestamp datetime [not null, note: 'default in Python: now()']
  text text [not null]
  rich_text bool [default: false, not null]
  extra_data text
  screenshot_id integer [not null]
  x "smallint unsigned"
  y "smallint unsigned" [not null]
  w "smallint unsigned" [not null]
  h "smallint unsigned" [not null]

  indexes {
    (issue_status) [name: 'reviews_screenshotcomment_issue_status_818e13d1']
    (reply_to_id) [name: 'reviews_screenshotcomment_reply_to_id_20d83c7c']
    (screenshot_id) [name: 'reviews_screenshotcomment_screenshot_id_0a8f6ad7']
  }

  Note: '''A comment on a screenshot.

Columns from BaseComment (abstract): issue_opened, issue_status, reply_to_id, timestamp, text, rich_text, extra_data.'''
}

Table reviews_review {
  id integer [pk, increment]
  review_request_id integer [not null]
  user_id integer [not null]
  timestamp datetime [not null, note: 'default in Python: now()']
  public bool [default: false, not null]
  ship_it bool [default: false, not null, note: 'Indicates whether the reviewer thinks this code is ready to ship.']
  base_reply_to_id integer [note: 'The top-most review in the discussion thread for this review reply.']
  email_message_id varchar(255)
  time_emailed datetime [default: null]
  body_top text [not null, note: 'The review text shown above the diff and screenshot comments.']
  body_top_rich_text bool [default: false, not null]
  body_bottom text [not null, note: 'The review text shown below the diff and screenshot comments.']
  body_bottom_rich_text bool [default: false, not null]
  body_top_reply_to_id integer [note: 'The review that the body (top) field is in reply to.']
  body_bottom_reply_to_id integer [note: 'The review that the body (bottom) field is in reply to.']
  extra_data text
  rich_text bool [default: false, not null]
  reviewed_diffset_id integer [note: 'This field is unused and will be removed in a future version.']

  indexes {
    (review_request_id) [name: 'reviews_review_review_request_id_be762bb2']
    (user_id) [name: 'reviews_review_user_id_875caff2']
    (base_reply_to_id) [name: 'reviews_review_base_reply_to_id_a208ad8a']
    (body_top_reply_to_id) [name: 'reviews_review_body_top_reply_to_id_4f3807c0']
    (body_bottom_reply_to_id) [name: 'reviews_review_body_bottom_reply_to_id_a0c60294']
    (reviewed_diffset_id) [name: 'reviews_review_reviewed_diffset_id_4b8bdf06']
  }

  Note: '''A review of a review request.'''
}

Table reviews_reviewrequestdraft {
  id integer [pk, increment]
  description text [not null]
  description_rich_text bool [default: false, not null]
  testing_done text [not null]
  testing_done_rich_text bool [default: false, not null]
  bugs_closed varchar(300) [not null]
  branch varchar(300) [not null]
  commit_id varchar(64)
  extra_data text
  rich_text bool [default: false, not null]
  summary varchar(300) [not null]
  owner_id integer
  review_request_id integer [unique, not null]
  last_updated datetime [not null]
  diffset_id integer
  changedesc_id integer
  screenshots_count integer [default: null]
  inactive_screenshots_count integer [default: null]
  file_attachments_count integer [default: null]
  inactive_file_attachments_count integer [default: null]

  indexes {
    (commit_id) [name: 'reviews_reviewrequestdraft_commit_id_a36610d9']
    (owner_id) [name: 'reviews_reviewrequestdraft_owner_id_86066878']
    (diffset_id) [name: 'reviews_reviewrequestdraft_diffset_id_ba3c2e37']
    (changedesc_id) [name: 'reviews_reviewrequestdraft_changedesc_id_70a4d612']
  }

  Note: '''A draft of a review request.

When a review request is being modified, a special draft copy of it is
created containing all the details of the review request. This copy can
be modified and eventually saved or discarded. When saved, the new
details are copied back over to the originating ReviewRequest.

Columns from BaseReviewRequestDetails (abstract): description, description_rich_text, testing_done, testing_done_rich_text, bugs_closed, branch, commit_id, extra_data, rich_text.'''
}

Table reviews_statusupdate {
  id integer [pk, increment]
  service_id varchar(255) [not null]
  user_id integer
  timestamp datetime [not null, note: 'default in Python: now()']
  summary varchar(255) [not null]
  description varchar(255) [not null]
  url varchar(255) [not null]
  url_text varchar(64) [not null]
  state StatusUpdateState [not null]
  review_request_id integer [not null]
  change_description_id integer
  review_id integer [unique]
  extra_data text
  timeout integer

  indexes {
    (user_id) [name: 'reviews_statusupdate_user_id_1f850855']
    (review_request_id) [name: 'reviews_statusupdate_review_request_id_09b3d2bf']
    (change_description_id) [name: 'reviews_statusupdate_change_description_id_260b3553']
  }

  Note: '''A status update from a third-party service or extension.

This status model allows external services (such as continuous integration
services, Review Bot, etc.) to provide an update on their status. An
example of this would be a CI tool which does experimental builds of
changes. While the build is running, that tool would set its status to
pending, and when it was done, would set it to one of the done states,
and potentially associate it with a review containing issues.'''
}

Table scmtools_tool {
  id integer [pk, increment]
  name varchar(32) [unique, not null]
  class_name varchar(128) [unique, not null]

  Note: '''A configured source code management tool.

Each :py:class:`~reviewboard.scmtools.core.SCMTool` used by repositories
must have a corresponding :py:class:`Tool` entry. These provide information
on the capabilities of the tool, and accessors to construct a tool for
a repository.

Deprecated:
    5.0:
    This model is now obsolete. Any usage of this should be updated to use
    equivalent methods on the Repository or SCMTool instead.'''
}

Table scmtools_repository {
  id integer [pk, increment]
  name varchar(255) [not null]
  path varchar(255) [not null]
  mirror_path varchar(255) [not null]
  raw_file_url varchar(255) [not null]
  username varchar(32) [not null]
  password varchar(128) [not null]
  extra_data text
  tool_id integer [not null]
  scmtool_id varchar(255)
  hosting_account_id integer
  bug_tracker varchar(256) [not null, note: 'This should be the full path to a bug in the bug tracker for this repository, using \'%s\' in place of the bug ID.']
  encoding varchar(32) [not null, note: 'The encoding used for files in this repository. This is an advanced setting and should only be used if you\'re sure you need it.']
  visible bool [default: true, not null, note: 'Use this to control whether or not a repository is shown when creating new review requests. Existing review requests are unaffected.']
  archived bool [default: false, not null, note: 'Archived repositories do not show up in lists of repositories, and aren\'t open to new review requests.']
  archived_timestamp datetime
  local_site_id integer
  public bool [default: true, not null, note: 'Review requests and files on public repositories are visible to anyone. Private repositories must explicitly list the users and groups that can access them.']
  hooks_uuid varchar(32) [note: 'Unique identifier used for validating incoming webhooks.']

  indexes {
    (tool_id) [name: 'scmtools_repository_tool_id_d3b242d1']
    (hosting_account_id) [name: 'scmtools_repository_hosting_account_id_fe34c221']
    (local_site_id) [name: 'scmtools_repository_local_site_id_989f4f3a']
    (name, local_site_id) [unique, name: 'scmtools_repository_name_local_site_id_17cf0ace_uniq']
    (archived_timestamp, path, local_site_id) [unique, name: 'scmtools_repository_archived_timestamp_path_local_site_id_cac61803_uniq']
    (hooks_uuid, local_site_id) [unique, name: 'scmtools_repository_hooks_uuid_local_site_id_05a64b12_uniq']
  }

  Note: '''A configured external source code repository.

Each configured Repository entry represents a source code repository that
Review Board can communicate with as part of the diff uploading and
viewing process.

Repositories are backed by a
:py:class:`~reviewboard.scmtools.core.SCMTool`, which functions as a client
for the type of repository and can fetch files, load lists of commits and
branches, and more.

Access control is managed by a combination of the :py:attr:`public`,
:py:attr:`users`, and :py:attr:`groups` fields. :py:attr:`public` controls
whether a repository is publicly-accessible by all users on the server.
When ``False``, only users explicitly listed in :py:attr:`users` or users
who are members of the groups listed in :py:attr:`groups` will be able
to access the repository or view review requests posted against it.'''
}

Table site_localsite {
  id integer [pk, increment]
  name varchar(32) [unique, not null]
  public bool [default: false, not null, note: 'Allow people outside the team to access and post review requests and reviews.']
  extra_data text

  indexes {
    (public) [name: 'site_localsite_public_a3cbfbac']
  }

  Note: '''A division within a Review Board installation.

This allows the creation of independent, isolated divisions within a given
server. Users can be designated as members of a LocalSite, and optionally
as admins (which allows them to manipulate the repositories, groups and
users in the site).

Pretty much every other model in this module can all be assigned to a
single LocalSite, at which point only members will be able to see or
manipulate these objects. Access control is performed at every level, and
consistency is enforced through a liberal sprinkling of assertions and unit
tests.'''
}

Table webapi_webapitoken {
  id integer [pk, increment]
  user_id integer [not null, note: 'The user that owns the token.']
  token varchar(255) [unique, not null, note: 'The access token.']
  token_generator_id varchar(255) [not null, note: 'The token generator that generated the token.']
  time_added datetime [not null, note: 'The date and time when the token was first added to the database.. default in Python: now()']
  last_updated datetime [not null, note: 'The date and time when the token was last updated.. default in Python: now()']
  last_used datetime [note: 'The date and time when the token was last used for authentication.']
  expires datetime [note: 'An optional field for the date and time that the token will expire. The token will be invalid and unusable for authentication after this point.']
  valid bool [default: true, not null, note: 'Whether the token is currently valid.']
  invalid_date datetime [note: 'The date and time at which the token became invalid.']
  invalid_reason text [not null, note: 'A message indicating why the token is no longer valid.']
  note text [not null, note: 'A message describing the token.']
  policy text [note: 'The policy document describing what this token can access in the API. If empty, this provides full access.']
  extra_data text
  local_site_id integer

  indexes {
    (user_id) [name: 'webapi_webapitoken_user_id_3651ab64']
    (local_site_id) [name: 'webapi_webapitoken_local_site_id_72c83924']
  }

  Note: '''An access token used for authenticating with the API.

Each token can be used to authenticate the token\'s owner with the API,
without requiring a username or password to be provided. Tokens can
be revoked, and new tokens added.

Tokens can store policy information, which will later be used for
restricting access to the API.

Columns from BaseWebAPIToken (abstract): user_id, token, token_generator_id, time_added, last_updated, last_used, expires, valid, invalid_date, invalid_reason, note, policy, extra_data.'''
}

