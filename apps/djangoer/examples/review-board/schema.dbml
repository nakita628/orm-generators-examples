}

Table reviews_group {
  id integer [pk, increment]
  name varchar(64) [not null]
  display_name varchar(64) [not null]
  mailing_list varchar(254) [not null, note: 'The mailing list review requests and discussions are sent to.']
  email_list_only bool [default: true, not null, note: 'If a mailing list is specified and this option is checked, group members will not be individually included on e-mails, and only the mailing list will be used. This is highly recommended for large groups.']
  local_site_id integer
  is_default_group bool [default: false, not null, note: 'If a local site is set, this will automatically add users to this group when those users are added to the local site. If there is no local site, users will be automatically added to this group when they are registered.']
  incoming_request_count integer [default: null]
  invite_only bool [default: false, not null, note: 'If checked, only the users listed below will be able to view review requests sent to this group.']
  visible bool [default: true, not null]
  extra_data text

  indexes {
    (name) [name: 'reviews_group_name_c92d67b9']
    (local_site_id) [name: 'reviews_group_local_site_id_b7e35237']
    (name, local_site_id) [unique, name: 'reviews_group_name_local_site_id_cd520124_uniq']
  }

  Note: '''A group of people who can be targeted for review.

This is usually used to separate teams at a company or components of a
project.

Each group can have an e-mail address associated with it, sending
all review requests and replies to that address. If that e-mail address is
blank, e-mails are sent individually to each member of that group.'''
}

Table reviews_defaultreviewer {
  id integer [pk, increment]
  name varchar(64) [not null]
  file_regex varchar(256) [not null, note: 'File paths are matched against this regular expression to determine if these reviewers should be added.']
  local_site_id integer

  indexes {
    (local_site_id) [name: 'reviews_defaultreviewer_local_site_id_bcfc837d']
  }

  Note: '''Represents reviewers automatically added to review requests.

A default reviewer entry automatically adds default reviewers to a
review request when the diff modifies a file matching the ``file_regex``
pattern specified.

This is useful when different groups own different parts of a codebase.
Adding DefaultReviewer entries ensures that the right people will always
see the review request and discussions.

A ``file_regex`` of ``".*"`` will add the specified reviewers by
default for every review request.

Note that this is keyed off the same LocalSite as its "repository" member.'''
}

Table reviews_comment {
  id integer [pk, increment]
  issue_opened bool [default: false, not null]
  issue_status CommentIssueStatus
  reply_to_id integer
  timestamp datetime [not null, note: 'default in Python: now()']
  text text [not null]
  rich_text bool [default: false, not null]
