Table radbatch {
  organization_id char(32) [not null]
  id char(32) [pk, note: 'default in Python: uuid4()']
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'default in Python: now()']
  strategy RadiusBatchStrategy [not null, note: 'Import users from a CSV or generate using a prefix']
  status RadiusBatchStatus [default: 'pending', not null]
  name varchar(128) [not null, note: 'A unique batch name']
  csvfile varchar(100) [note: 'The csv file containing the user details to be uploaded']
  prefix varchar(20) [note: 'Usernames generated will be of the format [prefix][number]']
  user_credentials text
  expiration_date date [note: 'If left blank users will never expire']
  group_id char(32)
  notes text [not null, note: 'internal notes']

  indexes {
    (organization_id) [name: 'radbatch_organization_id_d184d391']
    (strategy) [name: 'radbatch_strategy_1fe16152']
    (status) [name: 'radbatch_status_35f74861']
    (name) [name: 'radbatch_name_15eac8ea']
    (group_id) [name: 'radbatch_group_id_8bd9d0a5']
    (name, organization_id) [unique, name: 'radbatch_name_organization_id_82270c3b_uniq']
  }

  Note: '''Columns from AbstractRadiusBatch (abstract): strategy, status, name, csvfile, prefix, user_credentials, expiration_date, group_id, notes.

Columns from OrgMixin (abstract): organization_id.

Columns from TimeStampedEditableModel (abstract): created, modified.

Columns from UUIDModel (abstract): id.'''
}

Table radiustoken {
  organization_id char(32) [not null]
  created datetime [not null, note: 'default in Python: now()']
  key varchar(40) [pk]
  user_id char(32) [unique, not null]
  can_auth bool [default: false, not null, note: 'Enable the radius token to be used for freeradius authorization request']
  password_based bool [default: null, note: 'Indicates whether the user\'s most recent authentication used the local password. When false, the radius token is treated as externally authenticated (eg: SSO, SAML), so the local password expiration policy does not apply to it.']

  indexes {
    (organization_id) [name: 'radiustoken_organization_id_8e1824bf']
  }

  Note: '''Columns from AbstractRadiusToken (abstract): key, user_id, can_auth, password_based.

Columns from OrgMixin (abstract): organization_id.

Columns from TimeStampedEditableModel (abstract): created.'''
}

Table openwisp_radius_organizationradiussettings {
  id char(32) [pk, note: 'default in Python: uuid4()']
  organization_id char(32) [unique, not null]
  token varchar(32) [not null, note: 'default in Python: get_random_key()']
  sms_verification bool [default: null, note: 'Whether users who sign up should be required to verify their mobile phone number via SMS']
  needs_identity_verification bool [default: null, note: 'Whether identity verification is required at the time of user registration']
  sms_sender varchar(128) [note: 'alpha numeric identifier used as sender for SMS sent by this organization']
  sms_message text [default: null, note: 'SMS message template used for sending verification code. Must contain "{code}" placeholder for OTP value.']
  sms_cooldown "integer unsigned" [default: null, note: 'Time period a user will have to wait before requesting another SMS token (in seconds).']
  sms_meta_data text [note: 'Additional configuration for SMS backend in JSON format (optional, leave blank if unsure)']
  freeradius_allowed_hosts text [default: null, note: 'Comma separated list of IP addresses allowed to access freeradius API']
  coa_enabled bool [default: null, note: 'Whether RADIUS Change Of Authoization (CoA) is enabled']
  allowed_mobile_prefixes text [default: null, note: 'Comma separated list of international mobile prefixes allowed to register via the user registration API.']
  first_name OrganizationRadiusSettingsFirstName [default: null, note: 'Whether this field should be disabled, allowed or mandatory in the user registration API.']
  last_name OrganizationRadiusSettingsLastName [default: null, note: 'Whether this field should be disabled, allowed or mandatory in the user registration API.']
  location OrganizationRadiusSettingsLocation [default: null, note: 'Whether this field should be disabled, allowed or mandatory in the user registration API.']
  birth_date OrganizationRadiusSettingsBirthDate [default: null, note: 'Whether this field should be disabled, allowed or mandatory in the user registration API.']
  registration_enabled bool [default: null, note: 'Whether the registration API endpoint should be enabled or not']
  saml_registration_enabled bool [default: null, note: 'Whether the registration using SAML should be enabled or not']
  mac_addr_roaming_enabled bool [default: null, note: 'Whether the MAC address roaming should be enabled or not.']
  social_registration_enabled bool [default: null, note: 'Whether the registration using social applications should be enabled or not']
  login_url varchar(200) [note: 'Enter the URL where users can log in to the wifi service']
  status_url varchar(200) [note: 'Enter the URL where users can log out from the wifi service']
  password_reset_url varchar(200) [default: null, note: 'Enter the URL where users can reset their password']

  Note: '''Columns from AbstractOrganizationRadiusSettings (abstract): organization_id, token, sms_verification, needs_identity_verification, sms_sender, sms_message, sms_cooldown, sms_meta_data, freeradius_allowed_hosts, coa_enabled, allowed_mobile_prefixes, first_name, last_name, location, birth_date, registration_enabled, saml_registration_enabled, mac_addr_roaming_enabled, social_registration_enabled, login_url, status_url, password_reset_url.

Columns from UUIDModel (abstract): id.'''
}

