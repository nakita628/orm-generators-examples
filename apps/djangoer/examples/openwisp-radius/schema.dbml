Table openwisp_users_user {
  password varchar(128) [not null]
  last_login datetime
  is_superuser bool [default: false, not null, note: 'Designates that this user has all permissions without explicitly assigning them.']
  username varchar(150) [unique, not null, note: 'Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only.']
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  is_staff bool [default: false, not null, note: 'Designates whether the user can log into this admin site.']
  is_active bool [default: true, not null, note: 'Designates whether this user should be treated as active. Unselect this instead of deleting accounts.']
  date_joined datetime [not null, note: 'default in Python: now()']
  id char(32) [pk, note: 'default in Python: uuid4()']
  email varchar(254) [unique]
  bio text [not null]
  url varchar(200) [not null]
  company varchar(30) [not null]
  location varchar(256) [not null]
  phone_number varchar(128) [unique]
  birth_date date
  notes text [not null, note: 'notes for internal usage']
  language UserLanguage [default: 'en-us', not null]
  password_updated date
  password_based_token bool [default: null, note: 'Indicates whether the last authentication token was obtained using the local password. When false, the token came from an external method (eg: SSO, SAML) and password expiration is not enforced for it. None means no token has been issued for this user since this feature was introduced.']
  expiration_date date [note: 'If set, the account will be deactivated after this date passes and the user will no longer be able to log in.']

  indexes {
    (id, email) [name: 'user_id_email_idx']
    (is_active, expiration_date) [name: 'user_active_expiry_idx']
  }

  Note: '''Columns from AbstractUser (abstract): id, bio, url, company, location, phone_number, birth_date, notes, language, password_updated, password_based_token, expiration_date.

Columns from AbstractUser (abstract): username, first_name, last_name, email, is_staff, is_active, date_joined.

Columns from AbstractBaseUser (abstract): password, last_login.

Columns from PermissionsMixin (abstract): is_superuser.'''
}

