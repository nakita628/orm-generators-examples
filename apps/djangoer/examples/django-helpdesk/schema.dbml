  last_updated datetime [not null, note: 'The date on which this question was most recently changed.']
  team_id bigint
  order "integer unsigned"
  enabled bool [default: true, not null]

  indexes {
    (category_id) [name: 'helpdesk_kbitem_category_id_14a1b130']
    (team_id) [name: 'helpdesk_kbitem_team_id_81825755']
  }

  Note: '''An item within the knowledgebase. Very straightforward question/answer
style system.'''
}

Table helpdesk_savedsearch {
  id integer [pk, increment]
  user_id integer [not null]
  title varchar(100) [not null, note: 'User-provided name for this query']
  shared bool [default: false, not null, note: 'Should other users see this query?']
  query text [not null, note: 'Pickled query object. Be wary changing this.']

  indexes {
    (user_id) [name: 'helpdesk_savedsearch_user_id_24cf33b5']
  }

  Note: '''Allow a user to save a ticket search, eg their filtering and sorting
options, and optionally share it with other users. This lets people
easily create a set of commonly-used filters, such as:
    * My tickets waiting on me
    * My tickets waiting on submitter
    * My tickets in \'Priority Support\' queue with priority of 1
    * All tickets containing the word \'billing\'.
     etc...'''
}

Table helpdesk_usersettings {
  id integer [pk, increment]
  user_id integer [unique, not null]
  settings_pickled text [note: 'DEPRECATED! This is a base64-encoded representation of a pickled Python dictionary. Do not change this field via the admin.']
  login_view_ticketlist bool [not null, note: 'Display the ticket list upon login? Otherwise, the dashboard is shown.. default in Python: login_view_ticketlist_default()']
  email_on_ticket_change bool [not null, note: 'If you\'re the ticket owner and the ticket is changed via the web by somebody else,do you want to receive an e-mail?. default in Python: email_on_ticket_change_default()']
  email_on_ticket_assign bool [not null, note: 'If you are assigned a ticket via the web, do you want to receive an e-mail?. default in Python: email_on_ticket_assign_default()']
  tickets_per_page UserSettingsTicketsPerPage [not null, note: 'How many tickets do you want to see on the Ticket List page?. default in Python: tickets_per_page_default()']
  use_email_as_submitter bool [not null, note: 'When you submit a ticket, do you want to automatically use your e-mail address as the submitter address? You can type a different e-mail address when entering the ticket if needed, this option only changes the default.. default in Python: use_email_as_submitter_default()']
  ticket_respond_layout UserSettingsTicketRespondLayout [not null, note: 'Where should the respond form appear when viewing a ticket?. default in Python: ticket_respond_layout_default()']

  Note: '''A bunch of user-specific settings that we want to be able to define, such
as notification preferences and other things that should probably be
configurable.'''
}

Table helpdesk_ignoreemail {
  id integer [pk, increment]
  name varchar(100) [not null]
  date date [not null, note: 'Date on which this e-mail address was added']
  email_address varchar(150) [not null, note: 'Enter a full e-mail address, or portions with wildcards, eg *@domain.com or postmaster@*.']
  keep_in_mailbox bool [default: false, not null, note: 'Do you want to save emails from this address in the mailbox? If this is unticked, emails from this address will be deleted.']

  Note: '''This model lets us easily ignore e-mails from certain senders when
processing IMAP and POP3 mailboxes, eg mails from postmaster or from
known trouble-makers.'''
}

Table helpdesk_ticketcc {
  id integer [pk, increment]
  ticket_id integer [not null]
  user_id integer [note: 'User who wishes to receive updates for this ticket.']
  email varchar(254) [note: 'For non-user followers, enter their e-mail address']
  can_view bool [default: false, not null, note: 'Can this CC login to view the ticket details?']
  can_update bool [default: false, not null, note: 'Can this CC login and update the ticket?']

  indexes {
    (ticket_id) [name: 'helpdesk_ticketcc_ticket_id_4e774289']
    (user_id) [name: 'helpdesk_ticketcc_user_id_d811c3c2']
  }

  Note: '''Often, there are people who wish to follow a ticket who aren\'t the
person who originally submitted it. This model provides a way for those
people to follow a ticket.

In this circumstance, a \'person\' could be either an e-mail address or
an existing system user.'''
}

Table helpdesk_customfield {
  id integer [pk, increment]
  name varchar(50) [unique, not null, note: 'As used in the database and behind the scenes. Must be unique and consist of only lowercase letters with no punctuation.']
  label varchar(30) [not null, note: 'The display label for this field']
  help_text text [note: 'Shown to the user when editing the ticket']
  data_type CustomFieldDataType [not null, note: 'Allows you to restrict the data entered into this field']
  max_length integer
  decimal_places integer [note: 'Only used for decimal fields']
  empty_selection_list bool [default: false, not null, note: 'Only for List: adds an empty first entry to the choices list, which enforces that the user makes an active choice.']
  list_values text [note: 'For list fields only. Enter one option per line.']
  ordering integer [note: 'Lower numbers are displayed first; higher numbers are listed later']
  required bool [default: false, not null, note: 'Does the user have to enter a value for this field?']
  staff_only bool [default: false, not null, note: 'If this is ticked, then the public submission form will NOT show this field']

  Note: '''Definitions for custom fields that are glued onto each ticket.'''
}

Table helpdesk_ticketcustomfieldvalue {
  id integer [pk, increment]
  ticket_id integer [not null]
  field_id integer [not null]
  value text

