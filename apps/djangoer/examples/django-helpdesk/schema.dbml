Table helpdesk_queue {
  id integer [pk, increment]
  title varchar(100) [not null]
  slug varchar(50) [unique, not null, note: 'This slug is used when building ticket ID\'s. Once set, try not to change it or e-mailing may get messy.']
  email_address varchar(254) [note: 'All outgoing e-mails for this queue will use this e-mail address. If you use IMAP or POP3, this should be the e-mail address for that mailbox.']
  locale varchar(10) [note: 'Locale of this queue. All correspondence in this queue will be in this language.']
  allow_public_submission bool [default: false, not null, note: 'Should this queue be listed on the public submission form?']
  allow_email_submission bool [default: false, not null, note: 'Do you want to poll the e-mail box below for new tickets?']
  escalate_days integer [note: 'For tickets which are not held, how often do you wish to increase their priority? Set to 0 for no escalation.']
  new_ticket_cc varchar(200) [note: 'If an e-mail address is entered here, then it will receive notification of all new tickets created for this queue. Enter a comma between multiple e-mail addresses.']
  updated_ticket_cc varchar(200) [note: 'If an e-mail address is entered here, then it will receive notification of all activity (new tickets, closed tickets, updates, reassignments, etc) for this queue. Separate multiple addresses with a comma.']
  enable_notifications_on_email_events bool [default: false, not null, note: 'When an email arrives to either create a ticket or to interact with an existing discussion. Should email notifications be sent ? Note: the new_ticket_cc and updated_ticket_cc work independently of this feature']
  email_box_type QueueEmailBoxType [note: 'E-Mail server type for creating tickets automatically from a mailbox - both POP3 and IMAP are supported, as well as reading from a local directory.']
  email_box_host varchar(200) [note: 'Your e-mail server address - either the domain name or IP address. May be "localhost".']
  email_box_port integer [note: 'Port number to use for accessing e-mail. Default for POP3 is "110", and for IMAP is "143". This may differ on some servers. Leave it blank to use the defaults.']
  email_box_ssl bool [default: false, not null, note: 'Whether to use SSL for IMAP or POP3 - the default ports when using SSL are 993 for IMAP and 995 for POP3.']
  email_box_user varchar(200) [note: 'Username for accessing this mailbox.']
  email_box_pass varchar(200) [note: 'Password for the above username']
  email_box_imap_folder varchar(100) [note: 'If using IMAP, what folder do you wish to fetch messages from? This allows you to use one IMAP account for multiple queues, by filtering messages on your IMAP server into separate folders. Default: INBOX.']
  email_box_local_dir varchar(200) [note: 'If using a local directory, what directory path do you wish to poll for new email? Example: /var/lib/mail/helpdesk/']
  permission_name varchar(72) [note: 'Name used in the django.contrib.auth permission system']
  email_box_interval integer [default: '5', note: 'How often do you wish to check this mailbox? (in Minutes)']
  email_box_last_check datetime
  socks_proxy_type QueueSocksProxyType [note: 'SOCKS4 or SOCKS5 allows you to proxy your connections through a SOCKS server.']
  socks_proxy_host char(39) [note: 'Socks proxy IP address. Default: 127.0.0.1']
  socks_proxy_port integer [note: 'Socks proxy port number. Default: 9150 (default TOR port)']
  logging_type QueueLoggingType [note: 'Set the default logging level. All messages at that level or above will be logged to the directory set below. If no level is set, logging will be disabled.']
  logging_dir varchar(200) [note: 'If logging is enabled, what directory should we use to store log files for this queue? The standard logging mechanisms are used if no directory is set']
  default_owner_id integer
  dedicated_time bigint [note: 'Time to be spent on this Queue in total']

  indexes {
    (default_owner_id) [name: 'helpdesk_queue_default_owner_id_b0930a66']
  }

  Note: '''A queue is a collection of tickets into what would generally be business
areas or departments.

For example, a company may have a queue for each Product they provide, or
a queue for each of Accounts, Pre-Sales, and Support.'''
}

Table helpdesk_ticket {
  id integer [pk, increment]
  title varchar(200) [not null]
  queue_id integer [not null]
  created datetime [not null, note: 'Date this ticket was first created. default in Python: now()']
  modified datetime [not null, note: 'Date this ticket was most recently changed.. default in Python: now()']
  submitter_email varchar(254) [note: 'The submitter will receive an email for all public follow-ups left for this task.']
  assigned_to_id integer
  status TicketStatus [default: 1, not null]
  on_hold bool [default: false, not null, note: 'If a ticket is on hold, it will not automatically be escalated.']
  description text [note: 'The content of the customers query.']
  resolution text [note: 'The resolution provided to the customer by our staff.']
  priority TicketPriority [default: 3, not null, note: '1 = Highest Priority, 5 = Low Priority']
  due_date datetime
  last_escalation datetime [note: 'The date this ticket was last escalated - updated automatically by management/commands/escalate_tickets.py.']
  secret_key varchar(36) [not null, note: 'default in Python: mk_secret()']
  kbitem_id integer
  merged_to_id integer

  indexes {
    (queue_id) [name: 'helpdesk_ticket_queue_id_9b210169']
    (assigned_to_id) [name: 'helpdesk_ticket_assigned_to_id_0716992e']
    (kbitem_id) [name: 'helpdesk_ticket_kbitem_id_ee0464fc']
    (merged_to_id) [name: 'helpdesk_ticket_merged_to_id_7e3893ff']
  }

  Note: '''To allow a ticket to be entered as quickly as possible, only the
bare minimum fields are required. These basically allow us to
sort and manage the ticket. The user can always go back and
enter more information later.

A good example of this is when a customer is on the phone, and
you want to give them a ticket ID as quickly as possible. You can
enter some basic info, save the ticket, give the customer the ID
and get off the phone, then add in further detail at a later time
(once the customer is not on the line).

Note that assigned_to is optional - unassigned tickets are displayed on
the dashboard to prompt users to take ownership of them.'''
}

Table helpdesk_followup {
  id integer [pk, increment]
  ticket_id integer [not null]
  date datetime [not null, note: 'default in Python: now()']
  title varchar(200)
  comment text
  public bool [default: false, not null, note: 'Public tickets are viewable by the submitter and all staff, but non-public tickets can only be seen by staff.']
  user_id integer
  new_status FollowUpNewStatus [note: 'If the status was changed, what was it changed to?']
  message_id varchar(256) [note: 'The Message ID of the submitter\'s email.']
  time_spent bigint [note: 'Time spent on this follow up']
  email_recipients text [default: null, note: 'Addresses successfully notified by e-mail about this follow-up. Null means recipients were not recorded.']

  indexes {
    (ticket_id) [name: 'helpdesk_followup_ticket_id_3db2d079']
    (user_id) [name: 'helpdesk_followup_user_id_5b9c07e3']
  }

  Note: '''A FollowUp is a comment and/or change to a ticket. We keep a simple
title, the comment entered by the user, and the new status of a ticket
to enable easy flagging of details on the view-ticket page.

The title is automatically generated at save-time, based on what action
the user took.

Tickets that aren\'t public are never shown to or e-mailed to the submitter,
although all staff can see them.'''
}

Table helpdesk_ticketchange {
  id integer [pk, increment]
  followup_id integer [not null]
  field varchar(200) [not null]
  old_value text
  new_value text

  indexes {
    (followup_id) [name: 'helpdesk_ticketchange_followup_id_2e4e87bc']
  }

  Note: '''For each FollowUp, any changes to the parent ticket (eg Title, Priority,
etc) are tracked here for display purposes.'''
}

Table helpdesk_followupattachment {
