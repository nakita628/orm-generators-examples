  id integer [pk, increment]
  user_id integer [not null]
  interval SettingsInterval [default: 0, not null, note: 'interval in minutes (0=instant, 60=notify once per hour)']
  is_default bool [default: false, not null]
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'default in Python: now()']

  indexes {
    (user_id) [name: 'nyt_settings_user_id_1fad6d98']
  }

  Note: '''Reusable settings object for a subscription'''
}

Table nyt_subscription {
  id integer [pk, increment]
  settings_id bigint [not null]
  notification_type_id varchar(128) [not null]
