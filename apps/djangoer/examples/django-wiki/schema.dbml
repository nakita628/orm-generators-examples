  user_id integer
  modified datetime [not null, note: 'default in Python: now()']
  created datetime [not null, note: 'default in Python: now()']
  previous_revision_id bigint
  deleted bool [default: false, not null]
  locked bool [default: false, not null]
  attachment_id bigint [not null]
  file varchar(255) [not null]
  description text [not null]

  indexes {
    (user_id) [name: 'wiki_attachments_attachmentrevision_user_id_2da908ac']
    (previous_revision_id) [name: 'wiki_attachments_attachmentrevision_previous_revision_id_e7f09093']
    (attachment_id) [name: 'wiki_attachments_attachmentrevision_attachment_id_32ffc4ea']
  }

  Note: '''Columns from BaseRevisionMixin (abstract): revision_number, user_message, automatic_log, ip_address, user_id, modified, created, previous_revision_id, deleted, locked.'''
}

Table wiki_notifications_articlesubscription {
  articleplugin_ptr_id bigint [pk, note: 'parent link: a ArticleSubscription is a ArticlePlugin (multi-table inheritance)']
