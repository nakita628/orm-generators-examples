  send_emails bool [default: true, not null]
  latest_id bigint
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'default in Python: now()']
  last_sent datetime

  indexes {
    (settings_id) [name: 'nyt_subscription_settings_id_761bae06']
    (notification_type_id) [name: 'nyt_subscription_notification_type_id_ca8af379']
    (latest_id) [name: 'nyt_subscription_latest_id_bbb7d98b']
  }
}

Table nyt_notification {
  id integer [pk, increment]
  subscription_id bigint
  user_id integer
  message text [not null]
  url varchar(2000)
  is_viewed bool [default: false, not null]
  is_emailed bool [default: false, not null]
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'default in Python: now()']
  occurrences "integer unsigned" [default: 1, not null, note: 'If the same notification was fired multiple times with no intermediate notifications']

  indexes {
    (subscription_id) [name: 'nyt_notification_subscription_id_5a132ae1']
    (user_id) [name: 'nyt_notification_user_id_acbb5c10']
  }
}

Table thumbnail_kvstore {
  key varchar(200) [pk]
  value text [not null]
}

Table wiki_article {
  id integer [pk, increment]
  current_revision_id bigint [unique, note: 'The revision being displayed for this article. If you need to do a roll-back, simply change the value of this field.']
  created datetime [not null, note: 'default in Python: now()']
  modified datetime [not null, note: 'Article properties last modified. default in Python: now()']
  owner_id integer [note: 'The owner of the article, usually the creator. The owner always has both read and write access.']
  group_id integer [note: 'Like in a UNIX file system, permissions can be given to a user according to group membership. Groups are handled through the Django auth system.']
  group_read bool [default: true, not null]
  group_write bool [default: true, not null]
  other_read bool [default: true, not null]
  other_write bool [default: true, not null]

  indexes {
    (owner_id) [name: 'wiki_article_owner_id_956bc94a']
    (group_id) [name: 'wiki_article_group_id_bf035c83']
  }
}

Table wiki_articleforobject {
  id integer [pk, increment]
  article_id bigint [not null]
  content_type_id integer [not null]
  object_id "integer unsigned" [not null, note: 'content_object: with content_type_id, a generic foreign key to a row of any model (from URLPath.articles)']
  is_mptt bool [default: false, not null]

  indexes {
    (article_id) [name: 'wiki_articleforobject_article_id_7d67d809']
    (content_type_id) [name: 'wiki_articleforobject_content_type_id_ba569059']
    (content_type_id, object_id) [unique, name: 'wiki_articleforobject_content_type_id_object_id_046be756_uniq']
  }
}

Table wiki_articlerevision {
  id integer [pk, increment]
  revision_number integer [not null]
  user_message text [not null]
  automatic_log text [not null]
  ip_address char(39)
  user_id integer
  modified datetime [not null, note: 'default in Python: now()']
  created datetime [not null, note: 'default in Python: now()']
  previous_revision_id bigint
  deleted bool [default: false, not null]
  locked bool [default: false, not null]
  article_id bigint [not null]
  content text [not null]
  title varchar(512) [not null, note: 'Each revision contains a title field that must be filled out, even if the title has not changed']

  indexes {
    (user_id) [name: 'wiki_articlerevision_user_id_c687e4de']
    (previous_revision_id) [name: 'wiki_articlerevision_previous_revision_id_bcfaf4c9']
    (article_id) [name: 'wiki_articlerevision_article_id_e0fb2474']
    (article_id, revision_number) [unique, name: 'wiki_articlerevision_article_id_revision_number_5bcd5334_uniq']
  }

  Note: '''This is where main revision data is stored. To make it easier to
copy, do NEVER create m2m relationships.

Columns from BaseRevisionMixin (abstract): revision_number, user_message, automatic_log, ip_address, user_id, modified, created, previous_revision_id, deleted, locked.'''
}

Table wiki_articleplugin {
  id integer [pk, increment]
  article_id bigint [not null]
  deleted bool [default: false, not null]
  created datetime [not null, note: 'default in Python: now()']

  indexes {
    (article_id) [name: 'wiki_articleplugin_article_id_9ab0e854']
  }

  Note: '''This is the mother of all plugins. Extending from it means a deletion
of an article will CASCADE to your plugin, and the database will be kept
clean. Furthermore, it\'s possible to list all plugins and maintain generic
properties in the future...'''
}

Table wiki_reusableplugin {
  articleplugin_ptr_id bigint [pk, note: 'parent link: a ReusablePlugin is a ArticlePlugin (multi-table inheritance)']

  Note: '''Extend from this model if you have a plugin that may be related to many
articles. Please note that the ArticlePlugin.article ForeignKey STAYS! This
is in order to maintain an explicit set of permissions.

In general, it\'s quite complicated to maintain plugin content that\'s shared
between different articles. The best way to go is to avoid this. For inspiration,
look at wiki.plugins.attachments

You might have to override the permission methods (can_read, can_write etc.)
if you have certain needs for logic in your reusable plugin.'''
}

Table wiki_simpleplugin {
  articleplugin_ptr_id bigint [pk, note: 'parent link: a SimplePlugin is a ArticlePlugin (multi-table inheritance)']
  article_revision_id bigint [not null]

  indexes {
    (article_revision_id) [name: 'wiki_simpleplugin_article_revision_id_cff7df92']
  }

  Note: '''Inherit from this model and make sure to specify an article when
saving a new instance. This way, a new revision will be created, and
users are able to roll back to the a previous revision (in which your
plugin wasn\'t related to the article).

Furthermore, your plugin relation is kept when new revisions are created.

Usage:

class YourPlugin(SimplePlugin):
    ...

Creating new plugins instances:
YourPlugin(article=article_instance, ...) or
YourPlugin.objects.create(article=article_instance, ...)'''
}

Table wiki_revisionplugin {
  articleplugin_ptr_id bigint [pk, note: 'parent link: a RevisionPlugin is a ArticlePlugin (multi-table inheritance)']
  current_revision_id bigint [unique, note: 'The revision being displayed for this plugin. If you need to do a roll-back, simply change the value of this field.']

  Note: '''If you want your plugin to maintain revisions, extend from this one,
not SimplePlugin.

This kind of plugin is not attached to article plugins so rolling articles
back and forth does not affect it.'''
}

Table wiki_revisionpluginrevision {
  id integer [pk, increment]
  revision_number integer [not null]
  user_message text [not null]
  automatic_log text [not null]
  ip_address char(39)
  user_id integer
  modified datetime [not null, note: 'default in Python: now()']
  created datetime [not null, note: 'default in Python: now()']
  previous_revision_id bigint
  deleted bool [default: false, not null]
  locked bool [default: false, not null]
  plugin_id bigint [not null]

  indexes {
    (user_id) [name: 'wiki_revisionpluginrevision_user_id_ee40f729']
    (previous_revision_id) [name: 'wiki_revisionpluginrevision_previous_revision_id_38c877c0']
    (plugin_id) [name: 'wiki_revisionpluginrevision_plugin_id_c8f4475b']
  }

  Note: '''If you want your plugin to maintain revisions, make an extra model
that extends from this one.

(this class is very much copied from wiki.models.article.ArticleRevision

Columns from BaseRevisionMixin (abstract): revision_number, user_message, automatic_log, ip_address, user_id, modified, created, previous_revision_id, deleted, locked.'''
}

Table wiki_urlpath {
  id integer [pk, increment]
  article_id bigint [not null, note: 'This field is automatically updated, but you need to populate it when creating a new URL path.']
  slug varchar(50)
  site_id integer [not null]
  parent_id bigint [note: 'Position of URL path in the tree.']
  moved_to_id bigint [note: 'Article path was moved to this location']
  lft "integer unsigned" [not null]
  rght "integer unsigned" [not null]
  tree_id "integer unsigned" [not null]
  level "integer unsigned" [not null]

  indexes {
    (article_id) [name: 'wiki_urlpath_article_id_9ef0c0fb']
    (slug) [name: 'wiki_urlpath_slug_39d212eb']
    (site_id) [name: 'wiki_urlpath_site_id_319be912']
    (parent_id) [name: 'wiki_urlpath_parent_id_a6e675ac']
    (moved_to_id) [name: 'wiki_urlpath_moved_to_id_4718abf8']
    (tree_id) [name: 'wiki_urlpath_tree_id_090b475d']
    (site_id, parent_id, slug) [unique, name: 'wiki_urlpath_site_id_parent_id_slug_e4942e5d_uniq']
  }

  Note: '''Strategy: Very few fields go here, as most has to be managed through an
article\'s revision. As a side-effect, the URL resolution remains slim and swift.'''
}

Table wiki_attachments_attachment {
  reusableplugin_ptr_id bigint [pk, note: 'parent link: a Attachment is a ReusablePlugin (multi-table inheritance)']
  current_revision_id bigint [unique, note: 'The revision of this attachment currently in use (on all articles using the attachment)']
  original_filename varchar(256)
}

Table wiki_attachments_attachmentrevision {
  id integer [pk, increment]
  revision_number integer [not null]
  user_message text [not null]
  automatic_log text [not null]
