  extra_data jsonb [not null, note: 'default in Python: dict()']
  created "timestamp with time zone" [not null, note: 'default in Python: now()']
  modified "timestamp with time zone" [not null, note: 'default in Python: now()']

  indexes {
    (user_id) [name: 'social_auth_usersocialauth_user_id_17d28448']
    (uid) [name: 'social_auth_usersocialauth_uid_796e51dc']
    (uid) [name: 'social_auth_usersocialauth_uid_796e51dc_like', note: 'varchar_pattern_ops']
    (provider, uid) [unique, name: 'social_auth_usersocialauth_provider_uid_e6b5e668_uniq']
  }

  checks {
    `NOT ("uid" = '')` [name: 'user_social_auth_uid_required']
  }

  Note: '''Social Auth association model

Columns from AbstractUserSocialAuth (abstract): user_id, provider, id_key, uid, extra_data, created, modified.'''
}

