  job_id uuid [not null, note: 'Job this button will run']
  weight smallint [default: 100, not null]
  group_name varchar(255) [not null, note: 'Buttons with the same group will appear as a dropdown menu. Group dropdown buttons will inherit the button class from the button with the lowest weight in the group.']
