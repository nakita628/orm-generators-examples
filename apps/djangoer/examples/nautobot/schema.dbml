The button text field accepts Jinja2 template code to be rendered with an object as context.

Columns from ChangeLoggedModel (abstract): created, last_updated.

Columns from BaseModel (abstract): id.'''
}

Table extras_scheduledjobs {
  ident smallint [pk, default: 1]
  last_update "timestamp with time zone" [not null]

  Note: '''Helper table for tracking updates to scheduled tasks.

Is and must remain API-compatible with `django_celery_beat.models.PeriodicTasks` model, because it is used
in place of that model via `nautobot.core.celery.schedulers.NautobotDatabaseScheduler`.

This stores a single row with `ident=1`.
`last_update` is updated via Django signals whenever anything is changed in the `ScheduledJob` model.
Basically this acts like a DB data audit trigger.
Doing this so we also track deletions, and not just insert/update.'''
}

Table extras_scheduledjob {
  id uuid [pk, note: 'default in Python: uuid4()']
  name varchar(255) [unique, not null, note: 'Human-readable description of this scheduled task']
  task varchar(201) [not null, note: 'The name of the Celery task that should be run. (Example: "proj.tasks.import_contacts")']
  interval ScheduledJobInterval [not null]
  crontab varchar(255) [not null, note: 'Cronjob syntax string for custom scheduling']
  solar_id integer
  clocked_id integer
  args jsonb [not null, note: 'default in Python: list()']
  kwargs jsonb [not null, note: 'default in Python: dict()']
  exchange varchar(255) [default: null]
  routing_key varchar(255) [default: null]
  headers text [default: '{}', not null]
  priority integer [default: null]
  expires "timestamp with time zone"
  expire_seconds integer
  one_off boolean [default: false, not null, note: 'If True, the schedule will only run the task a single time']
  start_time "timestamp with time zone" [not null, note: 'Datetime when the schedule should begin triggering the task to run']
  state ScheduledJobState [default: 'active', not null, note: 'Current state of the Scheduled Job']
  enabled boolean [default: true, not null, note: 'Set to False to disable the schedule']
  last_run_at "timestamp with time zone" [note: 'Datetime that the schedule last triggered the task to run. Reset to None if enabled is set to False.']
  total_run_count integer [default: 0, not null, note: 'Running count of how many times the schedule has triggered the task']
  date_changed "timestamp with time zone" [not null, note: 'Datetime that this scheduled job was last modified. default in Python: now()']
  description text [not null, note: 'Detailed description about the details of this scheduled job']
  celery_kwargs jsonb [not null, note: 'default in Python: dict()']
  job_model_id uuid
  job_queue_id uuid
  time_zone ScheduledJobTimeZone [not null, note: 'default in Python: get_default_timezone_name()']
  user_id uuid [note: 'User that requested the schedule']
  decision_date "timestamp with time zone" [note: 'Datetime that the schedule was approved or denied']

  indexes {
    (name) [name: 'extras_scheduledjob_name_fcea52d7_like', note: 'varchar_pattern_ops']
    (task) [name: 'extras_scheduledjob_task_7eaf2d6d']
    (task) [name: 'extras_scheduledjob_task_7eaf2d6d_like', note: 'varchar_pattern_ops']
    (solar_id) [name: 'extras_scheduledjob_solar_id_07789418']
    (clocked_id) [name: 'extras_scheduledjob_clocked_id_7521f2a5']
    (state) [name: 'extras_scheduledjob_state_a164d56f']
    (state) [name: 'extras_scheduledjob_state_a164d56f_like', note: 'varchar_pattern_ops']
    (job_model_id) [name: 'extras_scheduledjob_job_model_id_d4c0711e']
    (job_queue_id) [name: 'extras_scheduledjob_job_queue_id_d238dd34']
    (user_id) [name: 'extras_scheduledjob_user_id_4d8034ff']
  }

  Note: '''Model representing a scheduled execution of a Nautobot Job.

Is and must remain API-compatible with `django_celery_beat.models.PeriodicTask` model, because it is used
in place of that model via `nautobot.core.celery.schedulers.NautobotDatabaseScheduler`.

Columns from BaseModel (abstract): id.'''
}

