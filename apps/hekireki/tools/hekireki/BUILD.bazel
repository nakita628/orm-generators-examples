load("@aspect_rules_js//js:defs.bzl", "js_binary")

package(default_visibility = ["//visibility:public"])

# `prisma generate` with every hekireki generator on PATH; see generate.mjs.
js_binary(
    name = "generate",
    data = [
        "//apps/hekireki:node_modules/@prisma/client",
        "//apps/hekireki:node_modules/hekireki",
        "//apps/hekireki:node_modules/prisma",
    ],
    entry_point = "generate.mjs",
)
