  id String [pk]
  value Json [not null]
  assetId String [not null]
  customFieldId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table AssetModelCustomFieldDefault {
  id String [pk]
  value Json [not null]
  assetModelId String [not null]
  customFieldId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (assetModelId, customFieldId) [unique]
  }

  Note: '''A custom field value an AssetModel gives the assets that join it.

`value` has the exact shape of `AssetCustomFieldValue.value`, so filling an
asset is a plain copy. Rows cascade away with their model or field.'''
}

Table Invite {
  id String [pk]
  inviterId String [not null]
  organizationId String [not null]
  inviteeUserId String
  teamMemberId String [not null]
  inviteeEmail String [not null]
  status InviteStatuses [default: 'PENDING', not null]
  inviteCode String [not null]
  roles OrganizationRoles[] [not null]
  inviteMessage String
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table Announcement {
  id String [pk]
  name String [not null]
  content String [not null]
  link String
  linkText String
  published Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table ConsumptionLog {
  id String [pk]
  assetId String [not null]
  category ConsumptionCategory [not null]
  quantity Int [not null]
  note String
  userId String [not null]
  bookingId String
  custodianId String
  bookingAssetId String
  locationId String
  stockChange Int
  createdAt DateTime [default: `now()`, not null]

  Note: '''*
* Audit trail for all quantity changes on quantity-tracked assets.
* Every event records who performed it, who received/returned items,
* which booking it relates to, and the category of change.
* Quantity is always positive — direction is determined by category.'''
}

Table BookingAsset {
  id String [pk]
  bookingId String [not null]
  assetId String [not null]
  quantity Int [default: 1, not null]
  bookingModelRequestId String
  assetKitId String
  sourceKitId String
  checkedOutAt DateTime
  checkedOutById String
  checkedInAt DateTime
  checkedInById String
  checkedOutQuantity Int [default: 0, not null]
  sourceLocationId String

  Note: '''*
* Explicit pivot table between Booking and Asset.
* Replaces the implicit M2M (_AssetToBooking) via a rename migration in Phase 3.'''
}

Table Booking {
  id String [pk]
  name String [not null]
  status BookingStatus [default: 'DRAFT', not null]
  description String [default: '']
  activeSchedulerReference String
  creatorId String [not null]
  custodianUserId String
  custodianTeamMemberId String
  organizationId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  from DateTime [not null]
  to DateTime [not null]
  originalFrom DateTime
  originalTo DateTime
  autoArchivedAt DateTime
  archivedWithoutCheckin Boolean [default: false, not null]
  cancellationReason String
}

Table BookingSettings {
  id String [pk]
  bufferStartTime Int [default: 0, not null]
  tagsRequired Boolean [default: false, not null]
  maxBookingLength Int
  maxBookingLengthSkipClosedDays Boolean [default: false, not null]
  autoArchiveBookings Boolean [default: false, not null]
  autoArchiveDays Int [default: 2, not null]
  autoArchiveExpiredReservations Boolean [default: false, not null]
  requireExplicitCheckinForAdmin Boolean [default: false, not null]
  requireExplicitCheckinForSelfService Boolean [default: false, not null]
  requireExplicitCheckoutForAdmin Boolean [default: false, not null]
  requireExplicitCheckoutForSelfService Boolean [default: false, not null]
  countKitsAsSingleUnit Boolean [default: false, not null]
  notifyBookingCreator Boolean [default: true, not null]
  notifyAdminsOnNewBooking Boolean [default: true, not null]
  organizationId String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table PartialBookingCheckin {
  id String [pk]
  assetIds String[] [not null]
  checkinCount Int [not null]
  checkinTimestamp DateTime [default: `now()`, not null]
  bookingId String [not null]
  checkedInById String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''A progressive check-in SESSION, mirroring PartialBookingCheckout.

`assetIds` lists only FULLY reconciled assets: INDIVIDUAL always, and
QUANTITY_TRACKED only once its remaining units hit zero (partial returns
live in `ConsumptionLog`). Completing a booking outright writes no row here,
so the same warning applies — absence is not evidence of anything.
`BookingAsset.checkedInAt` is the per-slice fact.'''
}

Table PartialBookingCheckout {
  id String [pk]
  assetIds String[] [not null]
  quantities Int[] [not null]
  bookingAssetIds String[] [not null]
  checkoutCount Int [not null]
  checkoutTimestamp DateTime [default: `now()`, not null]
  bookingId String [not null]
  checkedOutById String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''A progressive checkout SESSION: one scan batch, covering N assets via the
positional `assetIds` / `quantities` / `bookingAssetIds` arrays.

Records sessions and the units they claimed — NOT whether an asset is out.
The all-at-once checkout (`checkoutBooking`, the Check out button) flips
statuses and writes NO row here, so **absence proves nothing** and must never
be read as "was not checked out". Reading it that way is what let a single
later scan mark every button-checked-out asset on a booking as
"never checked out". `BookingAsset.checkedOutAt` answers that question.'''
}

Table MobileAuthCode {
  id String [pk]
  userId String [not null]
  codeHash String [unique, not null]
  codeChallenge String
  sessionCiphertext String
  consumedAt DateTime
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]

  Note: '''Native-app SSO web-delegated login — single-use session-handoff codes.
@see apps/webapp/app/routes/_auth+/oauth.callback.mobile.tsx'''
}

Table PushToken {
  id String [pk]
  token String [unique, not null]
  platform DevicePlatform [not null]
  deviceName String
  appVersion String
  lastSeenAt DateTime [not null]
  disabledAt DateTime
  userId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''One Expo push token per installed companion app. A token identifies a
device, not a person: when someone else signs in on the same phone, the
row moves to them. Pushes go only to rows where `disabledAt` is null.
@see apps/webapp/app/modules/push/service.server.ts'''
}

Table NotificationPreference {
  userId String [pk]
  pushEnabled Boolean [default: true, not null]
  bookings Boolean [default: true, not null]
  audits Boolean [default: true, not null]
  stockAndReminders Boolean [default: true, not null]
  updatedAt DateTime [not null]

  Note: '''A person\'s push notification switches. A missing row means every switch
is on, so no backfill is needed. The three category columns are named
after `PushCategory` in apps/webapp/app/modules/push/types.ts.'''
}

Table Kit {
  id String [pk]
  name String [not null]
  description String
  status KitStatus [default: 'AVAILABLE', not null]
  image String
  imageExpiration DateTime
  organizationId String [not null]
  createdById String [not null]
  categoryId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  locationId String
}

Table KitCustody {
  id String [pk]
  custodianId String [not null]
  kitId String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table AssetKit {
  id String [pk]
  assetId String [not null]
  kitId String [not null]
  organizationId String [not null]
  quantity Int [default: 1, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (assetId, kitId) [unique]
  }

  Note: '''Pivot linking an `Asset` to the `Kit` it belongs to.

`@@unique([assetId])` enforces "at most one kit per asset" today.
The structure already allows multi-row-per-asset; if multi-kit
allocation lands later, drop the `assetId` unique constraint and
add a type-aware single-row trigger + sum-within-total CONSTRAINT
TRIGGER (parallel to the Custody / BookingAsset pivots).'''
}

Table AssetLocation {
  id String [pk]
  assetId String [not null]
  locationId String [not null]
  organizationId String [not null]
  quantity Int [default: 1, not null]
  assetKitId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table AssetReminder {
  id String [pk]
  name String [not null]
  message String [not null]
  alertDateTime DateTime [not null]
  activeSchedulerReference String
  recurrenceUnit ReminderRecurrenceUnit
  recurrenceInterval Int
  recurrenceTimezone String
  recurrenceEndsAt DateTime
  organizationId String [not null]
  assetId String [not null]
  createdById String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table WorkingHours {
  id String [pk]
  enabled Boolean [default: false, not null]
  weeklySchedule Json [default: '{"0":{"isOpen":false},"1":{"isOpen":true,"openTime":"09:00","closeTime":"17:00"},"2":{"isOpen":true,"openTime":"09:00","closeTime":"17:00"},"3":{"isOpen":true,"openTime":"09:00","closeTime":"17:00"},"4":{"isOpen":true,"openTime":"09:00","closeTime":"17:00"},"5":{"isOpen":true,"openTime":"09:00","closeTime":"17:00"},"6":{"isOpen":false}}', not null]
  organizationId String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table WorkingHoursOverride {
  id String [pk]
  date DateTime [not null]
  isOpen Boolean [default: false, not null]
  openTime String
  closeTime String
  reason String
  workingHoursId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (workingHoursId, date) [unique]
  }
}

Table Update {
  id String [pk]
  title String [not null]
  content String [not null]
  url String
  imageUrl String
  publishDate DateTime [not null]
  status UpdateStatus [default: 'DRAFT', not null]
  targetRoles OrganizationRoles[] [not null]
  clickCount Int [default: 0, not null]
  viewCount Int [default: 0, not null]
  createdById String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table UserUpdateRead {
  id String [pk]
  userId String [not null]
  updateId String [not null]
  readAt DateTime [default: `now()`, not null]

  indexes {
    (userId, updateId) [unique]
  }
}

Table AuditNote {
  id String [pk]
  content String [not null]
  type NoteType [default: 'COMMENT', not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  userId String
  auditSessionId String [not null]
  auditAssetId String
}

Table TeamMemberNote {
  id String [pk]
  content String [not null]
  type NoteType [default: 'COMMENT', not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  userId String
  teamMemberId String [not null]
  organizationId String [not null]
}

Table AuditSession {
  id String [pk]
  name String [not null]
  description String
  targetId String
  status AuditStatus [default: 'PENDING', not null]
  scopeMeta Json
  expectedAssetCount Int [default: 0, not null]
  foundAssetCount Int [default: 0, not null]
  missingAssetCount Int [default: 0, not null]
  unexpectedAssetCount Int [default: 0, not null]
  startedAt DateTime
  dueDate DateTime
  completedAt DateTime
  cancelledAt DateTime
  activeSchedulerReference String
  createdById String [not null]
  organizationId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table AssetImport {
  id String [pk]
  status AssetImportStatus [default: 'DRAFT', not null]
  phase AssetImportPhase [default: 'PREPARE', not null]
  fileName String
  totalRows Int [not null]
  processedRows Int [default: 0, not null, note: 'Rows committed so far. Advanced in the same transaction as each chunk.']
  rows Json [note: 'Parsed rows (`StoredImportRow[]`). Cleared when the import completes.']
  resolved Json [note: 'Name to id maps written by the PREPARE step (`ResolvedImportEntities`).']
  canUseBarcodes Boolean [default: false, not null]
  errorMessage String [note: 'User-facing reason the import failed. Null unless status is FAILED.']
  warnings Json [note: 'Rows imported without a conflicting piece (`ImportWarning[]`), capped at 500.']
  warningCount Int [default: 0, not null, note: 'Exact number of warnings, including any beyond the stored cap.']
  lockedUntil DateTime [note: 'A step holds the import until this time. Null when no step is running.']
  confirmedAt DateTime
  startedAt DateTime
  completedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  createdById String [not null]
  organizationId String [not null]

  Note: '''One CSV content import. Holds the parsed rows from preview until the import
completes, so the job imports exactly the file the user previewed.
A partial unique index on (organizationId) WHERE status IN (QUEUED, RUNNING) allows one
active import per workspace. Prisma cannot express it; it lives in migration
20261015120100_asset_import_one_active_per_workspace.'''
}

Table LinkPreview {
  id String [pk]
  url String [not null, note: '''`LinkKey` from @shelf/links, never a raw field value. At most 2048
characters (CHECK constraint in the migration).''']
  pageTitle String
  outcome LinkPreviewOutcome [note: 'Null until the first fetch finishes.']
  attempts Int [default: 0, not null]
  fetchedAt DateTime
  nextFetchAt DateTime [default: `now()`, note: '''When the link may be fetched next; null means never again. A claim moves
it a few minutes ahead, which is also the lease on a fetch in flight.''']
  customTitle String [note: 'The name a person gave the link in this workspace; wins over pageTitle.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organizationId String [not null]

  indexes {
    (organizationId, url) [unique]
  }

  Note: '''What Shelf knows about one web link used in a workspace\'s custom fields,
keyed by its `LinkKey` from @shelf/links. Two writers on disjoint columns:
the link preview job (fetch columns) and people (customTitle).'''
}

Table AuditAssignment {
  id String [pk]
  auditSessionId String [not null]
  userId String [not null]
  role AuditAssignmentRole
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (auditSessionId, userId) [unique]
  }
}

Table AuditAsset {
  id String [pk]
  auditSessionId String [not null]
  assetId String [not null]
  expected Boolean [default: true, not null]
  status AuditAssetStatus [default: 'PENDING', not null]
  scannedById String
  scannedAt DateTime
  metadata Json
  expectedQuantity Int [note: '''Units the audit expects to find, snapshotted when the row is created: the
units in the audit\'s scope (placed at its locations, held in its kits, or
held by its person; at most `Asset.quantity`), or `Asset.quantity` when
none are in scope or the audit has no scope. Null for INDIVIDUAL assets,
which count as one.

A snapshot, not a live read: stock that moves during the audit must not
move the target the auditor is counting against.''']
  foundQuantity Int [note: '''Units the auditor counted. Null until a quantity-tracked asset is
counted, and always null for INDIVIDUAL assets. A FOUND row with a count
below `expectedQuantity` is a shortfall: the status stays FOUND (the pool
was located), the gap is this number.

Both columns are non-negative, enforced by CHECK constraints in raw SQL
(migration `20261104120000_add_audit_asset_quantities`).''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (auditSessionId, assetId) [unique]
  }
}

Table AuditScan {
  id String [pk]
  auditSessionId String [not null]
  auditAssetId String
  assetId String
  scannedById String
  code String
  assetTitle String [note: '''What was scanned, recorded BY VALUE at scan time.

`asset` and `auditAsset` are both SetNull/Cascade, so deleting an asset
leaves this row pointing at nothing: no name, and no way to tell whether
it had been expected. An audit is a historical record, and a record whose
entries can silently lose their meaning is not one — so the two
descriptive facts are snapshotted here rather than only referenced.

Readers prefer the LIVE asset when it still exists (a rename should show
the current name) and fall back to these.

Null means the snapshot could not be taken: scans whose asset had already
been deleted before these columns were backfilled. Nothing can recover
those, and they degrade to the scanned `code`, which also survives. Every
other row carries a snapshot, so null is never merely "old".''']
  wasExpected Boolean
  metadata Json
  scannedAt DateTime [default: `now()`, not null]
  createdAt DateTime [default: `now()`, not null]
}

Table AuditImage {
  id String [pk]
  imageUrl String [not null]
  thumbnailUrl String
  description String
  auditSessionId String [not null]
  auditAssetId String
  uploadedById String
  organizationId String [not null]
  capturedAt DateTime [note: '''When the photo was taken, from its EXIF data (or the phone app\'s copy of
it). Null when the photo carried no usable date. EXIF can be edited, so
this is the best signal available, not proof.''']
  captureSource AuditImageCaptureSource [note: '''How the photo reached Shelf. Null only for photos uploaded before this
field existed; a phone upload with no or an unknown source is PHONE.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table RoleChangeLog {
  id String [pk]
  previousRole OrganizationRoles [not null]
  newRole OrganizationRoles [not null]
  source RoleChangeSource [default: 'MANUAL', not null, note: 'How the change was made. SSO rows name the member themself as `changedBy`.']
  createdAt DateTime [default: `now()`, not null]
  userId String [not null]
  changedById String [not null]
  organizationId String [not null]
}

Table ActivityEvent {
  id String [pk]
  organizationId String [not null]
  occurredAt DateTime [default: `now()`, not null]
  actorUserId String
  actorSnapshot Json
  action ActivityAction [not null]
  entityType ActivityEntity [not null]
  entityId String [not null]
  assetId String
  bookingId String
  auditSessionId String
  auditAssetId String
  kitId String
  locationId String
  teamMemberId String
  targetUserId String
  field String
  fromValue Json
  toValue Json
  meta Json
}

