// drizzle/alchemy-d1: the tables that drizzle-kit creates from the Drizzle schema of apps/drizzler/examples/alchemy-d1,
// written up by `prisma db pull`. Written by pull/pull.mjs; do not edit.
//
// Changed from what `prisma db pull` wrote, which `prisma validate` or `prisma db push` refuses:
// - posts.created_at: dbgenerated("unixepoch()") -> dbgenerated("(unixepoch())") (an SQLite expression default has to be in parentheses, which `prisma db push` leaves out)
// - users.created_at: dbgenerated("unixepoch()") -> dbgenerated("(unixepoch())") (an SQLite expression default has to be in parentheses, which `prisma db push` leaves out)
// - users: the name "sqlite_autoindex_users_1" of the unique of email dropped (SQLite reserves the sqlite_autoindex_ prefix, so no ORM can create an index called that)

datasource db {
  provider = "sqlite"
}

model posts {
  id         Int    @id @default(autoincrement())
  user_id    Int
  title      String
  body       String
  created_at Int    @default(dbgenerated("(unixepoch())"))
  users      users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  name       String
  created_at Int     @default(dbgenerated("(unixepoch())"))
  posts      posts[]
}
