// activerecord/loomio: the tables that Active Record creates from Loomio's db/schema.rb,
// written up by `prisma db pull`. Written by pull/pull.mjs; do not edit.
//
// Changed from what `prisma db pull` wrote, which `prisma validate` or `prisma db push` refuses:
// - account_completion_proofs.user_id: BigInt -> Int, the type of users.id it references
// - anonymous_ballot_choices.poll_option_id: BigInt -> Int, the type of poll_options.id it references
// - anonymous_ballots.poll_id: BigInt -> Int, the type of polls.id it references
// - anonymous_poll_voters.poll_id: BigInt -> Int, the type of polls.id it references
// - anonymous_poll_voters.inviter_id: BigInt? -> Int?, the type of users.id it references
// - anonymous_poll_voters.voter_id: BigInt -> Int, the type of users.id it references
// - discussions.topic_id: Int? -> BigInt?, the type of topics.id it references
// - email_suppressions.cleared_by_id: BigInt? -> Int?, the type of users.id it references
// - group_follows.user_id: BigInt -> Int, the type of users.id it references
// - group_follows.group_id: BigInt -> Int, the type of groups.id it references
// - group_handle_redirects.group_id: BigInt -> Int, the type of groups.id it references
// - mobile_authorization_codes.user_id: BigInt -> Int, the type of users.id it references
// - mobile_devices.user_id: BigInt -> Int, the type of users.id it references
// - passkey_challenges.user_id: BigInt? -> Int?, the type of users.id it references
// - passkey_credentials.user_id: BigInt -> Int, the type of users.id it references
// - pending_emails.group_id: BigInt -> Int, the type of groups.id it references
// - polls.topic_id: Int? -> BigInt?, the type of topics.id it references
// - push_subscriptions.user_id: BigInt -> Int, the type of users.id it references
// - sessions.user_id: BigInt -> Int, the type of users.id it references
// - subscription_update_receipts.subscription_id: BigInt? -> Int?, the type of subscriptions.id it references
// - tasks_users.user_id: BigInt -> Int, the type of users.id it references
// - topic_items.topic_id: Int -> BigInt, the type of topics.id it references
// - topic_readers.topic_id: Int -> BigInt, the type of topics.id it references

datasource db {
  provider = "postgresql"
}

// The preview features the schema needs.
generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["partialIndexes"]
}

model account_completion_proofs {
  id           BigInt   @id @default(autoincrement())
  created_at   DateTime @db.Timestamp(6)
